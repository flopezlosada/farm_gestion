{% extends '_layouts/csa_public_survey.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block csa_main %}
    <div class="svy-thanks">
        <h1>{{ title }}</h1>
        <p class="svy-thanks__lead">{{ text }}</p>
    </div>
{% endblock %}
