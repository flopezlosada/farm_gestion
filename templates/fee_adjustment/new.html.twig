{# ============================================================
 # Ajustar la cuota de un socix: paga de más o de menos, cuánto, por qué y
 # en qué meses.
 #
 # El controller pasa: form, partner.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% form_theme form 'form_div_layout.html.twig' %}

{% block title %}Ajustar la cuota · {{ partner.legalName }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('partner_index') }}">Socios</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('partner_show', { id: partner.id }) }}">{{ partner.legalName }}</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Ajustar la cuota</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    <style>
        /* Las dos direcciones como dos botones: es la decisión principal. El radio
           queda dentro del botón (va justo antes de su etiqueta). */
        .fa-direction { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
        .fa-direction input[type=radio] { position: absolute; opacity: 0; pointer-events: none; }
        .fa-direction label { padding: 9px 16px; border: 1px solid var(--csa-rule); border-radius: 8px; cursor: pointer; font-weight: 500; background: var(--csa-surface, #fff); }
        .fa-direction input:checked + label { border-color: var(--csa-ink, #222); box-shadow: inset 0 0 0 1px var(--csa-ink, #222); }
        .fa-direction input:focus-visible + label { outline: 2px solid var(--csa-ink, #222); outline-offset: 2px; }
    </style>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Socios · Cuota', 'Ajustar la cuota de ' ~ partner.legalName,
        'Lo que paga de más o de menos sobre la tarifa de su cesta, en euros al mes. Va en la ficha de quien paga el recibo.') }}

    {{ form_start(form, { attr: { class: 'csa-form-narrow' } }) }}

        {{ form_errors(form) }}

        <div class="csa-stack-lg">

            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Cuánto', subtitle: 'Amplía su cuota, pide una reducción porque no llega, o aporta a una iniciativa.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.direction, 'Paga', { full: true, attr: { class: 'fa-direction' } }) }}
                        {{ csa.field(form.amount, 'Euros al mes', { hint: 'sin signo' }) }}
                        {{ csa.field(form.initiative, 'A qué va', { hint: 'si no va a ninguna iniciativa, es para la asociación', show_when: 'direction=more' }) }}
                        {{ csa.field(form.reason, 'Motivo', { full: true, hint: 'por ejemplo, «amplía su cuota» o «se le cobró dos veces en septiembre»' }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '2', title: 'Cuándo', subtitle: 'Por meses enteros, los dos incluidos. Para un solo mes (devolver algo que se cobró de más) pon el mismo en los dos.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.fromMonth, 'Desde') }}
                        {{ csa.field(form.untilMonth, 'Hasta', { hint: 'vacío: sin fin, hasta que se le ponga' }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: path('partner_show', { id: partner.id }) ~ '#cuota' }) }}
                    <button type="submit" class="csa-btn csa-btn--primary">Guardar ajuste</button>
                </div>
            </div>

        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}
{% endblock %}
