{# ============================================================
 # Ficha de un pedido del grupo de consumo (gestión).
 #   - round        ConsumerGroupRound
 #   - aggregate    { participantCount, total, byItem: [{item, quantity,
 #                    associationQuantity, totalQuantity, subtotal}] }
 #   - transitions  int[] estados a los que se puede pasar ahora
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% set status_badge = {
    5: { label: 'Borrador',   cls: 'warn'    },
    0: { label: 'Abierto',    cls: 'activo'  },
    1: { label: 'Cerrado',    cls: 'pausado' },
    3: { label: 'Cancelado',  cls: 'baja'    },
    4: { label: 'Entregado',  cls: 'mute'    }
} %}
{% set tx_labels = { 0: 'Reabrir pedido', 1: 'Cerrar pedido', 3: 'Cancelar pedido', 4: 'Marcar entregado' } %}
{% set sb = status_badge[round.status]|default({ label: round.statusLabel, cls: 'mute' }) %}
{% set can_edit = is_granted('ROLE_GESTION_GRUPO_CONSUMO_EDIT') %}
{% set can_socixs = is_granted('ROLE_GESTION_SOCIXS') %}
{# El pago lo lleva contabilidad: la comisión del grupo de consumo ve el estado pero no lo cambia. #}
{% set can_pay = is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
{% set can_see_bank = is_granted('FEATURE_CONTABILIDAD') and is_granted('ROLE_GESTION_CONTABILIDAD') %}
{% set can_reparto = is_granted('ROLE_GESTION_REPARTO') %}

{% block title %}{{ round.title }} · Grupo de consumo{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('consumer_group_index') }}">Grupo de consumo</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ round.title }}</span>
{% endblock %}

{% block csa_main %}

    <div class="prt">
        <header class="prt-hero">
            <div>
                <h1 class="prt-hero__title">{{ round.title }}</h1>
                <div class="prt-hero__meta">
                    <span class="prt-chip prt-chip--{{ sb.cls }}"><span class="dot"></span>{{ sb.label }}</span>
                    {% if round.confirmed %}<span class="prt-chip prt-chip--mod-1"><span class="dot"></span>Confirmado</span>{% endif %}
                    {% if round.fullyPickedUp %}<span class="prt-chip prt-chip--activo"><span class="dot"></span>Recogido por todas</span>{% endif %}
                    <span class="sep">·</span>
                    <span>{{ round.producerNames }}</span>
                    {% if round.deliveryDate %}<span class="sep">·</span><span>Entrega {{ round.deliveryDate|date('d/m/Y') }}</span>{% endif %}
                </div>
            </div>
            <div class="prt-hero__actions">
                <a href="{{ path('consumer_group_index') }}" class="prt-btn"><i class="fa fa-arrow-left"></i> Volver</a>
            </div>
        </header>

        <div class="cg-facts">
            <div class="cg-fact">
                <span class="cg-fact__l">Cierre de apuntes</span>
                <span class="cg-fact__v">
                    {{ round.ordersCloseAt ? round.ordersCloseAt|date('d/m/Y') : '—' }}
                    {# El pedido sigue ABIERTO como estado, pero ya no entra nadie: es la
                     # señal de que se puede pasar al productor sin que aparezcan
                     # cantidades nuevas después. #}
                    {% if round.status == 0 and round.ordersCloseAt and not round.canReceiveOrders %}
                        <span class="cg-fact__note">· plazo vencido, ya no se apunta nadie</span>
                    {% endif %}
                </span>
            </div>
            <div class="cg-fact"><span class="cg-fact__l">Entrega</span><span class="cg-fact__v">{{ round.deliveryDate ? round.deliveryDate|date('d/m/Y') : '—' }}</span></div>
            <div class="cg-fact">
                <span class="cg-fact__l">Mínimo</span>
                <span class="cg-fact__v">
                    {{ round.minimumTypeLabel }}
                    {% if round.minimumCondition %}<span class="cg-fact__note">· {{ round.minimumCondition }}</span>{% endif %}
                    {% if not round.confirmed %}
                        {% if round.hasNoMinimum %}<span class="cg-fact__note">· queda confirmado al abrirlo</span>
                        {% elseif round.hasAutomaticMinimum %}<span class="cg-fact__note">· se confirma solo al alcanzarlo</span>
                        {% else %}<span class="cg-fact__note">· lo confirmáis a mano</span>{% endif %}
                    {% endif %}
                </span>
            </div>
            {% if round.confirmedAt %}<div class="cg-fact"><span class="cg-fact__l">Confirmado</span><span class="cg-fact__v">{{ round.confirmedAt|date('d/m/Y') }}</span></div>{% endif %}
            {# Sin aviso, el pedido existe pero no lo ha visto nadie: es un dato de
             # primera línea, no un detalle de trazabilidad. #}
            <div class="cg-fact"><span class="cg-fact__l">Avisado</span><span class="cg-fact__v">{{ round.announcedAt ? round.announcedAt|date('d/m/Y H:i') : 'todavía no' }}</span></div>
            {% if round.deliveredAt %}<div class="cg-fact"><span class="cg-fact__l">Entregado</span><span class="cg-fact__v">{{ round.deliveredAt|date('d/m/Y') }}</span></div>{% endif %}
            {% if round.cancelledAt %}<div class="cg-fact"><span class="cg-fact__l">Cancelado</span><span class="cg-fact__v">{{ round.cancelledAt|date('d/m/Y') }}</span></div>{% endif %}
        </div>

        {% if round.description or round.providerNote or round.cancelReason %}
            <div class="cg-notes">
                {% if round.description %}<p>{{ round.description|nl2br }}</p>{% endif %}
                {% if round.providerNote %}<p><b>Nota al productor:</b> {{ round.providerNote|nl2br }}</p>{% endif %}
                {% if round.cancelReason %}<p><b>Motivo de cancelación:</b> {{ round.cancelReason|nl2br }}</p>{% endif %}
            </div>
        {% endif %}

        {% if can_edit %}
            <div class="prt-actionbar">
                {# canManageOrders y no canReceiveOrders: pasado el plazo de apuntes, la
                 # comisión sigue necesitando tocar la fecha de entrega o la nota al
                 # productor — es justo entonces cuando habla con él. #}
                {% if round.canManageOrders %}
                    <a href="{{ path('consumer_group_edit', { id: round.id }) }}" class="prt-btn prt-btn--primary"><i class="fa fa-pencil"></i> Editar</a>
                    <a href="{{ path('consumer_group_items', { id: round.id }) }}" class="prt-btn"><i class="fa fa-list"></i> Productos del pedido</a>
                {% elseif round.producers is not empty and not round.hasSelfManagedProducer and round.items is not empty %}
                    {# Ya no se tocan productos ni precio final, pero el desglose de un pedido anterior se puede rellenar. #}
                    <a href="{{ path('consumer_group_items', { id: round.id }) }}" class="prt-btn"><i class="fa fa-list"></i> Desglosar precios</a>
                {% endif %}
                {% if can_open %}
                    <a href="{{ path('consumer_group_announce', { id: round.id }) }}" class="prt-btn prt-btn--primary"><i class="fa fa-bullhorn"></i> Abrir y avisar a las socias</a>
                {% elseif round.draft %}
                    <span class="csa-muted">En borrador: para abrirlo hace falta que cada productor tenga productos, que la fecha de cierre no haya pasado y que no queden incrementos pendientes de revisar.</span>
                    {% set pending_items = round.items|filter(i => i.markupPendingReview) %}
                    {% if pending_items|length > 0 %}
                        <div class="csa-alert csa-alert--warning" style="flex-basis: 100%;">
                            Incremento pendiente de revisar en: <strong>{{ pending_items|map(i => i.name)|join(', ') }}</strong>.
                            <a href="{{ path('consumer_group_items', { id: round.id }) }}">Revisarlos en «Productos del pedido»</a>.
                        </div>
                    {% endif %}
                {% endif %}
                {% if can_confirm %}
                    <a href="{{ path('consumer_group_confirm', { id: round.id }) }}" class="prt-btn prt-btn--primary"><i class="fa fa-check"></i> Confirmar pedido</a>
                {% endif %}
                {% if can_announce %}
                    <a href="{{ path('consumer_group_announce', { id: round.id }) }}" class="prt-btn"><i class="fa fa-bullhorn"></i> {{ round.announcedAt ? 'Volver a avisar' : 'Avisar a las socias' }}</a>
                {% endif %}
                {% for to in transitions %}
                    <form method="post" action="{{ path('consumer_group_transition', { id: round.id }) }}" style="display:inline;"
                          {% if to == 3 %}onsubmit="var r=prompt('Motivo de cancelación (opcional):'); if(r===null){return false;} this.reason.value=r; return true;"{% endif %}>
                        <input type="hidden" name="_token" value="{{ csrf_token('consumer_group_transition_' ~ round.id) }}">
                        <input type="hidden" name="to" value="{{ to }}">
                        {% if to == 3 %}<input type="hidden" name="reason" value="">{% endif %}
                        <button type="submit" class="prt-btn{{ to == 3 ? ' prt-btn--danger' : '' }}">{{ tx_labels[to] ?? 'Cambiar estado' }}</button>
                    </form>
                {% endfor %}
            </div>
        {% endif %}

        {# LA TABLA ES EL PEDIDO QUE SE LE PASA AL PRODUCTOR, y eso no es sólo lo que
         # piden las socias: la comisión encarga además para el local. Por eso el
         # total de cada línea suma las dos cosas, y el desglose sólo se enseña
         # cuando hay algo para el local —si no, sobra una columna de ceros—. #}
        {% set can_order_local = can_edit and round.canManageOrders %}
        <section class="prt-card">
            <header class="prt-card__head">
                <h2 class="prt-card__title"><span class="accent"></span>Pedido al productor</h2>
                <span class="csa-muted">{{ aggregate.participantCount == 1 ? '1 socia ha pedido' : aggregate.participantCount ~ ' socias han pedido' }}</span>
                {# En un pedido con varios productores, cada uno recibe solo lo suyo. #}
                {% if round.mixed %}
                    {% for producer in round.producers %}
                        <a href="{{ path('consumer_group_export', { id: round.id, producer: producer.id }) }}" class="prt-btn"><i class="fa fa-download"></i> CSV de {{ producer.name }}</a>
                    {% endfor %}
                {% else %}
                    <a href="{{ path('consumer_group_export', { id: round.id }) }}" class="prt-btn"><i class="fa fa-download"></i> Exportar pedido (CSV)</a>
                {% endif %}
            </header>
            <div class="prt-card__body">
            {% if round.items is empty %}
                <p class="csa-muted">Este pedido no tiene productos.
                    {% if can_order_local %}<a href="{{ path('consumer_group_items', { id: round.id }) }}">Añádelos</a>.{% endif %}
                </p>
            {% else %}
                <form method="post" action="{{ path('consumer_group_association_order', { id: round.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('consumer_group_association_order_' ~ round.id) }}">
                    {# Lo que cuentan las tres columnas de cantidad lo dice el pedido: con un
                     # solo producto, su nombre y su unidad; con varios de la misma unidad,
                     # la unidad; y sólo si mezclan unidades, un texto genérico. #}
                    {% set first_item = aggregate.byItem|first %}
                    {% set mixed_units = aggregate.byItem|filter(l => (l.item.unit ~ '') != (first_item.item.unit ~ ''))|length > 0 %}
                    {% if aggregate.byItem|length == 1 %}
                        {% set qty_title = 'Nº de «' ~ first_item.item.unit ~ '» de ' ~ first_item.item.name %}
                    {% elseif not mixed_units %}
                        {% set qty_title = 'Nº de «' ~ first_item.item.unit ~ '»' %}
                    {% else %}
                        {% set qty_title = 'Nº de unidades de cada producto' %}
                    {% endif %}
                    <div class="prl prl-table-wrap">
                        <table class="prl-table">
                            {# Con table-layout: fixed los anchos salen de las columnas, no de la
                             # segunda fila de la cabecera: se fijan aquí. #}
                            <colgroup>
                                <col>
                                <col style="width: 170px;">
                                <col style="width: 110px;"><col style="width: 110px;"><col style="width: 110px;">
                                <col style="width: 28px;">
                                <col style="width: 120px;"><col style="width: 100px;"><col style="width: 110px;">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th rowspan="2">Producto</th>
                                    <th rowspan="2" class="tight">Precio</th>
                                    <th colspan="3" class="tight cg-agg__group">{{ qty_title }}</th>
                                    <th rowspan="2" class="cg-agg__gap"></th>
                                    <th colspan="3" class="tight cg-agg__group">Importe</th>
                                </tr>
                                <tr>
                                    <th class="tight cg-agg__num">De las socias</th>
                                    <th class="tight cg-agg__num">Para el local</th>
                                    <th class="tight cg-agg__num">Total a pedir</th>
                                    <th class="tight cg-agg__num">Para el productor</th>
                                    <th class="tight cg-agg__num">Gestión</th>
                                    <th class="tight cg-agg__num">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for line in aggregate.byItem %}
                                    {% set medios = line.item.product and line.item.product.halfUnits %}
                                    <tr>
                                        <td>
                                            {{ line.item.name }}
                                            <div class="csa-muted" style="font-size: .8em;">se pide por {{ line.item.unit }}</div>
                                            {% if round.mixed %}<div class="csa-muted" style="font-size: .8em;">{{ line.item.product.producer }}</div>{% endif %}
                                        </td>
                                        <td class="tight" data-label="Precio">
                                            {{ line.item.price|number_format(2, ',', '.') }} € <span class="csa-muted">/ {{ line.item.unit }}</span>
                                            {% if line.item.producerPrice is not null %}
                                                <div class="csa-muted" style="font-size: .8em;">productor {{ line.item.producerPrice|number_format(2, ',', '.') }} + gestión {{ (line.item.price - line.item.producerPrice)|number_format(2, ',', '.') }}</div>
                                            {% endif %}
                                        </td>
                                        <td class="tight cg-agg__num" data-label="De las socias">{{ csa.qty(line.quantity, 2) }}</td>
                                        <td class="tight cg-agg__num" data-label="Para el local">
                                            {% if can_order_local %}
                                                {# El salto lo dice el producto, igual que en el panel de la
                                                 # socia: el local pide los mismos bultos que ellas. #}
                                                <input type="number" min="0"
                                                       step="{{ medios ? '0.5' : '1' }}"
                                                       inputmode="{{ medios ? 'decimal' : 'numeric' }}"
                                                       name="association[{{ line.item.id }}]"
                                                       value="{{ line.associationQuantity ? line.associationQuantity + 0 : '' }}"
                                                       class="csa-input cg-local-qty"
                                                       placeholder="0"
                                                       aria-label="Para el local · {{ line.item.name }}">
                                            {% else %}
                                                {{ csa.qty(line.associationQuantity, 2) }}
                                            {% endif %}
                                        </td>
                                        <td class="tight cg-agg__num" data-label="Total a pedir"><b>{{ csa.qty(line.totalQuantity, 2) }}</b></td>
                                        <td class="cg-agg__gap"></td>
                                        <td class="tight cg-agg__num" data-label="Para el productor">{{ line.producerSubtotal|number_format(2, ',', '.') }} €</td>
                                        <td class="tight cg-agg__num" data-label="Gestión">{{ (line.subtotal - line.producerSubtotal)|number_format(2, ',', '.') }} €</td>
                                        <td class="tight cg-agg__num" data-label="Total"><b>{{ line.subtotal|number_format(2, ',', '.') }} €</b></td>
                                    </tr>
                                {% endfor %}
                                <tr>
                                    <td colspan="5" style="text-align: right;"><b>Total del pedido</b></td>
                                    <td class="cg-agg__gap"></td>
                                    <td class="tight cg-agg__num" data-label="Para el productor"><b>{{ aggregate.producerTotal|number_format(2, ',', '.') }} €</b></td>
                                    <td class="tight cg-agg__num" data-label="Gestión"><b>{{ (aggregate.total - aggregate.producerTotal)|number_format(2, ',', '.') }} €</b></td>
                                    <td class="tight cg-agg__num" data-label="Total"><b>{{ aggregate.total|number_format(2, ',', '.') }} €</b></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    {% if can_order_local %}
                        <div class="csa-row" style="justify-content: flex-end; margin-top: var(--csa-sp-2);">
                            <button type="submit" class="prt-btn prt-btn--primary"><i class="fa fa-save"></i> Guardar lo del local</button>
                        </div>
                    {% endif %}
                </form>
                <p class="csa-muted" style="margin-top: var(--csa-sp-2);">
                    «Para el local» es lo que encarga la asociación además de lo que piden las socias: se suma
                    al pedido del productor, no se le cobra a nadie y no sale en el reparto.
                    A quien paga por recibo se le cobra en la remesa del grupo de consumo del mes; el resto, por transferencia o en metálico.{% if not round.hasNoMinimum and not round.confirmed %} {{ round.hasAutomaticMinimum ? 'Al alcanzarse el mínimo del productor, el pedido se confirma solo.' : 'La comisión decide si se supera el mínimo del productor.' }}{% endif %}
                </p>
            {% endif %}
            </div>
        </section>

        <section class="prt-card">
            <header class="prt-card__head">
                <h2 class="prt-card__title"><span class="accent"></span>Pedidos por socia</h2>
                <div class="csa-row" style="gap: var(--csa-sp-3); align-items: center; flex-wrap: wrap;">
                    {% if socias is not empty %}
                        <div class="cg-pay-summary">
                            <span class="prl-chip prl-chip--activo"><span class="dot"></span>{{ payment.paidCount }}/{{ payment.count }} pagados</span>
                            <span class="csa-muted">Cobrado <b>{{ payment.paidTotal|number_format(2, ',', '.') }} €</b> · Pendiente <b>{{ payment.pendingTotal|number_format(2, ',', '.') }} €</b></span>
                        </div>
                    {% endif %}
                    {% if can_edit and round.canManageOrders %}
                        <a href="{{ path('consumer_group_order_new', { id: round.id }) }}" class="prt-btn"><i class="fa fa-plus"></i> Apuntar socia</a>
                    {% endif %}
                </div>
            </header>
            <div class="prt-card__body">
            {% if socias is empty %}
                <p class="csa-muted">Todavía no se ha apuntado ninguna socia.</p>
            {% else %}
                <div class="prl">
                    <div class="prl-toolbar">
                        <div class="prl-search">
                            <input type="search" id="cg-socia-q" placeholder="Buscar socia…" autocomplete="off">
                        </div>
                        <div class="spacer"></div>
                        <div class="cg-pago-filter" role="group" aria-label="Filtrar por pago">
                            <button type="button" class="prl-btn prl-btn--sm is-active" data-pago="all">Todas</button>
                            <button type="button" class="prl-btn prl-btn--sm" data-pago="pending">Pendientes</button>
                            <button type="button" class="prl-btn prl-btn--sm" data-pago="paid">Pagadas</button>
                        </div>
                        {% if round.delivered %}
                            <div class="cg-pago-filter" role="group" aria-label="Filtrar por recogida">
                                <button type="button" class="prl-btn prl-btn--sm is-active" data-pickup="all">Todas</button>
                                <button type="button" class="prl-btn prl-btn--sm" data-pickup="pending">Sin recoger</button>
                                <button type="button" class="prl-btn prl-btn--sm" data-pickup="picked">Recogidas</button>
                            </div>
                        {% endif %}
                    </div>
                    <div class="prl-table-wrap">
                        <table class="prl-table" id="cg-socias">
                            <thead>
                                <tr>
                                    <th>Socia</th>
                                    <th>Pedido</th>
                                    <th class="tight" style="width: 80px;">Total</th>
                                    <th class="tight" style="width: 140px;">Pago</th>
                                    {% if round.delivered %}
                                        <th class="tight" style="width: 130px;">Recogida</th>
                                    {% endif %}
                                    <th class="tight" style="width: 44px;"><span class="sr-only">Acciones</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for order in socias %}
                                    {% set partner = order.partner %}
                                    <tr data-name="{{ (partner.name ~ ' ' ~ partner.surname)|lower }}" data-paid="{{ order.paid ? '1' : '0' }}" data-picked-up="{{ order.pickedUp ? '1' : '0' }}">
                                        <td class="prl-cell-person">
                                            <div class="prl-person">
                                                <span class="prl-person__avatar prl-person__avatar--sage" aria-hidden="true"><i class="fa fa-user"></i></span>
                                                <div class="prl-person__body">
                                                    {% if can_edit and round.canManageOrders %}
                                                        <a class="prl-person__name" href="{{ path('consumer_group_order_edit', { id: order.id }) }}">{{ partner.name }} {{ partner.surname }}</a>
                                                    {% else %}
                                                        <span class="prl-person__name">{{ partner.name }} {{ partner.surname }}</span>
                                                    {% endif %}
                                                    {% set contacto = partner.email ?: partner.celular %}
                                                    {% if contacto %}<span class="prl-person__meta">{{ contacto }}</span>{% endif %}
                                                </div>
                                            </div>
                                        </td>
                                        <td data-label="Pedido">
                                            <ul class="cg-order__lines">
                                                {% for oline in order.lines %}
                                                    {% if oline.quantity > 0 %}
                                                        <li>{{ oline.quantity|number_format(2, ',', '.') }} {{ oline.roundItem.unit }} · {{ oline.roundItem.name }}</li>
                                                    {% endif %}
                                                {% endfor %}
                                            </ul>
                                        </td>
                                        <td class="tight" data-label="Total"><b>{{ order.total|number_format(2, ',', '.') }} €</b></td>
                                        <td class="tight" data-label="Pago">
                                            <div class="cg-cell-pago">
                                                {# Pagado = de una forma concreta. «Va en el recibo» no es
                                                 # pagado todavía: se le cobra en la remesa del mes. Con el
                                                 # recibo ya enviado, el pago lo lleva el banco: no se toca
                                                 # a mano. #}
                                                {% set state = order.getPaymentState(is_granted('FEATURE_GRUPO_CONSUMO_REMESA')).value %}
                                                {% set pay_label = {
                                                    paid: order.paid ? 'Pagado · ' ~ order.paidVia.label ~ (order.transfer ? ' del ' ~ order.paidAt|date('d/m') : '') : '',
                                                    awaiting_bank: 'En el recibo, falta el abono',
                                                    in_receipt: 'Va en el recibo',
                                                    returned: 'Recibo devuelto',
                                                    pending: 'Pendiente',
                                                }[state] %}
                                                {% set pay_chip = { paid: 'activo', awaiting_bank: 'mod-4', in_receipt: 'mod-4', returned: 'baja', pending: 'pausado' }[state] %}
                                                {% set manual = can_pay and not order.inSentReceipt %}
                                                {% if order.paid and order.transfer %}
                                                    {# Pagado con un movimiento del banco: el chip lleva a verlo (y a deshacerlo
                                                     # si no es suyo), no vuelve el pedido a pendiente. #}
                                                    {% if can_see_bank %}
                                                        <a href="{{ path('accounting_cg_transfers') }}#transferencia-{{ order.transfer.id }}" class="prl-chip prl-chip--{{ pay_chip }}" title="Ver la transferencia en Contabilidad"><span class="dot"></span>{{ pay_label }}</a>
                                                    {% else %}
                                                        <span class="prl-chip prl-chip--{{ pay_chip }}"><span class="dot"></span>{{ pay_label }}</span>
                                                    {% endif %}
                                                {% elseif manual and order.paid %}
                                                    <form method="post" action="{{ path('consumer_group_order_payment', { id: order.id }) }}" class="cg-order__pay-form">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('consumer_group_order_payment_' ~ order.id) }}">
                                                        <input type="hidden" name="via" value="">
                                                        <button type="submit" class="prl-chip prl-chip--{{ pay_chip }} cg-chip-btn" title="Click para volver a dejarlo pendiente">
                                                            <span class="dot"></span>{{ pay_label }}
                                                        </button>
                                                    </form>
                                                {% else %}
                                                    <span class="prl-chip prl-chip--{{ pay_chip }}"{% if state == 'returned' %} title="Se cierra desde la devolución del recibo, en Contabilidad"{% endif %}><span class="dot"></span>{{ pay_label }}</span>
                                                {% endif %}
                                                {% if manual and not order.paid %}
                                                    <form method="post" action="{{ path('consumer_group_order_payment', { id: order.id }) }}" class="cg-order__pay-form cg-order__pay-via">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('consumer_group_order_payment_' ~ order.id) }}">
                                                        <span class="cg-order__ref-label">Pagado por:</span>
                                                        <button type="submit" name="via" value="transfer" class="prl-btn prl-btn--sm">Transferencia</button>
                                                        <button type="submit" name="via" value="cash" class="prl-btn prl-btn--sm">Metálico</button>
                                                    </form>
                                                {% endif %}
                                                {% if state == 'pending' %}
                                                    {# El mismo concepto que se le pide a la socia, para poder
                                                     # buscarlo en el extracto: en el banco aparece el titular de
                                                     # la cuenta, que no siempre es quien figura aquí. Rotulado a
                                                     # propósito: sin "Concepto:" delante, en la vista apilada de
                                                     # móvil parece un segundo nombre suelto, no una referencia. #}
                                                    <div class="cg-order__ref"><span class="cg-order__ref-label">Concepto:</span> {{ order.paymentReference }}</div>
                                                {% endif %}
                                            </div>
                                        </td>
                                        {% if round.delivered %}
                                            <td class="tight" data-label="Recogida">
                                                <div class="cg-cell-pago">
                                                    {% if can_edit %}
                                                        <form method="post" action="{{ path('consumer_group_order_toggle_picked_up', { id: order.id }) }}" class="cg-order__pay-form">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('consumer_group_toggle_picked_up_' ~ order.id) }}">
                                                            <button type="submit" class="prl-chip prl-chip--{{ order.pickedUp ? 'activo' : 'mod-3' }} cg-chip-btn" title="Click para marcar {{ order.pickedUp ? 'sin recoger' : 'recogido' }}">
                                                                <span class="dot"></span>{{ order.pickedUp ? 'Recogido' : 'Sin recoger' }}
                                                            </button>
                                                        </form>
                                                    {% else %}
                                                        <span class="prl-chip prl-chip--{{ order.pickedUp ? 'activo' : 'mod-3' }}"><span class="dot"></span>{{ order.pickedUp ? 'Recogido' : 'Sin recoger' }}</span>
                                                    {% endif %}
                                                </div>
                                            </td>
                                        {% endif %}
                                        <td class="tight" data-label="Acciones" style="text-align: right;">
                                            {% if can_socixs or can_reparto %}
                                                <button type="button" class="cg-kebab" aria-label="Acciones de la socia">
                                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
                                                </button>
                                                <div class="cg-kebab-menu" hidden>
                                                    {% if can_socixs %}<a href="{{ path('partner_show', { id: partner.id }) }}"><i class="fa fa-user"></i> Ver ficha del socio</a>{% endif %}
                                                    {% if can_socixs or can_reparto %}<a href="{{ path('partner_delivery_calendar', { id: partner.id }) }}"><i class="fa fa-calendar"></i> Calendario de reparto</a>{% endif %}
                                                </div>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                <tr id="cg-socias-empty" hidden><td colspan="5" class="csa-muted" style="text-align:center; padding: var(--csa-sp-4);">Ninguna socia coincide con el filtro.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <script>
                (function () {
                    var table = document.getElementById('cg-socias');
                    if (!table) { return; }
                    var q = document.getElementById('cg-socia-q');
                    var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr[data-name]'));
                    var emptyRow = document.getElementById('cg-socias-empty');
                    var pago = 'all';
                    var pickup = 'all';
                    function apply() {
                        var term = (q.value || '').trim().toLowerCase();
                        var visible = 0;
                        rows.forEach(function (r) {
                            var okName = !term || r.getAttribute('data-name').indexOf(term) !== -1;
                            var paid = r.getAttribute('data-paid') === '1';
                            var okPago = pago === 'all' || (pago === 'paid' ? paid : !paid);
                            var pickedUp = r.getAttribute('data-picked-up') === '1';
                            var okPickup = pickup === 'all' || (pickup === 'picked' ? pickedUp : !pickedUp);
                            var show = okName && okPago && okPickup;
                            r.hidden = !show;
                            if (show) { visible++; }
                        });
                        if (emptyRow) { emptyRow.hidden = visible !== 0; }
                    }
                    q.addEventListener('input', apply);
                    Array.prototype.forEach.call(document.querySelectorAll('.cg-pago-filter [data-pago]'), function (btn) {
                        btn.addEventListener('click', function () {
                            document.querySelectorAll('.cg-pago-filter [data-pago]').forEach(function (b) { b.classList.remove('is-active'); });
                            btn.classList.add('is-active');
                            pago = btn.getAttribute('data-pago');
                            apply();
                        });
                    });
                    Array.prototype.forEach.call(document.querySelectorAll('.cg-pago-filter [data-pickup]'), function (btn) {
                        btn.addEventListener('click', function () {
                            document.querySelectorAll('.cg-pago-filter [data-pickup]').forEach(function (b) { b.classList.remove('is-active'); });
                            btn.classList.add('is-active');
                            pickup = btn.getAttribute('data-pickup');
                            apply();
                        });
                    });
                })();
                </script>

                <script>
                (function () {
                    var openMenu = null;
                    function closeAll() { if (openMenu) { openMenu.hidden = true; openMenu = null; } }
                    Array.prototype.forEach.call(document.querySelectorAll('.cg-kebab'), function (btn) {
                        btn.addEventListener('click', function (e) {
                            e.stopPropagation();
                            var menu = btn.nextElementSibling;
                            if (openMenu === menu) { closeAll(); return; }
                            closeAll();
                            menu.hidden = false;
                            var r = btn.getBoundingClientRect();
                            menu.style.top = (r.bottom + 4) + 'px';
                            menu.style.left = Math.max(8, r.right - menu.offsetWidth) + 'px';
                            openMenu = menu;
                        });
                    });
                    document.addEventListener('click', closeAll);
                    window.addEventListener('scroll', closeAll, true);
                    window.addEventListener('resize', closeAll);
                })();
                </script>
            {% endif %}
            </div>
        </section>

        {# Plegada por defecto: es el histórico de trazabilidad, no algo que se
         # consulte al entrar a la ficha, y una lista que crece con cada apunte
         # y cada cambio de estado saturaba la pantalla por debajo de lo que sí
         # se mira siempre (socias, agregado, acciones). #}
        {% include '_components/cg_activity.html.twig' with { activity: activity } %}

        {% if can_edit and round.orders is empty %}
            <div class="csa-row" style="justify-content: flex-end;">
                <form method="post" action="{{ path('consumer_group_delete', { id: round.id }) }}"
                      onsubmit="return confirm('¿Borrar este pedido? No tiene pedidos, así que no se pierde nada.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('consumer_group_delete_' ~ round.id) }}">
                    <button type="submit" class="csa-btn csa-btn--ghost">Borrar pedido</button>
                </form>
            </div>
        {% endif %}

    </div>

{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/partner_card_styles.html.twig' %}
    {% include '_components/cg_facts_styles.html.twig' %}
    {% include '_components/cg_activity_styles.html.twig' %}
    {% include 'partner/_listing_styles.html.twig' %}
    <style>
        .cg-notes { margin-top: var(--csa-sp-3); color: var(--prt-ink-soft, #5a564a); }
        .cg-notes p { margin: 0 0 var(--csa-sp-2); }
        /* Separar y dar contraste a la barra de acciones respecto a la cabecera. */
        .prt-actionbar { margin-top: var(--csa-sp-5); padding-top: var(--csa-sp-4); border-top: 1px solid var(--prt-line, #ebe7dd); }
        /* Botones de acción con color de acento (verde salvia) para que contrasten
         * sobre el fondo claro; el principal va en verde sólido, cancelar en terracota. */
        .prt-actionbar .prt-btn:not(.prt-btn--primary):not(.prt-btn--danger) {
            border-color: var(--prt-sage, #5b7a4c); color: var(--prt-sage-d, #2f4426);
        }
        .prt-actionbar .prt-btn:not(.prt-btn--primary):not(.prt-btn--danger) .fa { color: var(--prt-sage, #5b7a4c); }
        .prt-actionbar .prt-btn:not(.prt-btn--primary):not(.prt-btn--danger):hover {
            background: var(--prt-sage-l, #eaf0e2); border-color: var(--prt-sage-d, #2f4426); color: var(--prt-sage-d, #2f4426);
        }
        .prt-actionbar .prt-btn--danger { border-color: var(--prt-terra, #b45d3a); color: var(--prt-terra-d, #7d3a1f); }
        .prt-actionbar .prt-btn--danger .fa { color: var(--prt-terra, #b45d3a); }
        .prt-actionbar .prt-btn--danger:hover { background: var(--prt-terra-l, #fae6dc); border-color: var(--prt-terra-d, #7d3a1f); }
        .cg-order__lines { margin: 0; padding-left: var(--csa-sp-4); font-size: .9rem; }
        .cg-cell-pago { display: flex; flex-direction: column; align-items: flex-start; gap: var(--csa-sp-1); max-width: 100%; }
        {# Sin wrap, "Concepto: GC15 FRANCISCO LOPEZ LOSADA" no cabía en la
           columna y se salía por la derecha, empujando la página entera a
           scroll horizontal — el mismo problema que ya se arregló en
           "Productos del pedido", aquí con el nombre del concepto en vez de
           la unidad. #}
        .cg-order__ref { font-size: .8rem; color: var(--csa-muted); white-space: normal; overflow-wrap: anywhere; }
        .cg-order__ref-label { font-weight: 600; }
        .cg-order__pay-via { display: flex; flex-wrap: wrap; align-items: center; gap: var(--csa-sp-1); font-size: .8rem; color: var(--csa-muted); }
        .cg-order__pay-form { margin: 0; max-width: 100%; }
        {# El chip ES el botón: un click cambia el estado, sin un botón de
           texto aparte al lado —eso era lo que hacía desbordar la columna—. #}
        .cg-chip-btn { border: none; cursor: pointer; font: inherit; }
        .cg-chip-btn:hover { filter: brightness(0.96); }
        .cg-pay-summary { display: flex; align-items: center; gap: var(--csa-sp-3); flex-wrap: wrap; }
        .prl-table thead th.cg-agg__group { white-space: normal; text-align: center; border-bottom: 1px solid var(--prt-line, #ebe7dd); }
        .prl-table thead th[rowspan] { vertical-align: bottom; }
        .prl-table .cg-agg__num { text-align: center; }
        {# Hueco entre el bloque de cantidades y el de euros: la columna no pinta las
           líneas, así que se cortan ahí. En tarjetas (móvil) no pinta nada. #}
        .prl-table .cg-agg__gap { padding: 0; }
        .prl-table thead th.cg-agg__gap, .prl-table tbody td.cg-agg__gap { border-bottom-color: transparent; }
        .prl-table tbody tr:hover td.cg-agg__gap { background: transparent; }
        @media (max-width: 768px) { .prl-table .cg-agg__gap { display: none; } }
        {# Cabe una cantidad de tres cifras y media, centrada bajo su cabecera. Sin las
           flechas del navegador el número queda en el centro real de la celda y se
           alinea con las cifras de arriba y de abajo; .csa-input es display:block, así
           que el centrado lo da el margen automático. #}
        .cg-local-qty { display: block; width: 5.5rem; margin-inline: auto; text-align: center; -moz-appearance: textfield; appearance: textfield; }
        .cg-local-qty::-webkit-inner-spin-button, .cg-local-qty::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
        .cg-pago-filter { display: inline-flex; gap: var(--csa-sp-2); }
        .cg-pago-filter .prl-btn.is-active { background: var(--prt-ink, #1d1c17); color: #fff; border-color: var(--prt-ink, #1d1c17); }
        .cg-kebab { background: none; border: 0; cursor: pointer; color: var(--prt-ink-faint, #8d8773); padding: 4px 6px; border-radius: 6px; line-height: 0; }
        .cg-kebab:hover { background: var(--prt-bg, #fbfaf6); color: var(--prt-ink, #1d1c17); }
        .cg-kebab-menu { position: fixed; z-index: 100; min-width: 210px; background: #fff; border: 1px solid var(--prt-line-2, #d8d2c2); border-radius: 8px; box-shadow: 0 8px 26px rgba(0,0,0,0.16); padding: 6px; }
        .cg-kebab-menu a { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 6px; color: var(--prt-ink, #1d1c17); text-decoration: none; font-size: 13px; }
        .cg-kebab-menu a:hover { background: var(--prt-sage-l, #eaf0e2); }
    </style>
{% endblock %}
