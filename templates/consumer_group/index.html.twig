{# ============================================================
 # Listado de pedidos del grupo de consumo — estilo listado prl-*.
 #
 # El controller pasa:
 #   - rounds        ConsumerGroupRound[] (más recientes por entrega arriba)
 #   - order_counts  array round_id => nº de pedidos
 #   - statuses      array status(int) => etiqueta
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% set status_chip = {
    0: { label: 'Abierto',    cls: 'activo'   },
    1: { label: 'Cerrado',    cls: 'pausado'  },
    3: { label: 'Cancelado',  cls: 'baja'     },
    4: { label: 'Entregado',  cls: 'pausado'  }
} %}

{% block title %}Grupo de consumo{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Grupo de consumo</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
{% endblock %}

{% block more_js %}
    {{ parent() }}
    {% include '_components/listing_filters_js.html.twig' %}
{% endblock %}

{% block csa_main %}

<div class="prl">

    {{ csa.page_header(
        'Grupo de consumo',
        'Pedidos',
        'Pedidos colectivos de productos de terceros que se reparten con la cesta. Abre un pedido, las socias se apuntan y, al superar el mínimo del productor, se confirma.'
    ) }}

    {# ============ STAT STRIP (siempre sobre el total, no lo filtrado) ============ #}
    <div class="prl-stats">
        <div class="prl-stat prl-stat--active">
            <div class="v">{{ all_rounds|filter(r => r.status == 0)|length }}</div>
            <div class="l">abiertos</div>
        </div>
        <div class="prl-stat prl-stat--paused">
            <div class="v">{{ all_rounds|filter(r => r.status == 1)|length }}</div>
            <div class="l">cerrados</div>
        </div>
        <div class="prl-stat prl-stat--active">
            <div class="v">{{ all_rounds|filter(r => r.confirmed)|length }}</div>
            <div class="l">confirmados</div>
        </div>
        <div class="prl-stat prl-stat--leave">
            <div class="v">{{ all_rounds|filter(r => r.status == 3)|length }}</div>
            <div class="l">cancelados</div>
        </div>
    </div>

    {# ============ FILTROS ============ #}
    <form method="get" action="{{ path('consumer_group_index') }}" id="prl-filter-form">
        <div class="prl-toolbar">
            {% set selected_producer = filters.producer ? producers|filter(p => p.id == filters.producer)|first : null %}
            <div class="prl-filt-wrap">
                <button type="button" class="prl-filt {{ filters.producer ? 'has' : '' }}" data-pop-trigger="pop-productor">
                    {{ selected_producer ? selected_producer.name : 'Productor' }}
                    <svg class="chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="prl-pop" id="pop-productor" hidden>
                    <label><input type="radio" name="producer" value="" {{ filters.producer is null ? 'checked' : '' }}> Todos</label>
                    {% for p in producers %}
                        <label><input type="radio" name="producer" value="{{ p.id }}" {{ filters.producer == p.id ? 'checked' : '' }}> {{ p.name }}</label>
                    {% endfor %}
                </div>
            </div>

            <div class="prl-filt-wrap">
                <button type="button" class="prl-filt {{ filters.status is not null ? 'has' : '' }}" data-pop-trigger="pop-estado">
                    {{ filters.status is not null ? statuses[filters.status]|default('Estado') : 'Estado' }}
                    <svg class="chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="prl-pop" id="pop-estado">
                    <label><input type="radio" name="status" value="" {{ filters.status is null ? 'checked' : '' }}> Todos</label>
                    {% for value, label in statuses %}
                        <label><input type="radio" name="status" value="{{ value }}" {{ filters.status == value ? 'checked' : '' }}> {{ label }}</label>
                    {% endfor %}
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 6px;">
                <input type="date" name="from" value="{{ filters.from }}" aria-label="Entrega desde" class="prl-filt" style="cursor: text;">
                <span class="csa-muted">–</span>
                <input type="date" name="to" value="{{ filters.to }}" aria-label="Entrega hasta" class="prl-filt" style="cursor: text;">
                <button type="submit" class="prl-btn prl-btn--sm">Filtrar</button>
            </div>

            {% if filters.producer or filters.status is not null or filters.from or filters.to %}
                <a class="prl-filt prl-filt--clear" href="{{ path('consumer_group_index') }}">
                    <i class="fa fa-times" aria-hidden="true"></i> Quitar filtros
                </a>
            {% endif %}

            <div class="spacer"></div>
            <div class="counters">
                <b>{{ rounds|length }}</b> pedido{{ rounds|length == 1 ? '' : 's' }}
            </div>
            {% if is_granted('ROLE_GESTION_GRUPO_CONSUMO_EDIT') %}
                <a href="{{ path('consumer_group_new') }}" class="prl-btn prl-btn--primary">
                    <i class="fa fa-plus"></i> Nuevo pedido
                </a>
            {% endif %}
        </div>
    </form>

    {# ============ TABLA ============ #}
    <div class="prl-table-wrap">
        {% if rounds is empty %}
            <div class="prl-empty">
                Todavía no hay ningun pedido. Crea la primera con el botón de arriba.
            </div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th class="tight">Estado</th>
                        <th class="tight">Entrega</th>
                        <th class="tight">Pedidos</th>
                        <th class="actions"><span class="sr-only">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for round in rounds %}
                        {% set sc = status_chip[round.status]|default({ label: round.statusLabel, cls: 'baja' }) %}
                        <tr>
                            <td>
                                <div class="prl-person">
                                    <span class="prl-person__avatar prl-person__avatar--sage" aria-hidden="true">
                                        <i class="fa fa-shopping-basket"></i>
                                    </span>
                                    <div class="prl-person__body">
                                        <a class="prl-person__name" href="{{ path('consumer_group_show', { id: round.id }) }}">
                                            {{ round.title }}
                                        </a>
                                        <span class="prl-person__meta">{{ round.producer ? round.producer.name : '—' }}</span>
                                    </div>
                                </div>
                            </td>
                            <td class="tight">
                                <span class="prl-chip prl-chip--{{ sc.cls }}"><span class="dot"></span>{{ sc.label }}</span>
                                {% if round.confirmed %}<span class="prl-chip prl-chip--activo"><span class="dot"></span>Confirmado</span>{% endif %}
                            </td>
                            <td class="tight">{{ round.deliveryDate ? round.deliveryDate|date('d/m/Y') : '—' }}</td>
                            <td class="tight">{{ order_counts[round.id] ?? 0 }}</td>
                            <td class="actions">
                                <a href="{{ path('consumer_group_show', { id: round.id }) }}" title="Ver" aria-label="Ver"><i class="fa fa-eye"></i></a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

</div>

{% endblock %}
