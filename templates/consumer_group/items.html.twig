{# ============================================================
 # Productos del pedido: elegir qué productos del catálogo del
 # productor entran y su precio de pedido.
 #   - round          ConsumerGroupRound
 #   - catalog        ConsumerGroupProduct[] (activos + los ya en el pedido)
 #   - current_price        map product_id => precio de pedido actual
 #   - included             map product_id => true (si está en el pedido)
 #   - removals_with_orders opcional: [{product, item, lines}] — productos que
 #                          se están quitando y que alguna socia ya tenía
 #                          pedidos de verdad. Si viene, hace falta confirmar
 #                          antes de que el controlador aplique el cambio.
 #   - locked_product_ids   map product_id => true — productos con pedidos
 #                          reales (cantidad > 0): su precio no se puede tocar.
 #   - managed              true si el productor lo gestiona la comisión: el precio
 #                          final = precio del productor + incremento de gestión.
 #   - pricing_form         estado del desglose (incremento del pedido y, por
 #                          producto, precio del productor, incremento propio).
 #   - item_by_product      map product_id => ConsumerGroupRoundItem ya en el pedido.
 #
 # Mismo lenguaje visual que consumer_group/show.html.twig (hero .prt +
 # .prt-card): esto es una pestaña de esa misma ficha, no un formulario suelto.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}

{% block title %}Productos del pedido · Grupo de consumo{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('consumer_group_index') }}">Grupo de consumo</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('consumer_group_show', { id: round.id }) }}">{{ round.title }}</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Productos</span>
{% endblock %}

{% block csa_main %}

    <div class="prt">
        <header class="prt-hero">
            <div>
                <h1 class="prt-hero__title">{{ round.title }}</h1>
                <div class="prt-hero__meta">
                    <span class="prt-chip prt-chip--mod-1"><span class="dot"></span>Editando productos</span>
                    {% if round.producers is not empty %}<span class="sep">·</span><span>{{ round.producerNames }}</span>{% endif %}
                </div>
            </div>
            <div class="prt-hero__actions">
                <a href="{{ path('consumer_group_show', { id: round.id }) }}" class="prt-btn"><i class="fa fa-arrow-left"></i> Volver al pedido</a>
            </div>
        </header>

        {% if catalog is empty %}
            <div class="prt-card">
                <div class="prt-card__body">
                    <p class="csa-muted" style="margin: 0;">
                        {{ round.mixed ? 'Los productores no tienen' : 'El productor no tiene' }} productos activos en su catálogo. Añádelos primero:
                        {% for producer in round.producers %}<a href="{{ path('consumer_group_producer_show', { id: producer.id }) }}">{{ producer.name }}</a>{{ loop.last ? '.' : ', ' }}{% endfor %}
                    </p>
                </div>
            </div>
        {% else %}
            {% if removals_with_orders is defined and removals_with_orders is not empty %}
                <div class="csa-alert csa-alert--warning cg-removal-warning">
                    <p><strong>Ojo: estás quitando productos con pedidos ya hechos.</strong> Si confirmas, esos pedidos se pierden y se avisará a las socias afectadas.</p>
                    <ul class="cg-removal-warning__list">
                        {% for removal in removals_with_orders %}
                            <li>
                                <strong>{{ removal.product.name }}</strong>
                                <ul>
                                    {% for line in removal.lines %}
                                        <li>{{ line.order.partner.name }} {{ line.order.partner.surname }} — {{ line.quantity }} {{ removal.product.unit }}</li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post" action="{{ path('consumer_group_items', { id: round.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('consumer_group_items_' ~ round.id) }}">

                {% if managed and not breakdown_only %}
                    <div class="prt-card">
                        <div class="prt-card__head">
                            <h2 class="prt-card__title"><span class="accent"></span>Incremento de gestión del pedido</h2>
                        </div>
                        <div class="prt-card__body">
                            <p class="csa-muted" style="margin-top: 0;">
                                Lo que suma la asociación al precio del productor. Lo heredan todos los productos que no tengan uno propio. Las socias solo ven el precio final.
                            </p>
                            <div class="cg-markup">
                                <select name="round_markup_type" id="round-markup-type" class="csa-input">
                                    <option value="">Sin incremento</option>
                                    <option value="percent" {{ pricing_form.round_type.value|default('') == 'percent' ? 'selected' : '' }}>% sobre el precio del productor</option>
                                    <option value="amount" {{ pricing_form.round_type.value|default('') == 'amount' ? 'selected' : '' }}>€ por unidad</option>
                                </select>
                                <input type="number" min="0" step="0.01" inputmode="decimal" name="round_markup_value" id="round-markup-value"
                                       value="{{ pricing_form.round_value|default('') }}" class="csa-input" placeholder="0,00">
                            </div>
                            <p class="csa-muted" style="margin-bottom: 0;">
                                Al cambiarlo se recalculan los productos que lo heredan. Los que tienen incremento propio quedan <strong>pendientes de revisar</strong>, y el pedido no se puede abrir hasta que los valides.
                            </p>
                        </div>
                    </div>
                    <div style="height: var(--csa-sp-4);"></div>
                {% endif %}

                <div class="prt-card">
                    <div class="prt-card__head">
                        <h2 class="prt-card__title"><span class="accent"></span>Productos y precios</h2>
                        <span class="prt-card__head-meta">{{ catalog|length }} en el catálogo</span>
                    </div>
                    <div class="prt-card__body">
                        {% if breakdown_only|default(false) %}
                            <div class="csa-alert csa-alert--warning">
                                Este pedido ya no admite cambios de productos ni de precio final. Solo puedes poner el precio del productor: el incremento se calcula por diferencia y el precio final no cambia.
                            </div>
                        {% endif %}
                        <p class="csa-muted" style="margin-top: 0;">
                            Marca los productos que entran en este pedido y ajusta su precio. El precio es de este pedido: se ha rellenado con el de la última vez que lo llevó este productor.
                        </p>
                        <div class="prl prl-table-wrap">
                            <table class="prl-table">
                                <thead>
                                    <tr>
                                        <th style="width: 40px;"><span class="sr-only">Incluir</span></th>
                                        <th>Producto</th>
                                        {% if managed %}
                                            <th class="tight">Precio del productor</th>
                                            <th class="tight">Incremento</th>
                                            <th class="tight">Precio final</th>
                                        {% else %}
                                            <th class="tight" style="width: 190px;">Precio</th>
                                        {% endif %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for product in catalog %}
                                        {% set is_locked = locked_product_ids[product.id]|default(false) %}
                                        <tr class="{{ is_locked ? 'cg-row-locked' : '' }}">
                                            <td class="tight">
                                                <input type="checkbox" name="include[{{ product.id }}]" value="1" {{ included[product.id]|default(false) ? 'checked' : '' }} {{ breakdown_only|default(false) ? 'disabled' : '' }}>
                                            </td>
                                            <td>
                                                {{ product.name }} <span class="csa-muted">/ {{ product.unit }}</span>
                                                {% if round.mixed %}<div class="csa-muted" style="font-size: .8em;">{{ product.producer }}</div>{% endif %}
                                                {% if product.description %}<div class="csa-muted" style="font-size: .85em;">{{ product.description|striptags|u.truncate(80, '…', false) }}</div>{% endif %}
                                            </td>
                                            {% if managed %}
                                                {% set item = item_by_product[product.id]|default(null) %}
                                                {# Precio final fijo: con socias apuntadas, o sin desglosar en un pedido ya abierto. #}
                                                {% set unbroken = item and (is_locked or (item.producerPrice is null and not round.draft)) %}
                                                {% set pending = item and item.markupPendingReview and not is_locked %}
                                                {% if unbroken %}
                                                    {% set bd_producer = pricing_form.producer_price[product.id]|default(item.producerPrice) %}
                                                    <td>
                                                        <div class="cg-cell-price">
                                                            <input type="number" min="0" step="0.01" inputmode="decimal" class="csa-input cg-bd-producer"
                                                                   name="producer_price[{{ product.id }}]" value="{{ bd_producer }}"
                                                                   data-final="{{ current_price[product.id]|default('0') }}"
                                                                   placeholder="sin desglosar" title="El precio final no cambia: el incremento se calcula por diferencia.">
                                                            <span class="csa-muted">€/{{ product.unit }}</span>
                                                        </div>
                                                    </td>
                                                    <td class="csa-muted cg-bd-markup">
                                                        {{ bd_producer is not null and bd_producer != '' ? ((current_price[product.id] - bd_producer)|number_format(2, ',', '.') ~ ' €') : 'Sin desglosar' }}
                                                    </td>
                                                    <td class="tight"><strong>{{ current_price[product.id]|default('0')|number_format(2, ',', '.') }} €</strong>
                                                        <i class="fa fa-lock csa-muted" title="El precio final de este producto no se puede cambiar: solo se desglosa."></i>
                                                    </td>
                                                {% else %}
                                                    <td>
                                                        <div class="cg-cell-price">
                                                            <input type="number" min="0" step="0.01" inputmode="decimal" class="csa-input cg-producer-price"
                                                                   name="producer_price[{{ product.id }}]"
                                                                   value="{{ pricing_form.producer_price[product.id]|default('') }}" placeholder="0,00"
                                                                   {{ is_locked ? 'disabled' : '' }}>
                                                            <span class="csa-muted">€/{{ product.unit }}</span>
                                                        </div>
                                                    </td>
                                                    <td class="{{ pending ? 'cg-pending' : '' }}">
                                                        {% set own_type = pricing_form.markup_type[product.id].value|default('') %}
                                                        <div class="cg-cell-price">
                                                            <select name="markup_type[{{ product.id }}]" class="csa-input cg-markup-type" {{ is_locked ? 'disabled' : '' }}>
                                                                <option value="" {{ own_type == '' ? 'selected' : '' }}>Como el pedido</option>
                                                                <option value="percent" {{ own_type == 'percent' ? 'selected' : '' }}>Otro, en %</option>
                                                                <option value="amount" {{ own_type == 'amount' ? 'selected' : '' }}>Otro, en €</option>
                                                            </select>
                                                            <input type="number" min="0" step="0.01" inputmode="decimal" class="csa-input cg-markup-value"
                                                                   name="markup_value[{{ product.id }}]"
                                                                   value="{{ pricing_form.markup_value[product.id]|default('') }}" placeholder="0,00"
                                                                   {{ own_type == '' ? 'hidden' : '' }} {{ is_locked ? 'disabled' : '' }}>
                                                        </div>
                                                        {% if pending %}
                                                            <label class="cg-review">
                                                                <input type="checkbox" name="reviewed[{{ product.id }}]" value="1" {{ pricing_form.reviewed[product.id] is defined ? 'checked' : '' }}>
                                                                <span>Revisado: el incremento propio sigue siendo correcto</span>
                                                            </label>
                                                        {% endif %}
                                                    </td>
                                                    <td class="tight"><strong class="cg-final-price">{{ current_price[product.id]|default('0')|number_format(2, ',', '.') }}</strong> €
                                                        {% if is_locked %}<i class="fa fa-lock csa-muted" title="Ya hay pedidos de socias con este precio: no se puede cambiar."></i>{% endif %}
                                                    </td>
                                                {% endif %}
                                            {% else %}
                                            <td class="tight cg-cell-price">
                                                <input type="number" min="0" step="0.01" inputmode="decimal"
                                                       name="price[{{ product.id }}]"
                                                       value="{{ current_price[product.id]|default('0') }}"
                                                       class="csa-input" placeholder="0,00"
                                                       {{ is_locked ? 'disabled title="Ya hay pedidos de socias con este precio: no se puede cambiar."' : '' }}>
                                                <span class="csa-muted">€/{{ product.unit }}</span>
                                                {% if is_locked %}
                                                    <i class="fa fa-lock csa-muted" title="Ya hay pedidos de socias con este precio: no se puede cambiar."></i>
                                                {% endif %}
                                            </td>
                                            {% endif %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {% if removals_with_orders is defined and removals_with_orders is not empty %}
                            <label class="cg-removal-confirm">
                                <input type="checkbox" name="confirm_removal" value="1" required>
                                <span>Confirmo que quiero quitar estos productos aunque ya tengan pedidos, y avisar a las socias afectadas.</span>
                            </label>
                        {% endif %}
                    </div>
                    <div class="prt-card__foot" style="display: flex; justify-content: flex-end; gap: 8px;">
                        <a href="{{ path('consumer_group_show', { id: round.id }) }}" class="prt-btn">Cancelar</a>
                        <button type="submit" class="prt-btn prt-btn--primary"><i class="fa fa-check"></i> Guardar productos</button>
                    </div>
                </div>
            </form>
        {% endif %}
    </div>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/partner_card_styles.html.twig' %}
    {% include 'partner/_listing_styles.html.twig' %}
    <style>
        .cg-removal-warning { margin-bottom: var(--csa-sp-4); }
        .cg-removal-warning__list { margin: var(--csa-sp-2) 0 0; padding-left: var(--csa-sp-4); }
        .cg-removal-warning__list ul { margin: var(--csa-sp-1) 0 var(--csa-sp-2); }
        .cg-removal-confirm { display: flex; align-items: flex-start; gap: var(--csa-sp-2); margin-top: var(--csa-sp-4); font-weight: 400; }
        .cg-removal-confirm input { width: auto; height: auto; margin-top: 3px; }
        .cg-markup { display: flex; flex-wrap: wrap; gap: var(--csa-sp-2); margin-bottom: var(--csa-sp-2); }
        .cg-markup .csa-input { height: 34px; width: auto; min-width: 6.5rem; }
        .cg-pending { background: var(--csa-warning-bg, #fff4d6); }
        .cg-review { display: flex; align-items: flex-start; gap: var(--csa-sp-2); font-weight: 400; font-size: .85em; flex-basis: 100%; }
        .cg-review input { width: auto; height: auto; margin-top: 3px; }
        .cg-cell-price select.csa-input { width: auto; }
        .cg-row-locked { background: var(--prl-sage-l, #eaf0e2); }
        {# Sin nowrap: "€/garrafa de 5 L" es más ancho que la columna (190px,
           table-layout: fixed) y desbordaba la fila hacia la derecha,
           empujando toda la página a scroll horizontal. Envuelve en vez de
           salirse — para eso está flex-wrap. #}
        .cg-cell-price { display: flex; align-items: center; flex-wrap: wrap; gap: 2px var(--csa-sp-2); }
        .cg-cell-price .csa-input { width: 6.5rem; height: 34px; }
        {# Las flechas nativas de type=number solo sirven para sumar/restar de
           céntimo en céntimo: para un precio se escribe, no se "sube". #}
        .cg-cell-price .csa-input::-webkit-outer-spin-button,
        .cg-cell-price .csa-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        .cg-cell-price .csa-input[type=number] { -moz-appearance: textfield; }
        .cg-cell-price .fa-lock { font-size: 12px; }
    </style>
{% endblock %}

{% block more_js %}
    {{ parent() }}
    {% if managed %}
    <script>
        {# Precio final en vivo. Misma aritmética que App\Service\ConsumerGroup\Markup
           (céntimos enteros, porcentaje redondeado mitad hacia arriba); el servidor
           recalcula al guardar, esto es solo para ver el resultado antes. #}
        (function () {
            var cents = function (v) { var n = parseFloat(String(v).replace(',', '.')); return isNaN(n) ? 0 : Math.round(n * 100); };
            var roundType = document.getElementById('round-markup-type');
            var roundValue = document.getElementById('round-markup-value');
            var markupCents = function (type, value, producer) {
                if (type === 'amount') { return cents(value); }
                if (type === 'percent') { return Math.floor((producer * cents(value) * 2 + 10000) / 20000); }
                return 0;
            };
            var money = function (c) { return (c / 100).toFixed(2).replace('.', ','); };
            var refreshBreakdown = function () {
                document.querySelectorAll('.cg-bd-producer').forEach(function (input) {
                    var out = input.closest('tr').querySelector('.cg-bd-markup');
                    var producer = cents(input.value);
                    var final = cents(input.dataset.final);
                    if (input.value === '' || producer <= 0) { out.textContent = 'Sin desglosar'; }
                    else if (producer > final) { out.textContent = 'No puede superar el precio final'; }
                    else { out.textContent = money(final - producer) + ' €'; }
                });
            };
            var refresh = function () {
                refreshBreakdown();
                document.querySelectorAll('.cg-markup-type').forEach(function (select) {
                    var value = select.closest('td').querySelector('.cg-markup-value');
                    value.hidden = select.value === '';
                    if (select.value === '') { value.value = ''; }
                });
                document.querySelectorAll('tr').forEach(function (row) {
                    var price = row.querySelector('.cg-producer-price');
                    var out = row.querySelector('.cg-final-price');
                    if (!price || !out) { return; }
                    var own = row.querySelector('.cg-markup-type').value;
                    var type = own || roundType.value;
                    var value = own ? row.querySelector('.cg-markup-value').value : roundValue.value;
                    var producer = cents(price.value);
                    var total = producer + markupCents(type, value, producer);
                    out.textContent = (total / 100).toFixed(2).replace('.', ',');
                });
            };
            document.addEventListener('input', refresh);
            document.addEventListener('change', refresh);
            refresh();
        })();
    </script>
    {% endif %}
{% endblock %}
