{% extends '_layouts/csa_panel.html.twig' %}

{% block title %}Mi panel{% endblock %}

{% block csa_crumbs %}
    <span class="csa-topbar__crumb-active">Inicio</span>
{% endblock %}

{# ============================================================
 # La home del socix. Reutiliza el aspecto de la ficha admin (componentes
 # .prt-*), pero NO su contenido ni su orden: la ficha admin contesta "qué datos
 # tenemos de esta persona" y esta pantalla contesta "qué me toca ahora".
 #
 # El orden es el diseño:
 #   1. Cuándo y dónde es mi próxima cesta — es a lo que se entra.
 #   2. Qué llevo en ella.
 #   3. En qué puedo echar una mano.
 #   4. Mi familia.
 #   5. Mis datos, plegados: DNI, dirección y fecha de alta son papeleo que se
 #      mira una vez al año, y ocupaban media pantalla con el mismo peso que la
 #      cesta.
 #
 # El nodo y el grupo salían CUATRO veces en la misma pantalla (banner ×2 y
 # datos ×2). Ahora se dicen una vez, arriba, y el grupo sólo si no se llama
 # igual que el punto.
 # ============================================================ #}
{% block more_css %}
    {{ parent() }}
    {% include '_components/partner_card_styles.html.twig' %}
    {% include '_components/panel_home_styles.html.twig' %}
    {% if is_granted('FEATURE_VOLUNTEERING') %}
        {% include '_components/volunteering_styles.html.twig' %}
    {% endif %}
    <style>
        /* Papeleo: se abre cuando hace falta y no antes. */
        .prt-fold { margin-top: 18px; }
        .prt-fold > summary {
            display: inline-flex; gap: 8px; align-items: center;
            font-size: 13px; color: var(--prt-ink-faint);
            cursor: pointer; list-style: none;
        }
        .prt-fold > summary::-webkit-details-marker { display: none; }
        .prt-fold > summary::before {
            content: ''; width: 6px; height: 6px;
            border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
            transform: rotate(-45deg); transition: transform .15s ease;
        }
        .prt-fold[open] > summary::before { transform: rotate(45deg); }
        .prt-fold > summary:hover { color: var(--prt-ink); }
        .prt-fold__body { margin-top: 12px; }
    </style>
{% endblock %}

{% block csa_main %}

    {% set initials = (partner.name|first|upper) ~ (partner.surname|first|default('')|upper) %}
    {% set avatar_palette = ['sage', 'ochre', 'terra', 'ink'] %}
    {% set avatar_tone = partner.status == 'BAJA' ? 'muted' : avatar_palette[(partner.id|default(0)) % 4] %}

    {% set status_chip = {
        'ACTIVO':  { label: 'Activx',  cls: 'activo'  },
        'PAUSADO': { label: 'Pausadx', cls: 'pausado' },
        'BAJA':    { label: 'De baja', cls: 'baja'    }
    } %}
    {% set sc = status_chip[partner.status]|default({ label: partner.status, cls: 'baja' }) %}

    {% set bs_id = active_share ? active_share.basketShare.id : null %}
    {% set bs_label = active_share ? active_share.basketShare.name : null %}

    {# El punto de recogida de la próxima entrega: el de siempre, salvo que esa
     # semana la haya trasladado a otro (el proyector lo marca en el slot). #}
    {% set home_place = group and group.node ? group.node.name : null %}
    {% set next_place = next_delivery ? (next_delivery.pickup_place|default(home_place)) : home_place %}
    {# El grupo sólo aporta cuando NO se llama igual que el punto: en la mayoría
     # de los sitios coinciden y repetirlo era ruido. #}
    {% set show_group = group and (home_place is null or group.name != home_place) %}

    <div class="prt">

        {# ============ SALUDO ============
         # "Hola, Inés" y no "INÉS BAUTISTA CAMPOS": esto no es su ficha, es su
         # casa. El nombre entero y el papeleo están más abajo, plegados, para
         # quien venga a comprobar un dato.
         #
         # La fecha de hoy encima no es decoración: es lo que hace legible el
         # "es hoy" de la tarjeta siguiente sin tener que salir a mirar el
         # calendario del teléfono. #}
        <header class="pnl-greet">
            <span class="prt-avatar prt-avatar--{{ avatar_tone }} pnl-greet__avatar" aria-hidden="true">{{ initials }}</span>
            <div class="pnl-greet__date">{{ 'now'|format_date(pattern="EEEE d 'de' MMMM", locale='es') }}</div>
            <h1 class="pnl-greet__title">Hola, {{ partner.name|lower }}</h1>
            <div class="pnl-greet__chips">
                <span class="prt-chip prt-chip--{{ sc.cls }}"><span class="dot"></span>{{ sc.label }}</span>
                {% if active_share %}
                    <span class="prt-chip prt-chip--mod-{{ bs_id }}">
                        {% if bs_id != 4 %}<span class="dot"></span>{% endif %}
                        {{ bs_label }}
                    </span>
                {% else %}
                    <span class="prt-chip prt-chip--warn"><span class="dot"></span>Sin cesta</span>
                {% endif %}
            </div>
        </header>

        {# ============ 1. LA PRÓXIMA CESTA ============
         # Lo que se venía a mirar, y por eso es lo único de la pantalla en verde
         # sólido: el resto de la home es consulta, y esto es la cita.
         #
         # El horario sale del NODO donde se recoge esa semana —que no siempre es
         # el de casa: si hay traslado puntual, el proyector deja el nodo destino
         # en el slot—. Es texto libre ("Viernes de 18:00 a 20:00") y hay nodos
         # que no lo tienen, así que se pinta si existe y tal cual. #}
        {% if next_delivery %}
            {% set is_today = next_delivery.date|date('Y-m-d') == 'now'|date('Y-m-d') %}
            {% set is_tomorrow = next_delivery.date|date('Y-m-d') == 'tomorrow'|date('Y-m-d') %}
            {% set relocated = next_delivery.relocated|default(false) %}
            {% set pickup_node = next_delivery.pickup_node|default(group ? group.node : null) %}
            <section class="pnl-next">
                <div class="pnl-next__main">
                    <div class="pnl-next__head">
                        <i class="fa fa-shopping-basket" aria-hidden="true"></i>
                        <span>Tu próxima cesta</span>
                        {% if is_today %}<span class="pnl-next__soon">Es hoy</span>
                        {% elseif is_tomorrow %}<span class="pnl-next__soon">Es mañana</span>{% endif %}
                    </div>
                    <p class="pnl-next__when">{{ next_delivery.date|format_date(pattern="EEEE d 'de' MMMM", locale='es') }}</p>
                    <ul class="pnl-next__facts">
                        {% if next_place %}
                            <li>
                                <i class="fa fa-map-marker" aria-hidden="true"></i>
                                <span>{% if relocated %}Esa semana, en {{ next_place }}{% else %}{{ next_place }}{% if show_group %} · {{ group.name }}{% endif %}{% endif %}</span>
                            </li>
                        {% endif %}
                        {% if pickup_node and pickup_node.schedule %}
                            <li>
                                <i class="fa fa-clock-o" aria-hidden="true"></i>
                                <span>{{ pickup_node.schedule }}</span>
                            </li>
                        {% endif %}
                    </ul>
                </div>
                <div class="pnl-next__actions">
                    <a href="{{ path('panel_calendar') }}" class="pnl-next__btn pnl-next__btn--solid">
                        <i class="fa fa-calendar" aria-hidden="true"></i> Mi calendario
                    </a>
                    {# Traslado puntual de nodo: sólo con cesta activa, semanas futuras
                       con entrega y algún otro nodo al que ir. El mismo cambio se puede
                       hacer también desde el calendario. #}
                    {% if active_share and relocate_weeks is not empty and relocate_groups is not empty %}
                        <button type="button" class="pnl-next__btn"
                                onclick="document.getElementById('panel-relocate-dialog').showModal()">
                            <i class="fa fa-exchange" aria-hidden="true"></i> Recoger en otro sitio
                        </button>
                    {% endif %}
                </div>
            </section>
        {% elseif group %}
            {# Sin entregas por delante (sin cesta activa, o pausadx): al menos,
             # dónde recoge cuando la tenga. En claro y no en verde: no hay cita a
             # la que ir, y pintarlo igual que una entrega sería mentir. #}
            <section class="pnl-next pnl-next--quiet">
                <div class="pnl-next__main">
                    <div class="pnl-next__head">
                        <i class="fa fa-map-marker" aria-hidden="true"></i>
                        <span>Tu punto de recogida</span>
                    </div>
                    <p class="pnl-next__when">{{ home_place ?: 'Sin punto asignado' }}</p>
                    <ul class="pnl-next__facts">
                        {% if show_group %}
                            <li><i class="fa fa-users" aria-hidden="true"></i> <span>{{ group.name }}</span></li>
                        {% endif %}
                        {% if group.node and group.node.schedule %}
                            <li><i class="fa fa-clock-o" aria-hidden="true"></i> <span>{{ group.node.schedule }}</span></li>
                        {% endif %}
                    </ul>
                </div>
                <div class="pnl-next__actions">
                    <a href="{{ path('panel_calendar') }}" class="pnl-next__btn pnl-next__btn--solid">
                        <i class="fa fa-calendar" aria-hidden="true"></i> Mi calendario
                    </a>
                </div>
            </section>
        {% endif %}

        {# Quién le monta la cesta esa semana en su punto, o el aviso de que no se
         # ha apuntado nadie. Pegado a la franja porque habla de ESA entrega. Sólo
         # se pinta donde el montaje se organiza como tarea de voluntariado. #}
        {% if next_delivery and basket_prep|default([]) is not empty %}
            {% include '_components/basket_prep_card.html.twig' with {
                offers: basket_prep,
                partner: partner,
                place: next_place,
                delivery_date: next_delivery.date
            } only %}
        {% endif %}

        {# ============ 2. QUÉ LLEVO ============ #}
        {% if active_share %}
            {# En una familia la cesta cuelga del principal: si no es la suya
             # propia, se dice de quién es en vez de negársela. #}
            {% set owner = basket_owner|default(partner) %}
            {% set is_family_basket = owner.id != partner.id %}
            <section class="prt-card prt-card--terra">
                <header class="prt-card__head">
                    <h2 class="prt-card__title"><span class="accent"></span>{{ is_family_basket ? 'La cesta de casa' : 'Mi cesta' }}</h2>
                    {% if active_share.startDate %}
                        <span class="prt-card__head-meta">desde {{ active_share.startDate|date('d/m/Y') }}</span>
                    {% endif %}
                </header>
                <div class="prt-card__body">

                    <div class="prt-basket__chips">
                        <span class="prt-chip prt-chip--mod-{{ bs_id }}">
                            {% if bs_id != 4 %}<span class="dot"></span>{% endif %}
                            {{ bs_label }}
                        </span>
                        {% if bs_id == 3 and active_share.dayMonthOrder %}
                            <span class="prt-chip prt-chip--mute">{% if active_share.dayMonthOrder == -1 %}última semana{% else %}{{ active_share.dayMonthOrder }}º viernes{% endif %}</span>
                        {% endif %}
                        {% if active_share.vegetablesBasketAmount and active_share.vegetablesBasketAmount > 1 %}
                            <span class="prt-chip prt-chip--mute">×{{ active_share.vegetablesBasketAmount }} cestas</span>
                        {% endif %}
                    </div>

                    <div class="prt-mini">
                        <div class="prt-mini__cell">
                            <div class="prt-mini__label">Huevos</div>
                            {% if active_share.eggAmount %}
                                <div class="prt-mini__value prt-mini__value--ochre">
                                    {{ active_share.eggAmount.amount|default(active_share.eggAmount) }}
                                    {% if active_share.eggPeriod %}<small>· {{ active_share.eggPeriod.name|default(active_share.eggPeriod) }}</small>{% endif %}
                                </div>
                            {% else %}
                                <div class="prt-mini__value prt-mini__value--muted">Sin huevos</div>
                            {% endif %}
                        </div>
                        <div class="prt-mini__cell">
                            <div class="prt-mini__label">Precio mensual</div>
                            <div class="prt-mini__value prt-mini__value--sage">
                                {% if active_share.eggAmount and active_share.eggMonthPrice %}
                                    {{ (active_share.monthPrice + active_share.eggMonthPrice)|number_format(2, ',', '.') }}<small>€</small>
                                {% elseif active_share.monthPrice %}
                                    {{ active_share.monthPrice|number_format(2, ',', '.') }}<small>€</small>
                                {% else %}
                                    <span class="prt-mini__value--muted">—</span>
                                {% endif %}
                            </div>
                        </div>
                        {# La fecha de fin sólo se enseña si existe: "Sin fecha" en una
                         # caja propia era una caja entera para decir que no pasa nada. #}
                        {% if active_share.endDate %}
                            <div class="prt-mini__cell">
                                <div class="prt-mini__label">Hasta</div>
                                <div class="prt-mini__value">{{ active_share.endDate|date('d/m/Y') }}</div>
                            </div>
                        {% endif %}
                    </div>

                    {% if is_family_basket %}
                        <div class="prt-share">
                            <i class="fa fa-home"></i>
                            <span>Es la cesta de {{ owner.name|lower|capitalize }} {{ owner.surname|lower|capitalize }}, de tu familia. La recogéis juntxs.</span>
                        </div>
                    {% endif %}

                    {% if owner.sharePartner and bs_id in [4, 6, 7] %}
                        <div class="prt-share">
                            <i class="fa fa-handshake-o"></i>
                            <span>Compartes cesta con {{ owner.sharePartner.name|lower|capitalize }} {{ owner.sharePartner.surname|lower|capitalize }}</span>
                        </div>
                    {% endif %}

                </div>
            </section>
        {% else %}
            <section class="prt-card prt-card--terra">
                <header class="prt-card__head">
                    <h2 class="prt-card__title"><span class="accent"></span>Mi cesta</h2>
                </header>
                <div class="prt-card__body">
                    <p class="prt-family__intro">No tienes una cesta activa registrada. Si crees que es un error, escribe a <a href="mailto:info@csavegadejarama.org">info@csavegadejarama.org</a>.</p>
                </div>
            </section>
        {% endif %}

        {# ============ 3. ECHAR UNA MANO ============
         # Después de lo suyo y no en medio: antes partía la pantalla entre su
         # punto de recogida y sus datos, y se leía como parte de su ficha. Sigue
         # arriba —hay que estar en el camino, no al lado— pero como lo que es,
         # una petición de la asociación. #}
        {% if is_granted('FEATURE_VOLUNTEERING') %}
            {# Lo que llevas hecho, encima de lo que hace falta. Nunca al revés:
             # el contador arriba y solo es un reproche, con las tareas debajo es
             # una petición que se puede atender de un clic.
             #
             # A quien aún no ha empezado sólo se le pinta si HAY algo que ofrecer:
             # "todavía no has echado una mano" sin una sola tarea al lado es
             # exactamente el reproche sin salida que se quiere evitar. #}
            {% if my_contribution and (my_contribution.hasStarted or volunteering_offers|default([]) is not empty) %}
                {% include '_components/volunteering_gauge.html.twig' with {
                    contribution: my_contribution
                } only %}
            {% endif %}

            {% include '_components/volunteering_teaser.html.twig' with {
                offers: volunteering_offers|default([]),
                total: volunteering_total|default(0),
                my_node_id: group and group.node ? group.node.id : null
            } only %}
        {% endif %}

        {# ============ 4. MI FAMILIA ============
         # Sólo cuando hay algo que contar. A quien no tiene familia vinculada le
         # salía una tarjeta para decirle que no tiene familia vinculada. #}
        {% if partner.parent is not null or partner.relatives|length > 0 %}
            <section class="prt-card prt-card--ochre">
                <header class="prt-card__head">
                    <h2 class="prt-card__title"><span class="accent"></span>Mi familia</h2>
                    {% if partner.parent is null and partner.relatives|length > 0 %}
                        <span class="prt-card__head-meta">{{ partner.relatives|length }} vinculadx{{ partner.relatives|length == 1 ? '' : 's' }}</span>
                    {% endif %}
                </header>
                <div class="prt-card__body">
                    {% if partner.parent is null %}
                        <ul class="prt-relatives">
                            {% for relative in partner.relatives %}
                                <li class="prt-relative">
                                    <span class="prt-relative__dot"><i class="fa fa-user"></i></span>
                                    <span class="prt-relative__name">{{ relative.name }} {{ relative.surname }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="prt-family__intro">
                            Estás vinculadx a la familia de <strong>{{ partner.parent.name }} {{ partner.parent.surname }}</strong>.
                        </p>
                    {% endif %}
                </div>
            </section>
        {% endif %}

        {# ============ 5. EL PAPELEO ============ #}
        <details class="prt-fold">
            <summary>Mis datos personales</summary>
            <div class="prt-fold__body">
                <section class="prt-card">
                    <header class="prt-card__head">
                        <h2 class="prt-card__title"><span class="accent"></span>Mis datos</h2>
                        <a href="{{ path('panel_profile') }}" class="prt-btn"><i class="fa fa-pencil"></i> Editar</a>
                    </header>
                    <div class="prt-card__body">
                        <dl class="prt-defs">
                            <div class="prt-defs__row">
                                <dt class="prt-defs__label">Nombre completo</dt>
                                <dd class="prt-defs__value" style="text-transform: capitalize;">{{ (partner.name ~ ' ' ~ partner.surname)|lower }}</dd>
                            </div>
                            <div class="prt-defs__row">
                                <dt class="prt-defs__label">DNI</dt>
                                <dd class="prt-defs__value{% if not partner.dNI %} prt-defs__value--muted{% endif %}">{{ partner.dNI ?: '—' }}</dd>
                            </div>
                            <div class="prt-defs__row">
                                <dt class="prt-defs__label">Teléfono</dt>
                                <dd class="prt-defs__value{% if not partner.celular %} prt-defs__value--muted{% endif %}">{{ partner.celular ?: '—' }}</dd>
                            </div>
                            <div class="prt-defs__row">
                                <dt class="prt-defs__label">Email</dt>
                                <dd class="prt-defs__value{% if not partner.email %} prt-defs__value--muted{% endif %}">
                                    {% if partner.email %}<a href="mailto:{{ partner.email }}">{{ partner.email }}</a>{% else %}—{% endif %}
                                </dd>
                            </div>
                            {% if partner.address %}
                                <div class="prt-defs__row prt-defs__row--full">
                                    <dt class="prt-defs__label">Dirección</dt>
                                    <dd class="prt-defs__value">{{ partner.address }}{% if partner.city %} — {{ partner.city }}{% if partner.state %} ({{ partner.state }}){% endif %}{% endif %}</dd>
                                </div>
                            {% endif %}
                            {% if partner.inscriptionDate %}
                                <div class="prt-defs__row">
                                    <dt class="prt-defs__label">Fecha de inscripción</dt>
                                    <dd class="prt-defs__value">{{ partner.inscriptionDate|format_date('long', locale='es') }}</dd>
                                </div>
                            {% endif %}
                            <div class="prt-defs__row">
                                <dt class="prt-defs__label">¿Consume cárnicos?</dt>
                                <dd class="prt-defs__value">{{ partner.eatMeat ? 'Sí' : 'No' }}</dd>
                            </div>
                            {% if partner.sharePayment %}
                                <div class="prt-defs__row">
                                    <dt class="prt-defs__label">Forma de pago</dt>
                                    <dd class="prt-defs__value">{{ partner.sharePayment.name }}</dd>
                                </div>
                            {% endif %}
                        </dl>
                    </div>
                </section>
            </div>
        </details>

        {# ============ MODAL: RECOGER EN OTRO NODO (traslado puntual) ============ #}
        {% if active_share and relocate_weeks is not empty and relocate_groups is not empty %}
            <dialog id="panel-relocate-dialog" class="csa-modal csa-modal--info" aria-labelledby="panel-relocate-title">
                <form method="post" action="{{ path('panel_basket_change_group') }}" data-csa-dropdowns="1">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_basket_change_group') }}">
                    <button class="csa-modal__close" type="button" aria-label="Cerrar" onclick="this.closest('dialog').close()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
                    </button>
                    <header class="csa-modal__header">
                        <div class="csa-modal__heading">
                            <span class="csa-modal__eyebrow">Solo esa semana</span>
                            <h2 class="csa-modal__title" id="panel-relocate-title">Recoger en otro nodo</h2>
                        </div>
                    </header>
                    <div class="csa-modal__body">
                        <p>Tu punto de recogida habitual es <strong>{{ home_place ?: 'el de siempre' }}</strong>. Si una semana concreta te viene mejor recogerla en otro sitio, elígelo aquí. Solo cambia esa semana.</p>
                        <label class="csa-field">
                            <span class="csa-field__label">¿Qué semana?</span>
                            <select name="basket_id" required>
                                {% for w in relocate_weeks %}
                                    <option value="{{ w.basketId }}">{{ w.date|format_date('full', locale='es')|capitalize }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="csa-field">
                            <span class="csa-field__label">¿Dónde la recoges?</span>
                            <select name="group_id" required>
                                {% for g in relocate_groups %}
                                    <option value="{{ g.id }}">{{ g.label }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                    <footer class="csa-modal__footer">
                        <button type="button" class="csa-modal__btn csa-modal__btn--ghost" onclick="this.closest('dialog').close()">Cancelar</button>
                        <button type="submit" class="csa-modal__btn csa-modal__btn--primary">Trasladar</button>
                    </footer>
                </form>
            </dialog>
        {% endif %}

    </div>

{% endblock %}
