{# ============================================================
 # Panel del productor · Abrir pedido. `form.producer` viene
 # bloqueado (lock_producer): eres tú, no se elige.
 # ============================================================ #}

{% extends '_layouts/csa_producer.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% form_theme form 'form_div_layout.html.twig' %}

{% block title %}Abrir pedido{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel_producer_index') }}">Mis pedidos</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Abrir pedido</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Mi catálogo', 'Abrir pedido', 'Al crearlo se añaden los productos activos de tu catálogo, a su precio de referencia. Podrás ajustar cuáles entran y a qué precio.') }}

    {{ form_start(form, { attr: { class: 'csa-form-narrow', 'data-csa-dropdowns': '1' } }) }}
        <div class="csa-stack-lg">
            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Pedido', subtitle: 'Plazo de apuntes y día de entrega.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.title, 'Título', { full: true }) }}
                        {{ csa.field(form.ordersCloseAt, 'Cierre de apuntes') }}
                        {{ csa.field(form.deliveryDate, 'Fecha de entrega') }}
                        {{ csa.field(form.minimumCondition, 'Condición de mínimo (informativa)') }}
                        {{ csa.field(form.description, 'Descripción para las socias', { full: true }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: path('panel_producer_index') }) }}
                    <button type="submit" class="csa-btn csa-btn--primary">Abrir pedido</button>
                </div>
            </div>
        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}
{% endblock %}
