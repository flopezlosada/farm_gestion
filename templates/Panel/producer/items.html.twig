{# ============================================================
 # Panel del productor · Productos del pedido: qué entra del
 # catálogo y a qué precio de este pedido.
 #   - round          ConsumerGroupRound
 #   - catalog        ConsumerGroupProduct[] (activos + los ya en el pedido)
 #   - current_price  map product_id => precio de pedido actual
 #   - included       map product_id => true (si está en el pedido)
 #   - locked_product_ids map product_id => true — ya hay pedidos reales, precio fijo
 # ============================================================ #}

{% extends '_layouts/csa_producer.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Productos del pedido{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel_producer_index') }}">Mis pedidos</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('panel_producer_round_show', { id: round.id }) }}">{{ round.title }}</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Productos</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Mi catálogo', 'Productos del pedido', round.title) }}

    <div class="csa-card csa-form-narrow">
        {% if catalog is empty %}
            <p class="csa-muted">
                No tienes productos activos en tu catálogo.
                <a href="{{ path('panel_producer_product_new') }}">Añade el primero</a>.
            </p>
        {% else %}
            <p class="csa-muted" style="margin-top: 0;">
                Marca los productos que entran en este pedido y ajusta su precio. El precio es de este pedido: se ha rellenado con el de la última vez que lo llevaste.
            </p>
            <form method="post" action="{{ path('panel_producer_round_items', { id: round.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('panel_producer_items_' ~ round.id) }}">
                <div class="cg-items">
                    {% for product in catalog %}
                        {% set is_locked = locked_product_ids[product.id]|default(false) %}
                        <div class="cg-item-row">
                            <label class="cg-item-row__inc">
                                <input type="checkbox" name="include[{{ product.id }}]" value="1" {{ included[product.id]|default(false) ? 'checked' : '' }}>
                                <span>{{ product.name }} <span class="csa-muted">/ {{ product.unit }}</span></span>
                            </label>
                            <div class="cg-item-row__price">
                                <input type="number" min="0" step="0.01" inputmode="decimal"
                                       name="price[{{ product.id }}]"
                                       value="{{ current_price[product.id]|default('0') }}"
                                       class="csa-input" placeholder="0,00"
                                       {{ is_locked ? 'disabled title="Ya hay pedidos de socias con este precio: no se puede cambiar."' : '' }}>
                                <span class="csa-muted">€ / {{ product.unit }}</span>
                                {% if is_locked %}
                                    <i class="fa fa-lock csa-muted" title="Ya hay pedidos de socias con este precio: no se puede cambiar."></i>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="csa-row" style="justify-content: flex-end; margin-top: var(--csa-sp-4);">
                    {{ csa.btn('Volver', { variant: 'ghost', href: path('panel_producer_round_show', { id: round.id }) }) }}
                    <button type="submit" class="csa-btn csa-btn--primary">Guardar productos</button>
                </div>
            </form>
        {% endif %}
    </div>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    <style>
        .cg-items { display: flex; flex-direction: column; gap: var(--csa-sp-2); }
        .cg-item-row { display: flex; align-items: center; justify-content: space-between; gap: var(--csa-sp-3); padding: var(--csa-sp-2) 0; border-bottom: 1px solid var(--csa-rule); }
        .cg-item-row__inc { display: inline-flex; align-items: center; gap: var(--csa-sp-2); font-weight: 400; }
        .cg-item-row__inc input { width: auto; height: auto; }
        .cg-item-row__price { display: inline-flex; align-items: center; gap: var(--csa-sp-2); }
        .cg-item-row__price .csa-input { width: 7rem; }
    </style>
{% endblock %}
