{% extends '_layouts/csa_producer.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}{{ product.name }} · Mi catálogo{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel_producer_product_index') }}">Mi catálogo</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ product.name }}</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Mi catálogo', 'Editar producto', '') }}
    {% include 'consumer_group_product/_form.html.twig' with {
        submit_label: 'Guardar cambios',
        cancel_url: path('panel_producer_product_index')
    } %}

    <div class="csa-card csa-form-narrow cg-photo">
        <h2 class="cg-photo__title">Fotos</h2>
        <p class="csa-muted cg-photo__help">Las ve la socia al apuntarse.</p>

        {% include '_components/cg_product_gallery.html.twig' with {
            product: product,
            photos: photos,
            photo_form: photo_form,
            delete_route: 'panel_producer_product_photo_delete',
            csrf_prefix: 'panel_producer_product_photo_'
        } %}
    </div>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/cg_gallery_styles.html.twig' %}
    {% include '_components/cg_lightbox_styles.html.twig' %}
    <style>
        .cg-photo { margin-top: var(--csa-sp-5); }
        .cg-photo__title { font-size: 1.05rem; margin: 0 0 var(--csa-sp-1); }
        .cg-photo__help { margin-top: 0; }
    </style>
{% endblock %}

{% block more_js %}
    {{ parent() }}
    {% include '_components/cg_lightbox.html.twig' %}
{% endblock %}
