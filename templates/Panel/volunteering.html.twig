{% extends '_layouts/csa_panel.html.twig' %}

{% block title %}Voluntariado{% endblock %}

{% block csa_crumbs %}
    <span class="csa-topbar__crumb-active">Voluntariado</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{#
 # EL ORDEN DE ESTA PANTALLA ES EL DISEÑO, no una preferencia estética.
 #
 # 1. Lo que hace falta, con fecha, sitio y plazas libres. Es lo que cambia cada
 #    semana, y lo que cambia se lee. "Llevas 0 horas" es el mismo píxel toda la
 #    vida y a las dos semanas es mobiliario.
 # 2. Lo que tengo comprometido.
 # 3. De qué quiero que me avisen.
 # 4. Lo que llevo hecho — al final y en pequeño.
 #
 # Poner el contador arriba convierte la pantalla en un reproche sin salida, y un
 # reproche que no se resuelve de un clic sólo consigue que la gente deje de
 # entrar en la web. Y con ella se pierde el canal por el que gestionan su cesta.
 #}
{% block csa_main %}

    
    <div class="csa-stack">

        {# ============ 0. CONFIRMA LO QUE HICISTE ============ #}
        {# Va antes que nada porque es una pregunta concreta con respuesta de un
         # clic, y porque hasta que no se conteste esas horas no las tiene nadie.
         # Es lo contrario del contador: no reprocha, pregunta. #}
        {% if pending_confirmation is not empty %}
            {% embed '_components/csa_card.html.twig' with {
                title: pending_confirmation|length == 1 ? '¿Pudiste ir?' : '¿Pudiste ir a estas?',
                icon: 'fa-question-circle-o',
                accent: 'ochre'
            } %}
                {% block body %}
                {% import '_macros/volunteering.html.twig' as vol %}
                    <ul class="vol-list">
                        {% for signup in pending_confirmation %}
                            <li class="vol-item">
                                <div class="vol-item__main">
                                    <h4 class="vol-item__title">{{ signup.offer.title }}</h4>
                                    <div class="vol-item__meta">
                                        <span><i class="fa fa-calendar" aria-hidden="true"></i>
                                            {{ signup.offer.startsAt|format_datetime('full', 'short', locale='es') }}</span>
                                        {% if signup.offer.creditedMinutes %}
                                            <span><i class="fa fa-clock-o" aria-hidden="true"></i>
                                                Cuenta {{ vol.duration(signup.offer.creditedMinutes) }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="vol-item__action">
                                    <form method="post" action="{{ path('panel_volunteering_confirm', {id: signup.offer.id}) }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_volunteering') }}">
                                        <button type="submit" name="attended" value="1" class="csa-btn csa-btn--primary csa-btn--sm">Sí, la hice</button>
                                        <button type="submit" name="attended" value="0" class="csa-btn csa-btn--secondary csa-btn--sm">No pude</button>
                                    </form>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endblock %}
            {% endembed %}
        {% endif %}

        {# ============ 1. LO QUE HACE FALTA ============ #}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Lo que hace falta',
            subtitle: 'Tareas de las próximas semanas que siguen sin cubrir',
            icon: 'fa-hand-paper-o',
            accent: 'green',
            variant: 'hero'
        } %}
            {% block body %}
                {% import '_macros/volunteering.html.twig' as vol %}
                {% if offers is empty %}
                    <p class="vol-empty">
                        Ahora mismo no hay ninguna tarea pendiente. Cuando haya algo que
                        necesite manos, aparecerá aquí.
                    </p>
                {% else %}
                    <ul class="vol-list">
                        {% for offer in offers %}
                            {# Lo que ya tienes apuntado no sale aquí: vive en su
                             # propio bloque, con el botón de darte de baja. #}
                            {% set mine_here = my_node_id and offer.node and offer.node.id == my_node_id %}

                            <li class="vol-item">
                                <div class="vol-item__main">
                                    <h4 class="vol-item__title">{{ offer.title }}</h4>

                                    <div class="vol-item__meta">
                                        <span><i class="fa fa-calendar" aria-hidden="true"></i>
                                            {{ offer.startsAt|format_datetime('full', 'short', locale='es') }}</span>

                                        {% if offer.remote %}
                                            <span><i class="fa fa-home" aria-hidden="true"></i> Desde casa</span>
                                        {% elseif offer.node %}
                                            <span><i class="fa fa-map-marker" aria-hidden="true"></i> {{ offer.node }}</span>
                                        {% elseif offer.place %}
                                            <span><i class="fa fa-map-marker" aria-hidden="true"></i> {{ offer.place }}</span>
                                        {% endif %}

                                        {% if offer.creditedMinutes %}
                                            <span><i class="fa fa-clock-o" aria-hidden="true"></i>
                                                Cuenta {{ vol.duration(offer.creditedMinutes) }}</span>
                                        {% endif %}
                                    </div>

                                    {% if offer.description %}
                                        <p class="vol-item__desc">{{ offer.description|nl2br }}</p>
                                    {% endif %}

                                    <div class="vol-item__tags">
                                        {% if mine_here %}
                                            {# Lo que pasa en su punto de recogida: ya va a estar ahí ese día. #}
                                            <span class="csa-badge csa-badge--green">En tu punto de recogida</span>
                                        {% endif %}
                                        {% for category in offer.categories %}
                                            <span class="csa-badge">{{ category.name }}</span>
                                        {% endfor %}
                                    </div>
                                </div>

                                <div class="vol-item__action">
                                    {% if offer.remainingSlots is not null %}
                                        <p class="vol-item__slots">
                                            {% if offer.remainingSlots == 1 %}
                                                Falta <strong>1 persona</strong>
                                            {% else %}
                                                Faltan <strong>{{ offer.remainingSlots }} personas</strong>
                                            {% endif %}
                                        </p>
                                    {% endif %}

                                    <form method="post" action="{{ path('panel_volunteering_signup', {id: offer.id}) }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_volunteering') }}">
                                        {% if offer.companionsAllowed %}
                                            <label class="vol-item__companions">
                                                Vengo con
                                                <input type="number" name="companions" value="0" min="0" max="10" class="csa-input csa-input--compact">
                                                más
                                            </label>
                                        {% endif %}
                                        <button type="submit" class="csa-btn csa-btn--primary csa-btn--sm">Me apunto</button>
                                    </form>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endblock %}
        {% endembed %}

        {# ============ 2. LO QUE TENGO COMPROMETIDO ============ #}
        {% if my_signups is not empty %}
            {% embed '_components/csa_card.html.twig' with {
                title: 'A lo que te has apuntado',
                icon: 'fa-check-square-o',
                accent: 'sky'
            } %}
                {% block body %}
                {% import '_macros/volunteering.html.twig' as vol %}
                    {# El botón de darse de baja vive AQUÍ y no arriba: es donde
                     # está lo tuyo, y así "Lo que hace falta" habla sólo de lo
                     # que falta. #}
                    <ul class="vol-list">
                        {% for signup in my_signups %}
                            <li class="vol-item">
                                <div class="vol-item__main">
                                    <h4 class="vol-item__title">{{ signup.offer.title }}</h4>
                                    <div class="vol-item__meta">
                                        <span><i class="fa fa-calendar" aria-hidden="true"></i>
                                            {{ signup.offer.startsAt|format_datetime('full', 'short', locale='es') }}</span>
                                        {% if signup.offer.remote %}
                                            <span><i class="fa fa-home" aria-hidden="true"></i> Desde casa</span>
                                        {% elseif signup.offer.node %}
                                            <span><i class="fa fa-map-marker" aria-hidden="true"></i> {{ signup.offer.node }}</span>
                                        {% elseif signup.offer.place %}
                                            <span><i class="fa fa-map-marker" aria-hidden="true"></i> {{ signup.offer.place }}</span>
                                        {% endif %}
                                        {% if signup.companions > 0 %}
                                            <span><i class="fa fa-users" aria-hidden="true"></i>
                                                Vas con {{ signup.companions }} más</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="vol-item__action">
                                    <form method="post" action="{{ path('panel_volunteering_withdraw', {id: signup.offer.id}) }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_volunteering') }}">
                                        <button type="submit" class="csa-btn csa-btn--secondary csa-btn--sm">No voy a poder ir</button>
                                    </form>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endblock %}
            {% endembed %}
        {% endif %}

        {# ============ 3. DE QUÉ AVISAR ============ #}
        {% embed '_components/csa_card.html.twig' with {
            title: 'De qué quieres que te avisemos',
            icon: 'fa-bell-o'
        } %}
            {% block body %}
                {% import '_macros/volunteering.html.twig' as vol %}

                {# Esto se contesta UNA vez y luego se mira cero veces, pero ocupaba
                 # media pantalla en cada visita, por delante de lo único que cambia
                 # cada semana. Ahora el estado se dice en una frase y el formulario
                 # se abre sólo si se va a cambiar. El bloque no se mueve de sitio:
                 # el orden de la pantalla está pensado y sigue igual. #}
                {% set my_categories = categories|filter(c => c.id in my_category_ids) %}
                <p class="vol-total">
                    {% if partner.volunteeringOptOut %}
                        No quieres que te avisemos de voluntariado.
                    {% elseif my_categories is not empty %}
                        Te avisamos de:
                        {% for category in my_categories %}{{ category.name }}{% if not loop.last %}, {% endif %}{% endfor %}.
                    {% else %}
                        Te avisamos sólo de las tareas sencillas que puede hacer cualquiera.
                    {% endif %}
                </p>

                {# El formulario se fue a «Avisos», que es donde el socix busca
                 # cómo silenciar algo: se contesta una vez y aquí ocupaba media
                 # pantalla en cada visita, por delante de lo único que cambia cada
                 # semana. Se queda el ESTADO —que sí conviene ver desde aquí, para
                 # entender por qué llega lo que llega— y el enlace para cambiarlo.
                 #
                 # Y con él se fue el segundo botón de activar avisos, que estaba
                 # duplicado con el de la otra pantalla. #}
                <p>
                    <a href="{{ path('panel_notifications') }}" class="csa-btn csa-btn--secondary csa-btn--sm">Cambiar de qué me avisan</a>
                </p>
            {% endblock %}
        {% endembed %}

        {# ============ 4. LO QUE LLEVAS HECHO — al final y sin dramatismo ============ #}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Tu aportación este año',
            icon: 'fa-heart-o'
        } %}
            {% block body %}
                {% import '_macros/volunteering.html.twig' as vol %}
                <p class="vol-total">
                    {% if my_minutes > 0 %}
                        Llevas <strong>{{ vol.duration(my_minutes) }}</strong> de voluntariado este año.
                    {% else %}
                        Este año todavía no has echado una mano.
                    {% endif %}
                </p>

                {# Qué hiciste, no sólo cuánto. Un número suelto no significa
                 # nada; la lista de lo que hay detrás sí, y además deja ver de
                 # un vistazo si falta algo por confirmar. #}
                {% if my_done is not empty %}
                    <ul class="vol-mine">
                        {% for signup in my_done %}
                            <li>
                                <strong>{{ signup.offer.title }}</strong>
                                {% if signup.coordination %}
                                    {# Organizar también es trabajo, y quien lo
                                     # hace merece verlo nombrado. #}
                                    <span class="csa-badge">lo organizaste</span>
                                {% endif %}
                                <span class="vol-mine__when">
                                    {{ signup.offer.startsAt|format_date('long', locale='es') }}
                                    {%- if signup.creditedMinutes %} · {{ vol.duration(signup.creditedMinutes) }}{% endif -%}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {#
                 # La referencia se enseña SÓLO a quien va por debajo, y es la
                 # MEDIANA de quienes participan, no la media.
                 #
                 # La media está contaminada por los ceros: con mucha gente que no
                 # hace nada, se hunde, y quien fue una tarde suelta sale "por
                 # encima de la media" cuando hace falta bastante más. Y enseñársela
                 # a quien va sobrado es peor todavía: aprende que hace el doble de
                 # lo normal y se relaja hasta la media. Es el efecto bumerán que
                 # documentaron Schultz y Cialdini con el consumo eléctrico, donde
                 # los hogares que menos gastaban SUBIERON al ver la media del
                 # barrio. A esa gente, aquí, no se le enseña nada.
                 #}
                {% if show_median %}
                    <p class="vol-help">
                        Quien echa una mano suele dedicar unas
                        <strong>{{ vol.duration(median_minutes) }}</strong> al año.
                    </p>
                {% elseif my_minutes > 0 %}
                    <p class="vol-help">Gracias — la asociación se sostiene con esto.</p>
                {% endif %}

                <p class="vol-help vol-help--muted">
                    Sólo lo ves tú.
                </p>
            {% endblock %}
        {% endembed %}

    </div>
{% endblock %}
