{% extends '_layouts/csa_panel.html.twig' %}

{% block title %}Voluntariado{% endblock %}

{% block csa_crumbs %}
    <span class="csa-topbar__crumb-active">Voluntariado</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{#
 # LA PORTADA DEL VOLUNTARIADO: lo que hace falta, y nada más.
 #
 # Antes esta pantalla hacía CINCO cosas —confirmar lo hecho, ver lo que falta,
 # ver lo tuyo, elegir tus áreas y mirar tu aportación—, que en un móvil son
 # cuatro pantallazos de scroll y en la práctica significa que sólo se ve lo
 # primero. Ahora cada una tiene su pestaña y esta contesta una sola pregunta:
 # ¿dónde hago falta?
 #
 # Se queda de portada porque es lo que cambia cada semana, y lo que cambia se
 # lee. El cuadrante —la vista del mes entero, donde uno se apunta a varios días
 # de una vez— está a un clic, en su pestaña, en vez de enterrado en un enlace
 # de texto al pie de un bloque, que es donde estaba.
 #}
{% block csa_main %}

    {% include '_components/volunteering_tabs.html.twig' %}

    <div class="csa-stack">

        {# ============ 1. LO QUE HACE FALTA ============
         # EN TRES MONTONES Y NO EN UNA LISTA. Plana, una faena de cuatro plazas
         # del sábado pesaba lo mismo que sacar al perro el martes, y con el tope
         # de ocho por fecha bastaba una semana cargada para que lo de dentro de
         # quince días no existiera. Los montones son los del diseño: lo que hay
         # que resolver ya, lo que conviene cerrar, y el día a día.
         #
         # LAS MISMAS TARJETAS QUE LA PORTADA. Esta pantalla enseñaba filas con
         # el título y una línea de meta —peor presentación que el teaser de la
         # home, que es su resumen— y para saber si podías ir había que abrir la
         # tarea. La tarjeta trae los cinco datos que deciden y el botón. #}
        {# Las rutinas NO entran aquí: no se pintan como tarjetas sino como una
         # fila plegada al pie, y el filtro trabaja sobre lo pintado. Contarlas
         # dejaría el «Todas 7» prometiendo tarjetas que no están. #}
        {% set todos = urgent_shifts|merge(later_shifts) %}

        {# ---- CABECERA ----
         # Sin la csa-card «hero» que la envolvía: una banda verde con un icono
         # en un círculo blanco y el título dentro pesaba más que las tarjetas y
         # ponía un cuarto verde en una pantalla que ya tiene el de los botones.
         # Aquí el título hace de título, en serif y grande, y la pantalla empieza
         # donde empieza el contenido.
         #
         # «¿DÓNDE HAGO FALTA?» y no «Lo que hace falta»: es la pregunta que trae
         # a alguien a esta pantalla, dicha con sus palabras. Y la entradilla dice
         # de qué se le avisa —que es lo que explica por qué ve lo que ve— y que
         # puede venir a cualquier cosa, que si no marcar un área se lee como
         # cerrarse las demás. #}
        <header class="vol-head">
            <h1 class="vol-head__title">¿Dónde hago falta?</h1>
            <p class="vol-head__sub">
                Turnos de las próximas semanas que siguen sin cubrir.
                {%- if my_area_names is not empty %}
                    Te avisamos de {{ my_area_names|join(' y ') }}, pero puedes venir a cualquiera.
                {%- endif %}
            </p>
        </header>

        {% if todos is empty and routine_shifts is empty %}
                <p class="vol-empty">
                    Ahora mismo no hay ningún turno pendiente. Cuando haya algo que
                    necesite manos, aparecerá aquí.
                </p>
            {% else %}
                {# Los filtros sólo tienen sentido con tarjetas que filtrar:
                 # con el día a día por toda compañía, una barra de filtros es
                 # un control que no hace nada. #}
                {% if todos is not empty %}
                {# ---- FILTROS ----
                 # POR ÁREA, que es como la gente piensa en esto: «yo hago
                 # huerta». Es además un dato de primera —lo elige quien crea la
                 # tarea— y ya es el filtro del cuadrante, así que las dos
                 # pantallas se filtran igual.
                 #
                 # FUERA «FIN DE SEMANA». No salía de ningún campo: lo calculaba
                 # la plantilla de la fecha del turno. Con cinco tarjetas en
                 # pantalla, filtrar por sábado no le ahorra el trabajo a nadie, y
                 # para mirar por días está el cuadrante, que es una vista de
                 # calendario entera.
                 #
                 # «Desde casa» y «en mi punto» se quedan: son los dos que dicen
                 # si PUEDES ir, que es la pregunta anterior a si te apetece. El
                 # primero sale de `remote` y el segundo de que la tarea tenga
                 # nodo y sea el tuyo.
                 #
                 # «Sin experiencia» está en el diseño y no se pone: no hay campo
                 # que lo diga —`open_to_anyone` es otra cosa, a quién se le
                 # amplía el aviso— y un filtro que no filtra por lo que promete
                 # es peor que no tenerlo.
                 #
                 # Filtran en el navegador y sobre lo ya pintado: son unas pocas
                 # tarjetas, no hay recarga, y quien no tenga JS las sigue viendo
                 # todas, que es el estado útil. Por eso los contadores se
                 # calculan sobre lo que se pinta y no sobre el total: un filtro
                 # no puede sacar lo que no está. #}
                {% set n_casa = todos|filter(s => s.offer.remote)|length %}
                {% set n_mio = my_node_id ? todos|filter(s => s.offer.node and s.offer.node.id == my_node_id)|length : 0 %}

                <div class="vol-filters" data-vol-filters>
                    <button type="button" class="vol-filter vol-filter--on" data-vol-filter="todas" aria-pressed="true">
                        Todas <span class="vol-filter__n">{{ todos|length }}</span>
                    </button>

                    {# Las áreas que hay EN PANTALLA, no el catálogo entero: un
                     # filtro que deja la lista vacía es un botón que no sirve. #}
                    {% set areas_vistas = [] %}
                    {% for shift in todos %}
                        {% for category in shift.offer.categories %}
                            {% if category.id not in areas_vistas|map(a => a.id) %}
                                {% set areas_vistas = areas_vistas|merge([{ id: category.id, name: category.name }]) %}
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                    {% for area in areas_vistas %}
                        {% set n_area = todos|filter(s => area.id in s.offer.categories|map(c => c.id))|length %}
                        <button type="button" class="vol-filter" data-vol-filter="area-{{ area.id }}" aria-pressed="false">
                            {{ area.name }} <span class="vol-filter__n">{{ n_area }}</span>
                        </button>
                    {% endfor %}

                    {% if n_casa %}
                        <button type="button" class="vol-filter" data-vol-filter="remote" aria-pressed="false">
                            Desde casa <span class="vol-filter__n">{{ n_casa }}</span>
                        </button>
                    {% endif %}
                    {% if n_mio %}
                        <button type="button" class="vol-filter" data-vol-filter="mine" aria-pressed="false">
                            En mi punto <span class="vol-filter__n">{{ n_mio }}</span>
                        </button>
                    {% endif %}
                </div>

                {# Cuando un filtro deja la pantalla vacía hay que decirlo: si
                 # no, parece que se ha roto. #}
                <p class="vol-empty" data-vol-none hidden>
                    Nada de eso ahora mismo. Prueba con «Todas» o mira el calendario.
                </p>

                {% endif %}

                {% include '_components/volunteering_group.html.twig' with {
                    title: 'Falta gente ya', hint: 'Sin cubrir y con la fecha encima', tone: 'urgent',
                    shifts: urgent_shifts, total: urgent_total, my_node_id: my_node_id, my_category_ids: my_category_ids
                } only %}
                {% include '_components/volunteering_group.html.twig' with {
                    title: 'Próximas semanas', hint: 'Hay hueco, pero conviene cerrarlo', tone: 'later',
                    shifts: later_shifts, total: later_total, my_node_id: my_node_id, my_category_ids: my_category_ids
                } only %}
                {# ---- LO QUE QUEDA FUERA, UNA SOLA VEZ ----
                 # La suma de los dos montones, con su enlace y su aire. Antes
                 # iba dentro de cada montón, pegada al último botón: se leía
                 # como el pie de esa tarjeta, no como la salida de la lista, y
                 # con dos montones salía dos veces seguidas. #}
                {% set fuera = (urgent_total - urgent_shifts|length) + (later_total - later_shifts|length) %}
                {% if fuera > 0 %}
                    <p class="vol-more">
                        <a href="{{ path('panel_volunteering_calendar') }}">
                            Ver los otros {{ fuera }} turno{{ fuera == 1 ? '' : 's' }} en el cuadrante →
                        </a>
                    </p>
                {% endif %}

                {# ---- EL DÍA A DÍA, EN UNA LÍNEA ----
                 # Y no como un tercer montón de tarjetas, que en móvil dejaba
                 # el trabajo de verdad a cuatro scrolls de distancia. Son
                 # turnos de una plaza y un rato corto —sacar al perro—: se
                 # cubren solos casi siempre y quien los hace ya sabe que
                 # existen. Enseñarlos con el mismo peso que una faena de
                 # cuatro plazas era darles una importancia que no tienen.
                 #
                 # La fila entera es el enlace y mide 44px: se toca con el
                 # pulgar sin apuntar. #}
                {% if routine_shifts is not empty %}
                    <a class="vol-fold" href="{{ path('panel_volunteering_calendar') }}">
                        <span class="vol-fold__body">
                            <span class="vol-fold__title">Del día a día</span>
                            <span class="vol-fold__hint">
                                Un rato corto, todos los días.
                                {% for shift in routine_shifts|slice(0, 2) %}
                                    {{- ' ' }}{{ shift.offer.title }}{{ loop.last ? '.' : ',' }}
                                {%- endfor %}
                            </span>
                        </span>
                        <span class="vol-fold__go">
                            {{ routine_total }} turno{{ routine_total == 1 ? '' : 's' }} →
                        </span>
                    </a>
                {% endif %}

                {# SIN un tercer enlace al cuadrante al pie. Llegó a haber tres
                 # seguidos en el mismo palmo de pantalla —«y 12 turnos más», la
                 # fila del día a día y éste—, los tres al mismo sitio y diciendo
                 # casi lo mismo. Cada montón lleva ya el suyo, con su número y su
                 # contexto, y el cuadrante tiene además su pestaña arriba. #}
            {% endif %}

    </div>

    {# ---- FILTRO DE TURNOS ----
     # En el navegador y sobre lo ya pintado: son unas decenas de tarjetas, así
     # que filtrar aquí es instantáneo y no cuesta una recarga que además
     # perdería el sitio de la página. Sin JS, la pantalla se queda con todas las
     # tarjetas visibles, que es el estado útil — por eso los botones nacen
     # pintados como "Todas" y no se esconde nada de entrada.
     #
     # Oculta también el ENCABEZADO de un montón que se queda sin tarjetas: un
     # "Falta gente ya" sobre un hueco anuncia trabajo que no está ahí. Y si no
     # queda ninguna en toda la pantalla lo dice, porque si no parece rota. #}
    <script>
        (function () {
            var bar = document.querySelector('[data-vol-filters]');
            if (!bar) { return; }

            var tasks = Array.prototype.slice.call(document.querySelectorAll('[data-vol-task]'));
            var groups = Array.prototype.slice.call(document.querySelectorAll('[data-vol-group]'));
            var none = document.querySelector('[data-vol-none]');

            function matches(task, filter) {
                if (filter === 'todas') { return true; }

                // Por área: el filtro viaja como «area-3» y la tarjeta lleva la
                // lista de las suyas, que pueden ser varias.
                if (filter.indexOf('area-') === 0) {
                    var id = filter.slice(5);
                    return (task.getAttribute('data-vol-areas') || '').split(',').indexOf(id) !== -1;
                }

                return task.getAttribute('data-vol-' + filter) === '1';
            }

            function apply(filter) {
                tasks.forEach(function (task) {
                    task.hidden = !matches(task, filter);
                });

                var visibles = 0;
                groups.forEach(function (group) {
                    var dentro = group.querySelectorAll('[data-vol-task]:not([hidden])').length;
                    group.hidden = dentro === 0;
                    visibles += dentro;

                    // El contador del encabezado dice lo que se está viendo, no
                    // lo que había: con el filtro puesto, el número de antes
                    // contradice a las tarjetas que tiene debajo.
                    var n = group.querySelector('[data-vol-group-n]');
                    if (n) { n.textContent = dentro; }
                });

                if (none) { none.hidden = visibles > 0; }
            }

            bar.addEventListener('click', function (event) {
                var button = event.target.closest('[data-vol-filter]');
                if (!button) { return; }

                bar.querySelectorAll('[data-vol-filter]').forEach(function (other) {
                    var on = other === button;
                    other.classList.toggle('vol-filter--on', on);
                    other.setAttribute('aria-pressed', on ? 'true' : 'false');
                });

                apply(button.getAttribute('data-vol-filter'));
            });
        }());
    </script>
{% endblock %}
