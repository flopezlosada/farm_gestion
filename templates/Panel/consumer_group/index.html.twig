{# ============================================================
 # Panel del socix · Grupo de consumo — pedidos abiertos + pedidos
 # confirmados que se le entregarán con la cesta.
 #
 # El controller pasa:
 #   - open_rounds     ConsumerGroupRound[] abiertos
 #   - order_by_round  array round_id => ConsumerGroupOrder de la socia
 #   - confirmed       ConsumerGroupOrder[] confirmados y por entregar
 #   - past            ConsumerGroupOrder[] confirmados ya entregados (historial)
 #   - payment_info    texto de configuración: dónde transferir ('' = no hay)
 # ============================================================ #}

{% extends '_layouts/csa_panel.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Grupo de consumo{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Grupo de consumo</span>
{% endblock %}

{% block csa_main %}

    {{ csa.page_header(
        'Mi área · Grupo de consumo',
        'Pedidos colectivos',
        'Productos de temporada de productores cercanos que se reparten con tu cesta. Apúntate mientras el pedido esté abierto.'
    ) }}

    <div class="csa-stack-lg">

        {# ============ RONDAS ABIERTAS ============ #}
        <section>
            <h2 class="csa-section-title">Pedidos abiertos</h2>
            {% if open_rounds is empty %}
                <p class="csa-muted">Ahora mismo no hay ningun pedido abierto. Cuando la comisión abra una, aparecerá aquí.</p>
            {% else %}
                <div class="csa-stack">
                    {% for round in open_rounds %}
                        {% set mine = order_by_round[round.id] ?? null %}
                        {% include 'Panel/consumer_group/_round_card.html.twig' with { round: round, mine: mine } only %}
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        {# ============ PEDIDOS CONFIRMADOS ============ #}
        {% if confirmed is not empty %}
            <section>
                <h2 class="csa-section-title">Se te entregará con la cesta</h2>
                <div class="csa-stack">
                    {% for order in confirmed %}
                        {% set round = order.round %}
                        <div class="cg-round-card">
                            <div class="cg-round-card__body">
                                <div class="cg-round-card__title">{{ round.title }}</div>
                                <div class="cg-round-card__meta">
                                    Entrega el {{ round.deliveryDate ? round.deliveryDate|date('d/m/Y') : '—' }} con tu cesta
                                </div>
                                <ul class="cg-round-card__lines">
                                    {% for line in order.lines %}
                                        {% if line.quantity > 0 %}
                                            <li>{{ line.quantity|number_format(2, ',', '.') }} {{ line.roundItem.unit }} · {{ line.roundItem.name }}</li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>

                                {% include 'Panel/consumer_group/_payment.html.twig' with { order: order, payment_info: payment_info } only %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {# ============ HISTORIAL ============ #}
        {% if past is not empty %}
            <section>
                <h2 class="csa-section-title">Lo que ya te llevaste</h2>
                <div class="csa-stack">
                    {% for order in past %}
                        {% set round = order.round %}
                        <div class="cg-round-card cg-round-card--past">
                            <div class="cg-round-card__body">
                                <div class="cg-round-card__title">{{ round.title }}</div>
                                <div class="cg-round-card__meta">
                                    {{ round.deliveryDate ? round.deliveryDate|date('d/m/Y') : '—' }}
                                    · {{ order.total|number_format(2, ',', '.') }} €
                                    {%- set state = order.paymentState.value %}
                                    {%- if state in ['in_receipt', 'awaiting_bank'] %} · va en tu recibo{% elseif state == 'returned' %} · recibo devuelto{% elseif state == 'pending' %} · pendiente de pago{% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

    </div>

{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    <style>
        .csa-section-title { font-size: 1.05rem; margin: 0 0 var(--csa-sp-3); }
    </style>
    {% include 'Panel/consumer_group/_card_styles.html.twig' %}
    {% include 'Panel/consumer_group/_money_styles.html.twig' %}
{% endblock %}
