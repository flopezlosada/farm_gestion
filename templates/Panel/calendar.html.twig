{# ============================================================
 # Mi calendario de recogida — vista del SOCIO (/panel/calendar).
 # Reusa el partial compartido del calendario en SOLO LECTURA (etapa 1).
 # La edición (mover / no recoger) llega en una etapa posterior, con las
 # reglas de autoservicio y pensada para móvil.
 #
 # `route_shared_move` es la excepción: en una cesta compartida aquí no se
 # mueve nada, se PIDE al otro hogar. Ese endpoint recibe la semana en el
 # cuerpo, no en la ruta, por eso no lleva `shared_move_in_path`.
 # ============================================================ #}
{% extends '_layouts/csa_panel.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Mi calendario{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Mi calendario</span>
{% endblock %}

{% block more_css %}
{{ parent() }}
{% include 'partner/_calendar_styles.html.twig' %}
{% endblock %}

{% block csa_main %}

    {# Rejilla + panel lateral: esta pantalla SÍ aprovecha el ancho de más, así
     # que se sale del ancho de lectura del panel. Ver panel_shell_styles. #}
    <span class="csa-wide" hidden aria-hidden="true"></span>


    {{ csa.page_header(
        'Mi área · Calendario',
        'Mi calendario de recogida',
        'Cuándo y dónde recoges tu cesta' ~ (pickup_place ? ' · ' ~ pickup_place : '')
    ) }}

    {% include '_components/cg_calendar_panel.html.twig' %}

    {# Ayuda breve: para quien no tiene soltura con apps, explicar de un vistazo
       cómo se lee y se usa el calendario. Los marcadores son los mismos que en la rejilla. #}
    {# UN SOLO AVISO, y no uno por dispositivo. Eran dos, casi idénticos, que se turnaban
       por CSS —uno con la clase que se escondía en escritorio y otro con la que se escondía
       en táctil—. En cuanto una de esas reglas dejó de existir se vieron los dos a la vez,
       diciendo casi lo mismo. Un texto que sirve para los dos gestos no puede romperse así.
       Y en una cesta compartida ni siquiera se pinta: el partial ya explica lo suyo, que
       es más específico, y dos avisos seguidos no los lee nadie. #}
    {% if partner.sharePartner is null %}
        {{ csa.callout(
            'Los días en verde son los que recoges tu cesta (la hoja es verdura y el óvalo, huevos). Toca un día para ver el detalle y cambiarlo de fecha o no recogerlo; en el ordenador también puedes arrastrarlo.',
            'info', 'info-circle'
        ) }}
    {% endif %}

    {# dnd: true → arrastrar en escritorio (igual que el gestor): mover, no-recoger (a la
       papelera) y recuperar (sacar de la papelera a un día). El flujo por toque para móvil
       es ADITIVO y se oculta en escritorio por CSS. El socio no tiene reset de mes (es una
       acción de gestión). #}
    {# El autoservicio (saltar/mover/recuperar) está tras el feature-flag
       FEATURE_PARTNER_SELFSERVICE. Con él apagado, can_self_serve es false y el
       calendario se reusa en SOLO LECTURA: cal.readonly desactiva arrastre,
       papelera y botones de acción. La protección dura vive en cada endpoint. #}
    {# Deshacer un traslado sumando SÍ se le ofrece (es su propia cesta); quitar una cesta
       extra puesta a mano por gestión NO — de ahí que no se pase route_extra_remove. #}
    {% include 'partner/_calendar.html.twig' with {
        cal: {
            dnd: can_self_serve,
            readonly: not can_self_serve,
            egg_move: can_self_serve,
            route_view: 'panel_calendar',
            route_skip: 'panel_calendar_skip',
            route_move: 'panel_calendar_move',
            route_recover: 'panel_calendar_recover',
            route_egg_toggle: 'panel_calendar_eggs',
            route_undo_accumulate: 'panel_calendar_accumulate_undo',
            idp: {},
            csrf_skip: csrf_token('panel_calendar_skip'),
            csrf_move: csrf_token('panel_calendar_move'),
            csrf_egg_toggle: csrf_token('panel_calendar_eggs'),
            csrf_undo_accumulate: csrf_token('panel_calendar_move'),
            route_shared_move: 'panel_shared_basket_request_move',
            csrf_shared_move: csrf_token('panel_shared_basket_request'),
            shared_needs_consent: true,
            shared_other_name: partner.sharePartner ? partner.sharePartner.nameForDelivery : null,
        }
    } %}

{% endblock %}
