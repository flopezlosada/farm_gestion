{% extends '_layouts/csa_panel.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% form_theme profile_form 'form_div_layout.html.twig' %}

{% block title %}Mi perfil{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Mi perfil</span>
{% endblock %}

{% block csa_main %}

    {{ csa.page_header(
        'Mi área · Perfil',
        'Mis datos',
        'Mantén tu información al día.'
    ) }}

<div class="csa-stack-lg">

        {{ form_start(profile_form, { attr: { class: 'csa-form-narrow' } }) }}
            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Identidad y contacto', subtitle: 'Tus datos personales.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(profile_form.name, 'Nombre') }}
                        {{ csa.field(profile_form.surname, 'Apellidos') }}
                        {{ csa.field(profile_form.DNI, 'DNI') }}
                        {{ csa.field(profile_form.address, 'Dirección', { full: true }) }}
                        {{ csa.field(profile_form.state, 'Provincia') }}
                        {{ csa.field(profile_form.city, 'Municipio') }}
                    </div>

                    <div class="csa-form-grid" style="margin-top: var(--csa-sp-5); padding-top: var(--csa-sp-4); border-top: 1px dashed var(--csa-rule);">
                        <div class="csa-field">
                            <div class="csa-field__label-row">
                                <label class="csa-field__label">Email</label>
                            </div>
                            <p style="margin: 0;">{{ app.user.email }}</p>
                        </div>
                        <div class="csa-field">
                            <div class="csa-field__label-row">
                                <label class="csa-field__label">Teléfono</label>
                            </div>
                            <p style="margin: 0;">{{ partner.celular ?: '—' }}</p>
                        </div>
                    </div>
                    <p class="csa-muted" style="margin-top: var(--csa-sp-3); font-size: var(--csa-fs-sm);">
                        Para cambiar email o teléfono, escríbenos a
                        <a href="mailto:info@csavegadejarama.org?subject=Cambio de email o teléfono">info@csavegadejarama.org</a>.
                    </p>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <a href="{{ path('panel_password') }}" class="csa-btn csa-btn--secondary">Cambiar contraseña</a>
                <button type="submit" class="csa-btn csa-btn--primary">Guardar mis datos</button>
            </div>
            {{ form_rest(profile_form) }}
        {{ form_end(profile_form, { render_rest: false }) }}

        {# ============ AVISOS EN EL MÓVIL ============
         # AQUÍ Y NO SÓLO EN VOLUNTARIADO. El interruptor vivía dentro de la
         # pantalla de voluntariado, que va detrás de FEATURE_VOLUNTEERING: con
         # el módulo apagado no había NINGÚN sitio donde activar los avisos, y
         # el recordatorio de la cesta —que no tiene nada que ver con el
         # voluntariado— se quedaba sin canal.
         #
         # Fuera del formulario de datos a propósito: esto no se guarda con
         # "Guardar mis datos". Es una decisión del navegador, se aplica al
         # pulsar y afecta sólo a ESTE dispositivo; meterlo dentro del form
         # haría pensar que viaja con el resto del perfil. #}
        {% if app_vapid_public_key is not empty %}
        <div class="csa-form-narrow" style="padding-top: var(--csa-sp-5);">
            {% embed '_components/csa_card.html.twig' with {
                title: 'Avisos en este dispositivo',
                icon: 'fa-bell-o'
            } %}
                {% block body %}
                    {# Un solo interruptor para todo el canal, a propósito: partirlo
                     # en una casilla por tipo de aviso es justo la pantalla que no
                     # se entiende. La única salida que hace falta —no querer saber
                     # nada del voluntariado— ya existe en su sitio, y se enlaza
                     # desde aquí en vez de duplicarla. #}
                    <p class="csa-muted">
                        Te avisamos en el móvil cuando toque recoger tu cesta y,
                        si te interesa el voluntariado, cuando falte gente para
                        algo que encaje contigo. Se activa en cada dispositivo por
                        separado: si quieres los avisos en el móvil y en el
                        ordenador, hay que darle en los dos.
                        {% if is_granted('FEATURE_VOLUNTEERING') %}
                            Si sólo quieres lo de tu cesta, dilo en
                            <a href="{{ path('panel_volunteering') }}">Voluntariado</a>
                            y no te avisaremos de eso.
                        {% endif %}
                    </p>

                    {# El botón se pinta siempre pero se explica solo: push.js le
                     # cambia el texto al estado real (no admitido, bloqueado, ya
                     # activado…) antes de que nadie lo toque. #}
                    <button type="button" class="csa-btn csa-btn--secondary csa-btn--sm" data-push-toggle>Activar avisos</button>

                    <p class="csa-muted" style="margin-top: var(--csa-sp-3);">
                        En iPhone o iPad hay un paso más: abre esta web en Safari,
                        pulsa Compartir → «Añadir a pantalla de inicio» y ábrela
                        desde el icono que aparece. Sólo así deja Apple activar los
                        avisos.
                    </p>
                {% endblock %}
            {% endembed %}
        </div>
        {% endif %}

    </div>

    <script>
        (function () {
            const stateSelect = document.getElementById('{{ profile_form.state.vars.id }}');
            const citySelect = document.getElementById('{{ profile_form.city.vars.id }}');
            if (!stateSelect || !citySelect) return;

            const urlTemplate = '{{ path('panel_cities_by_state', { state: '__STATE__' }) }}';

            stateSelect.addEventListener('change', async () => {
                const stateId = stateSelect.value;
                citySelect.innerHTML = '<option value="">— Cargando… —</option>';
                if (!stateId) {
                    citySelect.innerHTML = '<option value="">— Selecciona primero una provincia —</option>';
                    return;
                }
                try {
                    const res = await fetch(urlTemplate.replace('__STATE__', stateId), { headers: { 'Accept': 'application/json' } });
                    const cities = await res.json();
                    citySelect.innerHTML = '<option value="">— Selecciona —</option>'
                        + cities.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
                } catch (e) {
                    citySelect.innerHTML = '<option value="">— Error al cargar municipios —</option>';
                }
            });
        })();
    </script>

{% endblock %}
