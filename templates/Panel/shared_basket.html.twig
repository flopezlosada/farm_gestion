{% extends '_layouts/csa_panel.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{# ============================================================
 # Los cambios que los dos hogares de una cesta compartida se piden entre sí.
 #
 # LO PRIMERO ES LO QUE ME TOCA CONTESTAR. Alguien entra aquí porque le ha llegado
 # un aviso, no a pasear: lo que espera respuesta va arriba y con los dos botones a
 # la vista. Lo que pedí yo va después, que es informativo.
 #
 # LA NEGATIVA NO ES UN BOTÓN DE SEGUNDA. Decir que no es una respuesta legítima —el
 # otro hogar tiene sus planes— y esconderla detrás de un enlace pequeño empuja a
 # aceptar por no buscarla. Los dos botones, uno al lado del otro.
 # ============================================================ #}

{% block title %}Cesta compartida{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Cesta compartida</span>
{% endblock %}

{% block csa_main %}

    {{ csa.page_header(
        'Mi área · Cesta compartida',
        'La cesta que compartes con ' ~ other.nameForDelivery,
        'Es una sola cesta y la repartís entre los dos hogares, así que los cambios los decidís entre los dos.'
    ) }}

    <div class="csa-stack-lg csa-form-narrow">

        {# ============ 1. LO QUE ME TOCA CONTESTAR ============
         # La tarjeta SÓLO SI HAY ALGO. Esta pantalla se abre desde un aviso —"tienes que
         # contestar a un cambio"— y lo primero que debe verse es eso, no dos cajas
         # anunciando que no hay nada. Lo que no existe no ocupa sitio. #}
        {% if incoming is not empty %}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Esperando tu respuesta',
            icon: 'fa-hand-paper-o'
        } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}

                    {% for req in incoming %}
                        <div class="csa-stack" style="padding-block: var(--csa-sp-3); border-bottom: 1px solid var(--csa-border);">
                            <p>
                                <strong>{{ req.requester.nameForDelivery }}</strong>
                                pide {{ req.summary }}.
                            </p>

                            {% if req.note %}
                                <p class="csa-muted" style="font-style: italic;">«{{ req.note }}»</p>
                            {% endif %}

                            {% if req.isActionable %}
                                {% if req.kind == 'modality' %}
                                    {{ csa.hint('Si dices que sí, queda acordado entre los dos y lo aplica administración: un cambio de modalidad afecta a la cuota.') }}
                                {% else %}
                                    {{ csa.hint('Si dices que sí, el cambio se aplica en ese momento para los dos hogares.') }}
                                {% endif %}

                                {# Dos formularios sueltos en un div, NO dentro de un <p>: un
                                 # <form> dentro de un párrafo lo cierra por su cuenta y la
                                 # maquetación se deshace (ya pasó en la pantalla de avisos). #}
                                <div class="csa-row">
                                    <form method="post" action="{{ path('panel_shared_basket_accept', {id: req.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_shared_basket_decide') }}">
                                        <button type="submit" class="csa-btn csa-btn--primary csa-btn--sm">Me viene bien</button>
                                    </form>
                                    <form method="post" action="{{ path('panel_shared_basket_reject', {id: req.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_shared_basket_decide') }}">
                                        <button type="submit" class="csa-btn csa-btn--secondary csa-btn--sm">No puedo</button>
                                    </form>
                                </div>
                            {% else %}
                                {# Pendiente pero con el reparto ya pasado: no se puede contestar
                                 # y no se ofrece un botón que sólo daría un error. #}
                                {{ csa.callout('Ese reparto ya pasó, así que esta petición se quedó sin efecto.', 'warning', 'clock-o') }}
                            {% endif %}
                        </div>
                    {% endfor %}
            {% endblock %}
        {% endembed %}
        {% endif %}

        {# ============ 2. LO QUE HE PEDIDO YO ============ #}
        {% if outgoing is not empty %}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Lo que has pedido',
            icon: 'fa-paper-plane-o'
        } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}

                    {% for req in outgoing %}
                        <div class="csa-stack" style="padding-block: var(--csa-sp-3); border-bottom: 1px solid var(--csa-border);">
                            <p>
                                Pediste {{ req.summary }}.
                                {% if req.isActionable %}
                                    <span class="csa-muted">Esperando a {{ req.counterpart.nameForDelivery }}.</span>
                                {% else %}
                                    <span class="csa-muted">Ese reparto ya pasó: se quedó sin efecto.</span>
                                {% endif %}
                            </p>

                            {% if req.isActionable %}
                                <form method="post" action="{{ path('panel_shared_basket_cancel', {id: req.id}) }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_shared_basket_decide') }}">
                                    <button type="submit" class="csa-btn csa-btn--secondary csa-btn--sm">Retirar la petición</button>
                                </form>
                            {% endif %}
                        </div>
                    {% endfor %}

            {% endblock %}
        {% endembed %}
        {% endif %}

        {# ============ 2a. ACORDADO, PENDIENTE DE ADMINISTRACIÓN ============
         # Un cambio de modalidad aceptado NO está aplicado: lo aplica administración. Hasta
         # entonces sigue en curso, así que no puede leerse en "Lo último" como si fuera
         # historia — que es justo lo que confundía— ni permitir proponer otro encima. #}
        {% if agreed is not empty %}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Acordado, en manos de administración',
            icon: 'fa-hourglass-half'
        } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                {% for req in agreed %}
                    <p>Los dos habéis dicho que sí a {{ req.summary }}. Falta que administración lo aplique; vuestra cesta sigue como está hasta entonces.</p>
                {% endfor %}
                {{ csa.callout('Mientras esto no esté hecho no se pueden pedir más cambios: primero que quede aplicado.', 'info', 'info-circle') }}
            {% endblock %}
        {% endembed %}
        {% endif %}

        {# ============ 3. CAMBIO DE MODALIDAD ============
         # No se ofrece si ya hay uno acordado esperando a administración: el servidor lo
         # rechazaría igual, y un formulario que sólo sirve para llevarse un error no es un
         # formulario. #}
        {% if agreed is empty %}
         # Aquí no se aplica nada: se acuerda. La cuota la lleva administración y la
         # ley que empareja a los dos hogares obliga a cambiar las dos cestas a la
         # vez, así que lo que esta pantalla aporta es que los dos hayan dicho que sí
         # antes de que nadie toque nada. #}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Cambiar la modalidad de la cesta',
            icon: 'fa-exchange'
        } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}

                {# `data-csa-dropdowns`: el desplegable del sistema operativo no se puede estilar
                   y aquí salía en gris del SO, roto respecto al resto. El componente es OPT-IN,
                   hay que pedirlo. #}
                <form method="post" action="{{ path('panel_shared_basket_request_modality') }}" class="csa-stack" data-csa-dropdowns>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_shared_basket_request') }}">

                    <label>
                        Modalidad que queréis
                        <select name="basket_share_id" class="csa-select" required>
                            <option value="">— elige —</option>
                            {% for modality in modalities %}
                                <option value="{{ modality.id }}">{{ modality.name }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>
                        Cuéntaselo a {{ other.nameForDelivery }} (opcional)
                        <textarea name="note" class="csa-input" rows="2" maxlength="500"></textarea>
                    </label>

                    <p>
                        <button type="submit" class="csa-btn csa-btn--primary csa-btn--sm">Proponérselo</button>
                    </p>

                    <p class="csa-muted" style="font-size: var(--csa-fs-sm);">Si acepta, queda acordado y lo aplica administración. Vuestra cesta no cambia hasta entonces.</p>
                </form>
            {% endblock %}
        {% endembed %}
        {% endif %}

        {# ============ EL HISTORIAL, AL FINAL Y RECOGIDO ============
         # Estuvo arriba y como tarjeta normal, y era lo más llamativo de la pantalla: cuatro
         # líneas de cosas ya resueltas por delante de lo único que hay que hacer. Un historial
         # se consulta cuando alguien quiere reconstruir qué pasó, no cada vez que se entra.
         # Va plegado, así que ocupa una línea; quien lo necesite lo abre. #}
        {% if decided is not empty %}
            {# Estilos aquí y no una clase de la casa: el desplegable del panel (`prt-fold`)
               tiene su CSS dentro de la plantilla de la portada, así que fuera de allí no
               existe. Son cuatro declaraciones para una línea plegada. #}
            <details style="margin-top: var(--csa-sp-4);">
                <summary style="cursor: pointer; color: var(--csa-ink-soft); font-size: var(--csa-fs-sm);">Historial de cambios ({{ decided|length }})</summary>
                <div style="padding-top: var(--csa-sp-3);">
                    {% set agreed_ids = [] %}
                    {% for a in agreed %}{% set agreed_ids = agreed_ids|merge([a.id]) %}{% endfor %}
                    {# `|filter` y no `for ... if`: Twig 3 quitó esa forma. #}
                    {% for req in decided|filter(r => r.id not in agreed_ids) %}
                        <p class="csa-muted" style="padding-block: var(--csa-sp-2); border-bottom: 1px solid var(--csa-border);">
                            {{ req.requester.nameForDelivery }} pidió {{ req.summary }}.
                            {% if req.status == 'accepted' %}
                                {{ req.counterpart.nameForDelivery }} dijo que sí.
                            {% elseif req.status == 'rejected' %}
                                {{ req.counterpart.nameForDelivery }} dijo que no.
                            {% else %}
                                Se retiró antes de contestarla.
                            {% endif %}
                            {{ req.decidedAt|format_date(pattern='d MMM', locale='es') }}
                        </p>
                    {% endfor %}
                </div>
            </details>
        {% endif %}

    </div>

{% endblock %}
