{% extends '_layouts/csa_panel.html.twig' %}

{% block title %}Voluntariado · Mis turnos{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel_volunteering') }}">Voluntariado</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Mis turnos</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{#
 # ES UN RESUMEN, NO UN ARCHIVO.
 #
 # La versión anterior desplegaba entera la lista de todo lo hecho en el año, y
 # ésa es la única parte de esta pantalla que crece sin techo: en septiembre eran
 # siete líneas y en junio serían treinta, enterrando lo que sí se viene a mirar.
 # Los pendientes y los turnos futuros son pocos por naturaleza; el histórico no.
 #
 # Orden: el próximo turno destacado —es a lo que se entra—, después lo que falta
 # por contestar, después lo que viene más adelante en una línea cada uno, y al
 # final la aportación, resumida y con su enlace al detalle.
 #
 # LA APORTACIÓN VA LA ÚLTIMA, siempre. Arriba, «llevas 0 horas» convierte la
 # pantalla en un reproche sin salida, y un reproche que no se resuelve de un
 # clic sólo consigue que la gente deje de entrar en la web — y con ella se
 # pierde el canal por el que gestionan su cesta.
 #}
{% block csa_main %}

    {% import '_macros/volunteering.html.twig' as vol %}

    {% include '_components/volunteering_tabs.html.twig' %}

    <div class="csa-stack">

        {# ============ 1. TU PRÓXIMO TURNO ============
         # Destacado y con la tarjeta entera: es lo que se viene a mirar, y lo
         # único de la pantalla sobre lo que se puede actuar hoy. #}
        {% if next_signup %}
            <section class="vol-group vol-group--first">
                <div class="vol-group__head">
                    <h4 class="vol-group__title">Tu próximo turno</h4>
                    <span class="vol-group__hint">
                        {%- set cuando = next_signup.startsAt -%}
                        {%- if cuando|date('Y-m-d') == 'now'|date('Y-m-d') -%}
                            Es hoy.
                        {%- elseif cuando|date('Y-m-d') == 'tomorrow'|date('Y-m-d') -%}
                            Es mañana.
                        {%- else -%}
                            Faltan {{ (cuando|date('U') - 'now'|date('U')) // 86400 + 1 }} días.
                        {%- endif -%}
                    </span>
                </div>

                {% include '_components/volunteering_task_card.html.twig' with {
                    shift: next_signup.shift,
                    mine: true,
                    companions: next_signup.companions,
                    my_node_id: null,
                    my_category_ids: [],
                    csrf: csrf_token('panel_volunteering')
                } only %}
            </section>
        {% endif %}

        {# ============ 2. LO QUE FALTA POR CONTESTAR ============
         # A LA VISTA, con sus botones, y no detrás de un «tienes 5 sin
         # confirmar». Es la acción que más cuesta conseguir —hasta que no
         # responden, esas horas no las tiene nadie— y ponerle un clic de más va
         # justo en contra.
         #
         # Con tope, eso sí: quien lleva medio año sin contestar tendría aquí una
         # pared de tarjetas, y una pared no se contesta, se cierra.
         #
         # LOS DOS BOTONES PESAN LO MISMO y ninguno es verde. Recomendar una de
         # las dos respuestas a una pregunta de hecho empuja a decir que sí a
         # quien no fue, y de ahí salen las horas del año de esa persona. #}
        {% if pending_confirmation is not empty %}
            <section class="vol-group">
                <div class="vol-group__head">
                    <h4 class="vol-group__title">{{ pending_total == 1 ? '¿Pudiste ir?' : '¿Pudiste ir a estas?' }}</h4>
                    <span class="vol-group__n">{{ pending_total }}</span>
                    <span class="vol-group__hint">Hasta que no contestes, esas horas no las tiene nadie.</span>
                </div>

                <div class="vol-tasks">
                    {% for signup in pending_confirmation %}
                        {% set shift = signup.shift %}
                        <article class="vol-task">
                            <p class="vol-task__kicker">
                                {%- for category in signup.offer.categories|slice(0, 1) %}{{ category.name }}{% endfor -%}
                            </p>
                            <h3 class="vol-task__title">{{ signup.offer.title }}</h3>
                            <div class="vol-task__meta">
                                {# Con el mes, a diferencia de las tarjetas que
                                 # miran hacia delante: aquí se recuerda algo que
                                 # ya pasó, y «lunes 31» a 9 de septiembre no dice
                                 # de qué mes se habla. #}
                                <p class="vol-task__when">
                                    {{- signup.startsAt|format_date(pattern="EEEE d 'de' MMMM", locale='es') -}}
                                    {%- if signup.startsAt|date('H:i') != '00:00' %}{{ ' · ' }}{{ signup.startsAt|date('H:i') }}{% endif -%}
                                </p>
                                {% if shift.creditedMinutes %}
                                    {# «Contarían» y no «cuenta»: todavía no son suyas. #}
                                    <p>Contarían {{ vol.duration(shift.creditedMinutes) }}</p>
                                {% endif %}
                            </div>
                            <form method="post" action="{{ path('panel_volunteering_confirm', {id: shift.id}) }}"
                                  class="vol-task__answers">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_volunteering') }}">
                                <button type="submit" name="attended" value="1" class="vol-task__answer">Sí, la hice</button>
                                <button type="submit" name="attended" value="0" class="vol-task__answer">No pude</button>
                            </form>
                        </article>
                    {% endfor %}
                </div>

                {% if pending_total > pending_confirmation|length %}
                    <p class="vol-group__more">
                        Y {{ pending_total - pending_confirmation|length }} más esperando respuesta. Contesta éstas y aparecerán.
                    </p>
                {% endif %}
            </section>
        {% endif %}

        {# ============ 3. LO QUE VIENE DESPUÉS ============
         # En una línea cada uno y no como tarjetas: para decidir si vas al del
         # sábado que viene no hace falta releer la ficha entera, y con tres
         # tarjetas verdes seguidas la pantalla dejaba de tener un solo foco. #}
        {% if later_signups is not empty %}
            <section class="vol-group">
                <div class="vol-group__head">
                    <h4 class="vol-group__title">Después de ése</h4>
                    <span class="vol-group__n">{{ later_signups|length }}</span>
                </div>

                <ul class="vol-next">
                    {% for signup in later_signups %}
                        <li class="vol-next__row">
                            <span class="vol-next__what">
                                <span class="vol-next__title">{{ signup.offer.title }}</span>
                                <span class="vol-next__when">
                                    {{- signup.startsAt|format_date(pattern="EEEE d 'de' MMMM", locale='es') -}}
                                    {%- if signup.startsAt|date('H:i') != '00:00' %}{{ ' · ' }}{{ signup.startsAt|date('H:i') }}{% endif -%}
                                    {%- if signup.companions > 0 %} · vas con {{ signup.companions }} más{% endif -%}
                                </span>
                            </span>
                            <form method="post" action="{{ path('panel_volunteering_withdraw', {id: signup.shift.id}) }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_volunteering') }}">
                                <button type="submit" class="vol-next__undo">No voy a poder ir</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {# Sin nada apuntado no hay pantalla vacía a secas: se dice dónde está lo
         # que hace falta, que es la única salida útil. #}
        {% if next_signup is null and pending_confirmation is empty %}
            <section class="vol-group vol-group--first">
                <p class="vol-empty">
                    No estás apuntadx a ningún turno todavía.
                    <a href="{{ path('panel_volunteering') }}">Mira lo que hace falta</a>.
                </p>
            </section>
        {% endif %}

        {# ============ 4. TU APORTACIÓN — resumida y la última ============
         # Sólo la cifra y cuántas tareas hay detrás; el listado entero vive en su
         # pantalla. Es lo único de aquí que crece todo el año, y desplegado
         # enterraba lo de arriba, que es lo que se viene a hacer. #}
        <section class="vol-group">
            <div class="vol-group__head">
                <h4 class="vol-group__title">Tu aportación este año</h4>
            </div>

            {% if my_minutes > 0 %}
                <p class="vol-sum">{{ vol.duration(my_minutes) }}</p>
                <p class="vol-note">
                    {% if done_count == 1 %}
                        En una tarea.
                    {% else %}
                        En {{ done_count }} tareas.
                    {% endif %}
                    {% if show_median %}
                        Quien echa una mano suele dedicar unas <strong>{{ vol.duration(median_minutes) }}</strong> al año.
                        No es una cuota: es lo que sale de sumar lo que hace la gente.
                    {% else %}
                        Gracias — la asociación se sostiene con esto.
                    {% endif %}
                </p>
            {% else %}
                <p class="vol-sum vol-sum--zero">Este año todavía no has echado una mano.</p>
                {% if show_median %}
                    <p class="vol-note">
                        Quien echa una mano suele dedicar unas <strong>{{ vol.duration(median_minutes) }}</strong> al año.
                        No es una cuota: es lo que sale de sumar lo que hace la gente.
                    </p>
                {% endif %}
            {% endif %}

            {% if done_count > 0 or coordination_log is not empty %}
                <p class="vol-group__more">
                    <a href="{{ path('panel_volunteering_history') }}">Ver el detalle →</a>
                </p>
            {% endif %}

            <p class="vol-note vol-note--faint">Sólo lo ves tú.</p>
        </section>

        {# ---- Horas de coordinar un área ----
         # Sólo para quien coordina alguna. Coordinar no es una tarea que cerrar:
         # no ocurre un día concreto, no tiene plazas y nadie se apunta. Es
         # buscar gente, cuadrarla, avisar y estar pendiente, repartido por la
         # semana — y hasta ahora no había forma de que esas horas contaran.
         #
         # Las apunta quien las hace, como quien va a una tarea dice si fue:
         # nadie más sabe ese número.
         #
         # Plegado: es de las pocas personas que coordinan, y aun a ellas les
         # toca una vez al mes. #}
        {% if coordinated is not empty %}
            <section class="vol-group">
                <div class="vol-group__head">
                    <h4 class="vol-group__title">Horas de coordinación</h4>
                    <span class="vol-group__hint">Sólo para quien lleva un área: el tiempo de cuadrar turnos y avisar a gente.</span>
                </div>

                <details class="vol-details">
                    <summary>Apuntar tiempo de coordinación</summary>

                    <form method="post" action="{{ path('panel_volunteering_log_coordination') }}"
                          class="vol-repeat" data-csa-validate>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_volunteering') }}">

                        {# Con una sola área no hay nada que elegir: se manda oculta. #}
                        {% if coordinated|length == 1 %}
                            <input type="hidden" name="category" value="{{ coordinated|first.id }}">
                        {% else %}
                            <label>
                                Área
                                <select name="category" class="csa-select" required>
                                    {% for category in coordinated %}
                                        <option value="{{ category.id }}">{{ category.name }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                        {% endif %}

                        <label>
                            Horas
                            <input type="number" name="hours" min="0.25" max="24" step="any" required
                                   class="csa-input csa-input--compact">
                        </label>

                        <label>
                            Cuándo
                            <input type="date" name="happened_on" class="csa-input"
                                   value="{{ 'now'|date('Y-m-d') }}" max="{{ 'now'|date('Y-m-d') }}">
                        </label>

                        <label>
                            En qué
                            <input type="text" name="notes" class="csa-input" maxlength="255"
                                   placeholder="opcional: «cuadrar los turnos de septiembre»">
                        </label>

                        <button type="submit" class="csa-btn csa-btn--primary csa-btn--sm">Apuntar</button>
                    </form>
                </details>
            </section>
        {% endif %}

    </div>
{% endblock %}
