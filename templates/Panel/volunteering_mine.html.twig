{% extends '_layouts/csa_panel.html.twig' %}

{% block title %}Voluntariado · Lo mío{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel_volunteering') }}">Voluntariado</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Lo mío</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{#
 # A lo que me he apuntado, lo que llevo hecho y lo que falta por confirmar.
 #
 # PANTALLA PROPIA desde que el voluntariado tiene pestañas. Todo esto vivía al
 # final de una pantalla que hacía otras dos cosas antes, o sea a varios
 # pantallazos de scroll en un móvil: en la práctica, no estaba.
 #
 # EL ORDEN NO ES ESTÉTICO. Primero lo que se pregunta (¿pudiste ir?), después
 # lo que viene, y el contador AL FINAL. Arriba, "llevas 0 horas" convierte la
 # pantalla en un reproche sin salida, y un reproche que no se resuelve de un
 # clic sólo consigue que la gente deje de entrar en la web — y con ella se
 # pierde el canal por el que gestionan su cesta.
 #}
{% block csa_main %}

    {% import '_macros/volunteering.html.twig' as vol %}

    {% include '_components/volunteering_tabs.html.twig' %}

    <div class="csa-stack">

        {# ============ 0. CONFIRMA LO QUE HICISTE ============
         # Va antes que nada porque es una pregunta concreta con respuesta de un
         # clic, y porque hasta que no se conteste esas horas no las tiene nadie.
         # Es lo contrario del contador: no reprocha, pregunta.
         #
         # LOS DOS BOTONES PESAN LO MISMO, y ninguno es verde. Antes «Sí, la
         # hice» iba en primario y «No pude» en secundario: eso es recomendar una
         # de las dos respuestas a una pregunta de hecho, y empuja a decir que sí
         # a quien no fue. Los datos que salen de aquí son las horas del año de
         # esa persona; inclinarlos es corromper el contador. #}
        {% if pending_confirmation is not empty %}
            <section class="vol-group">
                <div class="vol-group__head">
                    <h4 class="vol-group__title">{{ pending_confirmation|length == 1 ? '¿Pudiste ir?' : '¿Pudiste ir a estas?' }}</h4>
                    <span class="vol-group__hint">Hasta que no contestes, esas horas no las tiene nadie.</span>
                </div>

                <div class="vol-tasks">
                    {% for signup in pending_confirmation %}
                        {% set shift = signup.shift %}
                        <article class="vol-task">
                            <p class="vol-task__kicker">
                                {%- for category in signup.offer.categories|slice(0, 1) %}{{ category.name }}{% endfor -%}
                            </p>
                            <h3 class="vol-task__title">{{ signup.offer.title }}</h3>
                            <div class="vol-task__meta">
                                {# Con el mes, a diferencia de las tarjetas que
                                 # miran hacia delante: aquí se recuerda algo que
                                 # ya pasó, y «lunes 31» a día 9 de septiembre no
                                 # dice de qué mes se habla. #}
                                <p class="vol-task__when">
                                    {{- signup.startsAt|format_date(pattern="EEEE d 'de' MMMM", locale='es') -}}
                                    {%- if signup.startsAt|date('H:i') != '00:00' %}{{ ' · ' }}{{ signup.startsAt|date('H:i') }}{% endif -%}
                                </p>
                                {% if shift.creditedMinutes %}
                                    {# «Contarían» y no «cuenta»: todavía no son suyas. #}
                                    <p>Contarían {{ vol.duration(shift.creditedMinutes) }}</p>
                                {% endif %}
                            </div>
                            <form method="post" action="{{ path('panel_volunteering_confirm', {id: shift.id}) }}"
                                  class="vol-task__answers">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_volunteering') }}">
                                <button type="submit" name="attended" value="1" class="vol-task__answer">Sí, la hice</button>
                                <button type="submit" name="attended" value="0" class="vol-task__answer">No pude</button>
                            </form>
                        </article>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {# ============ 2. LO QUE TENGO COMPROMETIDO ============
         # La MISMA tarjeta que en «lo que hace falta», en estado «ya vas»: quien
         # se apuntó reconoce la tarjeta que pulsó. Antes era una fila de otro
         # componente y parecía otra cosa distinta.
         #
         # El botón de darse de baja vive AQUÍ y no en la portada: es donde está
         # lo tuyo, y así «lo que hace falta» habla sólo de lo que falta. #}
        {% if my_signups is not empty %}
            <section class="vol-group">
                <div class="vol-group__head">
                    <h4 class="vol-group__title">A lo que te has apuntado</h4>
                    <span class="vol-group__n">{{ my_signups|length }}</span>
                </div>

                <div class="vol-tasks">
                    {% for signup in my_signups %}
                        {% include '_components/volunteering_task_card.html.twig' with {
                            shift: signup.shift,
                            mine: true,
                            companions: signup.companions,
                            my_node_id: null,
                            my_category_ids: [],
                            csrf: csrf_token('panel_volunteering')
                        } only %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {# ---- Horas de coordinar un área ----
         # Sólo para quien coordina alguna. Coordinar no es una tarea que cerrar:
         # no ocurre un día concreto, no tiene plazas y nadie se apunta. Es
         # buscar gente, cuadrarla, avisar y estar pendiente, repartido por la
         # semana — y hasta ahora no había forma de que esas horas contaran.
         #
         # Las apunta quien las hace, como quien va a una tarea dice si fue:
         # nadie más sabe ese número. #}
        {% if coordinated is not empty %}
            {% embed '_components/csa_card.html.twig' with {
                title: coordinated|length == 1 ? 'Horas de coordinar ' ~ coordinated|first.name : 'Horas de coordinación',
                icon: 'fa-star-o'
            } %}
                {% block body %}
                    {% import '_macros/volunteering.html.twig' as vol %}

                    <p class="vol-help">
                        Apunta el tiempo que le dedicas a llevar
                        {{ coordinated|length == 1 ? 'el área' : 'las áreas' }}: cuadrar turnos,
                        buscar gente, avisar. No hace falta que sea exacto ni que lo apuntes cada
                        día — cuenta igual que las horas de las tareas.
                    </p>

                    <form method="post" action="{{ path('panel_volunteering_log_coordination') }}"
                          class="vol-repeat" data-csa-validate>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('panel_volunteering') }}">

                        {# Con una sola área no hay nada que elegir: se manda oculta. #}
                        {% if coordinated|length == 1 %}
                            <input type="hidden" name="category" value="{{ coordinated|first.id }}">
                        {% else %}
                            <label>
                                Área
                                <select name="category" class="csa-select" required>
                                    {% for category in coordinated %}
                                        <option value="{{ category.id }}">{{ category.name }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                        {% endif %}

                        <label>
                            Horas
                            <input type="number" name="hours" min="0.25" max="24" step="any" required
                                   class="csa-input csa-input--compact">
                        </label>

                        <label>
                            Cuándo
                            <input type="date" name="happened_on" class="csa-input"
                                   value="{{ 'now'|date('Y-m-d') }}" max="{{ 'now'|date('Y-m-d') }}">
                        </label>

                        <label>
                            En qué
                            <input type="text" name="notes" class="csa-input" maxlength="255"
                                   placeholder="opcional: «cuadrar los turnos de septiembre»">
                        </label>

                        <button type="submit" class="csa-btn csa-btn--primary csa-btn--sm">Apuntar</button>
                    </form>

                    {% if coordination_log is not empty %}
                        <hr class="vol-sep">
                        <p class="vol-help">Lo que llevas apuntado este año:</p>
                        <ul class="vol-mine">
                            {% for entry in coordination_log %}
                                <li>
                                    {{ vol.duration(entry.minutes) }} · {{ entry.category.name }}
                                    <span class="vol-mine__when">
                                        {{ entry.happenedOn|format_date('long', locale='es') }}
                                        {%- if entry.notes %} · {{ entry.notes }}{% endif -%}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endblock %}
            {% endembed %}
        {% endif %}
        {# ============ 4. LO QUE LLEVAS HECHO — al final y sin dramatismo ============ #}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Tu aportación este año',
            icon: 'fa-heart-o'
        } %}
            {% block body %}
                {% import '_macros/volunteering.html.twig' as vol %}
                <p class="vol-total">
                    {% if my_minutes > 0 %}
                        Llevas <strong>{{ vol.duration(my_minutes) }}</strong> de voluntariado este año.
                    {% else %}
                        Este año todavía no has echado una mano.
                    {% endif %}
                </p>

                {# Qué hiciste, no sólo cuánto. Un número suelto no significa
                 # nada; la lista de lo que hay detrás sí, y además deja ver de
                 # un vistazo si falta algo por confirmar. #}
                {% if my_done is not empty %}
                    <ul class="vol-mine">
                        {% for signup in my_done %}
                            <li>
                                <strong>{{ signup.offer.title }}</strong>
                                {% if signup.coordination %}
                                    {# Organizar también es trabajo, y quien lo
                                     # hace merece verlo nombrado. #}
                                    <span class="csa-badge">lo organizaste</span>
                                {% endif %}
                                <span class="vol-mine__when">
                                    {{ signup.startsAt|format_date('long', locale='es') }}
                                    {%- if signup.creditedMinutes %} · {{ vol.duration(signup.creditedMinutes) }}{% endif -%}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {#
                 # La referencia se enseña SÓLO a quien va por debajo, y es la
                 # MEDIANA de quienes participan, no la media.
                 #
                 # La media está contaminada por los ceros: con mucha gente que no
                 # hace nada, se hunde, y quien fue una tarde suelta sale "por
                 # encima de la media" cuando hace falta bastante más. Y enseñársela
                 # a quien va sobrado es peor todavía: aprende que hace el doble de
                 # lo normal y se relaja hasta la media. Es el efecto bumerán que
                 # documentaron Schultz y Cialdini con el consumo eléctrico, donde
                 # los hogares que menos gastaban SUBIERON al ver la media del
                 # barrio. A esa gente, aquí, no se le enseña nada.
                 #}
                {% if show_median %}
                    <p class="vol-help">
                        Quien echa una mano suele dedicar unas
                        <strong>{{ vol.duration(median_minutes) }}</strong> al año.
                    </p>
                {% elseif my_minutes > 0 %}
                    <p class="vol-help">Gracias — la asociación se sostiene con esto.</p>
                {% endif %}

                <p class="vol-help vol-help--muted">
                    Sólo lo ves tú.
                </p>
            {% endblock %}
        {% endembed %}


    </div>
{% endblock %}
