{# Inputs de cantidad por producto del pedido. Espera: round, quantities (map).
 #
 # Mismo criterio que el formulario del socix: el salto lo dice el PRODUCTO —una
 # garrafa o una caja no se parten; el queso se pide de medio en medio—. Con
 # step="0.01" para todos se acababa apuntando «0,03 garrafas de 5 L».
 #
 # La unidad va SOLO en la etiqueta, junto al precio, que es donde se entiende;
 # repetirla detrás del campo la decía dos veces en la misma línea. #}
<div class="cgo-lines">
    {% for item in round.items %}
        <div class="cgo-line">
            <label class="cgo-line__label" for="cgo-q-{{ item.id }}">
                {{ item.name }} <span class="csa-muted">· {{ item.price|number_format(2, ',', '.') }} € / {{ item.unit }}</span>
            </label>
            {% set medios = item.product and item.product.halfUnits %}
            <input type="number" min="0"
                   step="{{ medios ? '0.5' : '1' }}"
                   inputmode="{{ medios ? 'decimal' : 'numeric' }}" id="cgo-q-{{ item.id }}"
                   name="quantity[{{ item.id }}]"
                   value="{{ quantities[item.id] is defined ? quantities[item.id] + 0 : '' }}"
                   class="csa-input cgo-line__qty" placeholder="0">
            <span class="cgo-line__sub">
                {%- set pedido = quantities[item.id]|default(0) -%}
                {%- if pedido > 0 %}{{ (pedido * item.price)|number_format(2, ',', '.') }} €{% endif -%}
            </span>
        </div>
    {% endfor %}
</div>

<style>
    .cgo-lines { display: flex; flex-direction: column; gap: var(--csa-sp-3); }
    .cgo-line { display: flex; align-items: center; gap: var(--csa-sp-3); }
    .cgo-line__label { flex: 1; }
    .cgo-line__qty { flex: 0 0 6rem; }
    .cgo-line__sub { flex: 0 0 5.5rem; text-align: right; font-weight: 600; }
</style>
