{# Ficha de una obligación: qué es, cuándo caduca y el historial de renovaciones. #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% set days = obligation.daysLeft() %}
{% set state = obligation.state(notice_days) %}

{% block title %}{{ obligation.name }} · Vencimientos{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('obligation_index') }}">Vencimientos</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ obligation.name }}</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    <style>
        /* El titular de la ficha ES la fecha: lo primero que se quiere saber al
           abrirla es si hay que correr o no. */
        .obl-head { display: flex; flex-wrap: wrap; gap: 18px; align-items: baseline;
                    padding: 18px 20px; border-radius: 10px; margin-bottom: 18px;
                    background: var(--csa-surface-2, #f7f7f5); border-left: 4px solid #9ca3af; }
        .obl-head--due { border-left-color: #b54708; background: #fffaf0; }
        .obl-head--expired { border-left-color: #b42318; background: #fff5f4; }
        .obl-head--valid { border-left-color: #2e7d4f; }
        .obl-head__days { font-size: 26px; font-weight: 700; line-height: 1.1; }
        .obl-head__date { color: var(--csa-text-muted, #6b7280); }
        /* auto-FILL y no auto-fit: con auto-fit, dos datos se estiran hasta
           ocupar media pantalla cada uno y la ficha parece descuadrada. Con
           auto-fill las columnas conservan su ancho y los datos quedan
           alineados entre sí, haya dos o haya seis. */
        .obl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px 26px; margin-bottom: 22px; }
        .obl-field__label { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--csa-text-muted, #6b7280); }
        .obl-field__value { font-weight: 600; }
        .obl-notes { white-space: pre-wrap; background: var(--csa-surface-2, #f7f7f5); padding: 14px 16px; border-radius: 8px; margin-bottom: 22px; }
        .obl-section-title { font-size: 15px; font-weight: 700; margin: 26px 0 10px; }
        .obl-renew { background: var(--csa-surface-2, #f7f7f5); padding: 18px 20px; border-radius: 10px; }
        .obl-missing { color: var(--csa-text-muted, #6b7280); font-weight: 400; }
        .obl-actions-bar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; }
        /* Acción secundaria dentro de un dato: un botón con aspecto de botón
           pesaría más que el propio dato. */
        .obl-linkish { background: none; border: 0; padding: 0 0 0 10px; font: inherit;
                       font-weight: 400; color: var(--csa-text-muted, #6b7280);
                       text-decoration: underline; cursor: pointer; }
        .obl-linkish:hover { color: #b42318; }
        /* Subida por fila del historial. Va dentro de un <details> para que la
           tabla no se llene de campos de fichero abiertos: se despliega sólo
           la fila en la que se está trabajando, y sin una línea de JavaScript. */
        .obl-upload { display: inline-block; margin-left: 10px; font-weight: 400; }
        .obl-upload > summary { cursor: pointer; color: var(--csa-text-muted, #6b7280); font-size: 13px; }
        .obl-upload > form { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 8px; }
        .obl-upload input[type="file"] { max-width: 230px; font-size: 12px; }
    </style>
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(obligation.kindLabel, obligation.name, obligation.counterparty ? 'Con ' ~ obligation.counterparty : null) }}

    {% if obligation.archived %}
        {{ csa.callout('Esta ficha está archivada: no se vigila y no genera avisos.', 'info') }}
    {% endif %}

    {# ============ EL TITULAR: LA FECHA ============ #}
    <div class="obl-head obl-head--{{ state }}">
        <div>
            <div class="obl-head__days">
                {%- if days is null -%}
                    Sin fecha anotada
                {%- elseif days < 0 -%}
                    Caducó hace {{ days|abs }} día{{ days == -1 ? '' : 's' }}
                {%- elseif days == 0 -%}
                    Caduca hoy
                {%- elseif days == 1 -%}
                    Caduca mañana
                {%- else -%}
                    Quedan {{ days }} días
                {%- endif -%}
            </div>
            {% if obligation.expiresOn %}
                <div class="obl-head__date">
                    {{ days < 0 ? 'La fecha era el' : 'Vigente hasta el' }} {{ obligation.expiresOn|date('d/m/Y') }}
                </div>
            {% else %}
                <div class="obl-head__date">Sin ningún periodo anotado, esta ficha no vigila nada.</div>
            {% endif %}
        </div>
    </div>

    {# ============ DATOS ============ #}
    <div class="obl-grid">
        <div class="obl-field">
            <div class="obl-field__label">Quién se ocupa</div>
            <div class="obl-field__value">{{ obligation.responsible ? obligation.responsible.displayName|lower : '— sin asignar —' }}</div>
        </div>
        {% if obligation.reference %}
            <div class="obl-field">
                <div class="obl-field__label">Póliza o expediente</div>
                <div class="obl-field__value">{{ obligation.reference }}</div>
            </div>
        {% endif %}
        {% if obligation.leadDays %}
            <div class="obl-field">
                <div class="obl-field__label">Hay que avisar antes del</div>
                <div class="obl-field__value">
                    {{ obligation.expiresOn|date_modify('-' ~ obligation.leadDays ~ ' days')|date('d/m/Y') }}
                    <small>({{ obligation.leadDays }} días antes)</small>
                </div>
            </div>
        {% endif %}
        {# El documento se pinta SIEMPRE, esté subido o no. Ocultarlo cuando
         # falta deja la ficha diciendo que no existe tal cosa, cuando lo que
         # pasa es que nadie lo ha subido todavía — y eso es justo lo que hay
         # que ver para arreglarlo. #}
        <div class="obl-field">
            <div class="obl-field__label">Documento</div>
            <div class="obl-field__value">
                {% if obligation.documentFile %}
                    <a href="{{ path('obligation_document', { id: obligation.id }) }}" target="_blank" rel="noopener">Abrir <i class="fa fa-file-text-o"></i></a>
                    {% if is_granted('ROLE_GESTION_VENCIMIENTOS_EDIT') %}
                        <button type="button" class="obl-linkish" onclick="document.getElementById('dlg-obl-doc').showModal()">Quitar</button>
                        {{ csa.confirm_dialog('dlg-obl-doc', {
                            variant: 'danger',
                            eyebrow: 'Acción permanente',
                            title: 'Quitar el documento de «' ~ obligation.name ~ '»',
                            body: 'Se borra del archivo de la web y no se puede recuperar desde aquí. Los documentos de cada periodo del historial no se tocan.',
                            confirm_label: 'Quitar',
                            action: path('obligation_document_delete', { id: obligation.id }),
                            csrf_token: csrf_token('obligation_document_delete' ~ obligation.id),
                            csrf_name: '_token',
                        }) }}
                    {% endif %}
                {% else %}
                    <span class="obl-missing">— sin subir —</span>
                {% endif %}
            </div>
        </div>
    </div>

    {% if obligation.notes %}
        <div class="obl-notes">{{ obligation.notes }}</div>
    {% endif %}

    {% if is_granted('ROLE_GESTION_VENCIMIENTOS_EDIT') %}
        <div class="obl-actions-bar">
            <a href="{{ path('obligation_edit', { id: obligation.id }) }}" class="prl-btn"><i class="fa fa-pencil"></i> Editar datos</a>
            <button type="button" class="prl-btn" onclick="document.getElementById('dlg-obl-archive').showModal()">
                <i class="fa fa-archive"></i> {{ obligation.archived ? 'Volver a vigilar' : 'Archivar' }}
            </button>
            {{ csa.confirm_dialog('dlg-obl-archive', {
                variant: obligation.archived ? 'info' : 'warning',
                eyebrow: obligation.archived ? 'Volver a vigilar' : 'Dejar de vigilar',
                title: obligation.archived ? 'Devolver «' ~ obligation.name ~ '» a la vigilancia' : 'Archivar «' ~ obligation.name ~ '»',
                body: obligation.archived
                    ? 'Volverá a aparecer en el listado y a avisar cuando se acerque su fecha.'
                    : 'Deja de aparecer en el listado y deja de avisar. No se borra nada: el historial se conserva.',
                confirm_label: obligation.archived ? 'Volver a vigilar' : 'Archivar',
                action: path('obligation_archive', { id: obligation.id }),
                csrf_token: csrf_token('obligation_archive' ~ obligation.id),
                csrf_name: '_token',
            }) }}
        </div>
    {% endif %}

    {# ============ ANOTAR RENOVACIÓN ============ #}
    {% if is_granted('ROLE_GESTION_VENCIMIENTOS_EDIT') and not obligation.archived %}
        <div class="obl-section-title">Anotar una renovación</div>
        <div class="obl-renew">
            <p class="obl-head__date" style="margin-bottom:12px">
                Cuando se renueve, anota aquí la fecha nueva. Con eso vuelve a vigilarse sola: no hay que tocar nada más.
            </p>
            {# Mismo lenguaje de formulario que el resto de la aplicación
             # (csa-form-grid + csa.field). Con `form_row` crudo sobre un grid
             # propio, cada etiqueta y cada campo caen en celdas distintas y la
             # rejilla se descuadra entera. #}
            {{ form_start(renewal_form, { attr: { 'data-csa-dropdowns': '' } }) }}
                <div class="csa-form-grid">
                    {{ csa.field(renewal_form.startsOn, 'Vigente desde') }}
                    {{ csa.field(renewal_form.endsOn, 'Caduca el') }}
                    {{ csa.field(renewal_form.document, 'Documento firmado', { full: true, hint: 'Si aún no lo tienes escaneado, se puede subir luego desde el historial' }) }}
                    {{ csa.field(renewal_form.notes, 'Apunte', { full: true }) }}
                </div>
                <div class="csa-row" style="justify-content: flex-end; margin-top: var(--csa-sp-4);">
                    <button type="submit" class="csa-btn csa-btn--primary">Anotar la renovación</button>
                </div>
            {{ form_end(renewal_form) }}
        </div>
    {% endif %}

    {# ============ HISTORIAL ============ #}
    <div class="obl-section-title">Historial</div>
    <div class="prl-table-wrap">
        {% if obligation.terms is empty %}
            <div class="prl-empty">Todavía no hay ningún periodo anotado.</div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th class="tight">Desde</th>
                        <th class="tight">Hasta</th>
                        <th class="tight">Documento</th>
                        <th>Apunte</th>
                        <th class="actions"><span class="sr-only">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for term in obligation.terms|sort((a, b) => b.endsOn <=> a.endsOn) %}
                        <tr>
                            <td class="tight">{{ term.startsOn ? term.startsOn|date('d/m/Y') : '—' }}</td>
                            <td class="tight">
                                <b>{{ term.endsOn|date('d/m/Y') }}</b>
                                {% if obligation.expiresOn and term.endsOn == obligation.expiresOn %}
                                    <span class="prl-chip prl-chip--activo"><span class="dot"></span>Vigente</span>
                                {% endif %}
                            </td>
                            <td class="tight">
                                {% if term.documentFile %}
                                    <a href="{{ path('obligation_term_document', { id: obligation.id, termId: term.id }) }}" target="_blank" rel="noopener">Abrir <i class="fa fa-file-text-o"></i></a>
                                {% else %}
                                    <span class="obl-missing">—</span>
                                {% endif %}
                                {# El papel casi nunca está a mano el día que se anota la fecha:
                                 # se anota lo que se sabe y el escaneado llega después. Sin esto,
                                 # archivarlo obligaría a borrar el periodo y rehacerlo. #}
                                {% if is_granted('ROLE_GESTION_VENCIMIENTOS_EDIT') %}
                                    <details class="obl-upload">
                                        <summary>{{ term.documentFile ? 'Sustituir' : 'Subir' }}</summary>
                                        <form method="post" enctype="multipart/form-data" action="{{ path('obligation_term_document_upload', { id: obligation.id, termId: term.id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('obligation_term_document' ~ term.id) }}">
                                            {# accept sale de la misma lista que valida el servidor. #}
                                            <input type="file" name="document" required
                                                   accept="{{ constant('App\\Service\\Obligation\\ObligationDocumentStore::MIME_TYPES')|join(',') }}">
                                            <button type="submit" class="prl-btn prl-btn--sm">Guardar</button>
                                        </form>
                                    </details>
                                {% endif %}
                            </td>
                            <td>{{ term.notes ?: '' }}</td>
                            <td class="actions">
                                {% if is_granted('ROLE_GESTION_VENCIMIENTOS_EDIT') %}
                                    <button type="button" class="prl-btn prl-btn--danger prl-btn--sm" title="Borrar periodo" aria-label="Borrar periodo"
                                            onclick="document.getElementById('dlg-obl-term-{{ term.id }}').showModal()"><i class="fa fa-trash"></i></button>
                                    {{ csa.confirm_dialog('dlg-obl-term-' ~ term.id, {
                                        variant: 'danger',
                                        eyebrow: 'Acción permanente',
                                        title: 'Borrar el periodo que acaba el ' ~ term.endsOn|date('d/m/Y'),
                                        body: 'Esto es para corregir una fecha mal tecleada, no para deshacer una renovación. Si era el último periodo, la ficha se queda sin fecha y deja de avisar.',
                                        confirm_label: 'Borrar',
                                        action: path('obligation_term_delete', { id: obligation.id, termId: term.id }),
                                        csrf_token: csrf_token('obligation_term_delete' ~ term.id),
                                        csrf_name: '_token',
                                    }) }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

</div>
{% endblock %}
