{# ============================================================
 # Form compartido de obligación (new + edit).
 # Espera: form, submit_label, cancel_path.
 # La sección 2 (fechas) sólo existe en el ALTA: después, las fechas se
 # anotan como renovación desde la ficha, que es lo que conserva el
 # historial y reprograma el aviso.
 # ============================================================ #}
{% form_theme form 'form_div_layout.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{{ form_start(form, { attr: { role: 'form', class: 'csa-form-narrow', 'data-csa-dropdowns': '' } }) }}

    <div class="csa-stack-lg">

        {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Qué es', subtitle: 'Lo que hay que mantener vigente y con quién.' } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                <div class="csa-form-grid">
                    {{ csa.field(form.name, 'Qué es', { full: true }) }}
                    {{ csa.field(form.kind, 'Tipo') }}
                    {{ csa.field(form.counterparty, 'Con quién') }}
                    {{ csa.field(form.reference, 'Número de póliza o expediente') }}
                    {{ csa.field(form.responsible, 'Quién se ocupa') }}
                    {{ csa.field(form.leadDays, 'Hay que avisar con antelación de') }}
                    {{ csa.field(form.documentUrl, 'Dónde está el documento', { full: true }) }}
                    {{ csa.field(form.notes, 'Qué hay que saber para renovarlo', { full: true, widget_class: 'csa-textarea' }) }}
                </div>
            {% endblock %}
        {% endembed %}

        {% if form.firstEndsOn is defined %}
            {% embed '_components/csa_form_section.html.twig' with { num: '2', title: 'Desde cuándo y hasta cuándo', subtitle: 'La fecha de caducidad es lo que se vigila. Las renovaciones se anotan luego desde la ficha.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.firstStartsOn, 'Vigente desde') }}
                        {{ csa.field(form.firstEndsOn, 'Caduca el') }}
                    </div>
                {% endblock %}
            {% endembed %}
        {% endif %}

        <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
            <div></div>
            <div class="csa-row">
                {{ csa.btn('Cancelar', { variant: 'ghost', href: cancel_path }) }}
                <button type="submit" class="csa-btn csa-btn--primary">{{ submit_label }}</button>
            </div>
        </div>

    </div>

    {{ form_rest(form) }}
{{ form_end(form, { render_rest: false }) }}
