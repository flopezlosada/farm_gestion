{# ============================================================
 # Ficha de encuesta en SOLO LECTURA — shell csa.
 # Muestra la estructura (preguntas, tipo y opciones) de una
 # encuesta en cualquier estado. Es la única forma de ver una
 # encuesta ya abierta o cerrada (esas no se editan).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% set status_meta = {
    'draft':  { label: 'Borrador', tone: 'warning' },
    'open':   { label: 'Abierta',  tone: 'success' },
    'closed': { label: 'Cerrada',  tone: 'neutral' }
} %}

{% set type_meta = {
    'single':   'Opción única',
    'multiple': 'Opción múltiple',
    'scale':    'Escala 1–5',
    'text':     'Texto libre'
} %}

{% set meta = status_meta[survey.status] %}

{% block title %}{{ survey.title }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('survey_index') }}">Encuestas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ survey.title }}</span>
{% endblock %}

{% block csa_main %}

    {{ csa.page_header('Encuesta', survey.title, survey.description) }}

    <div class="csa-row" style="gap: var(--csa-sp-3); margin-bottom: var(--csa-sp-4); align-items: center;">
        {{ csa.badge(meta.label, meta.tone) }}
        <span class="csa-muted">{{ survey.questions|length }} pregunta(s) · {{ participants }} respuesta(s)</span>
        {% if survey.closesAt %}
            <span class="csa-muted">· Último día para responder: {{ survey.closesAt|date('d/m/Y') }}</span>
        {% endif %}
        {% if survey.open %}
            <span class="csa-muted">· {{ survey.announcedAt ? 'Avisada el ' ~ survey.announcedAt|date('d/m/Y') : 'Sin aviso enviado' }}</span>
        {% endif %}
    </div>

    {# Lo que se hace con la encuesta, arriba y a la vista. La vista previa es la
     # página real de la socia (en otra pestaña): la estructura de abajo es sólo
     # un resumen y no intenta parecerse. #}
    <div class="sv-actions-bar">
        {{ csa.btn('Vista previa', { variant: 'secondary', href: path('survey_preview', { id: survey.id }), icon: 'fa-eye', attr: { target: '_blank', rel: 'noopener' } }) }}
        {% if survey.editable and is_granted('ROLE_GESTION_ENCUESTAS_EDIT') %}
            {{ csa.btn('Editar', { variant: 'secondary', href: path('survey_edit', { id: survey.id }), icon: 'fa-pencil' }) }}
        {% endif %}
        {% if can_open %}
            <button type="button" class="csa-btn csa-btn--primary" onclick="document.getElementById('dlg-open-{{ survey.id }}').showModal()">
                <i class="fa fa-play" aria-hidden="true"></i> Abrir y avisar
            </button>
            {{ include('survey/_open_dialog.html.twig', { survey: survey, audience: audience }) }}
        {% endif %}
        {% if can_announce %}
            <button type="button" class="csa-btn csa-btn--primary" onclick="document.getElementById('dlg-announce-{{ survey.id }}').showModal()">
                <i class="fa fa-bullhorn" aria-hidden="true"></i> Avisar a todas
            </button>
            {{ include('survey/_announce_dialog.html.twig', { survey: survey }) }}
        {% endif %}
        {% if survey.status != 'draft' %}
            {{ csa.btn('Ver resultados', { variant: 'secondary', href: path('survey_results', { id: survey.id }), icon: 'fa-bar-chart' }) }}
        {% endif %}
        {{ csa.help('encuestas', 'abrir', 'Ayuda: abrir la encuesta y avisar') }}
    </div>

    {# Reenviar a UNA socia su correo con el enlace personal: la respuesta a
     # «no me llegó». El aviso a toda la asociación no se repite nunca. Sólo
     # nombres en el desplegable: este rol no ve fichas ni correos. #}
    {% if resend_partners is not empty %}
        <form id="reenviar-enlace" method="post" action="{{ path('survey_resend', { id: survey.id }) }}" class="csa-card sv-resend">
            <div class="sv-resend__text">
                <strong>¿A alguien no le llegó el correo? {{ csa.help('encuestas', 'reenviar', 'Ayuda: reenviar el enlace a una socia') }}</strong>
                <span class="csa-muted">Le reenviamos a ella sola su enlace para responder. No se le avisa a nadie más.</span>
            </div>
            <div class="sv-resend__row">
                <label class="sr-only" for="sv-resend-partner">Socia</label>
                <select id="sv-resend-partner" name="partner" class="csa-input" required>
                    <option value="">Elige una socia…</option>
                    {% for partner in resend_partners %}
                        <option value="{{ partner.id }}">{{ (partner.name ~ ' ' ~ partner.surname)|lower|title }}</option>
                    {% endfor %}
                </select>
                <input type="hidden" name="_token" value="{{ csrf_token('survey_resend_' ~ survey.id) }}">
                <button type="submit" class="csa-btn csa-btn--secondary"><i class="fa fa-paper-plane-o" aria-hidden="true"></i> Reenviar su enlace</button>
            </div>
        </form>
    {% endif %}

    <div class="csa-card" style="padding: 0; overflow: hidden;">
        {% for question in survey.questions %}
            <div style="padding: var(--csa-sp-4); {% if not loop.first %}border-top: 1px solid var(--csa-rule);{% endif %}">
                <div class="csa-row" style="gap: var(--csa-sp-2); align-items: baseline;">
                    <strong>{{ loop.index }}. {{ question.text }}</strong>
                    {{ csa.badge(type_meta[question.type]|default(question.type), 'neutral') }}
                    {% if not question.required %}
                        <span class="csa-muted">(opcional)</span>
                    {% endif %}
                </div>

                {# Resumen en texto, sin imitar el formulario: para ver cómo
                 # queda de verdad está la «Vista previa». #}
                {% if question.usesOptions %}
                    <ul class="sv-summary">
                        {% for option in question.options %}
                            <li>{{ option.label }}</li>
                        {% else %}
                            <li class="sv-summary__warn">Sin opciones: hay que añadir al menos dos antes de abrirla.</li>
                        {% endfor %}
                    </ul>
                {% elseif question.type == 'scale' %}
                    <p class="sv-summary__note">De 1 (Nada) a 5 (Mucho).</p>
                {% else %}
                    <p class="sv-summary__note">Cada socia escribe lo que quiera.</p>
                {% endif %}
            </div>
        {% else %}
            <div style="padding: var(--csa-sp-4);">
                {{ csa.callout('Esta encuesta todavía no tiene preguntas.', 'warning') }}
            </div>
        {% endfor %}
    </div>

    <div class="csa-row" style="gap: var(--csa-sp-2); margin-top: var(--csa-sp-4);">
        {{ csa.btn('Volver al listado', { variant: 'secondary', href: path('survey_index'), icon: 'fa-arrow-left' }) }}
    </div>

{% endblock %}

{% block more_css %}
    {{ parent() }}
    <style>
        .sv-resend { padding: var(--csa-sp-4); margin-bottom: var(--csa-sp-4); display: flex; flex-direction: column; gap: var(--csa-sp-3); }
        .sv-resend__text { display: flex; flex-direction: column; gap: 2px; }
        .sv-resend__row { display: flex; gap: var(--csa-sp-2); flex-wrap: wrap; align-items: center; }
        .sv-resend__row select { flex: 1 1 260px; max-width: 420px; }
        .sv-actions-bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--csa-sp-2); margin-bottom: var(--csa-sp-5); }
        .sv-summary { margin: var(--csa-sp-2) 0 0; padding-left: 1.2em; color: var(--csa-ink-soft); }
        .sv-summary li { margin: 2px 0; }
        .sv-summary__warn { color: #a8471f; list-style: none; margin-left: -1.2em; }
        .sv-summary__note { margin: var(--csa-sp-2) 0 0; color: var(--csa-ink-soft); }
    </style>
{% endblock %}
