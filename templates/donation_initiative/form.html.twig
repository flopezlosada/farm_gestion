{# ============================================================
 # Alta o cambio de una iniciativa.
 #
 # El controller pasa: form, initiative.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% form_theme form 'form_div_layout.html.twig' %}

{% set is_new = initiative.id is null %}

{% block title %}{{ is_new ? 'Nueva iniciativa' : initiative.name }} · Iniciativas{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('partner_index') }}">Socios</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('donation_initiative_index') }}">Iniciativas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ is_new ? 'Nueva' : 'Cambiar' }}</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Socios · Iniciativas', is_new ? 'Nueva iniciativa' : initiative.name, 'A dónde va lo que unx socix paga de más cuando lo destina a algo concreto.') }}

    {{ form_start(form, { attr: { class: 'csa-form-narrow' } }) }}

        {{ form_errors(form) }}

        <div class="csa-stack-lg">

            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'La iniciativa', subtitle: 'El nombre es lo que se elige en la ficha de cada socix.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.name, 'Nombre', { full: true, hint: 'por ejemplo, «Cestas para la RSP»' }) }}
                        {{ csa.field(form.description, 'Para qué es', { full: true, hint: 'opcional' }) }}
                        {{ csa.field(form.open, 'Abierta: se puede elegir al ajustar una cuota', { full: true, hint: 'al cerrarla, quien ya aporta sigue aportando hasta que se le ponga fin' }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: is_new ? path('donation_initiative_index') : path('donation_initiative_show', { id: initiative.id }) }) }}
                    <button type="submit" class="csa-btn csa-btn--primary">Guardar</button>
                </div>
            </div>

        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}
{% endblock %}
