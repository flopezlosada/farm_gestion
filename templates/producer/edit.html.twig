{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Editar productor · Grupo de consumo{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('consumer_group_index') }}">Grupo de consumo</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('consumer_group_producer_index') }}">Productores</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('consumer_group_producer_show', { id: producer.id }) }}">{{ producer.name }}</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Editar</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Grupo de consumo', 'Editar productor', producer.name) }}
    {% include 'producer/_form.html.twig' with { submit_label: 'Guardar cambios' } %}
{% endblock %}
