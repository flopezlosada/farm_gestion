{# ============================================================
 # Form de productor (solo sus datos). El catálogo de productos se
 # gestiona aparte, en la ficha del productor.
 # ============================================================ #}
{% import '_macros/csa.html.twig' as csa %}
{% form_theme form 'form_div_layout.html.twig' %}

{{ form_start(form, { attr: { class: 'csa-form-narrow', 'data-csa-dropdowns': '1' } }) }}

    <div class="csa-stack-lg">

        {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Productor', subtitle: 'Datos de contacto y modo de gestión.' } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                <div class="csa-form-grid">
                    {{ csa.field(form.name, 'Nombre del productor', { full: true }) }}
                    {{ csa.field(form.contactName, 'Persona de contacto') }}
                    {{ csa.field(form.email, 'Email') }}
                    {{ csa.field(form.phone, 'Teléfono') }}
                    {{ csa.field(form.web, 'Web') }}
                    {{ csa.field(form.minimumNote, 'Pedido mínimo (por defecto)', { full: true }) }}
                    {{ csa.field(form.notes, 'Notas internas', { full: true }) }}
                </div>
                <div class="csa-form-grid" style="margin-top: var(--csa-sp-4);">
                    <label class="cg-flag" style="display:inline-flex; align-items:center; gap: var(--csa-sp-2);">{{ form_widget(form.selfManaged) }} <span>Autogestiona sus pedidos</span></label>
                    <label class="cg-flag" style="display:inline-flex; align-items:center; gap: var(--csa-sp-2);">{{ form_widget(form.active) }} <span>Activo</span></label>
                </div>
                {% if create_hint|default(false) %}
                    <p class="csa-muted" style="margin-top: var(--csa-sp-3);">Tras crearlo podrás añadir sus productos al catálogo desde su ficha.</p>
                {% endif %}
            {% endblock %}
        {% endembed %}

        <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
            <div></div>
            <div class="csa-row">
                {{ csa.btn('Cancelar', { variant: 'ghost', href: path('consumer_group_producer_index') }) }}
                <button type="submit" class="csa-btn csa-btn--primary">{{ submit_label|default('Guardar') }}</button>
            </div>
        </div>

    </div>

    {{ form_rest(form) }}
{{ form_end(form, { render_rest: false }) }}
