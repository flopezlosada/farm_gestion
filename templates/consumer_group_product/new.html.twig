{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Nuevo producto · {{ producer.name }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('consumer_group_producer_index') }}">Productores</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('consumer_group_producer_show', { id: producer.id }) }}">{{ producer.name }}</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Nuevo producto</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Catálogo', 'Nuevo producto', producer.name) }}
    {% include 'consumer_group_product/_form.html.twig' with {
        submit_label: 'Añadir al catálogo',
        cancel_url: path('consumer_group_producer_show', { id: producer.id })
    } %}
{% endblock %}
