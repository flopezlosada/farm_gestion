{# ============================================================
 # Registro de avisos · Ejecuciones: el histórico completo de las tareas.
 #
 # /gestion/settings enseña la ÚLTIMA ejecución de cada tarea, que sirve para
 # "¿está viva?". Esto sirve para lo otro: "¿qué pasó el jueves pasado?".
 #
 # "Quién la lanzó" ya no gasta una columna: es la segunda línea de la fecha,
 # que es donde se lee sin buscarla —el reloj o una persona, a esa hora—.
 # ============================================================ #}

{% extends 'notification_log/_layout.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% set chip_by_status = {
    'done': 'ok',
    'nothing_to_do': 'neutral',
    'disabled': 'warn',
    'failed': 'danger'
} %}

{% set quien_lo_lanzo = {
    'manual': 'a mano',
    'tick': 'el reloj'
} %}

{% block log_toolbar %}

    {# Dentro del bloque: a nivel de plantilla, el código de la hija corre antes
     # que el de la madre y `qs` todavía no existiría. #}
    {% set qs_sin_estado = qs|filter((v, k) => k != 'status') %}

    {# Las tarjetas filtran el listado. La que importa es "fallaron": una fila
     # roja entre cincuenta verdes no se ve, y un número en rojo arriba sí. #}
    {% set marca_activa = 'box-shadow: inset 0 0 0 2px var(--prl-ink);' %}
    <div class="prl-stats">
        <a class="prl-stat prl-stat--active" style="text-decoration: none; {{ filters.status == 'done' ? marca_activa }}"
           href="{{ path('notification_log_runs', qs_sin_estado|merge(range)|merge({ status: 'done' })) }}">
            <div class="v">{{ summary.done }}</div>
            <div class="l">hicieron trabajo</div>
        </a>
        <a class="prl-stat" style="text-decoration: none; {{ filters.status == 'nothing_to_do' ? marca_activa }}"
           href="{{ path('notification_log_runs', qs_sin_estado|merge(range)|merge({ status: 'nothing_to_do' })) }}">
            <div class="v">{{ summary.nothing_to_do }}</div>
            <div class="l">sin nada que hacer</div>
        </a>
        <a class="prl-stat prl-stat--paused" style="text-decoration: none; {{ filters.status == 'disabled' ? marca_activa }}"
           href="{{ path('notification_log_runs', qs_sin_estado|merge(range)|merge({ status: 'disabled' })) }}">
            <div class="v">{{ summary.disabled }}</div>
            <div class="l">apagadas</div>
        </a>
        <a class="prl-stat prl-stat--leave" style="text-decoration: none; {{ filters.status == 'failed' ? marca_activa }}"
           href="{{ path('notification_log_runs', qs_sin_estado|merge(range)|merge({ status: 'failed' })) }}">
            <div class="v">{{ summary.failed }}</div>
            <div class="l">fallaron</div>
        </a>
        <a class="prl-stat" style="text-decoration: none; {{ filters.status is null ? marca_activa }}"
           href="{{ path('notification_log_runs', qs_sin_estado|merge(range)) }}">
            <div class="v">{{ summary.total }}</div>
            <div class="l">en total</div>
        </a>
    </div>

    <form method="get" action="{{ path('notification_log_runs') }}" id="prl-filter-form">
        {% if filters.status %}<input type="hidden" name="status" value="{{ filters.status }}">{% endif %}

        <div class="prl-toolbar">
            {% include 'notification_log/_period_filter.html.twig' %}

            <div class="prl-filt-wrap">
                <button type="button" class="prl-filt {{ filters.task ? 'has' : '' }}" data-pop-trigger="pop-tarea">
                    {{ filters.task ? tasks[filters.task]|default(filters.task) : 'Tarea' }}
                    <svg class="chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="prl-pop" id="pop-tarea" hidden>
                    <label><input type="radio" name="task" value="" {{ filters.task is null ? 'checked' : '' }}> Todas</label>
                    {% for key, label in tasks %}
                        <label><input type="radio" name="task" value="{{ key }}" {{ filters.task == key ? 'checked' : '' }}> {{ label }}</label>
                    {% endfor %}
                </div>
            </div>

            {% if filters.task or filters.status %}
                <a class="prl-filt prl-filt--clear" href="{{ path('notification_log_runs', range) }}">
                    <i class="fa fa-times" aria-hidden="true"></i> Quitar filtros
                </a>
            {% endif %}

            <div class="spacer"></div>
            <div class="counters"><b>{{ pagination.totalItemCount }}</b> ejecuciones</div>
        </div>
    </form>

{% endblock %}

{% block log_body %}

    <div class="prl-table-wrap">
        <table class="prl-table">
            <thead>
                <tr>
                    <th class="tight" style="width: 116px;">Cuándo</th>
                    <th style="width: 260px;">Tarea</th>
                    <th class="tight" style="width: 150px;">Resultado</th>
                    <th>Qué pasó</th>
                    <th class="tight" style="width: 88px;">Avisos</th>
                </tr>
            </thead>
            <tbody>
                {% for run in pagination %}
                    <tr>
                        <td class="tight">
                            <div class="prl-pickup__name">{{ run.startedAt|date('d/m/y') }}</div>
                            <div class="prl-person__meta">
                                {{ run.startedAt|date('H:i') }} · {{ quien_lo_lanzo[run.triggerSource]|default('programada') }}
                            </div>
                        </td>

                        <td>
                            <div class="prl-pickup__name">{{ tasks[run.taskKey]|default(run.taskKey) }}</div>
                            <span class="prl-person__meta" title="{{ run.command }}">{{ run.command }}</span>
                        </td>

                        <td class="tight">
                            <span class="prl-chip prl-chip--{{ chip_by_status[run.status]|default('neutral') }}">
                                <span class="dot"></span>{{ statuses[run.status]|default(run.status) }}
                            </span>
                        </td>

                        <td>{{ run.detail ?: '—' }}</td>

                        <td class="tight">
                            {# Cero avisos no es un fallo: la mayoría de ejecuciones son
                               "nada que hacer", y muchas tareas no mandan nada nunca. #}
                            {% set sent = sent_by_run[run.id]|default(0) %}
                            {% if sent > 0 %}
                                <a href="{{ path('notification_log_index', range|merge({ run: run.id })) }}">{{ sent }}</a>
                            {% else %}
                                <span class="prl-cell-muted">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="prl-empty">No hay ejecuciones registradas en este periodo.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="prl-pagination">{{ knp_pagination_render(pagination) }}</div>

{% endblock %}
