{# ============================================================
 # Base del registro de avisos: cabecera, pestañas y periodo.
 #
 # Las tres sub-pantallas extienden esta y rellenan `log_toolbar` (sus filtros)
 # y `log_body` (el contenido).
 #
 # El PERIODO es lo único que viaja de una pestaña a otra, y a propósito: el
 # canal o el tipo de aviso no significan nada en el listado de ejecuciones,
 # pero el rango de fechas que estás mirando sí, y perderlo al cambiar de
 # pestaña obliga a volver a escribirlo justo cuando estás siguiendo un rastro.
 #
 # Usa el lenguaje de listado compartido (`partner/_listing_styles`), el mismo
 # del listado de socixs y del resto de listados.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% set current = app.request.attributes.get('_route') %}
{% set range = { from: filters.from|date('Y-m-d'), to: filters.to|date('Y-m-d') } %}

{# Los filtros que NO son el periodo, listos para colgar de un enlace. Cambiar
 # de fechas no debe tirar por la borda el canal o la búsqueda que ya tenías
 # puestos: en un diagnóstico se fija a quién buscas y se mueve el tiempo. #}
{% set qs = {
    channel: filters.channel,
    kind: filters.kind,
    status: filters.status,
    task: filters.task,
    q: filters.q,
    run: filters.run
}|filter(v => v is not null and v != '') %}

{# Cómo se llama el periodo que estás viendo. Si coincide con un atajo, su
 # nombre; si no, las dos fechas. El botón tiene que decir qué estás mirando
 # sin abrirlo. #}
{% set preset_actual = presets|filter(p => p.from == range.from and p.to == range.to)|first %}
{% set periodo_label = preset_actual ? preset_actual.label : range.from|date('d/m/y') ~ ' – ' ~ range.to|date('d/m/y') %}

{% block title %}Registro de avisos{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Registro de avisos</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
{% endblock %}

{% block more_js %}
    {{ parent() }}
    {% include '_components/listing_filters_js.html.twig' %}
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Administración',
        'Registro de avisos',
        'Qué ha enviado el sistema, a quién y con qué resultado. Se guarda todo, salga bien o mal.'
    ) }}

    {% set tabs = {
        'notification_log_index':    'Envíos',
        'notification_log_runs':     'Ejecuciones',
        'notification_log_coverage': 'Cobertura'
    } %}
    <nav class="prl-tabs" role="tablist">
        {% for route, label in tabs %}
            <a href="{{ path(route, range) }}" class="{{ current == route ? 'active' : '' }}">{{ label }}</a>
        {% endfor %}
    </nav>

    {% block log_toolbar %}{% endblock %}

    {% block log_body %}{% endblock %}

</div>
{% endblock %}
