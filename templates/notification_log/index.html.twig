{# ============================================================
 # Registro de avisos · Envíos: una fila por aviso intentado.
 #
 # La tabla NO usa `data-paginate` (la paginación del navegador sobre la tabla
 # ya pintada): aquí pagina el servidor, porque el registro crece sin techo y
 # traerse un año entero para enseñar cincuenta filas se cae solo.
 #
 # Siete columnas se quedaron en cinco. Canal y destinatarix son la misma
 # pregunta ("¿a quién, y por dónde?") y ahora el canal es el icono de la
 # persona; tipo y asunto también ("¿qué se le mandó?") y van una encima de otra.
 # ============================================================ #}

{% extends 'notification_log/_layout.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% set chip_by_status = {
    'sent': 'ok',
    'failed': 'danger',
    'discarded': 'warn'
} %}

{% block log_toolbar %}

    {# Los filtros SIN el estado: los usan las tarjetas de abajo, que son el
     # mando para pasar de "entregados" a "fallidos" conservando todo lo demás.
     # Va DENTRO del bloque a propósito: a nivel de plantilla, el código de la
     # hija corre antes que el de la madre y `qs` todavía no existiría. #}
    {% set qs_sin_estado = qs|filter((v, k) => k != 'status') %}

    {# ============ TARJETAS DE RESULTADO ============
     # Son enlaces, no adorno: cada una filtra el listado por su estado. Antes
     # eran cuatro números que sólo se podían leer, y para ver los dos fallidos
     # de entre doscientos avisos había que buscarlos a ojo por la tabla. #}
    {% set marca_activa = 'box-shadow: inset 0 0 0 2px var(--prl-ink);' %}
    <div class="prl-stats">
        <a class="prl-stat prl-stat--active" style="text-decoration: none; {{ filters.status == 'sent' ? marca_activa }}"
           href="{{ path('notification_log_index', qs_sin_estado|merge(range)|merge({ status: 'sent' })) }}">
            <div class="v">{{ summary.sent }}</div>
            <div class="l">entregados</div>
        </a>
        <a class="prl-stat prl-stat--leave" style="text-decoration: none; {{ filters.status == 'failed' ? marca_activa }}"
           href="{{ path('notification_log_index', qs_sin_estado|merge(range)|merge({ status: 'failed' })) }}">
            <div class="v">{{ summary.failed }}</div>
            <div class="l">fallidos</div>
        </a>
        <a class="prl-stat prl-stat--paused" style="text-decoration: none; {{ filters.status == 'discarded' ? marca_activa }}"
           href="{{ path('notification_log_index', qs_sin_estado|merge(range)|merge({ status: 'discarded' })) }}">
            <div class="v">{{ summary.discarded }}</div>
            <div class="l">descartados</div>
        </a>
        <a class="prl-stat" style="text-decoration: none; {{ filters.status is null ? marca_activa }}"
           href="{{ path('notification_log_index', qs_sin_estado|merge(range)) }}">
            <div class="v">{{ summary.total }}</div>
            <div class="l">en total</div>
        </a>
    </div>

    {% if summary.discarded > 0 %}
        {{ csa.callout(
            'Hay avisos descartados en este periodo: se prepararon pero no salieron porque el interruptor general de envíos estaba apagado.',
            'warning'
        ) }}
    {% endif %}

    {# ============ BARRA DE FILTROS ============ #}
    <form method="get" action="{{ path('notification_log_index') }}" id="prl-filter-form">
        {# Si estás mirando los avisos de UNA ejecución, tocar otro filtro no
           debe sacarte de ella sin avisar: el aviso de arriba desaparecería y
           pasarías a ver el histórico entero creyendo que sigues dentro. #}
        {% if filters.run %}<input type="hidden" name="run" value="{{ filters.run }}">{% endif %}
        {% if filters.status %}<input type="hidden" name="status" value="{{ filters.status }}">{% endif %}

        <div class="prl-toolbar">
            <div class="prl-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                <input type="search" name="q" value="{{ filters.q }}" placeholder="Correo, nombre o asunto…" autocomplete="off">
            </div>

            {% include 'notification_log/_period_filter.html.twig' %}

            {# Canal #}
            <div class="prl-filt-wrap">
                <button type="button" class="prl-filt {{ filters.channel ? 'has' : '' }}" data-pop-trigger="pop-canal">
                    {{ filters.channel ? channels[filters.channel] : 'Canal' }}
                    <svg class="chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="prl-pop" id="pop-canal" hidden>
                    <label><input type="radio" name="channel" value="" {{ filters.channel is null ? 'checked' : '' }}> Los dos</label>
                    {% for value, label in channels %}
                        <label><input type="radio" name="channel" value="{{ value }}" {{ filters.channel == value ? 'checked' : '' }}> {{ label }}</label>
                    {% endfor %}
                </div>
            </div>

            {# Tipo de aviso #}
            <div class="prl-filt-wrap">
                <button type="button" class="prl-filt {{ filters.kind ? 'has' : '' }}" data-pop-trigger="pop-tipo">
                    {{ filters.kind ? filters.kind|notification_kind : 'Tipo de aviso' }}
                    <svg class="chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="prl-pop" id="pop-tipo" hidden>
                    <label><input type="radio" name="kind" value="" {{ filters.kind is null ? 'checked' : '' }}> Todos</label>
                    {% for k in kinds %}
                        <label><input type="radio" name="kind" value="{{ k }}" {{ filters.kind == k ? 'checked' : '' }}> {{ k|notification_kind }}</label>
                    {% endfor %}
                </div>
            </div>

            {% if filters.channel or filters.kind or filters.q or filters.status or filters.run %}
                <a class="prl-filt prl-filt--clear" href="{{ path('notification_log_index', range) }}">
                    <i class="fa fa-times" aria-hidden="true"></i> Quitar filtros
                </a>
            {% endif %}

            <div class="spacer"></div>
            <div class="counters"><b>{{ pagination.totalItemCount }}</b> avisos</div>
        </div>
    </form>

    {% if filters.run %}
        <p class="csa-muted" style="margin: 0 0 14px; font-size: 12.5px;">
            Sólo los avisos de la ejecución #{{ filters.run }}.
            <a href="{{ path('notification_log_index', range) }}">Ver todos</a>
        </p>
    {% endif %}

{% endblock %}

{% block log_body %}

    <div class="prl-table-wrap">
        <table class="prl-table">
            <thead>
                <tr>
                    <th class="tight" style="width: 104px;">Cuándo</th>
                    <th>Destinatarix</th>
                    <th>Aviso</th>
                    <th class="tight" style="width: 168px;">Resultado</th>
                    <th class="tight" style="width: 196px;">Salió de</th>
                </tr>
            </thead>
            <tbody>
                {% for log in pagination %}
                    <tr>
                        <td class="tight">
                            <div class="prl-pickup__name">{{ log.sentAt|date('d/m/y') }}</div>
                            <div class="prl-person__meta">{{ log.sentAt|date('H:i') }}</div>
                        </td>

                        <td class="prl-cell-person">
                            {# El push conoce a la persona; el correo sólo la dirección, y la
                               ficha se cruza al leer (partners_by_email). Sin ese cruce la
                               tabla sería una lista de correos sueltos, que no se lee. #}
                            {% set quien = log.partner ?? partners_by_email[log.target]|default(null) %}
                            {% set es_push = log.channel == 'push' %}
                            <div class="prl-person">
                                {# El icono ocupa el sitio del avatar: el canal se ve de un
                                   vistazo sin gastar una columna entera en repetir
                                   "Correo" cincuenta veces. #}
                                <span class="prl-person__avatar {{ es_push ? 'prl-person__avatar--ink' : '' }}"
                                      title="{{ es_push ? 'Aviso al móvil' : 'Correo' }}">
                                    <i class="fa fa-{{ es_push ? 'mobile' : 'envelope-o' }}" aria-hidden="true"></i>
                                </span>
                                <div class="prl-person__body">
                                    {% if quien %}
                                        <a class="prl-person__name" href="{{ path('partner_show', { id: quien.id }) }}">{{ quien.name }} {{ quien.surname }}</a>
                                        <span class="prl-person__meta">{{ log.target }}</span>
                                    {% else %}
                                        <span class="prl-person__name">{{ log.target }}</span>
                                        <span class="prl-person__meta">{{ es_push ? 'Aviso al móvil' : 'Sin ficha de socix' }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </td>

                        <td>
                            <div class="prl-pickup__name">{{ log.kind|notification_kind }}</div>
                            {% if log.subject %}
                                <span class="prl-person__meta" title="{{ log.subject }}">{{ log.subject }}</span>
                            {% endif %}
                        </td>

                        <td class="tight">
                            <span class="prl-chip prl-chip--{{ chip_by_status[log.status]|default('neutral') }}">
                                <span class="dot"></span>{{ statuses[log.status]|default(log.status) }}
                            </span>
                        </td>

                        <td class="tight">
                            {% if log.cronRun %}
                                <a class="prl-pickup__name" style="text-decoration: none;"
                                   href="{{ path('notification_log_index', range|merge({ run: log.cronRun.id })) }}"
                                   title="Ver todos los avisos de esta ejecución">
                                    {{ tasks[log.cronRun.taskKey]|default(log.cronRun.taskKey) }}
                                </a>
                                <div class="prl-person__meta">ejecución #{{ log.cronRun.id }}</div>
                            {% else %}
                                <span class="prl-cell-muted">a mano</span>
                            {% endif %}
                        </td>
                    </tr>

                    {% if log.error %}
                        {# El motivo, a todo el ancho y bajo su fila.
                           Estaba recortado en la celda del resultado con el texto
                           completo en el `title`, y un motivo que hay que adivinar
                           pasando el ratón no es un motivo: en el móvil no hay ratón,
                           y aquí se viene justamente a saber POR QUÉ no salió. Ocupa
                           sitio sólo cuando algo ha fallado, que es cuando importa.

                           El fondo va en el `style` y no en una clase porque así gana
                           al `tr:hover` de la tabla, que si no lo repinta de verde al
                           pasar por encima —y esto no es una fila más, es un error. #}
                        <tr>
                            <td colspan="5" style="background: var(--prl-terra-l); padding: 9px 14px 11px;">
                                <span style="font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
                                             font-weight: 600; color: var(--prl-terra-d); margin-right: 8px;">Motivo</span>
                                <span style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 1.5;
                                             color: var(--prl-ink); word-break: break-word;">{{ log.error }}</span>
                            </td>
                        </tr>
                    {% endif %}
                {% else %}
                    <tr>
                        <td colspan="5" class="prl-empty">
                            No hay avisos registrados con estos filtros.
                            {# El registro empezó a escribirse con esta pantalla: antes de
                               eso no hay nada que enseñar, y conviene decirlo para que un
                               listado vacío no se lea como "no se envió nada". #}
                            Si el periodo es anterior a que existiera este registro, no habrá nada aunque sí se enviaran avisos.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="prl-pagination">{{ knp_pagination_render(pagination) }}</div>

{% endblock %}
