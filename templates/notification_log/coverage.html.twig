{# ============================================================
 # Registro de avisos · Cobertura: de quienes recogían, a cuántxs se avisó.
 #
 # Las otras dos pestañas cuentan lo que el sistema hizo. Ésta compara lo hecho
 # con lo que había que hacer, que es lo único que descubre a quién NO se avisa.
 #
 # La serie de repartos va primero, y a propósito: un hueco suelto puede ser
 # cualquier cosa, pero el mismo hueco cada dos semanas es un fallo del sistema.
 # Eso sólo se ve poniendo los repartos uno debajo de otro.
 # ============================================================ #}

{% extends 'notification_log/_layout.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{# Ni periodo ni filtros: aquí la unidad es el reparto, no el día. #}
{% set con_hueco = series|filter(t => t.gap > 0 and not t.unrecorded)|length %}
{% set sin_registro = series|filter(t => t.unrecorded)|length %}
{% set personas_sin_avisar = series|reduce((total, t) => total + (t.unrecorded ? 0 : t.gap), 0) %}

{% block log_toolbar %}

    {# El resumen de la serie entera, que es la pregunta de esta pestaña:
     # ¿esto pasa una vez o pasa siempre? #}
    <div class="prl-stats">
        <div class="prl-stat">
            <div class="v">{{ series|length }}</div>
            <div class="l">repartos mirados</div>
        </div>
        <div class="prl-stat {{ con_hueco > 0 ? 'prl-stat--leave' }}">
            <div class="v">{{ con_hueco }}</div>
            <div class="l">con huecos</div>
        </div>
        <div class="prl-stat {{ personas_sin_avisar > 0 ? 'prl-stat--leave' }}">
            <div class="v">{{ personas_sin_avisar }}</div>
            <div class="l">personas sin avisar</div>
        </div>
        <div class="prl-stat">
            <div class="v">{{ sin_registro }}</div>
            <div class="l">sin registro</div>
        </div>
    </div>

    {% if con_hueco > 0 %}
        {{ csa.callout(
            'Hay repartos con gente que podía recibir el aviso y no lo recibió. Si el hueco se repite en varias fechas, no es un despiste: es que el sistema está dejando fuera a alguien de forma sistemática.',
            'warning'
        ) }}
    {% endif %}

{% endblock %}

{% block log_body %}

    <h2 class="csa-section-title" style="font-family: 'Fraunces', serif; font-size: 15px; font-weight: 600; margin: 4px 0 10px;">
        Últimos repartos
    </h2>

    <div class="prl-table-wrap">
        <table class="prl-table">
            <thead>
                <tr>
                    <th class="tight" style="width: 120px;">Reparto</th>
                    <th class="tight" style="width: 110px;">Recogen</th>
                    <th class="tight" style="width: 110px;">Avisadxs</th>
                    <th class="tight" style="width: 190px;">Sin forma de avisar</th>
                    <th class="tight">Sin aviso ni motivo</th>
                </tr>
            </thead>
            <tbody>
                {% for fecha, t in series %}
                    <tr{% if fecha == selected %} style="background: var(--prl-sage-l);"{% endif %}>
                        <td class="tight">
                            <a class="prl-person__name" href="{{ path('notification_log_coverage', { date: fecha }) }}">
                                {{ fecha|date('d/m/Y') }}
                            </a>
                        </td>
                        <td class="tight" data-label="Recogen">{{ t.picking }}</td>
                        <td class="tight" data-label="Avisadxs">{{ t.notified }}</td>
                        <td class="tight" data-label="Sin forma de avisar">
                            {{ t.unreachable > 0 ? t.unreachable : '—' }}
                        </td>
                        <td class="tight" data-label="Sin aviso ni motivo">
                            {# Un reparto anterior al primer apunte no se juzga: entonces
                               se avisaba igual y no quedaba constancia. Pintarlo en rojo
                               sería acusar al sistema por un dato que falta. #}
                            {% if t.unrecorded %}
                                <span class="prl-cell-muted">sin registro</span>
                            {% elseif t.gap > 0 %}
                                <span class="prl-chip prl-chip--danger"><span class="dot"></span>{{ t.gap }}</span>
                            {% else %}
                                <span class="prl-chip prl-chip--ok"><span class="dot"></span>0</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="prl-empty">No hay repartos materializados todavía.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <p class="csa-muted" style="margin: 10px 0 0; font-size: 12px; line-height: 1.5;">
        <b>Sin forma de avisar</b>: no tiene correo utilizable ni cuenta en la web. No es un fallo del sistema,
        es una ficha a medias. <b>Sin aviso ni motivo</b>: sí podía recibirlo y no consta que se le enviara —
        eso sí hay que mirarlo.
        {% if first_record %}
            De los repartos anteriores al {{ first_record|date('d/m/Y') }} no hay constancia: entonces se
            avisaba igual, pero no se guardaba.
        {% else %}
            Todavía no hay ningún aviso registrado, así que aún no se puede comprobar nada.
        {% endif %}
    </p>

    {% if detail %}
        <h2 class="csa-section-title" style="font-family: 'Fraunces', serif; font-size: 15px; font-weight: 600; margin: 26px 0 10px;">
            Reparto del {{ selected|date('d/m/Y') }}, por modalidad
        </h2>

        {% if detail.unrecorded and detail.rows is not empty %}
            <p class="csa-muted" style="margin: 0 0 10px; font-size: 12.5px;">
                Este reparto es anterior al registro de avisos: lo que se ve es quién recogía, pero no se
                puede decir a quién se avisó.
            </p>
        {% endif %}

        <div class="prl-table-wrap">
            <table class="prl-table">
                <thead>
                    <tr>
                        <th>Modalidad</th>
                        <th class="tight" style="width: 150px;">¿Recibe aviso?</th>
                        <th class="tight" style="width: 110px;">Recogen</th>
                        <th class="tight" style="width: 110px;">Avisadxs</th>
                        <th class="tight" style="width: 190px;">Sin forma de avisar</th>
                        <th class="tight" style="width: 190px;">Sin aviso ni motivo</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in detail.rows %}
                        <tr>
                            <td><div class="prl-pickup__name">{{ row.share }}</div></td>
                            <td class="tight" data-label="¿Recibe aviso?">
                                {# Se enseñan TAMBIÉN las modalidades que no reciben aviso, y no
                                   es relleno: si alguien saca una de la lista del recordatorio,
                                   aparecerá aquí con gente recogiendo y un "No" al lado. Así se
                                   ve un cambio que, de otro modo, sólo se nota cuando alguien
                                   escribe meses después. #}
                                {% if row.in_scope %}
                                    <span class="prl-chip prl-chip--ok"><span class="dot"></span>Sí</span>
                                {% else %}
                                    <span class="prl-chip prl-chip--neutral"><span class="dot"></span>No, por diseño</span>
                                {% endif %}
                            </td>
                            <td class="tight" data-label="Recogen">{{ row.picking }}</td>
                            <td class="tight" data-label="Avisadxs">{{ row.notified }}</td>
                            <td class="tight" data-label="Sin forma de avisar">{{ row.unreachable > 0 ? row.unreachable : '—' }}</td>
                            <td class="tight" data-label="Sin aviso ni motivo">
                                {% if row.gap > 0 %}
                                    <span class="prl-chip prl-chip--danger"><span class="dot"></span>{{ row.gap }}</span>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="prl-empty">Ese día no había reparto, o estaba cancelado.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if detail.missing is not empty %}
            <h2 class="csa-section-title" style="font-family: 'Fraunces', serif; font-size: 15px; font-weight: 600; margin: 26px 0 10px;">
                Quiénes se quedaron sin aviso
            </h2>
            <div class="prl-table-wrap">
                <table class="prl-table">
                    <thead>
                        <tr>
                            <th>Socix</th>
                            <th class="actions">Ficha</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for partner in detail.missing %}
                            <tr>
                                <td class="prl-cell-person">
                                    <div class="prl-person">
                                        <span class="prl-person__avatar prl-person__avatar--terra">
                                            {{ partner.name|slice(0, 1)|upper }}{{ partner.surname|slice(0, 1)|upper }}
                                        </span>
                                        <div class="prl-person__body">
                                            <a class="prl-person__name" href="{{ path('partner_show', { id: partner.id }) }}">{{ partner.name }} {{ partner.surname }}</a>
                                            <span class="prl-person__meta">{{ partner.email ?: 'sin correo' }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="actions">
                                    <a href="{{ path('partner_show', { id: partner.id }) }}" title="Ver ficha" aria-label="Ver ficha"><i class="fa fa-eye"></i></a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}

{% endblock %}
