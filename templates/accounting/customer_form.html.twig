{# ============================================================
 # Alta o cambio de un cliente.
 #
 # El controller pasa: form, customer.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% set is_new = customer.id is null %}
{% set short_name = is_new ? 'Nuevo cliente' : customer.name|split("\n")|first %}

{% block title %}{{ short_name }} · Clientes{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_customers') }}">Clientes</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ is_new ? 'Nuevo' : 'Cambiar' }}</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Contabilidad · Clientes', short_name, 'Lo que va en la cabecera de sus facturas. Las ya emitidas guardan los datos que tenían.') }}

    {{ form_start(form, { attr: { class: 'csa-form-narrow' } }) }}

        {{ form_errors(form) }}

        <div class="csa-stack-lg">

            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Quién es', subtitle: 'Sin CIF no se le puede emitir una factura.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.name, 'Razón social', { full: true, hint: 'tal como va en la factura; admite una segunda línea' }) }}
                        {{ csa.field(form.taxId, 'CIF / NIF') }}
                        {{ csa.field(form.email, 'Correo de facturación') }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '2', title: 'Dirección', subtitle: 'La de la cabecera de la factura.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.address, 'Dirección', { full: true }) }}
                        {{ csa.field(form.postalCode, 'Código postal') }}
                        {{ csa.field(form.town, 'Municipio') }}
                        {{ csa.field(form.province, 'Provincia') }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '3', title: 'En todas sus facturas', subtitle: 'Lo que este cliente pide que se diga siempre: los códigos DIR3 de una administración pública, un número de expediente…' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.invoiceNote, 'Texto fijo', { full: true, hint: 'opcional' }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: is_new ? path('accounting_customers') : path('accounting_customer_show', { id: customer.id }) }) }}
                    <button type="submit" class="csa-btn csa-btn--primary">Guardar</button>
                </div>
            </div>

        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}
{% endblock %}
