{# ============================================================
 # Añadir o cambiar un recibo de una remesa en borrador.
 #
 # El controller pasa: form, remittance, line.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% set is_new = line.id is null %}

{% block title %}{{ is_new ? 'Nuevo recibo' : line.debtorName }} · {{ remittance.label }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_remittances') }}">Remesas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_remittance_show', { id: remittance.id }) }}">{{ remittance.period|date('m/Y') }}</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ is_new ? 'Nuevo recibo' : 'Cambiar recibo' }}</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Contabilidad · ' ~ remittance.label, is_new ? 'Nuevo recibo' : line.debtorName, 'Las columnas del Excel que se sube a Fiare. El socix no sale en el Excel: sirve para comparar el recibo con sus cestas.') }}

    {{ form_start(form, { attr: { class: 'csa-form-narrow', 'data-csa-dropdowns': '1' } }) }}

        {{ form_errors(form) }}

        <div class="csa-stack-lg">

            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Quién paga', subtitle: 'El titular de la cuenta, que no siempre es quien tiene la cesta.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.partner, 'Socix', { full: true, hint: 'no sale en el Excel' }) }}
                        {{ csa.field(form.debtorName, 'Nombre de quien paga', { full: true }) }}
                        {{ csa.field(form.iban, 'Cuenta (IBAN)', { full: true }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '2', title: 'Mandato', subtitle: 'El papel que firmó para domiciliar. Su referencia no se reutiliza nunca, ni la de alguien de baja.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.mandateReference, 'Referencia del mandato') }}
                        {{ csa.field(form.mandateSignedOn, 'Fecha de firma') }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '3', title: 'Este recibo', subtitle: 'FRST el primero de un mandato; RCUR los siguientes.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.debitReference, 'Referencia del adeudo', { hint: 'distinta en cada recibo' }) }}
                        {{ csa.field(form.sequenceType, 'Tipo de adeudo') }}
                        {{ csa.field(form.amount, 'Importe (€)') }}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: path('accounting_remittance_show', { id: remittance.id }) }) }}
                    <button type="submit" class="csa-btn csa-btn--primary">Guardar</button>
                </div>
            </div>

        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}
{% endblock %}
