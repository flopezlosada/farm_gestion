{# ============================================================
 # Los datos de cabecera de un presupuesto. Las cifras van en su propia rejilla.
 #
 # El controller pasa: form, budget (null al crear), heading.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}{{ heading }} · Presupuestos{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_budgets') }}">Presupuestos</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ budget ? 'Cambiar' : 'Nuevo' }}</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header(
        'Contabilidad · Presupuestos',
        heading,
        'Un año puede tener varios: el que aprueba la asamblea y las revisiones.'
    ) }}

    {{ form_start(form, { attr: { class: 'csa-form-narrow', 'data-csa-dropdowns': '1' } }) }}

        {{ form_errors(form) }}

        <div class="csa-stack-lg">

            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'De qué presupuesto hablamos', subtitle: 'El nombre es lo que lo distingue de las revisiones del mismo año.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.year, 'Año') }}
                        {{ csa.field(form.name, 'Nombre', { hint: 'p. ej. «Aprobado en asamblea»' }) }}
                        {{ csa.field(form.openingCash, 'Tesorería al empezar el año', { hint: 'la suma de todas las cuentas a 1 de enero' }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '2', title: 'La asamblea', subtitle: 'Si éste es el compromiso aprobado o un escenario de trabajo.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        <label style="display:inline-flex; align-items:center; gap: var(--csa-sp-2);">
                            {{ form_widget(form.approved) }} <span>Aprobado en asamblea</span>
                        </label>
                        {{ csa.field(form.approvedAt, 'Fecha de la asamblea') }}
                    </div>
                    <div class="csa-form-grid" style="margin-top: var(--csa-sp-4);">
                        {{ csa.field(form.notes, 'Con qué supuestos se hizo', { full: true, widget_class: 'csa-textarea', hint: 'lo que habría que recordar dentro de un año' }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: path('accounting_budgets') }) }}
                    {{ form_widget(form.submit, { attr: { class: 'csa-btn csa-btn--primary' } }) }}
                </div>
            </div>

        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}
{% endblock %}
