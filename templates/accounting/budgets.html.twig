{# ============================================================
 # Los presupuestos, de todos los años.
 #
 # De un mismo año hay varios a propósito: el que aprobó la asamblea y las revisiones
 # que se hacen cuando la realidad se separa de lo previsto. Todos se conservan.
 #
 # El controller pasa: rows (budget, income, expense, result, lines), y para la
 # tarjeta del coste de la cesta: year, basketCost, baskets, committedMonthlyFees.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Contabilidad · Presupuestos{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Presupuestos</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad',
        'Presupuestos',
        'Lo que se espera ingresar y gastar cada año. Contra esto se mide «cómo vamos».'
    ) }}

    <div class="prl-toolbar">
        <div class="counters"><b>{{ rows|length }}</b> presupuesto{{ rows|length == 1 ? '' : 's' }}</div>
        <div class="spacer"></div>
        <a href="{{ path('accounting_report') }}" class="prl-btn"><i class="fa fa-line-chart"></i> Cómo vamos</a>
        {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
            <a href="{{ path('accounting_budget_new') }}" class="prl-btn prl-btn--primary"><i class="fa fa-plus"></i> Nuevo presupuesto</a>
        {% endif %}
        {{ csa.help('contabilidad', 'anual', 'Ayuda: el presupuesto del año') }}
    </div>

    <div class="prl-table-wrap">
        {% if rows is empty %}
            <div class="prl-empty">
                Todavía no hay ningún presupuesto. Crea uno y mete las cifras mes a mes.
            </div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th class="tight">Año</th>
                        <th>Presupuesto</th>
                        <th class="tight acc-num">Ingresos</th>
                        <th class="tight acc-num">Gastos</th>
                        <th class="tight acc-num">Resultado</th>
                        <th class="tight acc-num">Líneas</th>
                        {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}<th class="tight"></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td class="tight"><b>{{ row.budget.year }}</b></td>
                            <td>
                                <a href="{{ path('accounting_budget_lines', { id: row.budget.id }) }}">{{ row.budget.name }}</a>
                                {% if row.budget.approved %}
                                    <span class="prl-chip prl-chip--activo"><span class="dot"></span>aprobado</span>
                                {% endif %}
                                {% if row.budget.approvedAt %}
                                    <span class="acc-muted acc-small">{{ row.budget.approvedAt|date('d/m/Y') }}</span>
                                {% endif %}
                                {# Sin ninguno marcado, manda el aprobado: también se ve «en vigor». #}
                                {% if references[row.budget.year] == row.budget.id %}
                                    <span class="prl-chip prl-chip--ok" title="Contra éste se mide el año: portada, partidas, coste de la cesta y «Cómo vamos». La asamblea sigue comparando con el aprobado."><span class="dot"></span>en vigor</span>
                                {% endif %}
                            </td>
                            <td class="acc-num">{{ fmt.money(row.income) }}</td>
                            <td class="acc-num">{{ fmt.money(row.expense) }}</td>
                            <td class="acc-num"><b>{{ fmt.money(row.result, true) }}</b></td>
                            <td class="acc-num">{{ row.lines }}</td>
                            {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
                                <td class="tight" style="white-space: nowrap;">
                                    <a href="{{ path('accounting_budget_lines', { id: row.budget.id }) }}" class="prl-btn" title="Las cifras, mes a mes"><i class="fa fa-table"></i> Cifras</a>
                                    <a href="{{ path('accounting_budget_edit', { id: row.budget.id }) }}" class="prl-btn" title="Nombre, año y notas"><i class="fa fa-pencil"></i></a>
                                    <a href="{{ path('accounting_budget_scenario', { id: row.budget.id }) }}" class="prl-btn" title="Escenarios a partir de este presupuesto"><i class="fa fa-calculator"></i> ¿Y si…?</a>
                                    <form method="post" action="{{ path('accounting_budget_duplicate', { id: row.budget.id }) }}" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('accounting_budget_duplicate_' ~ row.budget.id) }}">
                                        <input type="hidden" name="year" value="{{ row.budget.year }}">
                                        <button type="submit" class="prl-btn" title="Copiar con sus cifras"><i class="fa fa-copy"></i></button>
                                    </form>
                                    <form method="post" action="{{ path('accounting_budget_in_force', { id: row.budget.id }) }}" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('accounting_budget_in_force_' ~ row.budget.id) }}">
                                        {% if row.budget.inForce %}
                                            <button type="submit" class="prl-btn" title="Sacar de vigor: el año vuelve a medirse contra el aprobado">Sacar de vigor</button>
                                        {% elseif references[row.budget.year] != row.budget.id %}
                                            <button type="submit" class="prl-btn" title="Medir el año contra este presupuesto en vez de contra el aprobado">Poner en vigor</button>
                                        {% endif %}
                                    </form>
                                    {% if not row.budget.approved and not row.budget.inForce %}
                                        <form method="post" action="{{ path('accounting_budget_delete', { id: row.budget.id }) }}" style="display:inline;"
                                              onsubmit="return confirm('¿Borrar «{{ row.budget.name }}» de {{ row.budget.year }} con todas sus cifras?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('accounting_budget_delete_' ~ row.budget.id) }}">
                                            <button type="submit" class="prl-btn" title="Borrar"><i class="fa fa-trash"></i></button>
                                        </form>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {# ============ COSTE POR CESTA ============ #}
    <div style="margin-top: 18px; max-width: 640px;">
    {% embed '_components/csa_card.html.twig' with { title: 'Cuánto tiene que costar la cesta', subtitle: 'Repartiendo el coste de ' ~ year ~ ' según el presupuesto en vigor', accent: 'green' } %}
        {% block body %}
            {% if basketCost.expenses == 0 %}
                <p style="margin: 0; font-size: 13px;" class="acc-muted">No hay presupuesto de {{ year }} con el que hacer la cuenta.</p>
            {% else %}
                <p style="margin: 0 0 10px; font-size: 13px;">
                    Los gastos previstos del año, con inversiones y cuotas de préstamo, suman
                    <b>{{ basketCost.expenses|number_format(2, ',', '.') }} €</b>. Descontando los huevos,
                    que se cobran aparte ({{ basketCost.eggExpenses|number_format(2, ',', '.') }} €),
                    quedan <b>{{ basketCost.toCover|number_format(2, ',', '.') }} €</b> que tienen que salir
                    de las cestas.
                </p>
                <p style="margin: 0 0 10px; font-size: 13px;">
                    Hoy hay <b>{{ baskets|number_format(2, ',', '.') }}</b> cestas completas equivalentes
                    activas. Su cuota calculada de este mes (cesta, huevos y transporte, sin ajustes) suma <b>{{ committedMonthlyFees|number_format(2, ',', '.') }} €</b>.
                </p>
                {% if basketCost.pricePerBasketNeeded %}
                    <p style="margin: 0; font-size: 15px;">
                        Con esas cestas, cada una tendría que aportar
                        <b>{{ basketCost.pricePerBasketNeeded|number_format(2, ',', '.') }} €</b> al mes.
                    </p>
                {% endif %}
                {% if basketCost.basketsNeeded %}
                    <p style="margin: 6px 0 0; font-size: 13px;" class="acc-muted">
                        Manteniendo los 100 € de la cesta semanal harían falta
                        {{ basketCost.basketsNeeded|number_format(2, ',', '.') }} cestas.
                    </p>
                {% endif %}
            {% endif %}
        {% endblock %}
    {% endembed %}
    </div>

</div>
{% endblock %}
