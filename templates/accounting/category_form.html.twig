{# ============================================================
 # Crear o cambiar una partida.
 #
 # El controller pasa: form, category (null al crear), entryCount, heading.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}{{ heading }} · Partidas{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_categories') }}">Partidas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ category ? 'Cambiar' : 'Nueva' }}</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header(
        'Contabilidad · Partidas',
        heading,
        'A qué se imputa el dinero. El mismo vocabulario vale para el libro y para el presupuesto.'
    ) }}

    {% if entryCount > 0 %}
        <div class="csa-form-narrow">
            {{ csa.callout(
                'Hay ' ~ entryCount ~ ' apunte' ~ (entryCount == 1 ? '' : 's') ~ ' en esta partida. Si le cambias el grupo, todos ellos pasan a sumar en el grupo nuevo, también en los años ya cerrados.',
                'warning',
                'exclamation-triangle'
            ) }}
        </div>
    {% endif %}

    {{ form_start(form, { attr: { class: 'csa-form-narrow', 'data-csa-dropdowns': '1' } }) }}

        {{ form_errors(form) }}

        <div class="csa-stack-lg">

            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'La partida', subtitle: 'Su nombre y dónde suma.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.group, 'Grupo', { widget_class: 'csa-select' }) }}
                        {{ csa.field(form.name, 'Nombre') }}
                        {{ csa.field(form.description, 'Para qué es', { full: true, hint: 'y qué NO va aquí' }) }}
                        {{ csa.field(form.sortOrder, 'Orden', { hint: 'menor, antes' }) }}
                    </div>
                    <div class="csa-form-grid" style="margin-top: var(--csa-sp-4);">
                        <label style="display:inline-flex; align-items:center; gap: var(--csa-sp-2);">
                            {{ form_widget(form.active) }} <span>En uso: se ofrece al anotar</span>
                        </label>
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: path('accounting_categories') }) }}
                    {{ form_widget(form.submit, { attr: { class: 'csa-btn csa-btn--primary' } }) }}
                </div>
            </div>

        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}
{% endblock %}
