{# ============================================================
 # Transferencias del grupo de consumo: elegir a mano qué pedido paga cada ingreso
 # que el cruce no asignó solo, y deshacer las asignadas.
 #
 # El controller pasa:
 #  - pending: { lines: [{ line, payer, suggestions: [{ order, sure, reasons }] }], payable: ConsumerGroupOrder[] }
 #  - assigned: ConsumerGroupTransfer[] (con pedidos), recientes primero
 #  - dismissed: ConsumerGroupTransfer[] apartadas, recientes primero
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Contabilidad · Transferencias del grupo de consumo{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Transferencias del grupo de consumo</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .cgt-row { display: grid; grid-template-columns: minmax(12rem, 17rem) minmax(0, 1fr); gap: .9rem 2rem; padding: 1rem 1.15rem; border-bottom: 1px solid var(--prl-line, #ebe7dd); }
        .cgt-row:last-child { border-bottom: 0; }
        .cgt-who { min-width: 0; }
        .cgt-amount { font-size: 1.1875rem; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; color: var(--prl-ink, #1d1c17); }
        .cgt-payer { margin-top: .2rem; font-weight: 500; overflow-wrap: anywhere; }
        .cgt-meta { margin-top: .15rem; font-size: 12px; color: var(--prl-ink-faint, #8d8773); }
        .cgt-pick { min-width: 0; margin: 0; }
        .cgt-none, .cgt-more { margin: 0 0 .6rem; font-size: 12.5px; color: var(--prl-ink-soft, #5a564a); }
        .cgt-group { margin: 0 0 .65rem; }
        .cgt-group__head { margin: 0 0 .35rem; font-size: 12px; color: var(--prl-ink-soft, #5a564a); }
        .cgt-group__head strong { color: var(--prl-ink, #1d1c17); font-weight: 600; font-variant-numeric: tabular-nums; }
        .cgt-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
        .cgt-chip { position: relative; }
        .cgt-chip input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
        .cgt-chip label { display: inline-flex; align-items: baseline; gap: .45rem; margin: 0; padding: .32rem .8rem; border: 1px solid var(--prl-line-2, #d8d2c2); border-radius: 999px; background: var(--prl-surface, #fff); font-size: 13px; font-weight: 400; color: var(--prl-ink, #1d1c17); cursor: pointer; transition: background .15s ease, border-color .15s ease, color .15s ease; }
        .cgt-chip label small { font-size: 11.5px; color: var(--prl-ink-faint, #8d8773); font-variant-numeric: tabular-nums; }
        .cgt-chip:hover label { background: var(--prl-bg, #fbfaf6); border-color: var(--prl-ink-faint, #8d8773); }
        .cgt-chip input:checked + label { background: var(--prl-sage-l, #eaf0e2); border-color: var(--prl-sage, #5b7a4c); color: var(--prl-sage-d, #2f4426); font-weight: 500; }
        .cgt-chip input:checked + label::before { content: "✓"; font-size: 12px; }
        .cgt-chip input:checked + label small { color: var(--prl-sage-d, #2f4426); }
        .cgt-chip input:focus-visible + label { outline: 2px solid var(--prl-sage, #5b7a4c); outline-offset: 2px; }
        .cgt-chip--named label { border-color: var(--prl-sage, #5b7a4c); }
        .prl h2.acc-section-head { margin: 2rem 0 .75rem; }
        .cgt-rest { margin-top: .45rem; }
        .cgt-rest summary { display: inline-block; font-size: 12px; font-weight: 500; color: var(--prl-sage-d, #2f4426); cursor: pointer; padding: .15rem 0; }
        .cgt-rest summary:focus-visible { outline: 2px solid var(--prl-sage, #5b7a4c); outline-offset: 2px; }
        .cgt-rest[open] .cgt-chips { max-height: 11rem; overflow-y: auto; margin-top: .4rem; padding: .15rem .1rem; }
        .cgt-act { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin-top: .25rem; }
        .cgt-act .prl-search { flex: 1 1 15rem; max-width: 24rem; min-width: 0; }
        .cgt-sum { flex: 1 1 auto; font-size: 12px; color: var(--prl-ink-soft, #5a564a); font-variant-numeric: tabular-nums; }
        .cgt-sum--ok { color: var(--prl-sage-d, #2f4426); }
        .cgt-sum--warn { color: var(--prl-ochre-d, #8c6919); font-weight: 500; }
        .cgt-readonly { margin: 0; padding: 0; list-style: none; font-size: 13px; }
        @media (max-width: 760px) {
            .cgt-row { grid-template-columns: minmax(0, 1fr); gap: .6rem; padding: .9rem 1rem; }
            .cgt-act .prl-btn { flex: 1 1 auto; justify-content: center; }
        }
        @media (prefers-reduced-motion: reduce) { .cgt-chip label { transition: none; } }
    </style>
{% endblock %}

{% macro chip(line, s, exact, checked) %}
    <li class="cgt-chip{{ s.named ? ' cgt-chip--named' : '' }}">
        <input type="checkbox" name="orders[]" id="o-{{ line.id }}-{{ s.order.id }}" value="{{ s.order.id }}" data-cents="{{ (s.order.total * 100)|round }}"{% if checked %} checked{% endif %}>
        <label for="o-{{ line.id }}-{{ s.order.id }}" title="{{ s.reasons|join('. ') }}">
            {{ s.order.partner }}
            {% if not exact %}<small>{{ s.order.total|number_format(2, ',', '.') }} €</small>{% endif %}
            {% if s.named %}<small>· nombre parecido</small>{% endif %}
        </label>
    </li>
{% endmacro %}

{% macro order_label(order) %}
    <span class="acc-strong">{{ order.partner }}</span>
    · {{ order.round.title }}{% if order.round.deliveryDate %} (entrega {{ order.round.deliveryDate|date('d/m') }}){% endif %}
    · {{ order.total|number_format(2, ',', '.') }} €
{% endmacro %}

{% block csa_main %}
{% set can_edit = is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad · Grupo de consumo',
        'Transferencias del grupo de consumo',
        'El banco no trae el concepto que escribe quien paga: sólo quién ordena la transferencia (a veces cortado) y el importe. Al subir el extracto, la transferencia que debe justo un pedido y viene de alguien de esa familia se asigna sola. Aquí quedan las demás: marca qué pedido paga cada una. La próxima vez que esa persona pague, se asignará sola.'
    ) }}

    <h2 class="acc-section-head" id="por-elegir">Por elegir ({{ pending.lines|length }})</h2>
    <div class="prl-table-wrap">
        {% if pending.lines is empty %}
            <div class="prl-empty">No hay transferencias por elegir. Al subir un extracto, las que no se asignen solas aparecerán aquí.</div>
        {% else %}
            {% for row in pending.lines %}
                {% set line = row.line %}
                {% set sureOnes = row.suggestions|filter(s => s.sure) %}
                <article class="cgt-row" id="movimiento-{{ line.id }}">
                    <div class="cgt-who">
                        <div class="cgt-amount">{{ fmt.money(line.amount) }}</div>
                        <div class="cgt-payer">{{ row.payer }}</div>
                        <div class="cgt-meta">{{ line.operationDate|date('d/m/Y') }} · {{ line.account.name }}</div>
                    </div>

                    {% if not can_edit %}
                        <ul class="cgt-readonly">
                            {% for s in row.suggestions|slice(0, 5) %}<li>{{ _self.order_label(s.order) }}</li>{% else %}<li class="acc-muted">Ningún pedido parecido.</li>{% endfor %}
                        </ul>
                    {% else %}
                        <form method="post" class="cgt-pick" action="{{ path('accounting_cg_transfer_assign', { id: line.id }) }}" id="asignar-{{ line.id }}" data-cgt-row data-cents="{{ line.amountCents }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cg_transfer_assign_' ~ line.id) }}">

                            {% if row.groups is empty %}
                                <p class="cgt-none">Ningún pedido por pagar debe este importe ni es de alguien con ese nombre. Búscalo, o apártala si no es de un pedido.</p>
                            {% endif %}

                            {% for g in row.groups %}
                                <div class="cgt-group">
                                    <p class="cgt-group__head">
                                        {% if g.exact %}Deben justo <strong>{{ fmt.money(line.amount) }}</strong>{% else %}Nombre parecido, pero deben otro importe{% endif %}
                                        · {{ g.round.title }}{% if g.round.deliveryDate %} (entrega {{ g.round.deliveryDate|date('d/m') }}){% endif %}
                                    </p>
                                    <ul class="cgt-chips">
                                        {% for s in g.items|slice(0, 6) %}{{ _self.chip(line, s, g.exact, s.sure and sureOnes|length == 1) }}{% endfor %}
                                    </ul>
                                    {% if g.items|length > 6 %}
                                        <details class="cgt-rest">
                                            <summary>Ver {{ g.items|length - 6 }} más</summary>
                                            <ul class="cgt-chips">
                                                {% for s in g.items|slice(6) %}{{ _self.chip(line, s, g.exact, false) }}{% endfor %}
                                            </ul>
                                        </details>
                                    {% endif %}
                                </div>
                            {% endfor %}
                            {% if row.hidden > 0 %}<p class="cgt-more">Y {{ row.hidden }} más: búscalos con el buscador.</p>{% endif %}

                            <div class="cgt-act">
                                <div class="prl-search">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                                    <input type="search" list="cgt-payable" data-cgt-find autocomplete="off" aria-label="Buscar otro pedido por socia o ronda" placeholder="{{ row.groups is empty ? 'Buscar un pedido…' : 'Otro pedido…' }}">
                                    <input type="hidden" name="other" value="">
                                </div>
                                <span class="cgt-sum" data-cgt-sum aria-live="polite"></span>
                                <button type="submit" class="prl-btn prl-btn--primary" data-cgt-assign>Asignar<span data-cgt-count></span></button>
                                <button type="submit" form="apartar-{{ line.id }}" class="prl-btn" title="Un donativo, una cuota u otra cosa: deja de pedir que se elija">No es de un pedido</button>
                            </div>
                        </form>
                        <form method="post" id="apartar-{{ line.id }}" action="{{ path('accounting_cg_transfer_dismiss', { id: line.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cg_transfer_dismiss_' ~ line.id) }}">
                        </form>
                    {% endif %}
                </article>
            {% endfor %}

            {# Los pedidos por pagar se pintan UNA vez y todos los buscadores comparten la lista. #}
            <datalist id="cgt-payable">
                {% for order in pending.payable %}
                    <option value="{{ order.partner }} · {{ order.round.title }} · {{ order.total|number_format(2, ',', '.') }} €" data-id="{{ order.id }}" data-cents="{{ (order.total * 100)|round }}"></option>
                {% endfor %}
            </datalist>
            <script>
                (function () {
                    var euros = function (cents) { return (cents / 100).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'; };
                    var known = {};
                    document.querySelectorAll('#cgt-payable option').forEach(function (o) { known[o.value] = { id: o.dataset.id, cents: parseInt(o.dataset.cents, 10) }; });

                    document.querySelectorAll('[data-cgt-row]').forEach(function (form) {
                        var find = form.querySelector('[data-cgt-find]');
                        var other = form.querySelector('input[name="other"]');
                        var button = form.querySelector('[data-cgt-assign]');
                        var count = form.querySelector('[data-cgt-count]');
                        var sum = form.querySelector('[data-cgt-sum]');
                        var paid = parseInt(form.dataset.cents, 10);

                        function refresh() {
                            var total = 0, n = 0;
                            form.querySelectorAll('input[name="orders[]"]:checked').forEach(function (c) { total += parseInt(c.dataset.cents, 10); n++; });
                            var extra = known[find.value];
                            other.value = extra ? extra.id : '';
                            if (extra) { total += extra.cents; n++; }
                            button.disabled = n === 0 || total > paid;
                            count.textContent = n > 1 ? ' (' + n + ')' : '';
                            sum.className = 'cgt-sum' + (n === 0 ? '' : (total === paid ? ' cgt-sum--ok' : ' cgt-sum--warn'));
                            sum.textContent = n === 0 ? '' : (total === paid ? 'Cuadra: ' + euros(total)
                                : (total > paid ? 'Suman ' + euros(total) + ' y la transferencia sólo trae ' + euros(paid) + ': quita alguno'
                                    : 'Suman ' + euros(total) + ' y la transferencia trae ' + euros(paid)));
                        }

                        form.addEventListener('change', refresh);
                        find.addEventListener('input', refresh);
                        refresh();
                    });
                })();
            </script>
        {% endif %}
    </div>

    <h2 class="acc-section-head" id="asignadas">Asignadas, las últimas</h2>
    <div class="prl-table-wrap">
        {% if assigned is empty %}
            <div class="prl-empty">Todavía no hay ninguna transferencia asignada a un pedido.</div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th class="tight">Fecha</th>
                        <th>Quién paga</th>
                        <th class="tight acc-num">Importe</th>
                        <th>Paga</th>
                        <th class="tight"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for t in assigned %}
                        <tr id="transferencia-{{ t.id }}">
                            <td class="tight" data-label="Fecha">{{ t.line.operationDate|date('d/m/Y') }}<br><span class="acc-muted acc-small">{{ t.line.account.name }}</span></td>
                            <td data-label="Quién paga">{{ t.line.transferPayer ?? t.line.suggestedConcept }}</td>
                            <td class="acc-num" data-label="Importe">{{ fmt.money(t.line.amount) }}</td>
                            <td data-label="Paga">
                                {% for order in t.orders %}<div>{{ _self.order_label(order) }}</div>{% endfor %}
                                <span class="prl-chip prl-chip--{{ t.automatic ? 'mod-4' : 'activo' }}"><span class="dot"></span>{{ t.automatic ? 'Asignada sola' : 'Asignada a mano' }}</span>
                            </td>
                            <td class="tight">
                                {% if can_edit %}
                                    <form method="post" action="{{ path('accounting_cg_transfer_release', { id: t.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cg_transfer_release_' ~ t.id) }}">
                                        <button type="submit" class="prl-btn prl-btn--sm" title="Los pedidos vuelven a pendientes de pago y la transferencia a «Por elegir»">Deshacer</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {% if dismissed is not empty %}
        <h2 class="acc-section-head" id="apartadas">Apartadas: no son de un pedido</h2>
        <div class="prl-table-wrap">
            <table class="prl-table">
                <tbody>
                    {% for t in dismissed %}
                        <tr>
                            <td class="tight" data-label="Fecha">{{ t.line.operationDate|date('d/m/Y') }}</td>
                            <td data-label="Quién paga">{{ t.line.transferPayer ?? t.line.suggestedConcept }}</td>
                            <td class="acc-num" data-label="Importe">{{ fmt.money(t.line.amount) }}</td>
                            <td class="tight">
                                {% if can_edit %}
                                    <form method="post" action="{{ path('accounting_cg_transfer_reopen', { id: t.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cg_transfer_reopen_' ~ t.id) }}">
                                        <button type="submit" class="prl-btn prl-btn--sm">Sí es de un pedido</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
