{# ============================================================
 # Transferencias del grupo de consumo: elegir a mano qué pedido paga cada ingreso
 # que el cruce no asignó solo, y deshacer las asignadas.
 #
 # El controller pasa:
 #  - pending: { lines: [{ line, payer, suggestions: [{ order, sure, reasons }] }], payable: ConsumerGroupOrder[] }
 #  - assigned: ConsumerGroupTransfer[] (con pedidos), recientes primero
 #  - dismissed: ConsumerGroupTransfer[] apartadas, recientes primero
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Contabilidad · Transferencias del grupo de consumo{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Transferencias del grupo de consumo</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .cgt-orders { list-style: none; margin: 0 0 .5rem; padding: 0; }
        .cgt-orders li { margin: 0 0 .35rem; }
        .cgt-orders label { display: flex; gap: .5rem; align-items: flex-start; cursor: pointer; font-weight: normal; margin: 0; }
        .cgt-orders input { margin-top: .2rem; flex: none; }
        .cgt-why { display: block; }
        .cgt-other { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-bottom: .5rem; }
        .cgt-other select { max-width: 100%; min-width: 0; flex: 1 1 16rem; }
        .cgt-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
        .cgt-actions form { margin: 0; }
    </style>
{% endblock %}

{% macro order_label(order) %}
    <span class="acc-strong">{{ order.partner }}</span>
    · {{ order.round.title }}{% if order.round.deliveryDate %} (entrega {{ order.round.deliveryDate|date('d/m') }}){% endif %}
    · {{ order.total|number_format(2, ',', '.') }} €
{% endmacro %}

{% block csa_main %}
{% set can_edit = is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad · Grupo de consumo',
        'Transferencias del grupo de consumo',
        'El banco no trae el concepto que escribe quien paga: sólo quién ordena la transferencia (a veces cortado) y el importe. Al subir el extracto, la transferencia que debe justo un pedido y viene de alguien de esa familia se asigna sola. Aquí quedan las demás: marca qué pedido paga cada una. La próxima vez que esa persona pague, se asignará sola.'
    ) }}

    <h2 class="acc-section-head" id="por-elegir">Por elegir ({{ pending.lines|length }})</h2>
    <div class="prl-table-wrap">
        {% if pending.lines is empty %}
            <div class="prl-empty">No hay transferencias por elegir.</div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th class="tight">Fecha</th>
                        <th>Quién paga</th>
                        <th class="tight acc-num">Importe</th>
                        <th>Qué pedido paga</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in pending.lines %}
                        {% set line = row.line %}
                        {% set suggested = row.suggestions|slice(0, 5) %}
                        {% set sure = row.suggestions|filter(s => s.sure) %}
                        <tr id="movimiento-{{ line.id }}">
                            <td class="tight" data-label="Fecha">{{ line.operationDate|date('d/m/Y') }}<br><span class="acc-muted acc-small">{{ line.account.name }}</span></td>
                            <td data-label="Quién paga"><span class="acc-strong">{{ row.payer }}</span></td>
                            <td class="acc-num" data-label="Importe">{{ fmt.money(line.amount) }}</td>
                            <td data-label="Qué pedido paga">
                                {% if not can_edit %}
                                    {% for s in suggested %}<div>{{ _self.order_label(s.order) }}</div>{% else %}<span class="acc-muted">Ningún pedido parecido.</span>{% endfor %}
                                {% else %}
                                    <form method="post" action="{{ path('accounting_cg_transfer_assign', { id: line.id }) }}" id="asignar-{{ line.id }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cg_transfer_assign_' ~ line.id) }}">
                                        {% if suggested is empty %}
                                            <p class="acc-muted acc-small">Ningún pedido por pagar debe este importe ni es de alguien con ese nombre. Elige uno abajo, o apártala si no es de un pedido.</p>
                                        {% else %}
                                            <ul class="cgt-orders">
                                                {% for s in suggested %}
                                                    <li>
                                                        <label>
                                                            <input type="checkbox" name="orders[]" value="{{ s.order.id }}"{% if s.sure and sure|length == 1 %} checked{% endif %}>
                                                            <span>
                                                                {{ _self.order_label(s.order) }}
                                                                <span class="cgt-why acc-muted acc-small">{{ s.reasons|join('. ') }}</span>
                                                            </span>
                                                        </label>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% endif %}
                                        {% if pending.payable is not empty %}
                                            <div class="cgt-other">
                                                <label for="otro-{{ line.id }}" class="acc-small">{{ suggested is empty ? 'Pedido:' : 'U otro pedido:' }}</label>
                                                <select name="other" id="otro-{{ line.id }}" data-payable><option value="">—</option></select>
                                            </div>
                                        {% endif %}
                                    </form>
                                    <div class="cgt-actions">
                                        {% if pending.payable is not empty %}
                                            <button type="submit" form="asignar-{{ line.id }}" class="prl-btn prl-btn--primary prl-btn--sm">Asignar</button>
                                        {% endif %}
                                        <form method="post" action="{{ path('accounting_cg_transfer_dismiss', { id: line.id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cg_transfer_dismiss_' ~ line.id) }}">
                                            <button type="submit" class="prl-btn prl-btn--sm" title="Un donativo, una cuota u otra cosa: deja de pedir que se elija">No es de un pedido</button>
                                        </form>
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            {# Los pedidos por pagar se pintan UNA vez y un script los copia a cada desplegable: pintarlos en cada fila crece con filas × pedidos. #}
            <template id="cgt-payable">
                {% for order in pending.payable %}
                    <option value="{{ order.id }}">{{ order.partner }} · {{ order.round.title }} · {{ order.total|number_format(2, ',', '.') }} €</option>
                {% endfor %}
            </template>
            <script>
                (function () {
                    var options = document.getElementById('cgt-payable');
                    if (!options) { return; }
                    document.querySelectorAll('select[data-payable]').forEach(function (select) {
                        select.appendChild(options.content.cloneNode(true));
                    });
                })();
            </script>
        {% endif %}
    </div>

    <h2 class="acc-section-head" id="asignadas">Asignadas, las últimas</h2>
    <div class="prl-table-wrap">
        {% if assigned is empty %}
            <div class="prl-empty">Todavía no hay ninguna transferencia asignada a un pedido.</div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th class="tight">Fecha</th>
                        <th>Quién paga</th>
                        <th class="tight acc-num">Importe</th>
                        <th>Paga</th>
                        <th class="tight"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for t in assigned %}
                        <tr>
                            <td class="tight" data-label="Fecha">{{ t.line.operationDate|date('d/m/Y') }}<br><span class="acc-muted acc-small">{{ t.line.account.name }}</span></td>
                            <td data-label="Quién paga">{{ t.line.transferPayer ?? t.line.suggestedConcept }}</td>
                            <td class="acc-num" data-label="Importe">{{ fmt.money(t.line.amount) }}</td>
                            <td data-label="Paga">
                                {% for order in t.orders %}<div>{{ _self.order_label(order) }}</div>{% endfor %}
                                <span class="prl-chip prl-chip--{{ t.automatic ? 'mod-4' : 'activo' }}"><span class="dot"></span>{{ t.automatic ? 'Asignada sola' : 'Asignada a mano' }}</span>
                            </td>
                            <td class="tight">
                                {% if can_edit %}
                                    <form method="post" action="{{ path('accounting_cg_transfer_release', { id: t.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cg_transfer_release_' ~ t.id) }}">
                                        <button type="submit" class="prl-btn prl-btn--sm" title="Los pedidos vuelven a pendientes de pago y la transferencia a «Por elegir»">Deshacer</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {% if dismissed is not empty %}
        <h2 class="acc-section-head" id="apartadas">Apartadas: no son de un pedido</h2>
        <div class="prl-table-wrap">
            <table class="prl-table">
                <tbody>
                    {% for t in dismissed %}
                        <tr>
                            <td class="tight" data-label="Fecha">{{ t.line.operationDate|date('d/m/Y') }}</td>
                            <td data-label="Quién paga">{{ t.line.transferPayer ?? t.line.suggestedConcept }}</td>
                            <td class="acc-num" data-label="Importe">{{ fmt.money(t.line.amount) }}</td>
                            <td class="tight">
                                {% if can_edit %}
                                    <form method="post" action="{{ path('accounting_cg_transfer_reopen', { id: t.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cg_transfer_reopen_' ~ t.id) }}">
                                        <button type="submit" class="prl-btn prl-btn--sm">Sí es de un pedido</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
