{# Apuntes en una tabla, igual en el libro y en las fichas de cuenta y de partida.
 # Va aparte porque una macro definida dentro de un bloque no queda registrada.
 #
 # invoices: id del apunte => id de su factura, para el clip (vacío si no importa). #}

{# Las celdas de un apunte: fecha, concepto (enlaza a su ficha), partida, cuenta e importe.
 # without: 'category' o 'account' para callar la columna que en esa ficha sería la
 # misma en todas las filas. #}
{% macro cells(entry, invoices = {}, without = null) %}
    <td class="tight">{{ entry.date ? entry.date|date('d/m/Y') : '—' }}</td>
    <td>
        <a href="{{ path('accounting_entry_show', { id: entry.id }) }}">{{ entry.concept }}</a>
        {% if invoices[entry.id] is defined %}
            <i class="fa fa-paperclip acc-muted" title="Tiene la factura adjunta"></i>
        {% endif %}
        {% if entry.providerName or entry.invoiceNumber %}
            <br><span class="acc-muted acc-small">
                {{ entry.providerName }}{% if entry.invoiceNumber %} · fra. {{ entry.invoiceNumber }}{% endif %}
            </span>
        {% endif %}
    </td>
    {% if without != 'category' %}
        <td>
            <span class="acc-muted acc-small">{{ entry.category.group.name }}</span><br>
            <a href="{{ path('accounting_category_show', { id: entry.category.id }) }}">{{ entry.category.name }}</a>
        </td>
    {% endif %}
    {% if without != 'account' %}
        <td class="tight"><a href="{{ path('accounting_account_show', { id: entry.account.id }) }}">{{ entry.account.name }}</a></td>
    {% endif %}
    <td class="acc-num {{ entry.incoming ? '' : 'acc-neg' }}">
        {{ entry.amount|number_format(2, ',', '.') }} €
    </td>
{% endmacro %}

{# Una tabla de sólo lectura, para las fichas. #}
{% macro table(entries, invoices = {}, without = null) %}
    {% import _self as rows %}
    <table class="prl-table">
        <thead>
            <tr>
                <th class="tight">Fecha</th>
                <th>Concepto</th>
                {% if without != 'category' %}<th>Partida</th>{% endif %}
                {% if without != 'account' %}<th class="tight">Cuenta</th>{% endif %}
                <th class="tight acc-num">Importe</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in entries %}
                <tr>{{ rows.cells(entry, invoices, without) }}</tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}
