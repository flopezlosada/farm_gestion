{# ============================================================
 # Cómo vamos — informe del año, dentro de «Informes».
 #
 # Responde a la pregunta que trae aquí a alguien: ¿cuadra el año? Cruza lo
 # presupuestado con lo realmente movido, proyecta el cierre y calcula cuánto
 # tendría que costar la cesta para que salga.
 #
 # El controller pasa:
 #   year, years              año mirado y los que tienen datos
 #   budget, budgets          presupuesto contra el que se mide y los del año
 #   tracked                  rejilla de BudgetTracker::track
 #   cash                     flujo de caja de BudgetTracker::cashFlow
 #                            (los dos, cortados en el último mes completo del
 #                            libro de los bancos: BudgetTracker::lastCompleteMonth)
 #   complete, booked         las dos cifras de cómo va el año, cortadas en el
 #                            último mes completo y en el último con apuntes
 #                            (las mismas que la portada: _outlook_stats)
 #   balances, totalCash      saldo de cada cuenta y el total
 #   months, shortMonths      nombre del mes, completo y en tres letras
 #
 # SIGNO: todo va con el signo de su efecto sobre la caja (negativo = sale). Eso
 # hace que la desviación se lea igual en ingresos y en gastos: positiva es buena
 # para la caja (ingresaste de más o gastaste de menos) y negativa es mala.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Contabilidad · Cómo vamos{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Cómo vamos</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .acc-bar { display: block; height: 6px; border-radius: 3px; background: rgba(0, 0, 0, 0.08); overflow: hidden; min-width: 60px; }
        .acc-bar > i { display: block; height: 100%; background: var(--csa-sage, #6a8f6b); }
        .acc-bar > i.over { background: #b3261e; }
        .acc-against { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; margin: 4px 0 18px; padding: 14px 18px; background: var(--prl-surface, #fff); border: 1px solid var(--prl-line, #ebe7dd); border-left: 4px solid var(--prl-sage, #5b7a4c); border-radius: 8px; }
        .acc-against .who { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; min-width: 0; }
        .acc-against .k { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--prl-ink-faint, #8d8773); font-weight: 500; }
        .acc-against .name { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 600; line-height: 1.2; color: var(--prl-ink, #1d1c17); text-decoration: none; }
        .acc-against a.name:hover { color: var(--prl-sage-d, #2f4426); text-decoration: underline; }
        .acc-against .pick { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; }
        .acc-against .pick label { display: flex; flex-direction: column; gap: 3px; margin: 0; font-size: 11px; font-weight: 500; color: var(--prl-ink-faint, #8d8773); }
        .acc-fold__toggle { display: inline-flex; align-items: center; gap: 8px; padding: 0; border: 0; background: none; font: inherit; color: inherit; cursor: pointer; text-align: left; }
        .acc-fold__toggle:hover { color: var(--prl-sage-d, #2f4426); }
        .acc-fold__chev { width: 7px; height: 7px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(-45deg); transition: transform 0.15s; flex: none; }
        .acc-fold__toggle[aria-expanded="true"] .acc-fold__chev { transform: rotate(45deg); }
        /* El móvil fuerza display: table-row en las filas (acc-keep), que le gana al [hidden]. */
        .prl-table tbody tr.acc-cat-row[hidden] { display: none; }
        .acc-fold__count { font-size: 11px; font-weight: 500; color: var(--prl-ink-faint, #8d8773); }
        .acc-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin: 18px 0; }
    </style>
{% endblock %}

{% block csa_main %}

<div class="prl">

    {{ csa.page_header(
        'Contabilidad · ' ~ year,
        'Cómo vamos' ~ (tracked.throughMonth > 0 ? ' hasta ' ~ months[tracked.throughMonth]|lower : ''),
        'Lo presupuestado frente a lo que de verdad ha pasado, con la proyección de cómo acabará el año.'
    ) }}

    {# ============ CONTRA QUÉ SE MIDE ============ #}
    {# El presupuesto con que se compara es lo primero que hay que saber al leer la
       pantalla: va grande, con el año y el selector al lado. Nada más: los enlaces a
       otras pantallas están en el menú. #}
    <div class="acc-against">
        <div class="who">
            <span class="k">Comparado con</span>
            {% if budget %}
                <a class="name" href="{{ path('accounting_budget_lines', { id: budget.id }) }}">{{ budget.name }}</a>
                {% if budget.inForce %}<span class="prl-chip prl-chip--ok"><span class="dot"></span>en vigor</span>{% endif %}
                {% if not budget.approved %}<span class="prl-chip prl-chip--pausado"><span class="dot"></span>no aprobado</span>{% endif %}
            {% else %}
                <span class="name acc-muted">ningún presupuesto de {{ year }}</span>
                {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
                    <a href="{{ path('accounting_budget_new') }}">hacer uno</a>
                {% endif %}
            {% endif %}
        </div>
        <form method="get" class="pick">
            <label>Año
                <select name="year" class="csa-input" onchange="this.form.submit()">
                    {% for y in years %}
                        <option value="{{ y }}" {{ y == year ? 'selected' : '' }}>{{ y }}</option>
                    {% endfor %}
                </select>
            </label>
            {% if budgets|length > 1 %}
                <label>Cambiar presupuesto
                    <select name="budget" class="csa-input" onchange="this.form.submit()">
                        {% for b in budgets %}
                            <option value="{{ b.id }}" {{ budget and b.id == budget.id ? 'selected' : '' }}>{{ b.name }}</option>
                        {% endfor %}
                    </select>
                </label>
            {% endif %}
        </form>
    </div>

    {# ============ STAT STRIP ============ #}
    {# Las mismas cifras que la portada, cortadas en el último mes completo del libro
       de los bancos (tracked.throughMonth). Debajo, la tabla por partidas, cuya
       fila final es el resultado que las da. #}
    {% set through = tracked.throughMonth %}
    {# Cabecera de las columnas que se cortan en ese mes: «a la fecha» no decía cuál. #}
    {% set upTo = through > 0 ? ' hasta ' ~ months[through]|lower : '' %}
    <div class="prl-stats">
        <div class="prl-stat {{ totalCash < 0 ? 'prl-stat--leave' : 'prl-stat--active' }}">
            <div class="v">{{ totalCash|number_format(0, ',', '.') }} €</div>
            <div class="l">en las cuentas, según el libro</div>
        </div>
        {% if budget %}
            {% include 'accounting/_outlook_stats.html.twig' with { detail: '' } %}
        {% endif %}
    </div>

    {% if not budget %}
        <div class="prl-empty">
            No hay ningún presupuesto cargado para {{ year }}, así que sólo se ve lo real.
        </div>
    {% endif %}

    {# ============ SEGUIMIENTO POR GRUPO ============ #}
    {# Plegada por grupos: lo que se busca al llegar es qué grupo se desvía, y las
       partidas de todos a la vez eran una lista de cincuenta filas. Un tbody por
       grupo, porque una tabla no admite <details>: el botón de la fila del grupo
       muestra u oculta sus partidas. La fila final suma las columnas y es el
       resultado de las cifras de arriba. #}
    <div class="prl-table-wrap" id="partidas">
        <table class="prl-table acc-keep">
            <thead>
                <tr>
                    <th>Partida</th>
                    <th class="tight acc-num">Previsto{{ upTo }}</th>
                    <th class="tight acc-num">Real{{ upTo }}</th>
                    <th class="tight acc-num">Diferencia</th>
                    <th class="tight">Ejecutado</th>
                    <th class="tight acc-num">Previsto al año</th>
                </tr>
            </thead>
            {% for group in tracked.groups %}
                {% set pct = group.budgetTotal != 0 ? (group.actualTotal / group.budgetTotal * 100)|abs|round : null %}
                <tbody class="acc-fold" id="grupo-{{ group.id }}" data-fold>
                    <tr class="acc-group-row">
                        <td>
                            <button type="button" class="acc-fold__toggle" aria-expanded="false" data-fold-toggle>
                                <span class="acc-fold__chev" aria-hidden="true"></span>{{ group.name }}
                                <span class="acc-fold__count">{{ group.categories|length }}</span>
                            </button>
                        </td>
                        <td class="acc-num">{{ fmt.money(group.budgetToDate, false) }}</td>
                        <td class="acc-num">{{ fmt.money(group.actualToDate, false) }}</td>
                        <td class="acc-num">{{ fmt.money(group.deviation, true) }}</td>
                        <td class="tight">
                            {% if pct is not null %}
                                <span class="acc-bar" title="{{ pct }}% de lo previsto para todo el año">
                                    <i class="{{ pct > 100 ? 'over' : '' }}" style="width: {{ min(pct, 100) }}%"></i>
                                </span>
                            {% endif %}
                        </td>
                        <td class="acc-num acc-muted">{{ fmt.money(group.budgetTotal, false) }}</td>
                    </tr>
                    {% for cat in group.categories %}
                        <tr class="acc-cat-row" hidden>
                            <td class="acc-muted"><a href="{{ path('accounting_category_show', { id: cat.id, year: year }) }}">{{ cat.name }}</a></td>
                            <td class="acc-num acc-muted">{{ fmt.money(cat.budgetToDate, false) }}</td>
                            <td class="acc-num">{{ fmt.money(cat.actualToDate, false) }}</td>
                            <td class="acc-num">{{ fmt.money(cat.deviation, true) }}</td>
                            <td></td>
                            <td class="acc-num acc-muted">{{ fmt.money(cat.budgetTotal, false) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            {% else %}
                <tbody>
                    <tr><td colspan="6"><div class="prl-empty">Todavía no hay ningún apunte de {{ year }}.</div></td></tr>
                </tbody>
            {% endfor %}
            {% if tracked.groups is not empty %}
                <tfoot>
                    <tr>
                        <td>Resultado</td>
                        <td class="acc-num">{{ fmt.money(tracked.result.budgetToDate, false) }}</td>
                        <td class="acc-num">{{ fmt.money(tracked.result.actualToDate, false) }}</td>
                        <td class="acc-num">{{ fmt.money(tracked.result.deviation, true) }}</td>
                        <td></td>
                        <td class="acc-num">{{ fmt.money(tracked.result.budgetTotal, false) }}</td>
                    </tr>
                </tfoot>
            {% endif %}
        </table>
    </div>

    <p class="acc-muted" style="margin: 10px 2px 24px; font-size: 12px;">
        Se compara sólo hasta el último mes completo del libro de los bancos
        ({{ months[tracked.throughMonth]|default('ninguno todavía')|lower }}), no el año entero: comparar unos meses de gasto
        contra los doce del presupuesto siempre daría la falsa impresión de que sobra dinero.
        {% if booked.throughMonth > through %}
            Hay apuntes hasta {{ months[booked.throughMonth]|lower }}, pero un mes a medias tiene las cuotas, que se cobran a
            primeros, y no las nóminas, que salen a final de mes: compararlo saldría mejor de lo que es.
        {% endif %}
        Una diferencia positiva es buena para la caja, tanto si es por ingresar de más como
        por gastar de menos.
    </p>

    <div class="acc-cards">

        {# ============ CAJA MES A MES ============ #}
        {% set cashSubtitle = tracked.throughMonth >= 12
            ? 'Todo el año es real'
            : 'Desde ' ~ months[tracked.throughMonth + 1]|lower ~ ' es previsión' %}
        {% embed '_components/csa_card.html.twig' with { title: 'La caja mes a mes', subtitle: cashSubtitle, accent: 'sky', id: 'caja' } %}
            {% block body %}
                <div class="acc-months">
                    {% for m in cash.months %}
                        <div class="m {{ m.projected ? 'proj' : '' }} {{ m.cumulative < 0 ? 'low' : '' }}"
                             title="{{ months[m.month] }}: neto {{ m.net|number_format(2, ',', '.') }} €">
                            <span class="v">{{ m.cumulative|number_format(0, ',', '.') }} €</span>
                            {{ shortMonths[m.month] }}
                        </div>
                    {% endfor %}
                </div>
                <p style="margin: 12px 0 0; font-size: 13px;">
                    {% if cash.fromAccounts %}
                        Arranca de los <b>{{ cash.opening|number_format(2, ',', '.') }} €</b> que había en las cuentas el 1 de enero,
                        y los meses anotados son lo que había en ellas al cerrar cada mes.
                    {% else %}
                        Arranca de los <b>{{ cash.opening|number_format(2, ',', '.') }} €</b> de tesorería que apunta el presupuesto:
                        ese año no se llevaban las cuentas aquí.
                    {% endif %}
                    El año cerraría con <b>{{ cash.endOfYear|number_format(2, ',', '.') }} €</b>.
                    {% if cash.lowest.cumulative < 0 %}
                        El punto más bajo es {{ months[cash.lowest.month]|lower }}, con
                        <b class="acc-neg">{{ cash.lowest.cumulative|number_format(2, ',', '.') }} €</b>.
                    {% endif %}
                </p>
            {% endblock %}
        {% endembed %}

        {# ============ SALDOS ============ #}
        {% embed '_components/csa_card.html.twig' with { title: 'Dónde está el dinero', subtitle: 'Saldo de cada cuenta hoy', accent: 'ochre' } %}
            {% block body %}
                <table class="prl-table" style="margin: 0;">
                    <tbody>
                        {% for row in balances %}
                            <tr>
                                <td><a href="{{ path('accounting_account_show', { id: row.account.id }) }}">{{ row.account.name }}</a><br><span class="acc-muted acc-small">{{ row.account.kindLabel }}</span></td>
                                <td class="acc-num">{{ row.balance|number_format(2, ',', '.') }} €</td>
                            </tr>
                        {% endfor %}
                        <tr>
                            <td><b>Total</b></td>
                            <td class="acc-num"><b>{{ totalCash|number_format(2, ',', '.') }} €</b></td>
                        </tr>
                    </tbody>
                </table>
            {% endblock %}
        {% endembed %}

    </div>

</div>
{% endblock %}

{% block more_js %}
    {{ parent() }}
    <script>
        (function () {
            /** Despliega o pliega las partidas de un grupo. */
            function setOpen(fold, open) {
                fold.querySelector('[data-fold-toggle]').setAttribute('aria-expanded', open ? 'true' : 'false');
                fold.querySelectorAll('.acc-cat-row').forEach(function (row) {
                    row.hidden = !open;
                });
            }

            document.querySelectorAll('[data-fold]').forEach(function (fold) {
                var toggle = fold.querySelector('[data-fold-toggle]');
                toggle.addEventListener('click', function () {
                    setOpen(fold, toggle.getAttribute('aria-expanded') !== 'true');
                });
                // Al entrar en una partida se apunta su grupo en la dirección: al volver
                // atrás se llega a esta misma página con #grupo-N y el grupo sale abierto.
                fold.querySelectorAll('.acc-cat-row a').forEach(function (link) {
                    link.addEventListener('click', function () {
                        history.replaceState(null, '', '#' + fold.id);
                    });
                });
            });

            var back = location.hash && document.getElementById(location.hash.slice(1));
            if (back && back.hasAttribute('data-fold')) {
                setOpen(back, true);
            }
        })();
    </script>
{% endblock %}
