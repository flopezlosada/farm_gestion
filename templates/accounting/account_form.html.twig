{# ============================================================
 # Abrir o cambiar una cuenta.
 #
 # El controller pasa: form, account (null al crear), entryCount, heading.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}{{ heading }} · Cuentas{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_accounts') }}">Cuentas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ account ? 'Cambiar' : 'Nueva' }}</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header(
        'Contabilidad · Cuentas',
        heading,
        'Una cuenta bancaria o una caja de efectivo.'
    ) }}

    {% if entryCount > 0 %}
        <div class="csa-form-narrow">
            {{ csa.callout(
                'Esta cuenta ya tiene ' ~ entryCount ~ ' apunte' ~ (entryCount == 1 ? '' : 's') ~ ', así que el saldo de apertura queda fijo: cambiarlo movería todos los saldos desde entonces.',
                'warning',
                'lock'
            ) }}
        </div>
    {% endif %}

    {{ form_start(form, { attr: { class: 'csa-form-narrow', 'data-csa-dropdowns': '1' } }) }}

        {{ form_errors(form) }}

        <div class="csa-stack-lg">

            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'La cuenta', subtitle: 'Cómo se llama y de qué tipo es.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.name, 'Nombre', { full: true, hint: 'como la llamáis entre vosotras' }) }}
                        {{ csa.field(form.kind, 'Tipo', { widget_class: 'csa-select' }) }}
                        {{ csa.field(form.iban, 'IBAN', { hint: 'sólo si es bancaria' }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '2', title: 'Punto de partida', subtitle: 'El saldo con el que la cuenta entra en la aplicación.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.openingBalance, 'Saldo inicial', { hint: 'el que tiene ese día' }) }}
                        {{ csa.field(form.openingDate, 'A fecha de', { hint: 'los apuntes anteriores no cuentan' }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '3', title: 'Presentación', subtitle: 'Dónde aparece y si sigue en uso.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.sortOrder, 'Orden', { hint: 'menor, antes' }) }}
                    </div>
                    <div class="csa-form-grid" style="margin-top: var(--csa-sp-4);">
                        <label style="display:inline-flex; align-items:center; gap: var(--csa-sp-2);">
                            {{ form_widget(form.active) }} <span>Abierta: se ofrece al anotar</span>
                        </label>
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: path('accounting_accounts') }) }}
                    {{ form_widget(form.submit, { attr: { class: 'csa-btn csa-btn--primary' } }) }}
                </div>
            </div>

        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}
{% endblock %}
