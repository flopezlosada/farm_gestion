{# ============================================================
 # Cierre del año para la asamblea: una hoja para imprimir desde el navegador.
 #
 # Lo previsto frente a lo real por grupo, el resultado, y el saldo de cada cuenta
 # al empezar y al acabar el año, con el cuadre entre la variación de los saldos y
 # el resultado. Sin dompdf: el navegador imprime a PDF mejor y sin dependencias.
 #
 # El controller pasa:
 #   year, budget             año y presupuesto aprobado (o null)
 #   tracked                  BudgetTracker::track del año entero
 #   balances                 por cuenta: account, openedDuringYear, start, end
 #   result, budgetResult     resultado real y previsto del año
 #   variation                lo que cambiaron los saldos de todas las cuentas
 #   unexplained              variación menos resultado (0 si cuadra)
 #   yearClosed               si el año ya acabó
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Cuentas {{ year }} · Para la asamblea{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_year', { year: year }) }}">Resumen {{ year }}</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Para la asamblea</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .acc-doc { max-width: 820px; }
        .acc-doc h2 { font-size: 16px; margin: 26px 0 8px; }
        .acc-doc .prl-table td, .acc-doc .prl-table th { padding-top: 6px; padding-bottom: 6px; }
        .acc-doc tr.acc-total td { font-weight: 700; border-top: 2px solid rgba(0, 0, 0, 0.25); }
        @media print {
            @page { size: A4; margin: 16mm 14mm; }
            .csa-sidebar, .csa-sidebar-overlay, .csa-topbar, .acc-no-print { display: none !important; }
            .csa-shell, .csa-main, .csa-content { display: block !important; margin: 0 !important; padding: 0 !important; width: auto !important; min-height: 0 !important; height: auto !important; }
            html, body { height: auto !important; min-height: 0 !important; }
            body { background: #fff !important; }
            .prl-table-wrap { box-shadow: none !important; border: 0 !important; overflow: visible !important; }
            .acc-doc { max-width: none; }
            .acc-doc h2, .acc-doc tr { break-inside: avoid; }
            a { color: inherit !important; text-decoration: none !important; }
            /* El A4 cae por debajo del corte móvil de .prl-table, que apila las
               celdas como tarjetas: en papel tiene que ser una tabla. */
            .acc-doc .prl-table { display: table !important; width: 100% !important; }
            .acc-doc .prl-table thead { display: table-header-group !important; }
            .acc-doc .prl-table tbody { display: table-row-group !important; }
            .acc-doc .prl-table tr { display: table-row !important; padding: 0 !important; }
            .acc-doc .prl-table td, .acc-doc .prl-table th { display: table-cell !important; padding: 5px 8px !important; border-bottom: 1px solid #ddd !important; }
            .acc-doc .prl-table td::before { content: none !important; }
        }
    </style>
{% endblock %}

{% block csa_main %}
<div class="prl acc-doc">

    {{ csa.page_header(
        'Asociación · Asamblea',
        'Cuentas de ' ~ year,
        budget
            ? 'Lo previsto en «' ~ budget.name ~ '» frente a lo que de verdad entró y salió, y el dinero de cada cuenta al empezar y al acabar el año.'
            : 'Lo que de verdad entró y salió, y el dinero de cada cuenta al empezar y al acabar el año. No hay presupuesto aprobado de ' ~ year ~ ' con el que compararlo.'
    ) }}

    <div class="prl-toolbar acc-no-print">
        {% if not yearClosed %}
            <span class="prl-chip prl-chip--pausado"><span class="dot"></span>{{ year }} todavía no ha acabado: las cifras son hasta hoy</span>
        {% endif %}
        <div class="spacer"></div>
        <button type="button" class="prl-btn prl-btn--primary" onclick="window.print()"><i class="fa fa-print"></i> Imprimir o guardar en PDF</button>
    </div>

    {# ============ RESULTADO ============ #}
    <h2>Resultado del año</h2>
    <div class="prl-table-wrap">
        <table class="prl-table">
            <thead>
                <tr>
                    <th></th>
                    {% if budget %}<th class="tight acc-num">Previsto</th>{% endif %}
                    <th class="tight acc-num">Real</th>
                    {% if budget %}<th class="tight acc-num">Diferencia</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for total in tracked.totals %}
                    <tr>
                        <td>{{ total.name }}</td>
                        {% if budget %}<td class="acc-num">{{ fmt.money(total.budgetTotal, false) }}</td>{% endif %}
                        <td class="acc-num">{{ fmt.money(total.actualTotal, false) }}</td>
                        {% if budget %}<td class="acc-num">{{ fmt.money(total.actualTotal - total.budgetTotal, true) }}</td>{% endif %}
                    </tr>
                {% endfor %}
                <tr class="acc-total">
                    <td>Resultado</td>
                    {% if budget %}<td class="acc-num">{{ fmt.money(budgetResult, false) }}</td>{% endif %}
                    <td class="acc-num">{{ fmt.money(result, false) }}</td>
                    {% if budget %}<td class="acc-num">{{ fmt.money(result - budgetResult, true) }}</td>{% endif %}
                </tr>
            </tbody>
        </table>
    </div>

    {# ============ POR GRUPO ============ #}
    <h2>Por grupo de partidas</h2>
    <div class="prl-table-wrap">
        <table class="prl-table">
            <thead>
                <tr>
                    <th>Grupo</th>
                    {% if budget %}<th class="tight acc-num">Previsto</th>{% endif %}
                    <th class="tight acc-num">Real</th>
                    {% if budget %}<th class="tight acc-num">Diferencia</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for group in tracked.groups %}
                    <tr>
                        <td>{{ group.name }} <span class="acc-muted acc-small">· {{ group.kindLabel|lower }}</span></td>
                        {% if budget %}<td class="acc-num">{{ fmt.money(group.budgetTotal, false) }}</td>{% endif %}
                        <td class="acc-num">{{ fmt.money(group.actualTotal, false) }}</td>
                        {% if budget %}<td class="acc-num">{{ fmt.money(group.deviation, true) }}</td>{% endif %}
                    </tr>
                {% else %}
                    <tr><td colspan="4"><div class="prl-empty">No hay ningún apunte de {{ year }}.</div></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# ============ CUENTAS ============ #}
    <h2>Dónde estaba el dinero</h2>
    <div class="prl-table-wrap">
        <table class="prl-table">
            <thead>
                <tr>
                    <th>Cuenta</th>
                    <th class="tight acc-num">1 de enero</th>
                    <th class="tight acc-num">31 de diciembre</th>
                    <th class="tight acc-num">Variación</th>
                </tr>
            </thead>
            <tbody>
                {% for row in balances %}
                    <tr>
                        <td>
                            {{ row.account.name }} <span class="acc-muted acc-small">· {{ row.account.kindLabel|lower }}</span>
                            {% if row.openedDuringYear %}<br><span class="acc-muted acc-small">abierta el {{ row.account.openingDate|date('d/m/Y') }}: la primera cifra es su saldo de apertura</span>{% endif %}
                        </td>
                        <td class="acc-num">{{ fmt.money(row.start, false) }}</td>
                        <td class="acc-num">{{ fmt.money(row['end'], false) }}</td>
                        <td class="acc-num">{{ fmt.money(row['end'] - row.start, true) }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4"><div class="prl-empty">En {{ year }} no había ninguna cuenta abierta en la aplicación.</div></td></tr>
                {% endfor %}
                <tr class="acc-total">
                    <td>Total</td>
                    <td class="acc-num">{{ fmt.money(balances|reduce((sum, r) => sum + r.start, 0), false) }}</td>
                    <td class="acc-num">{{ fmt.money(balances|reduce((sum, r) => sum + r['end'], 0), false) }}</td>
                    <td class="acc-num">{{ fmt.money(variation, true) }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    {% if balances is not empty %}
    <p class="acc-small" style="margin: 10px 2px;">
        {% if unexplained == 0 %}
            El dinero de las cuentas cambió exactamente lo que dice el resultado: las cuentas cuadran.
        {% else %}
            El dinero de las cuentas cambió {{ fmt.money(variation, true) }} y el resultado es {{ fmt.money(result, true) }}:
            hay <b>{{ fmt.money(unexplained, true) }}</b> sin explicar. Suele ser un traspaso entre cuentas con las dos mitades de importe distinto, o un apunte en una cuenta antes de su fecha de apertura; hay que revisarlo antes de la asamblea.
        {% endif %}
    </p>
    {% endif %}

</div>
{% endblock %}
