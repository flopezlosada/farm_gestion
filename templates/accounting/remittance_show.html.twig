{# ============================================================
 # Una remesa.
 #
 # Borrador: lo que impide enviarla, los avisos de cada recibo (no casa con
 # sus cestas, de baja, sin socix), las familias con cesta y sin recibo, y
 # los botones de añadir, cambiar y quitar recibos, descargar el Excel y
 # darla por enviada. Enviada: tal como salió.
 #
 # En las dos, lo que cambia respecto a la remesa anterior del mismo tipo.
 #
 # El controller pasa: remittance, previous, problems, warnings (por id de
 # recibo), withoutLine, changes.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% set can_edit = is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
{% set editable = can_edit and remittance.draft %}
{% set can_see_partners = is_granted('ROLE_GESTION_SOCIXS') %}
{% set warned = warnings|filter(w => w is not empty)|length %}

{% block title %}{{ remittance.label }} · Remesas{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_remittances') }}">Remesas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ remittance.period|date('m/Y') }}</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .rem-actions { display: flex; flex-wrap: wrap; gap: 8px; }
        .rem-actions form { display: inline; }
        .rem-warn { color: var(--csa-warning-ink, #8a5a00); font-size: 12.5px; line-height: 1.35; }
        .rem-warn li { margin: 0; }
        .rem-warn ul { margin: 2px 0 0; padding-left: 16px; }
        tr.rem-has-warn td { background: var(--csa-warning-bg, #fff8e6); }
        .rem-box { margin-bottom: var(--csa-sp-5, 20px); }
        .rem-box ul { margin: 4px 0 0; padding-left: 18px; }
        .rem-inline-form { display: inline; }
    </style>
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad · Remesas',
        remittance.label,
        remittance.kindLabel ~ ' de ' ~ remittance.period|date('m/Y') ~ ' · '
            ~ (remittance.draft
                ? 'borrador'
                : (remittance.imported ? 'importada de «' ~ remittance.importedFrom ~ '»' : 'enviada el ' ~ remittance.sentAt|date('d/m/Y') ~ (remittance.sentBy ? ' por ' ~ remittance.sentBy.displayName : '')))
    ) }}

    <div class="prl-stats">
        <div class="prl-stat"><b>{{ remittance.lines|length }}</b><span>recibos</span></div>
        <div class="prl-stat"><b>{{ fmt.money(remittance.total) }}</b><span>en total</span></div>
        {% if remittance.draft %}
            <div class="prl-stat"><b>{{ warned }}</b><span>{{ warned == 1 ? 'recibo' : 'recibos' }} con avisos</span></div>
        {% endif %}
    </div>

    <div class="prl-toolbar">
        <div class="rem-actions">
            <a href="{{ path('accounting_remittance_xlsx', { id: remittance.id }) }}" class="prl-btn"><i class="fa fa-file-excel-o"></i> Descargar el Excel</a>
            {% if editable %}
                <a href="{{ path('accounting_remittance_line_new', { id: remittance.id }) }}" class="prl-btn"><i class="fa fa-plus"></i> Añadir recibo</a>
            {% endif %}
            {% if can_edit and remittance.deletable %}
                <form method="post" action="{{ path('accounting_remittance_delete', { id: remittance.id }) }}" onsubmit="return confirm('¿Tirar esta remesa entera? {{ remittance.draft ? 'Es un borrador: no se ha enviado al banco.' : 'Es una importada: se puede volver a importar el Excel.' }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-remittance-' ~ remittance.id) }}">
                    <button type="submit" class="prl-btn"><i class="fa fa-trash-o"></i> Tirar</button>
                </form>
            {% endif %}
        </div>
        <div class="spacer"></div>
        {% if editable %}
            <form method="post" action="{{ path('accounting_remittance_send', { id: remittance.id }) }}" onsubmit="return confirm('¿Ya se ha subido al banco? Desde aquí la remesa no se puede cambiar.');">
                <input type="hidden" name="_token" value="{{ csrf_token('send-remittance-' ~ remittance.id) }}">
                <button type="submit" class="prl-btn prl-btn--primary"{{ problems is not empty ? ' disabled' }}><i class="fa fa-check"></i> Ya está enviada</button>
            </form>
        {% endif %}
    </div>

    {% if remittance.draft %}
        {% if problems is not empty %}
            <div class="csa-alert csa-alert--warning rem-box" role="status">
                <i class="csa-alert__icon fa fa-exclamation-triangle" aria-hidden="true"></i>
                <div class="csa-alert__body">
                    El banco rechazaría esta remesa. Falta arreglar:
                    <ul>{% for problem in problems %}<li>{{ problem }}</li>{% endfor %}</ul>
                </div>
            </div>
        {% else %}
            <div class="csa-alert csa-alert--info rem-box" role="status">
                <i class="csa-alert__icon fa fa-info-circle" aria-hidden="true"></i>
                <div class="csa-alert__body">Los recibos están completos. Revisa los avisos, descarga el Excel, súbelo a Fiare y vuelve a marcarla como enviada.</div>
            </div>
        {% endif %}
    {% endif %}

    {% if withoutLine is not empty %}
        <h2 class="acc-subhead">Con cesta este mes y sin recibo</h2>
        <p class="acc-muted">Puede que paguen por transferencia. Si es un alta, añádele su recibo.</p>
        <div class="prl-table-wrap rem-box">
            <table class="prl-table">
                <tbody>
                    {% for row in withoutLine %}
                        <tr>
                            <td>{% if can_see_partners %}<a href="{{ path('partner_show', { id: row.partner.id }) }}">{{ row.partner.legalName }}</a>{% else %}{{ row.partner.legalName }}{% endif %}</td>
                            <td class="tight acc-num">{{ fmt.money(row.amount) }} al mes</td>
                            {% if editable %}
                                <td class="tight"><a href="{{ path('accounting_remittance_line_new', { id: remittance.id, partner: row.partner.id }) }}" class="prl-btn"><i class="fa fa-plus"></i> Añadir su recibo</a></td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if previous %}
        <h2 class="acc-subhead">Cambios respecto a <a href="{{ path('accounting_remittance_show', { id: previous.id }) }}">{{ previous.label }}</a></h2>
        {% if changes is empty %}
            <p class="acc-muted rem-box">Ninguno: se cobra lo mismo a las mismas personas.</p>
        {% else %}
            <div class="prl-table-wrap rem-box">
                <table class="prl-table">
                    <thead>
                        <tr>
                            <th>Quién</th>
                            <th class="tight">Qué</th>
                            <th class="tight acc-num">Antes</th>
                            <th class="tight acc-num">Ahora</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for c in changes %}
                            <tr>
                                <td>{{ c.name }}</td>
                                <td class="tight">{{ { new: 'Entra', gone: 'Sale', amount: 'Cambia' }[c.change] }}</td>
                                <td class="acc-num">{{ c.before is not null ? fmt.money(c.before) : '—' }}</td>
                                <td class="acc-num">{{ c.after is not null ? fmt.money(c.after) : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}

    <h2 class="acc-subhead">Recibos</h2>
    <div class="prl-table-wrap">
        {% if remittance.lines is empty %}
            <div class="prl-empty">Ningún recibo todavía.</div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th>Quien paga</th>
                        <th class="tight">Cuenta</th>
                        <th class="tight">Mandato</th>
                        <th class="tight">Firma</th>
                        <th class="tight">Ref. adeudo</th>
                        <th class="tight">Tipo</th>
                        <th class="tight acc-num">Importe</th>
                        {% if editable %}<th class="tight"></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for line in remittance.lines %}
                        {% set w = warnings[line.id] ?? [] %}
                        <tr{{ w is not empty ? ' class="rem-has-warn"' }}>
                            <td>
                                {{ line.debtorName }}
                                {% if line.partner %}<br>{% if can_see_partners %}<a class="acc-muted acc-small" href="{{ path('partner_show', { id: line.partner.id }) }}">{{ line.partner.legalName }}</a>{% else %}<span class="acc-muted acc-small">{{ line.partner.legalName }}</span>{% endif %}{% endif %}
                                {% if w is not empty %}<div class="rem-warn"><ul>{% for msg in w %}<li>{{ msg }}</li>{% endfor %}</ul></div>{% endif %}
                            </td>
                            <td class="tight acc-muted" title="{{ editable ? line.iban }}">{{ line.maskedIban }}</td>
                            <td class="tight">{{ line.mandateReference }}</td>
                            <td class="tight">{{ line.mandateSignedOn ? line.mandateSignedOn|date('d/m/Y') : '—' }}</td>
                            <td class="tight">{{ line.debitReference }}</td>
                            <td class="tight">{{ line.sequenceType }}</td>
                            <td class="acc-num">{{ fmt.money(line.amount) }}</td>
                            {% if editable %}
                                <td class="tight">
                                    <a href="{{ path('accounting_remittance_line_edit', { id: line.id }) }}" title="Cambiar"><i class="fa fa-pencil"></i></a>
                                    <form method="post" class="rem-inline-form" action="{{ path('accounting_remittance_line_delete', { id: line.id }) }}" onsubmit="return confirm('¿Quitar el recibo de {{ line.debtorName|e('js') }}?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-remittance-line-' ~ line.id) }}">
                                        <button type="submit" class="prl-btn" title="Quitar"><i class="fa fa-trash-o"></i></button>
                                    </form>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

</div>
{% endblock %}
