{# ============================================================
 # Pendiente — la portada de contabilidad.
 #
 # Responde a «¿qué tengo que hacer?»: el libro al día y el paquete de la gestoría
 # completo. Arriba, tres cifras; debajo, las tareas de AccountingAgenda, cada una
 # con su enlace. «Cómo vamos» está en Informes.
 #
 # El controller pasa:
 #   year                       año en curso
 #   items                      list<AgendaItem>, ya ordenadas
 #   balances                   por cuenta: account, balance, lastDate, stale
 #   totalCash                  suma de saldos
 #   bookUpTo                   el último apunte más antiguo de las cuentas de banco
 #                              que tienen alguno (null si ninguna tiene)
 #   staleBook                  si alguna cuenta de banco lleva más de 30 días sin apuntes
 #   resultToDate, budgetToDate resultado real y previsto hasta el último mes anotado
 #   hasBudget                  si hay presupuesto aprobado del año
 #   unpairedTransfers          traspasos a los que les falta la otra mitad
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Contabilidad · Pendiente{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Contabilidad</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .acc-todo { list-style: none; margin: 0; padding: 0; }
        .acc-todo > li { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border-top: 1px solid rgba(0, 0, 0, 0.06); }
        .acc-todo > li:first-child { border-top: 0; }
        .acc-todo .t { font-weight: 600; }
        .acc-todo .d { margin: 4px 0 0; padding: 0; list-style: none; font-size: 13px; }
        .acc-todo .go { margin-left: auto; white-space: nowrap; }
        .acc-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 18px 0; }
    </style>
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad',
        'Pendiente',
        'Lo que queda por hacer para que el libro esté al día y a la gestoría le llegue el trimestre completo.'
    ) }}

    <div class="prl-toolbar">
        <div class="spacer"></div>
        <a href="{{ path('accounting_ledger') }}" class="prl-btn"><i class="fa fa-list"></i> Movimientos</a>
        {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
            <a href="{{ path('accounting_entry_new') }}" class="prl-btn prl-btn--primary"><i class="fa fa-plus"></i> Anotar apunte</a>
        {% endif %}
    </div>

    {# ============ TRES CIFRAS ============ #}
    <div class="prl-stats">
        <div class="prl-stat {{ totalCash < 0 ? 'prl-stat--leave' : 'prl-stat--active' }}">
            <div class="v">{{ totalCash|number_format(0, ',', '.') }} €</div>
            <div class="l">hay hoy en las cuentas</div>
        </div>
        <div class="prl-stat {{ staleBook ? 'prl-stat--leave' : 'prl-stat--active' }}">
            <div class="v">{{ bookUpTo ? bookUpTo|date('d/m/Y') : '—' }}</div>
            <div class="l">{{ bookUpTo ? 'libro de los bancos al día hasta' : 'ningún banco tiene apuntes' }}</div>
        </div>
        {% if hasBudget %}
            {% set deviation = resultToDate - budgetToDate %}
            <div class="prl-stat {{ deviation < 0 ? 'prl-stat--leave' : 'prl-stat--active' }}">
                <div class="v">{{ resultToDate|number_format(0, ',', '.') }} €</div>
                <div class="l">
                    resultado de {{ year }}, frente a {{ budgetToDate|number_format(0, ',', '.') }} € previstos a la fecha
                    · <a href="{{ path('accounting_report') }}">cómo vamos</a>
                </div>
            </div>
        {% else %}
            <div class="prl-stat">
                <div class="v">{{ resultToDate|number_format(0, ',', '.') }} €</div>
                <div class="l">resultado de {{ year }}; no hay presupuesto aprobado con que compararlo</div>
            </div>
        {% endif %}
    </div>

    {# ============ POR HACER ============ #}
    <div class="prl-table-wrap">
        {% if items is empty %}
            <div class="prl-empty">Todo al día: no hay nada pendiente.</div>
        {% else %}
            <ul class="acc-todo">
                {% for item in items %}
                    {% set url = path(item.route, item.routeParams) ~ (item.fragment ? '#' ~ item.fragment : '') %}
                    <li>
                        <span class="prl-chip prl-chip--{{ item.urgency.name == 'Soon' ? 'pausado' : 'activo' }}" title="{{ item.urgency.name == 'Soon' ? 'Se acaba el plazo' : 'Pendiente' }}"><span class="dot"></span></span>
                        <div>
                            <a href="{{ url }}" class="t">{{ item.title }}</a>
                            {% if item.details is not empty %}
                                <ul class="d acc-muted">
                                    {% for detail in item.details %}<li>{{ detail }}</li>{% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                        <a href="{{ url }}" class="prl-btn go">Ir <i class="fa fa-arrow-right"></i></a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <div class="acc-cards">
        {# ============ SALDOS Y ÚLTIMO APUNTE ============ #}
        {% embed '_components/csa_card.html.twig' with { title: 'Dónde está el dinero', subtitle: 'Saldo de cada cuenta y su último apunte', accent: 'ochre' } %}
            {% block body %}
                <table class="prl-table" style="margin: 0;">
                    <tbody>
                        {% for row in balances %}
                            <tr>
                                <td>
                                    <a href="{{ path('accounting_ledger', { account: row.account.id }) }}">{{ row.account.name }}</a><br>
                                    <span class="acc-small {{ row.stale ? 'acc-neg' : 'acc-muted' }}">
                                        {{ row.lastDate ? 'último apunte ' ~ row.lastDate|date('d/m/Y') : 'sin apuntes' }}
                                    </span>
                                </td>
                                <td class="acc-num">{{ row.balance|number_format(2, ',', '.') }} €</td>
                            </tr>
                        {% endfor %}
                        <tr>
                            <td><b>Total</b></td>
                            <td class="acc-num"><b>{{ totalCash|number_format(2, ',', '.') }} €</b></td>
                        </tr>
                    </tbody>
                </table>
            {% endblock %}
        {% endembed %}
    </div>

    {# ============ TRASPASOS SIN PAREJA ============ #}
    {% if unpairedTransfers|length > 0 %}
        <div class="prl-table-wrap" id="traspasos">
            <table class="prl-table">
                <thead>
                    <tr><th colspan="4">Traspasos a los que les falta la otra mitad</th></tr>
                </thead>
                <tbody>
                    {% for entry in unpairedTransfers %}
                        <tr>
                            <td class="tight">{{ entry.date ? entry.date|date('d/m/Y') : '—' }}</td>
                            <td>{{ entry.account.name }}</td>
                            <td><a href="{{ path('accounting_entry_show', { id: entry.id }) }}">{{ entry.concept }}</a></td>
                            <td class="acc-num">{{ fmt.money(entry.amount, false) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="acc-muted" style="margin: 10px 2px; font-size: 12px;">
            Un traspaso mueve dinero de una cuenta propia a otra, así que tiene dos apuntes
            que se anulan. Los de esta lista sólo tienen uno: o falta anotar el otro lado, o
            uno de los dos lleva un importe distinto.
        </p>
    {% endif %}

</div>
{% endblock %}
