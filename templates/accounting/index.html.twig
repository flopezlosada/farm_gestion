{# ============================================================
 # Inicio de contabilidad.
 #
 # Responde de un vistazo a «¿cómo están las cuentas?» y «¿qué tengo que hacer?».
 # Arriba, cuatro cifras; debajo, a dos columnas, el saldo de cada cuenta y las tareas
 # de AccountingAgenda, cada una con su enlace. «Cómo vamos» está en Informes.
 #
 # El controller pasa:
 #   year                       año en curso
 #   items                      list<AgendaItem>, ya ordenadas
 #   balances                   por cuenta: account, balance, lastDate, stale
 #   totalCash                  suma de saldos
 #   bookUpTo                   el último apunte más antiguo de las cuentas de banco
 #                              que tienen alguno (null si ninguna tiene)
 #   staleBook                  si alguna cuenta de banco lleva más de 30 días sin apuntes
 #   complete                   el año cortado en el último mes completo del libro de
 #                              los bancos: throughMonth, actual y budget (resultado
 #                              real y previsto hasta ahí) y endOfYear (caja a 31-dic)
 #   booked                     lo mismo cortado en el último mes con apuntes
 #   months                     nombre de cada mes
 #   hasBudget                  si hay presupuesto del año (el en vigor o, si no, el aprobado)
 #   unpairedTransfers          traspasos a los que les falta la otra mitad
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Contabilidad{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Contabilidad</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .acc-todo { list-style: none; margin: 0; padding: 0; }
        .acc-todo > li + li { border-top: 1px solid var(--prl-line, #ebe7dd); }
        /* La tarea entera es el enlace: el título dice qué hacer y la flecha, adónde. */
        .acc-todo a.task { display: grid; grid-template-columns: 10px minmax(0, 1fr) 14px; gap: 12px; align-items: start; padding: 12px 14px; color: inherit; text-decoration: none; }
        .acc-todo a.task:hover { background: var(--prl-sage-l, #eaf0e2); }
        .acc-todo .dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 6px; background: var(--prl-sage, #5b7a4c); }
        .acc-todo .dot.soon { background: var(--prl-ochre, #c89a3a); box-shadow: 0 0 0 3px var(--prl-ochre-l, #faf1d8); }
        .acc-todo .t { font-size: 13.5px; font-weight: 500; line-height: 1.4; color: var(--prl-ink, #1d1c17); }
        .acc-todo a.task:hover .t { color: var(--prl-sage-d, #2f4426); }
        .acc-todo .d { margin: 3px 0 0; padding: 0; list-style: none; font-size: 12.5px; line-height: 1.5; color: var(--prl-ink-soft, #5a564a); }
        .acc-todo .go { margin-top: 3px; font-size: 11px; color: var(--prl-ink-faint, #8d8773); }
        .acc-todo a.task:hover .go { color: var(--prl-sage-d, #2f4426); }
    </style>
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad',
        'Las cuentas de ' ~ year,
        'El dinero de cada cuenta, cómo va el año y lo que queda por hacer para que el libro esté al día y a la gestoría le llegue el trimestre completo.'
    ) }}

    <div class="prl-toolbar">
        <div class="spacer"></div>
        <a href="{{ path('accounting_ledger') }}" class="prl-btn"><i class="fa fa-list"></i> Movimientos</a>
        {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
            <a href="{{ path('accounting_entry_new') }}" class="prl-btn prl-btn--primary"><i class="fa fa-plus"></i> Anotar apunte</a>
        {% endif %}
        {{ csa.help('contabilidad', 'ritmo', 'Ayuda: cómo se lleva la contabilidad') }}
    </div>

    {# ============ CUATRO CIFRAS ============ #}
    <div class="prl-stats">
        <div class="prl-stat {{ totalCash < 0 ? 'prl-stat--leave' : 'prl-stat--active' }}">
            <div class="v">{{ totalCash|number_format(0, ',', '.') }} €</div>
            <div class="l">en las cuentas, según el libro</div>
        </div>
        <div class="prl-stat {{ staleBook ? 'prl-stat--leave' : 'prl-stat--active' }}">
            <div class="v">{{ bookUpTo ? bookUpTo|date('d/m/Y') : '—' }}</div>
            <div class="l">{{ bookUpTo ? 'libro de los bancos al día hasta' : 'ningún banco tiene apuntes' }}</div>
        </div>
        {% if hasBudget %}
            {% include 'accounting/_outlook_stats.html.twig' with { detail: path('accounting_report') } %}
        {% else %}
            <div class="prl-stat">
                <div class="v">{{ booked.actual|number_format(0, ',', '.') }} €</div>
                <div class="l">resultado de {{ year }}; no hay presupuesto con que compararlo</div>
            </div>
        {% endif %}
    </div>

    <div class="acc-split">
        {# ============ SALDOS Y ÚLTIMO APUNTE ============ #}
        <section>
            <div class="acc-section-head">
                <div>
                    <h2 class="acc-subhead">Dónde está el dinero</h2>
                    <p class="acc-lead">Saldo de cada cuenta según el libro. Pulsa una para ver sus movimientos.</p>
                </div>
            </div>
            <div class="prl-table-wrap">
                <table class="prl-table acc-keep">
                    <thead>
                        <tr>
                            <th>Cuenta</th>
                            <th class="tight">Último apunte</th>
                            <th class="acc-num">Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in balances %}
                            <tr>
                                <td>
                                    <a href="{{ path('accounting_ledger', { account: row.account.id }) }}" class="acc-strong">{{ row.account.name }}</a>
                                    {% if row.account.card and row.balance != 0 %}
                                        <br><span class="acc-small {{ row.balance > 0 ? 'acc-neg' : 'acc-muted' }}">
                                            {{ row.balance < 0 ? 'compras pendientes de liquidar' : 'liquidación sin sus compras' }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="tight {{ row.stale ? 'acc-neg' : 'acc-muted' }}" title="{{ row.stale ? 'Lleva más de 30 días sin apuntes' : '' }}">
                                    {{ row.lastDate ? row.lastDate|date('d/m/Y') : 'sin apuntes' }}
                                </td>
                                <td class="acc-num">{{ row.balance|number_format(2, ',', '.') }} €</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2">Total</td>
                            <td class="acc-num">{{ totalCash|number_format(2, ',', '.') }} €</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        {# ============ POR HACER ============ #}
        <section>
            <div class="acc-section-head">
                <div>
                    <h2 class="acc-subhead">Por hacer{% if items is not empty %} <span class="count">{{ items|length }}</span>{% endif %}</h2>
                    <p class="acc-lead">Primero lo que tiene plazo. Cada tarea lleva a la pantalla donde se hace.</p>
                </div>
            </div>
            {% if items is empty %}
                <div class="acc-done"><i class="fa fa-check"></i> Todo al día: no hay nada pendiente.</div>
            {% else %}
                <div class="prl-table-wrap">
                    <ul class="acc-todo">
                        {% for item in items %}
                            {% set soon = item.urgency.name == 'Soon' %}
                            <li>
                                <a class="task" href="{{ path(item.route, item.routeParams) ~ (item.fragment ? '#' ~ item.fragment : '') }}">
                                    <span class="dot {{ soon ? 'soon' : '' }}" title="{{ soon ? 'Se acaba el plazo' : 'Pendiente' }}"></span>
                                    <span>
                                        <span class="t">{{ item.title }}</span>
                                        {% if item.details is not empty %}
                                            <ul class="d">
                                                {% for detail in item.details %}<li>{{ detail }}</li>{% endfor %}
                                            </ul>
                                        {% endif %}
                                    </span>
                                    <i class="fa fa-chevron-right go" aria-hidden="true"></i>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </section>
    </div>

    {# ============ TRASPASOS SIN PAREJA ============ #}
    {% if unpairedTransfers|length > 0 %}
        <section id="traspasos">
            <div class="acc-section-head">
                <div>
                    <h2 class="acc-subhead">Traspasos a los que les falta la otra mitad <span class="count">{{ unpairedTransfers|length }}</span></h2>
                    <p class="acc-lead">
                        Un traspaso mueve dinero de una cuenta propia a otra, así que tiene dos apuntes
                        que se anulan. Éstos sólo tienen uno: o falta anotar el otro lado, o uno de los
                        dos lleva un importe distinto.
                    </p>
                </div>
            </div>
            <div class="prl-table-wrap">
                <table class="prl-table">
                    <thead>
                        <tr>
                            <th class="tight">Fecha</th>
                            <th class="tight">Cuenta</th>
                            <th>Concepto</th>
                            <th class="acc-num">Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in unpairedTransfers %}
                            <tr>
                                <td class="tight">{{ entry.date ? entry.date|date('d/m/Y') : '—' }}</td>
                                <td class="tight">{{ entry.account.name }}</td>
                                <td><a href="{{ path('accounting_entry_show', { id: entry.id }) }}">{{ entry.concept }}</a></td>
                                <td class="acc-num">{{ fmt.money(entry.amount, false) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}

</div>
{% endblock %}
