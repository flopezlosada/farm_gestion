{# ============================================================
 # La ficha de una cuenta: su saldo, lo que tenía al cerrar cada mes del año y sus
 # últimos apuntes. Todos los apuntes, en el libro filtrado por la cuenta.
 #
 # El controller pasa: account, balance (hoy), count (nº de apuntes), year,
 # balances (mes => saldo al cerrarlo, null si la cuenta aún no existía), months
 # (rótulos cortos), recent, invoices (apunte => factura, para el clip).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}
{% import 'accounting/_entries.html.twig' as rows %}

{% block title %}{{ account.name }} · Cuentas{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_accounts') }}">Cuentas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ account.name }}</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header('Contabilidad · Cuentas', account.name, account.kindLabel ~ (account.active ? '' : ' · retirada')) }}

    <div class="prl-toolbar">
        <div class="spacer"></div>
        {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') and account.active %}
            <a href="{{ path('accounting_entry_new', { account: account.id }) }}" class="prl-btn prl-btn--primary"><i class="fa fa-plus"></i> Anotar apunte</a>
        {% endif %}
        {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
            <a href="{{ path('accounting_account_edit', { id: account.id }) }}" class="prl-btn"><i class="fa fa-pencil"></i> Cambiar datos</a>
        {% endif %}
    </div>

    <div class="prl-stats">
        <div class="prl-stat {{ balance < 0 ? 'prl-stat--leave' : 'prl-stat--active' }}">
            <div class="v">{{ balance|number_format(2, ',', '.') }} €</div>
            <div class="l">saldo hoy, según el libro</div>
        </div>
        <div class="prl-stat">
            <div class="v">{{ account.openingBalance|number_format(2, ',', '.') }} €</div>
            <div class="l">al abrirla{{ account.openingDate ? ', el ' ~ account.openingDate|date('d/m/Y') : '' }}</div>
        </div>
        <div class="prl-stat">
            <div class="v">{{ count }}</div>
            <div class="l">{{ count == 1 ? 'apunte' : 'apuntes' }}</div>
        </div>
    </div>

    {% if account.iban %}
        <dl class="acc-facts">
            <dt>IBAN</dt>
            <dd>{{ account.iban }}</dd>
        </dl>
    {% endif %}

    {% if balances is not empty %}
        <h2 class="acc-subhead">Saldo al cerrar cada mes de {{ year }}</h2>
        <div class="acc-months acc-months--year">
            {% for m, value in balances %}
                <div class="m {{ value is not null and value < 0 ? 'low' : '' }}">
                    <span class="v">{{ value is null ? '—' : value|number_format(0, ',', '.') ~ ' €' }}</span>
                    {{ months[m] }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="acc-section-head">
        <div><h2 class="acc-subhead">Últimos apuntes</h2></div>
        <a href="{{ path('accounting_ledger', { account: account.id }) }}" class="prl-btn"><i class="fa fa-list"></i> Todos sus movimientos</a>
    </div>
    <div class="prl-table-wrap">
        {% if recent is empty %}
            <div class="prl-empty">Esta cuenta aún no tiene apuntes.</div>
        {% else %}
            {{ rows.table(recent, invoices, 'account') }}
        {% endif %}
    </div>

</div>
{% endblock %}
