{# ============================================================
 # La ficha de una cuenta: su saldo, lo que tenía al cerrar cada mes del año y sus
 # últimos apuntes. Todos los apuntes, en el libro filtrado por la cuenta.
 #
 # El controller pasa: account, balance (hoy), count (nº de apuntes), year,
 # months (mes => saldo al cerrarlo, null si la cuenta aún no existía), recent,
 # invoices (apunte => factura, para el clip).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}
{% import 'accounting/_entries.html.twig' as rows %}

{% block title %}{{ account.name }} · Cuentas{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_accounts') }}">Cuentas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ account.name }}</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .acc-facts { display: grid; grid-template-columns: max-content 1fr; gap: 6px 24px; margin: 0 0 var(--csa-sp-6, 32px); font-size: 14px; }
        .acc-facts dt { color: var(--csa-ink-soft, #6b6b6b); }
        .acc-facts dd { margin: 0; }
    </style>
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header('Contabilidad · Cuentas', account.name, account.kindLabel ~ (account.active ? '' : ' · retirada')) }}

    <div class="prl-toolbar">
        <div class="counters"><b>{{ fmt.money(balance) }}</b> hoy</div>
        <div class="spacer"></div>
        {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') and account.active %}
            <a href="{{ path('accounting_entry_new', { account: account.id }) }}" class="prl-btn"><i class="fa fa-plus"></i> Anotar apunte</a>
        {% endif %}
        {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
            <a href="{{ path('accounting_account_edit', { id: account.id }) }}" class="prl-btn prl-btn--primary"><i class="fa fa-pencil"></i> Cambiar datos</a>
        {% endif %}
    </div>

    <dl class="acc-facts">
        <dt>IBAN</dt>
        <dd>{{ account.iban ?? '—' }}</dd>
        <dt>Apertura</dt>
        <dd>{{ fmt.money(account.openingBalance) }} el {{ account.openingDate ? account.openingDate|date('d/m/Y') : '—' }}</dd>
        <dt>Apuntes</dt>
        <dd>{{ count }}</dd>
    </dl>

    {% if months is not empty %}
        {% embed '_components/csa_card.html.twig' with { title: 'Saldo al cerrar cada mes de ' ~ year, accent: 'sky' } %}
            {% block body %}
                <div class="acc-months">
                    {% for m, value in months %}
                        <div class="m {{ value is not null and value < 0 ? 'low' : '' }}">
                            <span class="v">{{ value is null ? '—' : (value / 1000)|number_format(1, ',', '.') ~ 'k' }}</span>
                            {{ m }}
                        </div>
                    {% endfor %}
                </div>
            {% endblock %}
        {% endembed %}
    {% endif %}

    <div class="prl-toolbar">
        <div class="counters">Últimos apuntes</div>
        <div class="spacer"></div>
        <a href="{{ path('accounting_ledger', { account: account.id }) }}" class="prl-btn"><i class="fa fa-list"></i> Todos en el libro</a>
    </div>
    <div class="prl-table-wrap">
        {% if recent is empty %}
            <div class="prl-empty">Esta cuenta aún no tiene apuntes.</div>
        {% else %}
            {{ rows.table(recent, invoices) }}
        {% endif %}
    </div>

</div>
{% endblock %}
