{# ============================================================
 # La entrega trimestral a la gestoría.
 #
 # Antes de descargar se ve qué va a ir, con lo que la gestoría tiene que saber
 # (desglose que no cuadra, documento que falta) y si queda algo en la bandeja sin
 # anotar, que entonces no iría. La descarga es un ZIP con el libro de facturas
 # recibidas y los documentos renombrados.
 #
 # El controller pasa: quarter, rows (invoice + warnings), names (nombre de cada
 # fichero en el ZIP, por id), total, withWarnings, open, years, withoutInvoice
 # (gastos del trimestre de partidas que piden factura y no tienen ninguna ligada)
 # delivery (la entrega más reciente del trimestre, o null si nunca se entregó) y
 # canDeliver (si el trimestre ha terminado y por tanto se puede dar por entregado).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Para la gestoría · Contabilidad{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_invoices') }}">Facturas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Para la gestoría</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad · Facturas',
        'Para la gestoría · ' ~ quarter.label,
        'Las facturas recibidas y emitidas del trimestre, renombradas, con el libro de cada una y el libro de caja (todos los movimientos de cada cuenta, con factura o sin ella). Se descarga en un ZIP para subirlo a la carpeta de la gestoría.'
    ) }}

    <div class="prl-toolbar">
        <form method="get" class="acc-filters">
            <select name="quarter" class="csa-input">
                {% for q in 1..4 %}
                    <option value="{{ q }}" {{ q == quarter.quarter ? 'selected' : '' }}>{{ q }}.º trimestre</option>
                {% endfor %}
            </select>
            <select name="year" class="csa-input">
                {% for y in years %}
                    <option value="{{ y }}" {{ y == quarter.year ? 'selected' : '' }}>{{ y }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="prl-btn"><i class="fa fa-calendar"></i> Ver</button>
        </form>
        <div class="spacer"></div>
        {% if rows is not empty or issued is not empty %}
            <a href="{{ path('accounting_accountant_export_download', { year: quarter.year, quarter: quarter.quarter }) }}" class="prl-btn prl-btn--primary">
                <i class="fa fa-download"></i> Descargar el ZIP
            </a>
        {% endif %}
    </div>

    {# ============ ENTREGA ============ #}
    {% set q = { year: quarter.year, quarter: quarter.quarter } %}
    {% if delivery and delivery.standing %}
        <div class="csa-alert csa-alert--success" role="status" style="margin-bottom: var(--csa-sp-5);">
            <i class="csa-alert__icon fa fa-check" aria-hidden="true"></i>
            <div class="csa-alert__body">
                <b>Entregado a la gestoría el {{ delivery.deliveredAt|date('d/m/Y') }}</b>{% if delivery.deliveredBy %} por {{ delivery.deliveredBy.username }}{% endif %}.
                Lo fechado en el {{ quarter.label }} ya no se puede cambiar.
                {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
                    <form method="post" action="{{ path('accounting_accountant_reopen', q) }}" style="display: inline; margin-left: 8px;">
                        <input type="hidden" name="_token" value="{{ csrf_token('reopen-quarter') }}">
                        <button type="submit" class="prl-btn"><i class="fa fa-unlock"></i> Reabrir para corregir</button>
                    </form>
                {% endif %}
            </div>
        </div>
    {% elseif not canDeliver %}
        {{ csa.callout('El ' ~ quarter.label ~ ' aún no ha terminado. Se entrega a la gestoría a partir del ' ~ quarter.dayAfter|date('d/m/Y') ~ '; mientras, el ZIP sirve para ir mirando.', 'info', 'hourglass-half') }}
    {% else %}
        <div class="csa-alert csa-alert--{{ delivery ? 'warning' : 'info' }}" role="status" style="margin-bottom: var(--csa-sp-5);">
            <i class="csa-alert__icon fa fa-{{ delivery ? 'exclamation-triangle' : 'paper-plane-o' }}" aria-hidden="true"></i>
            <div class="csa-alert__body">
                {% if delivery %}
                    <b>Reabierto el {{ delivery.reopenedAt|date('d/m/Y') }}</b>{% if delivery.reopenedBy %} por {{ delivery.reopenedBy.username }}{% endif %}:
                    hay que volver a mandarlo a la gestoría.
                {% else %}
                    Cuando lo hayas subido a la carpeta de la gestoría, márcalo como entregado: desde entonces nada fechado en el {{ quarter.label }} se podrá cambiar sin reabrirlo.
                {% endif %}
                {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
                    <form method="post" action="{{ path('accounting_accountant_deliver', q) }}" style="display: inline; margin-left: 8px;">
                        <input type="hidden" name="_token" value="{{ csrf_token('deliver-quarter') }}">
                        <button type="submit" class="prl-btn prl-btn--primary"><i class="fa fa-check"></i> Marcar como entregado</button>
                    </form>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if open > 0 %}
        {{ csa.callout(open ~ (open == 1 ? ' factura sigue' : ' facturas siguen') ~ ' en la bandeja sin anotar. Si alguna es de este trimestre, no irá en el ZIP hasta que se confirme.', 'warning', 'inbox') }}
    {% endif %}
    {% if withoutInvoice is not empty %}
        {{ csa.callout(withoutInvoice|length ~ (withoutInvoice|length == 1 ? ' gasto' : ' gastos') ~ ' del trimestre no ' ~ (withoutInvoice|length == 1 ? 'tiene' : 'tienen') ~ ' factura (abajo). Súbela a la bandeja y, al confirmarla, se liga al apunte.', 'warning', 'file-o') }}
    {% endif %}
    {% if withWarnings > 0 %}
        {{ csa.callout(withWarnings ~ (withWarnings == 1 ? ' factura lleva' : ' facturas llevan') ~ ' una observación (abajo). Va igual en el ZIP, con la observación en el libro, para que la gestoría lo sepa.', 'info', 'info-circle') }}
    {% endif %}

    <h2 class="acc-subhead">Recibidas</h2>
    <div class="prl-toolbar">
        <div class="counters">
            <b>{{ rows|length }}</b> {{ rows|length == 1 ? 'factura' : 'facturas' }} · <b>{{ total|number_format(2, ',', '.') }} €</b>
        </div>
    </div>

    <div class="prl-table-wrap">
        {% if rows is empty %}
            <div class="prl-empty">No hay facturas anotadas con fecha de este trimestre.</div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th class="tight">Fecha</th>
                        <th>Proveedor</th>
                        <th>Fichero en el ZIP</th>
                        <th class="tight acc-num">Total</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {% set invoice = row.invoice %}
                        {% set entry = invoice.accountEntry %}
                        {% set date = invoice.invoiceDate ?? (entry ? entry.date : null) %}
                        <tr>
                            <td class="tight">{{ date ? date|date('d/m/Y') : '—' }}</td>
                            <td>
                                {% if entry %}
                                    <a href="{{ path('accounting_entry_show', { id: entry.id }) }}">{{ invoice.provider ? invoice.provider.name : (invoice.providerName ?? '—') }}</a>
                                {% else %}
                                    {{ invoice.provider ? invoice.provider.name : (invoice.providerName ?? '—') }}
                                {% endif %}
                                {% if invoice.invoiceNumber %}<br><span class="acc-muted acc-small">fra. {{ invoice.invoiceNumber }}</span>{% endif %}
                            </td>
                            <td class="acc-small"><a href="{{ path('accounting_invoice_review', { id: invoice.id }) }}">{{ names[invoice.id] }}</a></td>
                            <td class="acc-num">{{ invoice.total is not null ? invoice.total|number_format(2, ',', '.') ~ ' €' : '—' }}</td>
                            <td class="acc-small">
                                {% for warning in row.warnings %}
                                    {{ csa.badge(warning, 'ochre') }}
                                {% else %}
                                    <span class="acc-muted">—</span>
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    <h2 class="acc-subhead" style="margin-top: var(--csa-sp-6, 24px);">Emitidas</h2>
    <div class="prl-toolbar">
        <div class="counters">
            <b>{{ issued|length }}</b> {{ issued|length == 1 ? 'factura' : 'facturas' }} · <b>{{ issuedTotal|number_format(2, ',', '.') }} €</b>
        </div>
    </div>
    <div class="prl-table-wrap">
        {% if issued is empty %}
            <div class="prl-empty">No hay facturas emitidas con fecha de este trimestre.</div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th class="tight">Fecha</th>
                        <th>Cliente</th>
                        <th>Fichero en el ZIP</th>
                        <th class="tight acc-num">Total</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in issued %}
                        {% set invoice = row.invoice %}
                        <tr>
                            <td class="tight">{{ invoice.issueDate|date('d/m/Y') }}</td>
                            <td>{{ invoice.customerName|split("\n")|first }}<br><span class="acc-muted acc-small">fra. {{ invoice.numberLabel }}</span></td>
                            <td class="acc-small"><a href="{{ path('accounting_issued_invoice_show', { id: invoice.id }) }}">{{ issuedNames[invoice.id] }}</a></td>
                            <td class="acc-num">{{ invoice.total|number_format(2, ',', '.') }} €</td>
                            <td class="acc-small">
                                {% for warning in row.warnings %}
                                    {{ csa.badge(warning, 'ochre') }}
                                {% else %}
                                    <span class="acc-muted">—</span>
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {% if withoutInvoice is not empty %}
        <h2 class="acc-subhead" style="margin-top: var(--csa-sp-6, 24px);">Gastos sin factura</h2>
        <p class="acc-muted acc-small" style="margin: 0 2px 8px;">
            Apuntes de partidas que piden factura (se cambia en cada partida) sin ninguna factura recibida ligada.
        </p>
        <div class="prl-table-wrap">
            <table class="prl-table">
                <thead>
                    <tr>
                        <th class="tight">Fecha</th>
                        <th>Concepto</th>
                        <th>Partida</th>
                        <th class="tight acc-num">Importe</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in withoutInvoice %}
                        <tr>
                            <td class="tight">{{ entry.date|date('d/m/Y') }}</td>
                            <td>
                                <a href="{{ path('accounting_entry_show', { id: entry.id }) }}">{{ entry.concept }}</a>
                                {% if entry.providerName %}<br><span class="acc-muted acc-small">{{ entry.providerName }}</span>{% endif %}
                            </td>
                            <td class="acc-small">{{ entry.category.name }} · {{ entry.account.name }}</td>
                            <td class="acc-num">{{ entry.amount|number_format(2, ',', '.') }} €</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

</div>
{% endblock %}
