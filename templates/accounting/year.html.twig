{# ============================================================
 # El año entero — cada partida por cada mes, con su total.
 #
 # Es la hoja «Resumen» del Excel, con una diferencia que importa: allí los
 # números se copian a mano desde las otras hojas y se descuadran (en 2026 el
 # resumen y el libro no coinciden en dos de los ocho meses cerrados). Aquí es la
 # misma suma de siempre, sólo que presentada de otra forma.
 #
 # El controller pasa: year, years, tracked (con throughMonth = 12, sin presupuesto),
 # months (en tres letras), balances (por cuenta: account y balances[0..12], 0 = el
 # saldo de partida, null antes de abrir), balancesThrough (hasta qué mes hay saldo)
 # y unexplained ([mes => diferencia], sólo los meses en que las cuentas descuadran).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Contabilidad · Resumen {{ year }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_reports') }}">Informes</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Resumen {{ year }}</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad · Resumen',
        'El año ' ~ year,
        'Cada partida mes a mes. Los mismos apuntes del libro, sumados.'
    ) }}

    <div class="prl-toolbar">
        <div class="counters">
            {% for y in years %}
                <a href="{{ path('accounting_year', { year: y }) }}" class="prl-chip {{ y == year ? 'prl-chip--activo' : '' }}">{{ y }}</a>
            {% endfor %}
        </div>
        <div class="spacer"></div>
        <a href="{{ path('accounting_report') }}" class="prl-btn"><i class="fa fa-line-chart"></i> Cómo vamos</a>
        <a href="{{ path('accounting_ledger') }}" class="prl-btn"><i class="fa fa-list"></i> Movimientos</a>
        <a href="{{ path('accounting_year_assembly', { year: year }) }}" class="prl-btn"><i class="fa fa-print"></i> Para la asamblea</a>
    </div>

    <div class="prl-table-wrap">
        {% if tracked.groups is empty %}
            <div class="prl-empty">No hay ningún apunte de {{ year }}.</div>
        {% else %}
            <table class="prl-table acc-grid">
                <thead>
                    <tr>
                        <th>Partida</th>
                        {% for n, name in months %}
                            <th class="acc-num"><a href="{{ path('accounting_month', { year: year, month: n }) }}">{{ name }}</a></th>
                        {% endfor %}
                        <th class="acc-num acc-total-col">Año</th>
                    </tr>
                </thead>
                <tbody>
                    {% for group in tracked.groups %}
                        <tr class="acc-group-row">
                            <td>{{ group.name }}</td>
                            {% for n in 1..12 %}
                                {% set v = group.actual[n] %}
                                <td class="acc-num {{ v < 0 ? 'acc-neg' : '' }} {{ v == 0 ? 'zero' : '' }}">
                                    {{ v == 0 ? '·' : v|number_format(0, ',', '.') }}
                                </td>
                            {% endfor %}
                            <td class="acc-num acc-total-col {{ group.actualTotal < 0 ? 'acc-neg' : '' }}">
                                {{ group.actualTotal|number_format(0, ',', '.') }}
                            </td>
                        </tr>
                        {% for cat in group.categories %}
                            <tr class="acc-cat-row">
                                <td class="acc-muted"><a href="{{ path('accounting_category_show', { id: cat.id, year: year }) }}">{{ cat.name }}</a></td>
                                {% for n in 1..12 %}
                                    {% set v = cat.actual[n] %}
                                    <td class="acc-num {{ v < 0 ? 'acc-neg' : '' }} {{ v == 0 ? 'zero' : '' }}">
                                        {{ v == 0 ? '·' : v|number_format(0, ',', '.') }}
                                    </td>
                                {% endfor %}
                                <td class="acc-num acc-total-col {{ cat.actualTotal < 0 ? 'acc-neg' : '' }}">
                                    {{ cat.actualTotal|number_format(0, ',', '.') }}
                                </td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                </tbody>
                <tfoot>
                    {% for total in tracked.totals %}
                        <tr>
                            <td><b>{{ total.name }}</b></td>
                            {% for n in 1..12 %}
                                {% set v = total.actual[n] %}
                                <td class="acc-num {{ v < 0 ? 'acc-neg' : '' }} {{ v == 0 ? 'zero' : '' }}">
                                    <b>{{ v == 0 ? '·' : v|number_format(0, ',', '.') }}</b>
                                </td>
                            {% endfor %}
                            <td class="acc-num acc-total-col {{ total.actualTotal < 0 ? 'acc-neg' : '' }}">
                                <b>{{ total.actualTotal|number_format(0, ',', '.') }}</b>
                            </td>
                        </tr>
                    {% endfor %}
                    {% set result = tracked.result %}
                    <tr class="acc-result-row">
                        <td><b>{{ result.name }}</b></td>
                        {% for n in 1..12 %}
                            {% set v = result.actual[n] %}
                            <td class="acc-num {{ v < 0 ? 'acc-neg' : '' }} {{ v == 0 ? 'zero' : '' }}">
                                <b>{{ v == 0 ? '·' : v|number_format(0, ',', '.') }}</b>
                            </td>
                        {% endfor %}
                        <td class="acc-num acc-total-col {{ result.actualTotal < 0 ? 'acc-neg' : '' }}">
                            <b>{{ result.actualTotal|number_format(0, ',', '.') }}</b>
                        </td>
                    </tr>
                </tfoot>
            </table>
        {% endif %}
    </div>

    <p class="acc-muted" style="margin: 10px 2px; font-size: 12px;">
        Importes redondeados a euros para que quepa la rejilla. El detalle está en el libro
        y en la pantalla de cada mes.
    </p>

    {% if balances is not empty %}
    <h2 class="acc-subhead">Saldo de cada caja y banco</h2>
    <div class="prl-table-wrap">
        <table class="prl-table acc-grid">
            <thead>
                <tr>
                    <th>Cuenta</th>
                    <th class="acc-num acc-total-col" title="Saldo de partida: lo que venía del año anterior">1 ene</th>
                    {% for n, name in months %}
                        <th class="acc-num">{{ name }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in balances %}
                    <tr>
                        <td><a href="{{ path('accounting_ledger', { account: row.account.id }) }}">{{ row.account.name }}</a></td>
                        {% for n in 0..12 %}
                            {% set v = n <= balancesThrough ? row.balances[n] : null %}
                            <td class="acc-num {{ n == 0 ? 'acc-total-col' : '' }} {{ v is not null and v < 0 ? 'acc-neg' : '' }} {{ v is null ? 'zero' : '' }}">
                                {{ v is null ? '·' : v|number_format(2, ',', '.') }}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr class="acc-result-row">
                    <td><b>Todas</b></td>
                    {% for n in 0..12 %}
                        {% set opened = balances|filter(r => r.balances[n] is not null) %}
                        {% set v = n <= balancesThrough and opened is not empty ? opened|reduce((sum, r) => sum + r.balances[n], 0) : null %}
                        <td class="acc-num {{ n == 0 ? 'acc-total-col' : '' }} {{ v is not null and v < 0 ? 'acc-neg' : '' }} {{ v is null ? 'zero' : '' }}">
                            <b>{{ v is null ? '·' : v|number_format(2, ',', '.') }}</b>
                        </td>
                    {% endfor %}
                </tr>
            </tfoot>
        </table>
    </div>

    <p class="acc-muted" style="margin: 10px 2px; font-size: 12px;">
        El 1 de enero es el saldo de partida, lo que venía del año anterior; cada mes, lo que
        había al cerrarlo{{ balancesThrough >= 1 and balancesThrough < 12 ? ' (el mes en curso, lo de hoy)' : '' }}.
        Una cuenta abierta durante el año empieza con su saldo de apertura. De un mes al
        siguiente «Todas» cambia lo que dice el resultado de arriba: los traspasos entre
        cuentas se anulan.
    </p>

    {% if unexplained is not empty %}
    <p class="acc-small" style="margin: 10px 2px;">
        Hay dinero sin explicar:
        {% for n, diff in unexplained %}
            {% set first = date(year ~ '-' ~ n ~ '-01') %}
            en <a href="{{ path('accounting_ledger', { from: first|date('Y-m-d'), to: first|date('Y-m-t') }) }}">{{ months[n]|lower }}</a>,
            «Todas» cambió <b>{{ fmt.money(diff, true) }}</b> más de lo que dice el resultado{{ loop.last ? '.' : ';' }}
        {% endfor %}
        Suele ser un traspaso entre cuentas con una sola mitad o con las dos de importe distinto.
    </p>
    {% endif %}
    {% endif %}

</div>
{% endblock %}
