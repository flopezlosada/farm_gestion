{# ============================================================
 # Traspasos contados por el bot que aún no están en el libro.
 #
 # Cada uno se revisa en el formulario de traspaso (ya relleno) y se anota, o se
 # descarta sin tocar el libro.
 #
 # El controller pasa: transfers (PendingTransfer sin confirmar, los más antiguos primero).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Traspasos por confirmar · Contabilidad{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Traspasos por confirmar</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad',
        'Traspasos por confirmar',
        'Lo que se ha contado por el bot de Telegram. No entra en el libro hasta que alguien lo revisa aquí.'
    ) }}

    <div class="prl-table-wrap">
        {% if transfers is empty %}
            <div class="prl-empty">No hay ninguno: todo lo contado por el bot está ya revisado.</div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th class="tight">Fecha</th>
                        <th class="tight acc-num">Importe</th>
                        <th>Sale de</th>
                        <th>Entra en</th>
                        <th>Concepto</th>
                        <th class="tight">Lo contó</th>
                        <th class="tight"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for t in transfers %}
                        <tr>
                            <td class="tight">{{ t.date|date('d/m/Y') }}</td>
                            <td class="tight acc-num">{{ t.amount is not null ? fmt.money(t.amount) : '¿?' }}</td>
                            <td>{{ t.from ? t.from.name : '¿?' }}</td>
                            <td>{{ t.to ? t.to.name : '¿?' }}</td>
                            <td>{{ t.concept ?? '' }}</td>
                            <td class="tight">{{ t.sentBy.displayName }}</td>
                            <td class="tight">
                                <div class="csa-row">
                                    <a href="{{ path('accounting_transfer_pending_confirm', { id: t.id }) }}" class="prl-btn"><i class="fa fa-check"></i> Revisar y anotar</a>
                                    <form method="post" action="{{ path('accounting_transfer_pending_discard', { id: t.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('accounting_transfer_pending_discard_' ~ t.id) }}">
                                        <button type="submit" class="prl-btn" title="No era un traspaso, o ya estaba anotado">Descartar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

</div>
{% endblock %}
