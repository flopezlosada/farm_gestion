{# ============================================================
 # Los extractos del banco subidos (Norma 43 u hoja de Excel) y el sitio para subir otro.
 #
 # El controller pasa: statements (BankStatement[], recientes primero) y
 # unlinked ([id del extracto => movimientos sin apunte]).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Contabilidad · Extractos del banco{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Extractos del banco</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .acc-upload { position: relative; }
        .acc-upload > summary { list-style: none; cursor: pointer; }
        .acc-upload > summary::-webkit-details-marker { display: none; }
        .acc-upload__menu {
            position: absolute; z-index: 10; top: calc(100% + 4px); left: 0; min-width: 220px; padding: 6px;
            background: var(--prl-surface, #fff); border: 1px solid var(--prl-line-2, #d8d2c2); border-radius: 8px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .08);
        }
        .acc-upload__hint { margin: 4px 8px 6px; font-size: 12px; color: var(--prl-ink-soft, #5a564a); }
        .acc-upload__item { display: block; margin: 0; padding: 8px 10px; border-radius: 6px; font-weight: 500; cursor: pointer; }
        .acc-upload__item:hover, .acc-upload__item:focus-within { background: var(--prl-line, #efeadd); }
    </style>
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad · Extractos',
        'Extractos del banco',
        'Sube cada mes el extracto que da la banca online: el fichero Norma 43 (cuaderno 43) o la hoja de movimientos en Excel (.xls o .xlsx, con columnas Fecha, Importe y Saldo). Se comprueba que está entero, se guardan sus movimientos y se cuadran con el libro: verás qué le falta al libro y qué apuntes no trae el banco.'
    ) }}

    {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
        {# Un solo botón: se elige la cuenta y se abre el explorador; al elegir el
         # fichero, sube. Cada cuenta es su propio formulario con su <label> del
         # fichero, así el explorador lo abre el navegador sin depender de JS. Las
         # comprobaciones (IBAN, saldo inicial, otra cuenta) sólo se ven si fallan. #}
        <div class="prl-toolbar">
            {% if accounts is empty %}
                <span class="acc-muted acc-small">No hay ninguna cuenta de banco activa a la que subir un extracto (Ajustes → Cuentas).</span>
            {% else %}
                <details class="acc-upload">
                    <summary class="prl-btn prl-btn--primary"><i class="fa fa-upload"></i> Subir extracto <i class="fa fa-caret-down"></i></summary>
                    <div class="acc-upload__menu">
                        <p class="acc-upload__hint">¿De qué cuenta es?</p>
                        {% for account in accounts %}
                            <form method="post" action="{{ path('accounting_bank_statement_upload') }}" enctype="multipart/form-data" class="inv-upload">
                                <input type="hidden" name="_token" value="{{ csrf_token('bank_statement_upload') }}">
                                <input type="hidden" name="account" value="{{ account.id }}">
                                <label class="acc-upload__item">
                                    <input type="file" name="file" required hidden onchange="if (this.files.length) { this.form.submit(); }">
                                    {{ account.name }}
                                </label>
                            </form>
                        {% endfor %}
                    </div>
                </details>
                <span class="acc-muted acc-small">El fichero Norma 43 o la hoja de Excel del banco. Si algo no cuadra, no se guarda nada; volver a subir uno ya subido no duplica movimientos.</span>
            {% endif %}
        </div>
    {% endif %}

    <div class="prl-table-wrap">
        {% if statements is empty %}
            <div class="prl-empty">Todavía no se ha subido ningún extracto.</div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th>Cuenta</th>
                        <th class="tight">Del</th>
                        <th class="tight">Al</th>
                        <th class="tight acc-num">Saldo inicial</th>
                        <th class="tight acc-num">Saldo final</th>
                        <th class="tight acc-num">Sin anotar</th>
                        <th class="tight">Subido</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in statements %}
                        {% set pending = unlinked[s.id] ?? 0 %}
                        <tr>
                            <td><a class="acc-strong" href="{{ path('accounting_bank_statement_show', { id: s.id }) }}">{{ s.account.name }}</a><br><span class="acc-muted acc-small">{{ s.fileName }}</span></td>
                            <td class="tight">{{ s.from|date('d/m/Y') }}</td>
                            <td class="tight">{{ s.to|date('d/m/Y') }}</td>
                            <td class="acc-num">{{ fmt.money(s.openingBalance) }}</td>
                            <td class="acc-num">{{ fmt.money(s.closingBalance) }}</td>
                            <td class="acc-num {{ pending > 0 ? 'acc-neg' : '' }}">{{ pending }}</td>
                            <td class="tight">{{ s.importedAt|date('d/m/Y') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

</div>
{% endblock %}
