{# ============================================================
 # Los extractos del banco subidos (Norma 43 u hoja de Excel) y el sitio para subir otro.
 #
 # El controller pasa: statements (BankStatement[], recientes primero) y
 # unlinked ([id del extracto => movimientos sin apunte]).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}

{% block title %}Contabilidad · Extractos del banco{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Extractos del banco</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad · Extractos',
        'Extractos del banco',
        'Sube cada mes el extracto que da la banca online: el fichero Norma 43 (cuaderno 43) o la hoja de movimientos en Excel (.xls o .xlsx, con columnas Fecha, Importe y Saldo). Se comprueba que está entero, se guardan sus movimientos y se cuadran con el libro: verás qué le falta al libro y qué apuntes no trae el banco.'
    ) }}

    {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
        {# Un botón que abre un modal: primero la cuenta, luego el fichero, y «Subir». #}
        <div class="prl-toolbar">
            {% if accounts is empty %}
                <span class="acc-muted acc-small">No hay ninguna cuenta de banco activa a la que subir un extracto (Ajustes → Cuentas).</span>
            {% else %}
                {% include 'accounting/_statement_upload_modal.html.twig' with { accounts: accounts } only %}
            {% endif %}
        </div>
    {% endif %}

    <div class="prl-table-wrap">
        {% if statements is empty %}
            <div class="prl-empty">Todavía no se ha subido ningún extracto.</div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th>Cuenta</th>
                        <th class="tight">Del</th>
                        <th class="tight">Al</th>
                        <th class="tight acc-num">Saldo inicial</th>
                        <th class="tight acc-num">Saldo final</th>
                        <th class="tight acc-num">Sin anotar</th>
                        <th class="tight">Subido</th>
                        <th class="tight"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in statements %}
                        {% set pending = unlinked[s.id] ?? 0 %}
                        {% set show_url = path('accounting_bank_statement_show', { id: s.id }) %}
                        {% set pending_url = path('accounting_bank_statement_show', { id: s.id, _fragment: 'sin-apunte' }) %}
                        <tr>
                            <td><a class="acc-strong" href="{{ show_url }}">{{ s.account.name }}</a><br><span class="acc-muted acc-small">{{ s.fileName }}</span></td>
                            <td class="tight">{{ s.from|date('d/m/Y') }}</td>
                            <td class="tight">{{ s.to|date('d/m/Y') }}</td>
                            <td class="acc-num">{{ fmt.money(s.openingBalance) }}</td>
                            <td class="acc-num">{{ fmt.money(s.closingBalance) }}</td>
                            <td class="acc-num">
                                {% if pending > 0 %}
                                    <a class="acc-neg acc-strong" href="{{ pending_url }}">{{ pending }}</a>
                                {% else %}
                                    0
                                {% endif %}
                            </td>
                            <td class="tight">{{ s.importedAt|date('d/m/Y') }}</td>
                            <td class="tight"><a class="prl-btn prl-btn--sm{{ pending > 0 ? ' prl-btn--primary' : '' }}" href="{{ pending > 0 ? pending_url : show_url }}">{{ pending > 0 ? 'Ver lo que falta' : 'Ver' }}</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

</div>
{% endblock %}
