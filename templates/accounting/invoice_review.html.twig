{# ============================================================
 # Revisar una factura y convertirla en apunte.
 #
 # El documento a un lado y el formulario de apunte de siempre al otro, ya relleno
 # con lo leído. Si está bien, se guarda tal cual; si no, se corrige mirando el
 # documento. Es la misma pantalla para una factura leída y para una que no se pudo
 # leer: en ésta los campos llegan vacíos.
 #
 # El controller pasa: invoice, twin (otra ya anotada con el mismo número, o null),
 # form (la factura + su apunte en form.entry), suggestions, hasDocument (si el
 # fichero está en el servidor).
 #
 # Quién la emite: un proveedor que ya existe se elige en la lista y su ficha se
 # enseña sin poder tocarla (se cambia en su propia pantalla); los campos de alta
 # sólo aparecen con «Nuevo proveedor».
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_invoice_macros.html.twig' as invm %}

{% block title %}Revisar factura · Contabilidad{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_invoices') }}">Facturas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Revisar</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .inv-review { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--csa-sp-6, 32px); align-items: start; }
        .inv-doc { position: sticky; top: var(--csa-sp-4, 16px); border: 1px solid var(--csa-rule, #ddd); border-radius: 6px; overflow: hidden; background: #fafafa; }
        .inv-doc img { display: block; width: 100%; height: auto; }
        .inv-doc iframe { display: block; width: 100%; height: 80vh; border: 0; }
        .inv-doc__bar { display: flex; justify-content: space-between; gap: 8px; padding: 6px 10px; font-size: 12px; border-bottom: 1px solid var(--csa-rule, #ddd); background: #fff; }
        .inv-provider { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: var(--csa-sp-3, 12px) 0 var(--csa-sp-4, 16px); padding: 12px 16px; border: 1px solid var(--csa-rule, #ddd); border-radius: 6px; font-size: 14px; }
        .inv-provider[hidden] { display: none; }
        .inv-who__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
        .inv-who__head .csa-badge[hidden] { display: none; }
        .inv-who__fix { background: none; border: 0; padding: 4px 0; font-size: 13px; color: var(--csa-ink-soft, #6b6b6b); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
        .inv-who__fix:hover { color: var(--csa-ink, #222); }
        /* El menú del buscador tiene que poder salirse del modal. */
        dialog.inv-who-modal { overflow: visible; }
        .inv-who-modal__option { display: flex; align-items: center; gap: 8px; margin: 0 0 var(--csa-sp-3, 12px); font-weight: 500; cursor: pointer; }
        .inv-who-modal [data-inv-who-pick] { margin: 0 0 var(--csa-sp-4, 16px) 24px; }
        .inv-provider dt { color: var(--csa-ink-soft, #6b6b6b); }
        .inv-provider dd { margin: 0; }
        .inv-provider__note { grid-column: 1 / -1; font-size: 12px; color: var(--csa-ink-soft, #6b6b6b); }
        .inv-facts { font-size: 12px; margin: 0 0 var(--csa-sp-4, 16px); }
        .inv-facts dt { float: left; clear: left; width: 120px; color: var(--csa-ink-soft, #6b6b6b); }
        .inv-facts dd { margin: 0 0 4px 120px; }
        .inv-taxline { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: var(--csa-sp-3, 12px); align-items: end; margin-bottom: var(--csa-sp-3, 12px); }
        .inv-taxline__remove { margin-bottom: 2px; }
        .inv-check { font-size: 13px; padding: 8px 12px; border-radius: 6px; margin-top: var(--csa-sp-3, 12px); }
        .inv-check--ok { background: #eef6ee; color: #2f6b34; }
        .inv-check--ko { background: #fdf3e6; color: #8a5300; }
        @media (max-width: 900px) {
            .inv-review { grid-template-columns: 1fr; }
            .inv-doc { position: static; }
            .inv-doc iframe { height: 60vh; }
        }
    </style>
{% endblock %}

{% block csa_main %}
    {% set e = form.entry %}
    {% set editable = is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}

    {{ csa.page_header(
        'Contabilidad · Facturas',
        invoice.providerName ?? invoice.originalName,
        invoice.status == 'read'
            ? 'Revisa lo leído mirando el documento. Si está bien, guarda: se crea el apunte.'
            : 'Esta factura no se ha leído sola. Complétala mirando el documento y guarda.'
    ) }}

    {% if twin %}
        {{ csa.callout('Ojo: ya hay una factura anotada de este proveedor con el número ' ~ twin.invoiceNumber ~ (twin.accountEntry ? ' (apunte del ' ~ twin.accountEntry.date|date('d/m/Y') ~ ', ' ~ twin.accountEntry.amount|number_format(2, ',', '.') ~ ' €)' : '') ~ '. Si es la misma, descártala: anotarla otra vez contaría el gasto doble.', 'danger', 'files-o') }}
    {% endif %}

    {% if invoice.status == 'unreadable' %}
        {{ csa.callout(invoice.lastError ?? 'No se ha podido leer.', 'warning', 'exclamation-triangle') }}
    {% elseif invoice.status == 'pending' %}
        {{ csa.callout('Todavía no se ha leído' ~ (invoice.lastError ? ': ' ~ invoice.lastError|trim('.') : '') ~ '. Puedes esperar o completarla ya a mano.', 'info', 'clock-o') }}
    {% elseif invoice.confidence == 'baja' %}
        {{ csa.callout('La lectura no está segura de estos datos: compáralos con el documento antes de guardar.', 'warning', 'eye') }}
    {% endif %}

    <div class="inv-review">

        {# ============ EL DOCUMENTO ============ #}
        <div class="inv-doc">
            {{ invm.document(invoice, hasDocument, 'inv-doc') }}
        </div>

        {# ============ EL APUNTE ============ #}
        <div>
            {% if invoice.status == 'read' %}
                <dl class="inv-facts">
                    <dt>Leída</dt>
                    <dd>{{ invoice.readAt|date('d/m/Y H:i') }}{% if invoice.confidence %} · confianza {{ invoice.confidence }}{% endif %}</dd>
                    <dt>Forma de pago</dt>
                    <dd>{{ invoice.paymentLabel }} <span class="acc-muted">(según la factura)</span></dd>
                </dl>
            {% endif %}

            {{ form_start(form, { attr: { 'data-csa-dropdowns': '1' } }) }}
                {{ form_errors(form) }}
                {{ form_errors(e) }}

                <div class="csa-stack-lg">
                    {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'El apunte', subtitle: 'Lo que entrará en el libro.' } %}
                        {% block body %}
                            {% import '_macros/csa.html.twig' as csa %}
                            <div class="csa-form-grid">
                                {{ csa.field(e.date, 'Fecha', { hint: 'cuándo se pagó' }) }}
                                {{ csa.field(e.account, 'Cuenta', { widget_class: 'csa-select' }) }}
                                {{ csa.field(e.concept, 'Concepto', { full: true }) }}
                                {{ csa.field(e.category, 'Partida', { full: true, widget_class: 'csa-select' }) }}
                                {{ csa.field(e.direction, '¿Entra o sale?', { widget_class: 'csa-select' }) }}
                                {{ csa.field(e.magnitude, 'Importe', { hint: 'lo que se pagó: total con IVA y menos la retención' }) }}
                            </div>
                        {% endblock %}
                    {% endembed %}

                    {% embed '_components/csa_form_section.html.twig' with { num: '2', title: 'Quién la emite', subtitle: 'Lo ha reconocido la lectura por el CIF. Si no es así, corrígelo.' } %}
                        {% block body %}
                            {% import '_macros/csa.html.twig' as csa %}
                            <div class="inv-who__head">
                                <span class="csa-badge csa-badge--green" data-inv-when-known hidden>Proveedor conocido</span>
                                <span class="csa-badge csa-badge--ochre" data-inv-when-new hidden>Proveedor nuevo: se dará de alta con estos datos</span>
                                <button type="button" class="inv-who__fix" data-inv-who-fix>
                                    <i class="fa fa-exclamation-circle"></i> ¿No es correcto?
                                </button>
                            </div>

                            {# El conocido, de sólo lectura: lo rellena el script con los data-* de su opción. #}
                            <dl class="inv-provider" data-inv-when-known hidden>
                                <dt>Proveedor</dt><dd data-inv-provider-name></dd>
                                <dt>CIF</dt><dd data-inv-provider-tax-id></dd>
                                <dt>Dirección</dt><dd data-inv-provider-place></dd>
                                <dd class="inv-provider__note">
                                    Lo que le falte a su ficha se completa con esta factura; lo que ya tiene no se toca.
                                    <a href="#" data-inv-provider-link target="_blank" rel="noopener">Cambiar su ficha</a>
                                </dd>
                            </dl>

                            {% set if_new = { show_when: form.provider.vars.full_name ~ '=' } %}
                            <div class="csa-form-grid">
                                {{ csa.field(e.providerName, 'Nombre', if_new) }}
                                {{ csa.field(form.providerTaxId, 'CIF / NIF', if_new|merge({ hint: 'sin CIF no se da de alta' })) }}
                                {{ csa.field(form.providerAddress, 'Dirección', if_new|merge({ full: true })) }}
                                {{ csa.field(form.providerPostalCode, 'Código postal', if_new) }}
                                {{ csa.field(form.providerTown, 'Municipio', if_new) }}
                                {{ csa.field(form.providerProvince, 'Provincia', if_new) }}
                                {{ csa.field(e.invoiceNumber, 'Nº de factura') }}
                                {{ csa.field(e.notes, 'Notas', { full: true, widget_class: 'csa-textarea' }) }}
                            </div>

                            {# Corregir quién la emite. Va DENTRO del formulario y sin <form> propio:
                             # el desplegable es el campo `provider` y tiene que enviarse con todo lo demás. #}
                            <dialog class="csa-modal csa-modal--info inv-who-modal" aria-labelledby="inv-who-title" data-inv-who-modal>
                                <header class="csa-modal__header">
                                    <div class="csa-modal__heading">
                                        <span class="csa-modal__eyebrow">Corregir la lectura</span>
                                        <h2 class="csa-modal__title" id="inv-who-title">¿Quién emite esta factura?</h2>
                                    </div>
                                </header>
                                <div class="csa-modal__body">
                                    <label class="inv-who-modal__option">
                                        <input type="radio" name="inv_who_kind" value="known" data-inv-who-kind>
                                        Un proveedor que ya tenemos
                                    </label>
                                    <div data-inv-who-pick hidden>
                                        {{ csa.field(form.provider, 'Proveedor', { widget_class: 'csa-select', hint: 'escribe para buscar' }) }}
                                    </div>
                                    <label class="inv-who-modal__option">
                                        <input type="radio" name="inv_who_kind" value="new" data-inv-who-kind>
                                        Un proveedor nuevo
                                    </label>
                                    <p class="acc-muted acc-small" data-inv-who-new-hint hidden>Se cierra y corriges sus datos en el formulario.</p>
                                </div>
                                <footer class="csa-modal__footer">
                                    <button type="button" class="csa-modal__btn csa-modal__btn--ghost" data-inv-who-cancel>Cancelar</button>
                                    <button type="button" class="csa-modal__btn csa-modal__btn--primary" data-inv-who-apply>Aplicar</button>
                                </footer>
                            </dialog>
                        {% endblock %}
                    {% endembed %}

                    {% embed '_components/csa_form_section.html.twig' with { num: '3', title: 'Bases e IVA', subtitle: 'Una línea por cada tipo de IVA que mezcle la factura. Para la gestoría.' } %}
                        {% block body %}
                            {% import '_macros/csa.html.twig' as csa %}
                            {% import 'accounting/_invoice_macros.html.twig' as invm %}
                            <div data-csa-collection data-prototype="{{ invm.tax_line(form.taxLines.vars.prototype)|e('html_attr') }}">
                                <div data-csa-collection-items data-inv-lines>
                                    {% for line in form.taxLines %}
                                        {{ invm.tax_line(line) }}
                                    {% endfor %}
                                </div>
                                {% do form.taxLines.setRendered %}
                                {% if not form.taxLines.vars.valid %}
                                    <div class="csa-field__error">{{ form_errors(form.taxLines) }}</div>
                                {% endif %}
                                <button type="button" class="csa-btn csa-btn--ghost" data-csa-collection-add hidden>
                                    <i class="fa fa-plus"></i> Añadir un tipo de IVA
                                </button>
                            </div>
                            <div class="csa-form-grid" style="margin-top: var(--csa-sp-4, 16px);">
                                {{ csa.field(form.withholding, 'Retención IRPF', { hint: 'en positivo; vacío si no lleva' }) }}
                                {{ csa.field(form.withholdingRate, '% de retención', { hint: 'si lo dice' }) }}
                            </div>
                            <div class="inv-check" data-inv-check hidden></div>
                        {% endblock %}
                    {% endembed %}

                    {% do e.submit.setRendered %}
                    {% do e.submitAndNew.setRendered %}

                    {% if editable %}
                        <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                            <div></div>
                            <div class="csa-row">
                                {{ csa.btn('Volver', { variant: 'ghost', href: path('accounting_invoices') }) }}
                                {{ csa.btn('Guardar el apunte', { variant: 'primary', type: 'submit', icon: 'fa-check' }) }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            {{ form_end(form) }}

            {% if editable %}
                <form method="post" action="{{ path('accounting_invoice_discard', { id: invoice.id }) }}" style="margin-top: var(--csa-sp-6, 32px);"
                      onsubmit="return confirm('¿Descartar esta factura? No se anota nada; el documento se conserva.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('discard-invoice-' ~ invoice.id) }}">
                    <button type="submit" class="csa-btn csa-btn--ghost"><i class="fa fa-ban"></i> <span>Descartar: está repetida o no es una factura</span></button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block more_js %}
    {{ parent() }}
    {% include 'accounting/_direction_suggest.html.twig' with { category: form.entry.category, direction: form.entry.direction } %}
    <script>
    /*
     * Quién emite la factura. Lo normal es que la lectura acierte: con un proveedor
     * conocido se enseña su ficha de sólo lectura; si no lo conoce, los campos de alta
     * (los enseña csa-reveal cuando el desplegable está vacío).
     *
     * Si la lectura se equivoca, el modal deja decir si es uno que ya tenemos (y
     * cuál) o uno nuevo. El desplegable es el campo `provider` del formulario: el
     * modal sólo lo cambia. Cancelar (o Escape) lo deja como estaba.
     */
    (function () {
        var select = document.getElementById('{{ form.provider.vars.id }}');
        var modal = document.querySelector('[data-inv-who-modal]');
        var pick = modal.querySelector('[data-inv-who-pick]');
        var newHint = modal.querySelector('[data-inv-who-new-hint]');
        var apply = modal.querySelector('[data-inv-who-apply]');
        var kinds = modal.querySelectorAll('[data-inv-who-kind]');
        var showUrl = '{{ path('accounting_provider_show', { id: 0 }) }}';
        var before = select.value;

        function setValue(value) {
            select.value = value;
            select.dispatchEvent(new Event('change', { bubbles: true }));
        }

        function kind() {
            var checked = modal.querySelector('[data-inv-who-kind]:checked');
            return checked ? checked.value : null;
        }

        function paint() {
            var option = select.options[select.selectedIndex];
            var known = !!option && option.value !== '';
            document.querySelectorAll('[data-inv-when-known]').forEach(function (el) { el.hidden = !known; });
            document.querySelectorAll('[data-inv-when-new]').forEach(function (el) { el.hidden = known; });
            if (!known) { return; }
            document.querySelector('[data-inv-provider-name]').textContent = option.dataset.name;
            document.querySelector('[data-inv-provider-tax-id]').textContent = option.dataset.taxId || 'sin CIF: se le pone el de esta factura';
            document.querySelector('[data-inv-provider-place]').textContent = option.dataset.place || '—';
            document.querySelector('[data-inv-provider-link]').href = showUrl.replace(/0$/, option.dataset.id);
        }

        function paintModal() {
            pick.hidden = kind() !== 'known';
            newHint.hidden = kind() !== 'new';
            apply.disabled = kind() === null || (kind() === 'known' && select.value === '');
        }

        document.querySelector('[data-inv-who-fix]').addEventListener('click', function () {
            before = select.value;
            kinds.forEach(function (radio) { radio.checked = radio.value === (before === '' ? 'new' : 'known'); });
            paintModal();
            modal.showModal();
        });

        kinds.forEach(function (radio) {
            radio.addEventListener('change', function () {
                // «Ya lo tenemos» empieza sin elegir si venía como nuevo: obliga a buscarlo.
                if (kind() === 'known' && before === '') { setValue(''); }
                paintModal();
            });
        });

        select.addEventListener('change', function () { paint(); paintModal(); });

        apply.addEventListener('click', function () {
            if (kind() === 'new') { setValue(''); }
            before = select.value;
            modal.close();
        });

        modal.querySelector('[data-inv-who-cancel]').addEventListener('click', function () { modal.close(); });
        // Cerrar sin aplicar (Cancelar o Escape) devuelve lo que había.
        modal.addEventListener('close', function () {
            if (select.value !== before) { setValue(before); }
        });

        paint();
    })();
    </script>
    <script>
    /*
     * Comprueba en vivo que el desglose cuadra con el importe: bases más cuotas menos
     * la retención tiene que dar lo que se pagó. Sólo avisa: hay facturas con
     * redondeos o recargos raros, y quien revisa decide.
     *
     * Además, al escribir base y tipo propone la cuota, si la casilla está vacía o la
     * había propuesto ya esta misma cuenta (no se pisa una cifra tecleada a mano).
     */
    (function () {
        var form = document.querySelector('[data-inv-lines]').closest('form');
        var total = document.getElementById('{{ form.entry.magnitude.vars.id }}');
        var withholding = form.querySelector('[data-inv-withholding]');
        var box = form.querySelector('[data-inv-check]');
        var euro = function (n) { return n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'; };
        var num = function (input) { var v = parseFloat(String(input && input.value || '').replace(',', '.')); return isNaN(v) ? 0 : v; };

        function check() {
            var lines = form.querySelectorAll('[data-inv-line]');
            if (!lines.length) { box.hidden = true; return; }
            var sum = 0;
            lines.forEach(function (line) {
                sum += num(line.querySelector('[data-inv-base]')) + num(line.querySelector('[data-inv-tax]'));
            });
            sum = Math.round((sum - num(withholding)) * 100) / 100;
            var paid = num(total);
            var diff = Math.round((paid - sum) * 100) / 100;
            box.hidden = false;
            box.className = 'inv-check ' + (diff === 0 ? 'inv-check--ok' : 'inv-check--ko');
            box.textContent = diff === 0
                ? 'Cuadra: el desglose suma ' + euro(sum) + ', lo mismo que el importe.'
                : 'No cuadra: el desglose suma ' + euro(sum) + ' y el importe es ' + euro(paid) + ' (diferencia ' + euro(diff) + '). Revísalo antes de guardar.';
        }

        function proposeTax(line) {
            var tax = line.querySelector('[data-inv-tax]');
            var base = line.querySelector('[data-inv-base]');
            var rate = line.querySelector('[data-inv-rate]');
            if (base.value === '' || rate.value === '' || (tax.value !== '' && tax.dataset.invAuto !== tax.value)) { return; }
            tax.value = (Math.round(num(base) * num(rate)) / 100).toFixed(2);
            tax.dataset.invAuto = tax.value;
        }

        form.addEventListener('input', function (event) {
            var line = event.target.closest('[data-inv-line]');
            if (line && (event.target.matches('[data-inv-base]') || event.target.matches('[data-inv-rate]'))) { proposeTax(line); }
            check();
        });
        // Quitar una línea no dispara «input»: se escucha el clic y se recalcula después.
        form.addEventListener('click', function (event) {
            if (event.target.closest('[data-csa-collection-remove]')) { setTimeout(check, 0); }
        });
        check();
    })();
    </script>
{% endblock %}
