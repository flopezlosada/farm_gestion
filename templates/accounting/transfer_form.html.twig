{# ============================================================
 # Mover dinero de una cuenta propia a otra.
 #
 # Se teclea como un solo hecho —«saco de aquí, meto allí»— y TransferRecorder lo
 # convierte en los dos apuntes enlazados. Un traspaso no es ingreso ni gasto: no
 # cuenta en el seguimiento del presupuesto, sólo cambia dónde está el dinero.
 #
 # El controller pasa: form.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Traspaso entre cuentas · Contabilidad{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_ledger') }}">Libro</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Traspaso</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header(
        'Contabilidad',
        'Traspaso entre cuentas',
        'El dinero cambia de sitio pero no entra ni sale de la asociación.'
    ) }}

    <div class="csa-form-narrow">
        {{ csa.callout('Se anotan los dos apuntes a la vez, con el mismo importe. No suman ni restan en el presupuesto.', 'info') }}
    </div>

    {{ form_start(form, { attr: { class: 'csa-form-narrow', 'data-csa-dropdowns': '1' } }) }}

        {{ form_errors(form) }}

        <div class="csa-stack-lg">

            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'El traspaso', subtitle: 'De dónde sale, a dónde entra y cuánto.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.date, 'Fecha') }}
                        {{ csa.field(form.amount, 'Importe', { hint: 'en euros' }) }}
                        {{ csa.field(form.from, 'Sale de', { widget_class: 'csa-select' }) }}
                        {{ csa.field(form.to, 'Entra en', { widget_class: 'csa-select' }) }}
                        {{ csa.field(form.concept, 'Concepto', { full: true, hint: 'opcional; si lo dejas vacío se pone solo' }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: path('accounting_ledger') }) }}
                    {{ form_widget(form.submit, { attr: { class: 'csa-btn csa-btn--primary' } }) }}
                </div>
            </div>

        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}
{% endblock %}
