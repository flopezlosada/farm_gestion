{# ============================================================
 # Una factura que ya salió de la bandeja: anotada (con su apunte) o descartada.
 # Se enseña tal como quedó, con el documento al lado; ya no se revisa.
 #
 # El controller pasa: invoice, hasDocument (si el fichero está en el servidor).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}
{% import 'accounting/_invoice_macros.html.twig' as invm %}

{% block title %}Factura · Contabilidad{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_invoices') }}">Facturas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Factura</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
<div class="prl">
    {% set entry = invoice.accountEntry %}
    {% set providerName = invoice.provider ? invoice.provider.name : (invoice.providerName ?? invoice.originalName) %}

    {{ csa.page_header(
        'Contabilidad · Facturas',
        providerName ~ (invoice.invoiceNumber ? ' · fra. ' ~ invoice.invoiceNumber : ''),
        invoice.status == 'confirmed' ? 'Anotada en el libro.' : 'Descartada: no se anotó.'
    ) }}

    <div class="ent-show{{ hasDocument ? '' : ' ent-show--solo' }}">
        <div class="ent-doc">
            {{ invm.document(invoice, hasDocument, 'ent-doc') }}
        </div>

        <div class="ent-panel">
            {% if invoice.total is not null %}
                <div class="ent-amount">
                    <span class="v">{{ invoice.total|number_format(2, ',', '.') }} €</span>
                    <span class="l">total de la factura{{ invoice.invoiceDate ? ' del ' ~ invoice.invoiceDate|date('d/m/Y') : '' }}</span>
                </div>
            {% endif %}
            <dl class="ent-facts">
                <dt>Estado</dt>
                <dd>{{ invoice.status == 'confirmed' ? csa.badge('Anotada', 'green') : csa.badge('Descartada', 'neutral') }}</dd>
                <dt>Proveedor</dt>
                <dd>
                    {% if invoice.provider %}
                        <a href="{{ path('accounting_provider_show', { id: invoice.provider.id }) }}">{{ invoice.provider.name }}</a>
                    {% else %}
                        {{ invoice.providerName ?? '—' }}
                    {% endif %}
                </dd>
                {% if entry %}
                    <dt>Apunte</dt>
                    <dd>
                        <a href="{{ path('accounting_entry_show', { id: entry.id }) }}">{{ entry.concept }}</a><br>
                        <span class="acc-muted acc-small">{{ entry.date|date('d/m/Y') }} · {{ entry.account.name }} · {{ entry.category.name }} · {{ fmt.money(entry.amount) }}</span>
                    </dd>
                {% endif %}
                <dt>Forma de pago</dt>
                <dd>{{ invoice.paymentLabel }} <span class="acc-muted">(según la factura)</span></dd>
                <dt>Subida</dt>
                <dd>{{ invoice.createdAt ? invoice.createdAt|date('d/m/Y H:i') : '—' }}{% if invoice.uploadedBy %} por {{ invoice.uploadedBy.username }}{% elseif invoice.source == 'email' %} · llegó al buzón de facturas{% endif %}</dd>
                {% if invoice.readByModel %}
                    <dt>Leída</dt>
                    <dd>{{ invoice.readAt ? invoice.readAt|date('d/m/Y H:i') : '—' }} <span class="acc-muted">· {{ invoice.readByModel }}</span></dd>
                {% endif %}
                {% if invoice.invoiceNumber %}
                    <dt>Nº de factura</dt>
                    <dd>{{ invoice.invoiceNumber }}</dd>
                {% endif %}
                {{ invm.fact_rows(invoice, invoice.total is null) }}
            </dl>

            <div class="ent-actions">
                {{ csa.btn('Volver a facturas', { variant: 'ghost', href: path('accounting_invoices') }) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
