{# ============================================================
 # Una factura emitida o un borrador.
 #
 # Borrador: lo que tiene, lo que le falta para emitirse y los botones de
 # cambiar, ver el PDF, emitir y tirar. Emitida: tal como salió, su PDF, sus
 # rectificativas y el botón de rectificar.
 #
 # Emitida y sin cobrar: los apuntes del libro que pueden ser su cobro, para
 # ligarla con un clic; cobrada: dónde y cuándo, con la opción de desligar.
 #
 # El controller pasa: invoice, problems, rectifications, paymentCandidates.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}
{% import 'accounting/_issued_invoice_macros.html.twig' as issm %}

{% set title = invoice.issued ? 'Factura ' ~ invoice.numberLabel : 'Borrador de factura' %}
{% set can_edit = is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}

{% block title %}{{ title }} · Facturas emitidas{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_issued_invoices', { year: invoice.year ?? 'now'|date('Y') }) }}">Facturas emitidas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ invoice.issued ? invoice.numberLabel : 'Borrador' }}</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    {% include 'accounting/_issued_invoice_styles.html.twig' %}
{% endblock %}

{% block csa_main %}

{% set note = invoice.customerNoteForPrint %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad · Facturas emitidas',
        title,
        invoice.issued
            ? invoice.seriesLabel ~ ' · emitida el ' ~ invoice.issuedAt|date('d/m/Y') ~ (invoice.issuedBy ? ' por ' ~ invoice.issuedBy.displayName : '')
            : invoice.seriesLabel ~ ' · sin número hasta que se emita' ~ (invoice.source == 'telegram' ? ' · llegó por Telegram' : '')
    ) }}

    <div class="prl-toolbar">
        <div class="iss-actions">
            <a href="{{ path('accounting_issued_invoice_pdf', { id: invoice.id }) }}" class="prl-btn" target="_blank" rel="noopener"><i class="fa fa-file-pdf-o"></i> {{ invoice.issued ? 'PDF' : 'Ver cómo queda' }}</a>
            {% if can_edit and invoice.draft %}
                <a href="{{ path('accounting_issued_invoice_edit', { id: invoice.id }) }}" class="prl-btn"><i class="fa fa-pencil"></i> Cambiar</a>
                <form method="post" action="{{ path('accounting_issued_invoice_delete', { id: invoice.id }) }}" onsubmit="return confirm('¿Tirar este borrador? No tiene número, así que no deja ningún hueco.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-invoice-' ~ invoice.id) }}">
                    <button type="submit" class="prl-btn"><i class="fa fa-trash-o"></i> Tirar el borrador</button>
                </form>
            {% endif %}
            {% if can_edit and invoice.issued and not invoice.rectifying %}
                <form method="post" action="{{ path('accounting_issued_invoice_rectify', { id: invoice.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('rectify-invoice-' ~ invoice.id) }}">
                    <button type="submit" class="prl-btn"><i class="fa fa-undo"></i> Rectificar</button>
                </form>
            {% endif %}
        </div>
        <div class="spacer"></div>
        {% if can_edit and invoice.draft %}
            <form method="post" action="{{ path('accounting_issued_invoice_issue', { id: invoice.id }) }}" onsubmit="return confirm('¿Emitirla? Recibe número y ya no se puede cambiar: sólo rectificar.');">
                <input type="hidden" name="_token" value="{{ csrf_token('issue-invoice-' ~ invoice.id) }}">
                <button type="submit" class="prl-btn prl-btn--primary"{{ problems is not empty ? ' disabled' }}><i class="fa fa-check"></i> Emitir</button>
            </form>
        {% endif %}
    </div>

    {% if problems is not empty %}
        <div class="csa-alert csa-alert--warning iss-problems" role="status">
            <i class="csa-alert__icon fa fa-exclamation-triangle" aria-hidden="true"></i>
            <div class="csa-alert__body">
                Para emitirla falta:
                <ul>
                    {% for problem in problems %}<li>{{ problem }}</li>{% endfor %}
                </ul>
            </div>
        </div>
    {% elseif invoice.draft %}
        <div class="csa-alert csa-alert--info iss-problems" role="status">
            <i class="csa-alert__icon fa fa-info-circle" aria-hidden="true"></i>
            <div class="csa-alert__body">Lista para emitir. Al emitirla recibe el siguiente número de la {{ invoice.seriesLabel|lower }} de {{ invoice.issueDate|date('Y') }} y ya no se puede cambiar.</div>
        </div>
    {% endif %}

    <div class="iss-paper">
        <div class="iss-head">
            <div>
                <h3>Cliente</h3>
                <p>{{ invoice.customerLines is empty ? 'Sin cliente todavía.' : invoice.customerLines|join("\n") }}</p>
                {% if invoice.draft and invoice.customer %}
                    <p><a href="{{ path('accounting_customer_show', { id: invoice.customer.id }) }}">ficha del cliente</a></p>
                {% endif %}
            </div>
            <div>
                <h3>Fecha</h3>
                <p>{{ invoice.issueDate ? invoice.issueDate|date('d/m/Y') : '—' }}</p>
                {% if invoice.rectifies %}
                    <h3 style="margin-top: 12px;">Rectifica</h3>
                    <p><a href="{{ path('accounting_issued_invoice_show', { id: invoice.rectifies.id }) }}">{{ invoice.rectifies.numberLabel }}</a></p>
                {% endif %}
            </div>
        </div>

        {% if invoice.description %}<p class="iss-desc">{{ invoice.description }}</p>{% endif %}

        <table class="iss-lines">
            {% for line in invoice.lines %}
                <tr>
                    <td>{{ line.concept }}</td>
                    <td class="rate">{{ line.exempt ? 'exenta' : 'IVA ' ~ line.vatRate ~ ' %' }}</td>
                    <td class="num">{{ fmt.money(line.amount) }}</td>
                </tr>
            {% else %}
                <tr><td class="acc-muted">Sin líneas.</td></tr>
            {% endfor %}
        </table>

        {{ issm.totals(invoice) }}

        {% if note %}<p class="iss-note">{{ note }}</p>{% endif %}
        {% if invoice.hasExemptLines and invoice.exemptionNote %}<p class="iss-note">{{ invoice.exemptionNote }}</p>{% endif %}
    </div>

    {% if invoice.issued %}
        <h2 class="acc-subhead">{{ invoice.rectifying ? 'Devolución' : 'Cobro' }}</h2>
        {% if invoice.paid %}
            {% set entry = invoice.accountEntry %}
            <div class="csa-alert csa-alert--success" role="status">
                <i class="csa-alert__icon fa fa-check-circle" aria-hidden="true"></i>
                <div class="csa-alert__body">
                    {{ invoice.rectifying ? 'Devuelta' : 'Cobrada' }} el {{ entry.date|date('d/m/Y') }} en {{ entry.account.name }}:
                    {% if can_edit %}<a href="{{ path('accounting_entry_edit', { id: entry.id }) }}">{{ entry.concept }}</a>{% else %}{{ entry.concept }}{% endif %}
                    · {{ fmt.money(entry.amount) }}
                    {% if can_edit %}
                        <form method="post" action="{{ path('accounting_issued_invoice_payment_remove', { id: invoice.id }) }}" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('payment-remove-invoice-' ~ invoice.id) }}">
                            <button type="submit" class="prl-btn"><i class="fa fa-chain-broken"></i> No es este</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% elseif paymentCandidates is empty %}
            <p class="acc-muted">Sin {{ invoice.rectifying ? 'devolver' : 'cobrar' }}: en el libro no hay ningún apunte de {{ fmt.money(invoice.total) }} cerca de su fecha. Cuando entre el extracto del banco aparecerá aquí.</p>
        {% else %}
            <p>Sin {{ invoice.rectifying ? 'devolver' : 'cobrar' }}. {{ paymentCandidates|length == 1 ? 'Este apunte del libro tiene' : 'Estos apuntes del libro tienen' }} su importe exacto:</p>
            <table class="iss-lines">
                {% for entry in paymentCandidates %}
                    <tr>
                        <td>{{ entry.date|date('d/m/Y') }} · {{ entry.account.name }} · {{ entry.concept }}</td>
                        <td class="num">{{ fmt.money(entry.amount) }}</td>
                        {% if can_edit %}
                            <td class="num">
                                <form method="post" action="{{ path('accounting_issued_invoice_payment', { id: invoice.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('payment-invoice-' ~ invoice.id) }}">
                                    <input type="hidden" name="entry" value="{{ entry.id }}">
                                    <button type="submit" class="prl-btn"><i class="fa fa-link"></i> Es este</button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </table>
        {% endif %}
    {% endif %}

    {% if rectifications is not empty %}
        <h2 class="acc-subhead">Rectificativas</h2>
        <ul>
            {% for r in rectifications %}
                <li><a href="{{ path('accounting_issued_invoice_show', { id: r.id }) }}">{{ r.issued ? r.numberLabel : 'Borrador' }}</a> · {{ fmt.money(r.total) }}</li>
            {% endfor %}
        </ul>
    {% endif %}

</div>
{% endblock %}
