{# ============================================================
 # La bandeja de facturas recibidas.
 #
 # Se suben, se leen solas y se confirman. Lo que esté esperando lectura lo dice un
 # aviso arriba, con el motivo y cuándo se vuelve a intentar: así nadie sube dos
 # veces la misma factura pensando que se ha perdido.
 #
 # El controller pasa: upload (formulario de subida), open (facturas por resolver),
 # queue (estado de la cola), recent (últimas anotadas).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Contabilidad · Facturas{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Facturas</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .inv-upload { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0; }
        .inv-upload input[type=file] { max-width: 100%; }
        .inv-queue { margin: 0 0 var(--csa-sp-4, 16px); }
    </style>
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Contabilidad · Facturas',
        'Facturas recibidas',
        'Sube la factura o el ticket y se lee sola. Sólo tienes que revisar lo leído y confirmarlo: el apunte se crea con un clic.'
    ) }}

    {# ============ AVISO DE LA COLA ============ #}
    <div class="inv-queue">
        {% if queue.count > 0 and not queue.enabled %}
            {{ csa.callout(
                queue.count ~ (queue.count == 1 ? ' factura espera' : ' facturas esperan') ~ ' a ser leída' ~ (queue.count == 1 ? '' : 's') ~ ', pero la lectura automática no está configurada. Puedes completarlas a mano entrando en cada una.',
                'warning', 'exclamation-triangle'
            ) }}
        {% elseif queue.waiting > 0 %}
            {{ csa.callout(
                queue.waiting ~ (queue.waiting == 1 ? ' factura no se ha podido leer todavía' : ' facturas no se han podido leer todavía') ~ ': ' ~ queue.lastError|trim('.') ~ '. '
                ~ (queue.nextAttempt ? 'Se vuelve a intentar a partir de las ' ~ queue.nextAttempt|date('H:i') ~ (queue.nextAttempt|date('Y-m-d') != 'now'|date('Y-m-d') ? ' del ' ~ queue.nextAttempt|date('d/m') : '') ~ '. ' : 'Se vuelve a intentar enseguida. ')
                ~ 'No hace falta volver a subirlas; si corre prisa, entra en cada una y complétala a mano.',
                'warning', 'clock-o'
            ) }}
        {% elseif queue.reading > 0 %}
            {{ csa.callout(
                (queue.reading == 1 ? 'Leyendo 1 factura' : 'Leyendo ' ~ queue.reading ~ ' facturas') ~ '. Suele tardar unos segundos; esta página se actualiza sola.',
                'info', 'refresh'
            ) }}
        {% endif %}
    </div>

    {# ============ SUBIR ============ #}
    {% if is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}
        <div class="prl-toolbar">
            {{ form_start(upload, { attr: { class: 'inv-upload' } }) }}
                {{ form_widget(upload.files) }}
                <button type="submit" class="prl-btn prl-btn--primary"><i class="fa fa-upload"></i> Subir</button>
                <span class="acc-muted acc-small">PDF o foto; puedes elegir varias a la vez. Hasta 12 MB cada una.</span>
            {{ form_end(upload) }}
        </div>
    {% endif %}

    {# ============ POR RESOLVER ============ #}
    <div class="prl-toolbar">
        <div class="counters">
            <b>{{ open|length }}</b> por resolver
        </div>
        <div class="spacer"></div>
        <a href="{{ path('accounting_accountant_export') }}" class="prl-btn"><i class="fa fa-briefcase"></i> Para la gestoría</a>
        <a href="{{ path('accounting_ledger') }}" class="prl-btn"><i class="fa fa-list"></i> Libro</a>
    </div>

    <div class="prl-table-wrap">
        {% if open is empty %}
            <div class="prl-empty">
                No hay facturas pendientes. Lo que subas aparecerá aquí.
            </div>
        {% else %}
            <table class="prl-table">
                <thead>
                    <tr>
                        <th class="tight">Estado</th>
                        <th>Factura</th>
                        <th>Partida propuesta</th>
                        <th class="tight">Fecha</th>
                        <th class="tight acc-num">Total</th>
                        <th class="tight"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for invoice in open %}
                        <tr>
                            <td class="tight">
                                {% if invoice.status == 'read' %}
                                    {{ csa.badge('Para revisar', 'green') }}
                                {% elseif invoice.status == 'unreadable' %}
                                    {{ csa.badge('A mano', 'terracotta') }}
                                {% elseif invoice.lastError %}
                                    {{ csa.badge('En espera', 'ochre') }}
                                {% else %}
                                    {{ csa.badge('Leyendo', 'sky') }}
                                {% endif %}
                            </td>
                            <td>
                                {{ invoice.providerName ?? invoice.originalName }}
                                <br><span class="acc-muted acc-small">
                                    {% if invoice.invoiceNumber %}fra. {{ invoice.invoiceNumber }} · {% endif %}
                                    {% if invoice.status == 'unreadable' %}{{ invoice.lastError }}{% else %}{{ invoice.concept ?? invoice.originalName }}{% endif %}
                                </span>
                            </td>
                            <td>
                                {% if invoice.suggestedCategory %}
                                    <span class="acc-muted acc-small">{{ invoice.suggestedCategory.group.name }}</span><br>
                                    {{ invoice.suggestedCategory.name }}
                                {% else %}
                                    <span class="acc-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="tight">{{ invoice.invoiceDate ? invoice.invoiceDate|date('d/m/Y') : '—' }}</td>
                            <td class="acc-num">{{ invoice.total is not null ? invoice.total|number_format(2, ',', '.') ~ ' €' : '—' }}</td>
                            <td class="tight">
                                <a href="{{ path('accounting_invoice_review', { id: invoice.id }) }}" class="prl-btn {{ invoice.status == 'pending' ? '' : 'prl-btn--primary' }}">
                                    {{ invoice.status == 'pending' ? 'Ver' : 'Revisar' }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {# ============ ÚLTIMAS ANOTADAS ============ #}
    {% if recent is not empty %}
        <h3 class="acc-muted" style="margin-top: var(--csa-sp-6, 32px); font-size: 14px;">Últimas anotadas</h3>
        <div class="prl-table-wrap">
            <table class="prl-table">
                <tbody>
                    {% for invoice in recent %}
                        <tr>
                            <td>{{ invoice.providerName ?? invoice.originalName }}</td>
                            <td class="tight">{{ invoice.accountEntry ? invoice.accountEntry.date|date('d/m/Y') : '—' }}</td>
                            <td class="acc-num">{{ invoice.accountEntry ? invoice.accountEntry.amount|number_format(2, ',', '.') ~ ' €' : '—' }}</td>
                            <td class="tight">
                                {% if invoice.accountEntry %}
                                    <a href="{{ path('accounting_entry_edit', { id: invoice.accountEntry.id }) }}" class="prl-btn" title="Ver el apunte"><i class="fa fa-pencil"></i></a>
                                {% endif %}
                                <a href="{{ path('accounting_invoice_file', { id: invoice.id }) }}" class="prl-btn" target="_blank" rel="noopener" title="Ver la factura"><i class="fa fa-file-o"></i></a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

</div>
{% endblock %}

{% block more_js %}
    {{ parent() }}
    {% if queue.reading > 0 and queue.enabled %}
        <script>
            // Mientras haya facturas leyéndose, la bandeja se actualiza sola: quien
            // acaba de subir no tiene que adivinar cuándo recargar. Se para en cuanto
            // no queda ninguna en lectura (el servidor deja de pintar este script).
            setTimeout(function () { window.location.reload(); }, 8000);
        </script>
    {% endif %}
{% endblock %}
