{# ============================================================
 # Un apunte del libro, con su factura al lado si vino de una.
 #
 # El documento se enseña igual que en la revisión de la bandeja (imagen o PDF
 # dentro de la página). Sin factura, la ficha ocupa todo el ancho.
 #
 # El controller pasa: entry, invoice (la factura de la que salió, o null),
 # otherInvoices (las demás que paga, si es el pago agrupado de varias),
 # issuedInvoice (la emitida de la que este apunte es el cobro, o null),
 # hasDocument (si el fichero de esa factura está en el servidor), closedBy (la
# entrega a la gestoría que cierra su trimestre, o null), y para un
 # traspaso sin pareja nearbyLoose (mitades sueltas de otras cuentas cerca de su
 # fecha), pairable (los id de ésas que casan) y peerAccounts (cuentas donde anotar
 # la que falta). splitCategories: partidas para partir el apunte (vacío en un traspaso).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}
{% import 'accounting/_invoice_macros.html.twig' as invm %}

{% block title %}Apunte · Contabilidad{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_ledger', { account: entry.account.id }) }}">Movimientos</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Apunte</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include 'accounting/_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
<div class="prl">
    {% import _self as here %}
    {% set editable = is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') and closedBy is null %}

    {# El concepto del banco es una tira larga («trf. semilleros alvarez…»): de título
     # va quién es, si se sabe, y el concepto entero queda en la ficha. #}
    {{ csa.page_header(
        'Contabilidad · Apunte',
        entry.providerName ?: entry.concept|u.truncate(70, '…', false),
        entry.date|date('d/m/Y') ~ ' · ' ~ entry.account.name ~ (entry.category ? ' · ' ~ entry.category.name : '')
    ) }}

    {% if closedBy %}
        <p class="csa-callout csa-callout--info">
            <i class="csa-callout__icon fa fa-lock"></i>
            <span>
                El {{ closedBy.quarter.label }} se entregó a la gestoría el {{ closedBy.deliveredAt|date('d/m/Y') }}: este apunte ya no se cambia.
                Si hay que corregirlo, se reabre desde
                <a href="{{ path('accounting_accountant_export', { year: closedBy.quarter.year, quarter: closedBy.quarter.quarter }) }}">Para la gestoría</a>.
            </span>
        </p>
    {% endif %}

    {# Sin documento que enseñar, a una columna: media pantalla vacía no dice nada. #}
    <div class="ent-show{{ invoice and hasDocument ? '' : ' ent-show--solo' }}">

        {% if invoice %}
            <div class="ent-doc">
                {{ invm.document(invoice, hasDocument, 'ent-doc') }}
            </div>
        {% endif %}

        <div class="ent-panel">
            <div class="ent-amount">
                <span class="v {{ entry.incoming ? '' : 'acc-neg' }}">{{ entry.amount|number_format(2, ',', '.') }} €</span>
                <span class="l">{{ entry.incoming ? 'entra en' : 'sale de' }} {{ entry.account.name }} el {{ entry.date|date('d/m/Y') }}</span>
            </div>

            {# Una sola lista: lo del apunte y, si vino de una factura, lo que sólo dice la
             # factura. Antes eran dos bloques que repetían fecha, proveedor y número. #}
            <dl class="ent-facts">
                <dt>Concepto</dt>
                <dd>{{ entry.concept }}</dd>
                <dt>Partida</dt>
                <dd>{% if entry.category %}<a href="{{ path('accounting_category_show', { id: entry.category.id }) }}">{{ entry.category.name }}</a> <span class="acc-muted">· {{ entry.category.group.name }}</span>{% else %}—{% endif %}</dd>
                <dt>Cuenta</dt>
                <dd><a href="{{ path('accounting_ledger', { account: entry.account.id }) }}">{{ entry.account.name }}</a></dd>
                {% if entry.pairedTransfer %}
                    <dt>Traspaso</dt>
                    <dd>{{ entry.incoming ? 'desde' : 'hacia' }} <a href="{{ path('accounting_entry_show', { id: entry.transferPeer.id }) }}">{{ entry.transferPeer.account.name }}</a></dd>
                {% endif %}
                {% if issuedInvoice %}
                    <dt>{{ issuedInvoice.rectifying ? 'Devolución de' : 'Cobro de' }}</dt>
                    <dd><a href="{{ path('accounting_issued_invoice_show', { id: issuedInvoice.id }) }}">la factura {{ issuedInvoice.numberLabel }}</a>{% if issuedInvoice.customer %} · {{ issuedInvoice.customer.name }}{% endif %}</dd>
                {% endif %}
                {% if entry.providerName %}
                    <dt>Proveedor</dt>
                    <dd>
                        {% if invoice and invoice.provider %}
                            <a href="{{ path('accounting_provider_show', { id: invoice.provider.id }) }}">{{ entry.providerName }}</a>
                        {% else %}
                            {{ entry.providerName }}
                        {% endif %}
                    </dd>
                {% endif %}
                {% if entry.invoiceNumber %}
                    <dt>Nº de factura</dt>
                    <dd>
                        {% if invoice %}<a href="{{ path('accounting_invoice_review', { id: invoice.id }) }}" title="Ver la factura">{{ entry.invoiceNumber }}</a>{% else %}{{ entry.invoiceNumber }}{% endif %}
                    </dd>
                {% endif %}
                {% if invoice %}
                    {# El total sólo si no es el importe de arriba: en un pago agrupado, el
                     # apunte paga varias y cada una tiene el suyo. #}
                    {{ invm.fact_rows(invoice, otherInvoices is not empty) }}
                {% endif %}
                {% if entry.notes %}
                    <dt>Notas</dt>
                    <dd>{{ entry.notes|nl2br }}</dd>
                {% endif %}
                <dt>Anotado</dt>
                <dd class="acc-muted">{{ entry.createdAt ? entry.createdAt|date('d/m/Y H:i') : '—' }}{% if entry.createdBy %} por {{ entry.createdBy.username }}{% endif %}</dd>
            </dl>

            {% if otherInvoices is not empty %}
                <p class="acc-lead">Este pago explica también
                    {% for other in otherInvoices %}<a href="{{ path('accounting_invoice_review', { id: other.id }) }}">{{ other.invoiceNumber ?? ('la del ' ~ other.invoiceDate|date('d/m/Y')) }}</a> ({{ fmt.money(other.total) }}){{ loop.last ? '.' : (loop.revindex == 2 ? ' y ' : ', ') }}{% endfor %}
                </p>
            {% endif %}

            {% if editable %}
                <div class="ent-actions">
                    {% if not entry.pairedTransfer %}
                        {{ csa.btn('Corregir', { variant: 'primary', href: path('accounting_entry_edit', { id: entry.id }), icon: 'fa-pencil' }) }}
                    {% endif %}
                    <form method="post" action="{{ path('accounting_entry_delete', { id: entry.id }) }}" style="display:inline;"
                          onsubmit="return confirm('{{ entry.pairedTransfer ? '¿Borrar el traspaso? Se van los dos apuntes.' : (otherInvoices is not empty ? '¿Borrar el apunte? Sus ' ~ (otherInvoices|length + 1) ~ ' facturas vuelven a la bandeja.' : (invoice ? '¿Borrar el apunte? La factura vuelve a la bandeja para anotarla de nuevo.' : (issuedInvoice ? '¿Borrar el apunte? La factura ' ~ issuedInvoice.numberLabel ~ ' volverá a estar sin cobrar.' : '¿Borrar el apunte?'))) }}');">
                        <input type="hidden" name="_token" value="{{ csrf_token('accounting_entry_delete_' ~ entry.id) }}">
                        <button type="submit" class="csa-btn csa-btn--ghost"><i class="fa fa-trash"></i> <span>{{ entry.pairedTransfer ? 'Borrar el traspaso' : 'Borrar' }}</span></button>
                    </form>
                </div>
                {% if splitCategories is not empty %}
                    {{ here.split_form(entry, splitCategories, invoice or issuedInvoice) }}
                {% endif %}
            {% endif %}
        </div>
    </div>

    {% if entry.looseTransfer %}
        {{ here.loose_transfer(entry, nearbyLoose, pairable, peerAccounts, editable) }}
    {% endif %}
</div>
{% endblock %}

{# Partir el apunte: un cargo del banco que junta dos cosas (el del Ayuntamiento:
 # alquiler con factura + suministros sin ella) se cuenta en dos partidas. Plegado,
 # porque es raro y la ficha no tiene que gritarlo. #}
{% macro split_form(entry, categories, explained) %}
    <details class="ent-split">
        <summary><i class="fa fa-scissors"></i> Partir el apunte</summary>
        <p class="acc-lead">
            Separa parte del importe en otro apunte de {{ entry.account.name }}, el mismo día, con su partida y su concepto.
            Éste baja en lo que separes; el saldo de la cuenta no cambia.
            {% if explained %}La factura se queda en este apunte.{% endif %}
        </p>
        <form method="post" action="{{ path('accounting_entry_split', { id: entry.id }) }}" class="ent-split__form">
            <input type="hidden" name="_token" value="{{ csrf_token('accounting_entry_split_' ~ entry.id) }}">
            <label>Importe que se separa (€)
                <input type="text" name="amount" class="csa-input" inputmode="decimal" required placeholder="50,00">
            </label>
            <label>Partida
                <select name="category" class="csa-input" required>
                    <option value="">Elige la partida</option>
                    {% for c in categories %}
                        <option value="{{ c.id }}">{{ c.group.name|capitalize }} · {{ c.name }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="ent-split__concept">Concepto
                <input type="text" name="concept" class="csa-input" required maxlength="255">
            </label>
            <div>
                <button type="submit" class="csa-btn csa-btn--secondary"><i class="fa fa-scissors"></i> <span>Partir</span></button>
            </div>
        </form>
    </details>
{% endmacro %}

{# Un traspaso al que le falta la otra mitad: la portada manda aquí. Se arregla
 # emparejándolo con la mitad ya anotada en la otra cuenta o anotando la que falta. #}
{% macro loose_transfer(entry, nearby, pairable, accounts, editable) %}
    {% import 'accounting/_money.html.twig' as fmt %}
    <h2 class="acc-subhead">Le falta la otra mitad</h2>
    <p class="acc-lead">
        Un traspaso son dos apuntes que se anulan: lo que sale de una cuenta entra en otra.
        A éste le falta el de la otra cuenta, y hasta que lo tenga el saldo de una de
        las dos no cuadra.
    </p>
    {% if nearby is not empty %}
        <p class="acc-lead">Mitades sueltas en sentido contrario, de otras cuentas y cerca de esta fecha. Si
           la pareja está pero con otro importe, corrige la que esté mal y vuelve aquí.</p>
        <div class="prl-table-wrap">
        <table class="prl-table">
            <thead>
                <tr>
                    <th class="tight">Fecha</th>
                    <th class="tight">Cuenta</th>
                    <th>Concepto</th>
                    <th class="acc-num">Importe</th>
                    <th class="tight"></th>
                </tr>
            </thead>
            <tbody>
                {% for c in nearby %}
                    <tr>
                        <td class="tight">{{ c.date|date('d/m/Y') }}</td>
                        <td class="tight">{{ c.account.name }}</td>
                        <td><a href="{{ path('accounting_entry_show', { id: c.id }) }}">{{ c.concept }}</a></td>
                        <td class="acc-num">{{ fmt.money(c.amount, false) }}</td>
                        {% if c.id not in pairable %}
                            <td class="tight acc-muted acc-small">otro importe</td>
                        {% elseif not editable %}
                            <td class="tight"></td>
                        {% else %}
                            <td class="tight">
                                <form method="post" action="{{ path('accounting_entry_pair', { id: entry.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('accounting_entry_pair_' ~ entry.id) }}">
                                    <input type="hidden" name="peer" value="{{ c.id }}">
                                    <button type="submit" class="csa-btn csa-btn--secondary"><i class="fa fa-link"></i> <span>Es ésta</span></button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% elseif editable %}
        <p class="acc-lead">No hay ninguna mitad suelta en otra cuenta cerca de esta fecha: anota la que falta.</p>
    {% endif %}
    {% if editable and accounts is not empty %}
        <form method="post" action="{{ path('accounting_entry_complete', { id: entry.id }) }}" class="csa-row" style="margin-top: var(--csa-sp-3);">
            <input type="hidden" name="_token" value="{{ csrf_token('accounting_entry_complete_' ~ entry.id) }}">
            <label>{{ entry.incoming ? 'Salió de' : 'Entró en' }}
                <select name="account" class="csa-input" required>
                    <option value="">Elige la cuenta</option>
                    {% for a in accounts %}
                        <option value="{{ a.id }}">{{ a.name }}</option>
                    {% endfor %}
                </select>
            </label>
            <button type="submit" class="csa-btn csa-btn--ghost"><i class="fa fa-plus"></i> <span>Anotar la otra mitad</span></button>
        </form>
    {% endif %}
{% endmacro %}
