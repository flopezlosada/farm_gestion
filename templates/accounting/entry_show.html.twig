{# ============================================================
 # Un apunte del libro, con su factura al lado si vino de una.
 #
 # El documento se enseña igual que en la revisión de la bandeja (imagen o PDF
 # dentro de la página). Sin factura, la ficha ocupa todo el ancho.
 #
 # El controller pasa: entry, invoice (la factura de la que salió, o null),
 # hasDocument (si el fichero de esa factura está en el servidor).
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'accounting/_money.html.twig' as fmt %}
{% import 'accounting/_invoice_macros.html.twig' as invm %}

{% block title %}Apunte · Contabilidad{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_index') }}">Contabilidad</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('accounting_ledger', { account: entry.account.id }) }}">Libro</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Apunte</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'accounting/_styles.html.twig' %}
    <style>
        .ent-show { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--csa-sp-6, 32px); align-items: start; }
        .ent-show--solo { grid-template-columns: minmax(0, 720px); }
        .ent-doc { position: sticky; top: var(--csa-sp-4, 16px); border: 1px solid var(--csa-rule, #ddd); border-radius: 6px; overflow: hidden; background: #fafafa; }
        .ent-doc img { display: block; width: 100%; height: auto; }
        .ent-doc iframe { display: block; width: 100%; height: 80vh; border: 0; }
        .ent-doc__bar { display: flex; justify-content: space-between; gap: 8px; padding: 6px 10px; font-size: 12px; border-bottom: 1px solid var(--csa-rule, #ddd); background: #fff; }
        .ent-facts { display: grid; grid-template-columns: max-content 1fr; gap: 8px 24px; margin: 0 0 var(--csa-sp-5, 24px); font-size: 14px; }
        .ent-facts dt { color: var(--csa-ink-soft, #6b6b6b); }
        .ent-facts dd { margin: 0; }
        .ent-h { font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--csa-ink-soft, #6b6b6b); margin: var(--csa-sp-5, 24px) 0 var(--csa-sp-3, 12px); }
        @media (max-width: 900px) {
            .ent-show { grid-template-columns: 1fr; }
            .ent-doc { position: static; }
            .ent-doc iframe { height: 60vh; }
        }
    </style>
{% endblock %}

{% block csa_main %}
    {% set editable = is_granted('ROLE_GESTION_CONTABILIDAD_EDIT') %}

    {{ csa.page_header(
        'Contabilidad · Libro',
        entry.concept,
        entry.date|date('d/m/Y') ~ ' · ' ~ entry.account.name
    ) }}

    <div class="ent-show{{ invoice ? '' : ' ent-show--solo' }}">

        {% if invoice %}
            <div class="ent-doc">
                {{ invm.document(invoice, hasDocument, 'ent-doc') }}
            </div>
        {% endif %}

        <div>
            <dl class="ent-facts">
                <dt>Importe</dt>
                <dd><b>{{ fmt.money(entry.amount) }}</b> <span class="acc-muted">({{ entry.incoming ? 'entra' : 'sale' }})</span></dd>
                <dt>Partida</dt>
                <dd>{{ entry.category ? entry.category.group.name ~ ' / ' ~ entry.category.name : '—' }}</dd>
                <dt>Cuenta</dt>
                <dd>{{ entry.account.name }}</dd>
                {% if entry.transfer and entry.transferPeer %}
                    <dt>Traspaso</dt>
                    <dd>{{ entry.incoming ? 'desde' : 'hacia' }} {{ entry.transferPeer.account.name }}</dd>
                {% endif %}
                {% if entry.providerName %}
                    <dt>Proveedor</dt>
                    <dd>
                        {% if invoice and invoice.provider %}
                            <a href="{{ path('accounting_provider_show', { id: invoice.provider.id }) }}">{{ entry.providerName }}</a>
                        {% else %}
                            {{ entry.providerName }}
                        {% endif %}
                    </dd>
                {% endif %}
                {% if entry.invoiceNumber %}
                    <dt>Nº de factura</dt>
                    <dd>{{ entry.invoiceNumber }}</dd>
                {% endif %}
                {% if entry.notes %}
                    <dt>Notas</dt>
                    <dd>{{ entry.notes|nl2br }}</dd>
                {% endif %}
                <dt>Anotado</dt>
                <dd>{{ entry.createdAt ? entry.createdAt|date('d/m/Y H:i') : '—' }}{% if entry.createdBy %} por {{ entry.createdBy.username }}{% endif %}</dd>
            </dl>

            {% if invoice %}
                <h2 class="ent-h">La factura</h2>
                <dl class="ent-facts">
                    <dt>Fecha</dt>
                    <dd>{{ invoice.invoiceDate ? invoice.invoiceDate|date('d/m/Y') : '—' }}</dd>
                    <dt>CIF</dt>
                    <dd>{{ invoice.providerTaxId ?? '—' }}</dd>
                    {% for line in invoice.taxLines %}
                        <dt>{{ loop.first ? 'Bases e IVA' : '' }}</dt>
                        <dd>{{ fmt.money(line.base) }} al {{ line.rate|number_format(0, ',', '.') }} % = {{ fmt.money(line.taxAmount) }}</dd>
                    {% else %}
                        <dt>Bases e IVA</dt>
                        <dd class="acc-muted">sin desglose</dd>
                    {% endfor %}
                    {% if invoice.withholding %}
                        <dt>Retención IRPF</dt>
                        <dd>{{ fmt.money(invoice.withholding) }}{% if invoice.withholdingRate %} ({{ invoice.withholdingRate|number_format(0, ',', '.') }} %){% endif %}</dd>
                    {% endif %}
                    <dt>Total</dt>
                    <dd>{{ invoice.total is not null ? fmt.money(invoice.total) : '—' }}</dd>
                </dl>
            {% endif %}

            {% if editable %}
                <div class="csa-row" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                    {% if not entry.transfer %}
                        {{ csa.btn('Corregir', { variant: 'primary', href: path('accounting_entry_edit', { id: entry.id }), icon: 'fa-pencil' }) }}
                    {% endif %}
                    <form method="post" action="{{ path('accounting_entry_delete', { id: entry.id }) }}" style="display:inline;"
                          onsubmit="return confirm('{{ entry.transfer ? '¿Borrar el traspaso? Se van los dos apuntes.' : (invoice ? '¿Borrar el apunte? La factura vuelve a la bandeja para anotarla de nuevo.' : '¿Borrar el apunte?') }}');">
                        <input type="hidden" name="_token" value="{{ csrf_token('accounting_entry_delete_' ~ entry.id) }}">
                        <button type="submit" class="csa-btn csa-btn--ghost"><i class="fa fa-trash"></i> <span>Borrar</span></button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
