{# Catálogo de áreas del voluntariado.
 #
 # Mismo patrón que el listado de socixs. El formulario de alta ya NO vive aquí:
 # tiene pantalla propia (volunteering_category_new). Un formulario debajo de la
 # tabla compite con ella por la atención y alarga la página sin motivo — a un
 # catálogo se entra a mirar mucho más a menudo que a crear. #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Voluntariado · Áreas{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'partner/_listing_styles.html.twig' %}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{% block more_js %}
    {{ parent() }}
    {% include '_components/listing_filters_js.html.twig' %}
{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('volunteering_index') }}">Voluntariado</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Áreas</span>
{% endblock %}

{% block csa_main %}
<div class="prl">

    {{ csa.page_header(
        'Voluntariado',
        'Áreas',
        'Cada socix marca en su ficha de qué áreas quiere que se le avise. Marcar significa "avísame de esto"; no marcar nada, "avísame de lo que sea sencillo".'
    ) }}

    <div class="prl-stats">
        <a class="prl-stat prl-stat--active" href="{{ path('volunteering_categories', { ver: 'active' }) }}" style="text-decoration: none;">
            <div class="v">{{ counts.active }}</div>
            <div class="l">activas</div>
        </a>
        <a class="prl-stat prl-stat--leave" href="{{ path('volunteering_categories', { ver: 'retired' }) }}" style="text-decoration: none;">
            <div class="v">{{ counts.retired }}</div>
            <div class="l">retiradas</div>
        </a>
        <a class="prl-stat" href="{{ path('volunteering_categories', { ver: 'all' }) }}" style="text-decoration: none;">
            <div class="v">{{ counts.all }}</div>
            <div class="l">en total</div>
        </a>
    </div>

    {% set tabs = { 'active': 'Activas', 'retired': 'Retiradas', 'all': 'Todas' } %}
    <nav class="prl-tabs" role="tablist">
        {% for key, label in tabs %}
            <a href="{{ path('volunteering_categories', { ver: key }) }}" class="{{ scope == key ? 'active' : '' }}">
                {{ label }} <span class="count">{{ counts[key] }}</span>
            </a>
        {% endfor %}
    </nav>

    <form method="get" action="{{ path('volunteering_categories') }}" id="prl-filter-form">
        <input type="hidden" name="ver" value="{{ scope }}">

        <div class="prl-toolbar">
            <div class="prl-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                <input type="search" name="q" value="{{ q }}" placeholder="Buscar por nombre o descripción…" autocomplete="off">
            </div>

            <div style="margin-left: auto;">
                {{ csa.btn('Nueva área', { variant: 'primary', icon: 'fa-plus', href: path('volunteering_category_new') }) }}
            </div>
        </div>
    </form>

    <div class="csa-table-wrap">
        <table class="csa-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Qué entra aquí</th>
                    <th>Coordina</th>
                    <th class="csa-table__col-tight">Socixs</th>
                    <th class="csa-table__col-tight">Estado</th>
                    <th class="csa-table__actions">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for category in pagination %}
                    <tr>
                        <td>
                            <a class="csa-table__primary" href="{{ path('volunteering_category_show', { id: category.id }) }}">{{ category.name }}</a>
                        </td>
                        <td>{{ category.description ?: '—' }}</td>
                        <td>
                            {# Insignia COMPACTA y sin punto: un nombre y apellidos con el
                             # padding normal se comía la celda y el punto de color delante
                             # de un nombre no informa de nada. Y en minúsculas + csa-name,
                             # porque en la base de datos están EN MAYÚSCULAS y así gritan. #}
                            {% for coordinator in category.coordinators %}
                                {{ csa.badge(coordinator.displayName|lower, 'sky', { sm: true, no_dot: true, class: 'csa-name' }) }}
                            {% else %}
                                <span class="vol-help">Sin coordinar</span>
                            {% endfor %}
                        </td>
                        <td class="csa-table__col-tight">{{ category.partners|length }}</td>
                        <td class="csa-table__col-tight">
                            {% if category.active %}
                                {{ csa.badge('Activa', 'green') }}
                            {% else %}
                                {{ csa.badge('Retirada', 'neutral') }}
                            {% endif %}
                        </td>
                        <td class="csa-table__actions">
                            <a href="{{ path('volunteering_category_show', { id: category.id }) }}" title="Ver" aria-label="Ver"><i class="fa fa-eye"></i></a>
                            <a href="{{ path('volunteering_category_edit', { id: category.id }) }}" title="Editar" aria-label="Editar"><i class="fa fa-pencil"></i></a>
                            {# Cambiar el estado a un clic: es la acción más
                             # frecuente sobre un catálogo y antes obligaba a
                             # entrar a editar y buscar una casilla. Nunca se
                             # borra: un área borrada se llevaría el histórico
                             # de tareas y las preferencias de quien lo marcó. #}
                            <form method="post" action="{{ path('volunteering_category_toggle', { id: category.id }) }}" style="display: inline;"
                                  onsubmit="return confirm('{{ category.active ? 'Se retira de las tareas nuevas y de la ficha de socixs. El histórico se conserva. ¿Seguimos?' : '¿Volver a ofrecer esta área?' }}');">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_category_toggle') }}">
                                <button type="submit" class="csa-table__iconbtn"
                                        title="{{ category.active ? 'Retirar' : 'Volver a ofrecer' }}"
                                        aria-label="{{ category.active ? 'Retirar' : 'Volver a ofrecer' }}">
                                    <i class="fa {{ category.active ? 'fa-archive' : 'fa-undo' }}"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6">No hay ninguna área que encaje con lo que buscas.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="csa-dt-bottom">{{ knp_pagination_render(pagination) }}</div>
</div>
{% endblock %}
