{# Listado de tareas de voluntariado. #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Voluntariado{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Voluntariado</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Socios', 'Voluntariado', 'Tareas que la asociación ofrece al voluntariado, y quién se apunta a ellas.') }}

    <div class="csa-row-between" style="margin-bottom: var(--csa-sp-4);">
        {# Crear áreas y nombrar coordinadoras es del rol global: quien coordina
         # un área no se nombra a sí misma en otra. #}
        {% if is_granted('ROLE_GESTION_VOLUNTARIADO_EDIT') %}
            {{ csa.btn('Tipos de trabajo', { variant: 'ghost', icon: 'fa-tags', href: path('volunteering_categories') }) }}
        {% else %}
            <div></div>
        {% endif %}
        {# Publicar sí puede quien coordina un área — de las suyas. Que la tarea
         # sea de un área que coordina se comprueba al guardarla, cuando ya se
         # sabe de qué área es. #}
        {{ csa.btn('Nueva tarea', { variant: 'primary', icon: 'fa-plus', href: path('volunteering_new') }) }}
    </div>

    {# Lo primero, lo que ya pasó y sigue sin cerrar: mientras no se cierra, no
     # computa horas a nadie, así que es trabajo hecho que no cuenta. #}
    {# Sólo llegan aquí las tareas que NADIE ha confirmado desde su panel. Lo
     # normal es que se cierren solas: quien fue lo dice y desaparecen de esta
     # lista. Lo que queda es lo que de verdad necesita a alguien detrás. #}
    {% if pending_closure is not empty %}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Pendientes de confirmar',
            subtitle: 'Ya pasaron y alguien no ha dicho todavía si fue.',
            icon: 'fa-exclamation-triangle',
            accent: 'ochre'
        } %}
        {% block body %}
        {% import '_macros/csa.html.twig' as csa %}
        {{ csa.callout('Se les pregunta en su panel; hasta que no respondan, esas horas no las tiene nadie. Si no contestan, ciérralas tú desde la tarea.', 'info') }}

        <div class="csa-table-wrap">
            <table class="csa-table">
                <thead>
                    <tr>
                        <th>Tarea</th>
                        <th class="csa-table__col-tight">Cuándo fue</th>
                        <th class="csa-table__col-tight">Apuntadxs</th>
                        <th class="csa-table__actions">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offer in pending_closure %}
                        <tr>
                            <td><a class="csa-table__primary" href="{{ path('volunteering_show', { id: offer.id }) }}">{{ offer.title }}</a></td>
                            <td class="csa-table__col-tight">{{ offer.startsAt|date('d/m/Y H:i') }}</td>
                            <td class="csa-table__col-tight">{{ offer.filledSlots }}</td>
                            <td class="csa-table__actions">
                                <a href="{{ path('volunteering_show', { id: offer.id }) }}" title="Cerrar" aria-label="Cerrar"><i class="fa fa-check-square-o"></i></a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endblock %}
        {% endembed %}
    {% endif %}

    {# Con título propio y en tarjeta: dos tablas seguidas sin encabezado —la de
     # pendientes de cerrar y ésta— se leen como una sola de veinte filas. #}
    {% embed '_components/csa_card.html.twig' with {
        title: 'Próximas',
        subtitle: 'Lo que está publicado para los días que vienen.',
        icon: 'fa-calendar'
    } %}
        {% block body %}
        {% import '_macros/csa.html.twig' as csa %}
    {% if upcoming is empty %}
        {{ csa.callout('No hay ninguna tarea publicada para los próximos días.', 'info') }}
    {% else %}
        <div class="csa-table-wrap">
            <table class="csa-table">
                <thead>
                    <tr>
                        <th>Tarea</th>
                        <th class="csa-table__col-tight">Cuándo</th>
                        <th class="csa-table__col-tight">Dónde</th>
                        <th class="csa-table__col-tight">Apuntadxs</th>
                        <th class="csa-table__col-tight">Aviso</th>
                        <th class="csa-table__actions">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offer in upcoming %}
                        <tr>
                            <td>
                                <a class="csa-table__primary" href="{{ path('volunteering_show', { id: offer.id }) }}">{{ offer.title }}</a>
                                {% for category in offer.categories %}
                                    {{ csa.badge(category.name, 'neutral') }}
                                {% endfor %}
                            </td>
                            <td class="csa-table__col-tight">{{ offer.startsAt|date('d/m/Y H:i') }}</td>
                            <td class="csa-table__col-tight">
                                {%- if offer.remote %}Desde casa
                                {%- elseif offer.node %}{{ offer.node }}
                                {%- elseif offer.place %}{{ offer.place }}
                                {%- else %}—{% endif -%}
                            </td>
                            <td class="csa-table__col-tight">
                                {# Sin tope, "4" a secas se lee como "hay 4
                                 # plazas". Con tope, el par x/y sí se entiende. #}
                                {% if offer.slots %}
                                    {{ offer.filledSlots }} / {{ offer.slots }}
                                {% else %}
                                    {{ offer.filledSlots }} <span class="vol-help">(sin tope)</span>
                                {% endif %}
                            </td>
                            <td class="csa-table__col-tight">
                                {% if offer.openToAnyone %}
                                    {{ csa.badge('Para cualquiera', 'green') }}
                                {% else %}
                                    {{ csa.badge('Dirigido', 'ochre') }}
                                {% endif %}
                            </td>
                            <td class="csa-table__actions">
                                <a href="{{ path('volunteering_show', { id: offer.id }) }}" title="Ver" aria-label="Ver"><i class="fa fa-eye"></i></a>
                                {% if is_granted('VOLUNTEER_OFFER_EDIT', offer) %}
                                    <a href="{{ path('volunteering_edit', { id: offer.id }) }}" title="Editar" aria-label="Editar"><i class="fa fa-pencil"></i></a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
        {% endblock %}
    {% endembed %}

    {# ============ LO QUE YA SE HA HECHO ============ #}
    {# La cara visible de que esto funciona. Sin nombres y sin ranking: lo que
     # mueve es ver que se hacen cosas, no quién las hace. Un listado de quién
     # más aporta convertiría la asociación en una competición y expulsaría a
     # quien no puede competir. #}
    {% if recently_done is not empty %}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Hecho últimamente',
            subtitle: 'Tareas de los últimos dos meses que se cubrieron.',
            icon: 'fa-check',
            accent: 'green'
        } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                <div class="csa-table-wrap">
                    <table class="csa-table">
                        <thead>
                            <tr>
                                <th>Tarea</th>
                                <th class="csa-table__col-tight">Cuándo</th>
                                <th class="csa-table__col-tight">Quiénes</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for offer in recently_done %}
                                <tr>
                                    <td><a class="csa-table__primary" href="{{ path('volunteering_show', { id: offer.id }) }}">{{ offer.title }}</a></td>
                                    <td class="csa-table__col-tight">{{ offer.startsAt|date('d/m/Y') }}</td>
                                    <td class="csa-table__col-tight">{{ offer.attendedCount }} persona{{ offer.attendedCount != 1 ? 's' : '' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
