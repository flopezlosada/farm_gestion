{# Alta y edición de un área, en pantalla propia. #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Voluntariado · {{ is_new ? 'Nueva área' : category.name }}{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('volunteering_index') }}">Voluntariado</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('volunteering_categories') }}">Áreas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ is_new ? 'Nueva' : category.name }}</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Voluntariado', is_new ? 'Nueva área' : 'Editar área') }}

    {% if not is_new and not category.active %}
        {{ csa.callout('Esta área está retirada: no se ofrece al crear tareas nuevas ni aparece en la ficha de lxs socixs. Las tareas históricas que la usaron siguen enteras.', 'info') }}
    {% endif %}

    {{ form_start(form, { attr: { class: 'csa-form-narrow' } }) }}

        {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Qué es' } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                <div class="csa-form-grid">
                    {{ csa.field(form.name, 'Nombre') }}
                    {{ csa.field(form.description, 'Qué entra aquí', {
                        full: true,
                        hint: 'se le enseña a cada socix junto a la casilla',
                        widget_class: 'csa-textarea'
                    }) }}
                    {# SIN LAS DOS CASILLAS que había aquí, y el motivo está en
                     # VolunteerCategoryType: retirar un área se hace a un clic desde
                     # el catálogo y desde su ficha, así que la casilla era un segundo
                     # camino más escondido y sin confirmación; y «es el montaje del
                     # reparto» es un booleano que sirve para señalar exactamente un
                     # área de la casa, así que permite marcar cero o dos y en los dos
                     # casos el panel del socix miente. #}
                </div>
            {% endblock %}
        {% endembed %}

        {% embed '_components/csa_form_section.html.twig' with {
            num: '2',
            title: 'Quién la coordina',
            subtitle: 'Marcar a alguien aquí le da acceso al voluntariado de esta área, y sólo de ésta: podrá publicar tareas, cerrarlas y pedir gente. No hace falta darle ningún permiso aparte.'
        } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                {# Aquí sale cualquier cuenta habilitada de la casa, así que son
                 # unas quince filas de pills: el buscador que inyecta
                 # csa-check-filter es lo que las hace navegables. #}
                <div class="csa-form-grid" data-csa-check-filter>
                    {{ csa.field(form.coordinators, 'Quién coordina esta área', {
                        full: true,
                        hint: 'al marcar a alguien le concedes el acceso'
                    }) }}
                </div>
            {% endblock %}
        {% endembed %}

        <div class="csa-row-between" style="margin-top: var(--csa-sp-6);">
            {{ csa.btn('Volver', {
                variant: 'ghost',
                href: is_new ? path('volunteering_categories') : path('volunteering_category_show', { id: category.id })
            }) }}
            <button type="submit" class="csa-btn csa-btn--primary">{{ is_new ? 'Crear' : 'Guardar cambios' }}</button>
        </div>

    {{ form_end(form) }}

    {# EL HISTÓRICO YA NO VIVE AQUÍ, está en la ficha del área. Un formulario es
     # para cambiar cosas; un registro de lo que pasó debajo del botón de guardar
     # no se lee y no se puede usar para nada. Y aquí sólo traía lo que le había
     # pasado al área EN SÍ —se creó, se renombró, cambió la coordinación—, que en
     # un área que nadie ha tocado son cero filas: el bloque se veía siempre
     # vacío. En la ficha va junto a las tareas y la gente que le dan sentido, y
     # con la actividad de dentro incluida. #}
{% endblock %}
