{# Alta y edición de un tipo de trabajo, en pantalla propia. #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import '_macros/volunteering.html.twig' as vol %}

{% block title %}Voluntariado · {{ is_new ? 'Nuevo tipo de trabajo' : category.name }}{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('volunteering_index') }}">Voluntariado</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('volunteering_categories') }}">Tipos de trabajo</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ is_new ? 'Nuevo' : category.name }}</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Voluntariado', is_new ? 'Nuevo tipo de trabajo' : 'Editar tipo de trabajo') }}

    {% if not is_new and not category.active %}
        {{ csa.callout('Este tipo está retirado: no se ofrece al crear tareas nuevas ni aparece en la ficha de lxs socixs. Las tareas históricas que lo usaron siguen enteras.', 'info') }}
    {% endif %}

    {{ form_start(form, { attr: { class: 'csa-form-narrow' } }) }}

        {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Qué es' } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                {% import '_macros/volunteering.html.twig' as vol %}
                <div class="csa-form-grid">
                    {{ csa.field(form.name, 'Nombre') }}
                    {{ csa.field(form.description, 'Qué entra aquí', {
                        full: true,
                        hint: 'se le enseña a cada socix junto a la casilla',
                        widget_class: 'csa-textarea'
                    }) }}
                    {{ vol.check(form.active, 'Se sigue ofreciendo', 'desmárcala para retirarlo sin perder el histórico') }}
                    {# Sólo el área de montar cestas. De aquí sale el "quién te prepara la
                     # cesta" del panel del socix; marcarla en dos áreas haría que la home
                     # señalara a gente que ese día está haciendo otra cosa. #}
                    {{ vol.check(form.deliveryPrep, 'Es el montaje del reparto', 'con ella, cada socix ve en su panel quién le prepara la cesta en su punto — y el aviso si no hay nadie') }}
                </div>
            {% endblock %}
        {% endembed %}

        {% embed '_components/csa_form_section.html.twig' with {
            num: '2',
            title: 'Quién lo coordina',
            subtitle: 'Marcar a alguien aquí le da acceso al voluntariado de esta área, y sólo de ésta: podrá publicar tareas, cerrarlas y pedir gente. No hace falta darle ningún permiso aparte.'
        } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                {# Aquí sale cualquier cuenta habilitada de la casa, así que son
                 # unas quince filas de pills: el buscador que inyecta
                 # csa-check-filter es lo que las hace navegables. #}
                <div class="csa-form-grid" data-csa-check-filter>
                    {{ csa.field(form.coordinators, 'Quién coordina esta área', {
                        full: true,
                        hint: 'al marcar a alguien le concedes el acceso'
                    }) }}
                </div>
            {% endblock %}
        {% endembed %}

        <div class="csa-row-between" style="margin-top: var(--csa-sp-6);">
            {{ csa.btn('Volver', { variant: 'ghost', href: path('volunteering_categories') }) }}
            <button type="submit" class="csa-btn csa-btn--primary">{{ is_new ? 'Crear' : 'Guardar cambios' }}</button>
        </div>

    {{ form_end(form) }}

    {# Sólo en edición: un objeto que no existe todavía no tiene historial, y un
     # bloque vacío en el alta sólo estorba. #}
    {% if not is_new %}
        <div class="csa-form-narrow" style="margin-top: var(--csa-sp-6);">
            {% embed '_components/csa_card.html.twig' with {
                title: 'Qué ha pasado con este tipo de trabajo',
                icon: 'fa-history'
            } %}
                {% block body %}
                    {% include '_components/volunteering_history.html.twig' with {
                        events: history,
                        actor_names: actor_names,
                        empty_text: 'Todavía no consta nada. Los cambios y los relevos de coordinación quedan registrados aquí.'
                    } only %}
                {% endblock %}
            {% endembed %}
        </div>
    {% endif %}
{% endblock %}
