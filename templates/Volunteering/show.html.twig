{# ============================================================
 # Una TAREA de voluntariado: qué es el trabajo, cómo se repite y qué turnos
 # tiene.
 #
 # LO QUE MANDA ES EL TRABAJO PENDIENTE. De una tarea continua no interesan sus
 # doscientos turnos: interesan los que hay que cerrar —que si se acumulan dejan
 # a la gente sin sus horas— y el siguiente. De ahí el orden de la pantalla:
 # primero lo que hay que hacer, después la definición, y al final el calendario.
 #
 # Lo que se hace CON GENTE —quién viene, pasar lista, imputar, pedir— no está
 # aquí sino en la ficha de cada turno: es trabajo de un día concreto, y en una
 # tarea que se hace todos los días no cabría en una sola pantalla.
 # ============================================================ #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import '_macros/volunteering.html.twig' as vol %}

{% block title %}Voluntariado · {{ offer.title }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('volunteering_index') }}">Voluntariado</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('volunteering_tasks') }}">Tareas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ offer.title }}</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/partner_card_styles.html.twig' %}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
    {% set can_edit = is_granted('VOLUNTEER_OFFER_EDIT', offer) %}
    {% set next = offer.getNextShift(now) %}

    {% set status_chip = {
        'draft':     { label: 'Borrador',  cls: 'warn'   },
        'published': { label: 'Publicada', cls: 'activo' },
        'paused':    { label: 'En pausa',  cls: 'warn'   },
        'cancelled': { label: 'Anulada',   cls: 'baja'   }
    } %}
    {% set sc = status_chip[offer.status]|default({ label: offer.status, cls: 'mute' }) %}

    {% set avatar_palette = ['sage', 'ochre', 'terra', 'ink'] %}
    {% set avatar_tone = offer.isCancelled() ? 'muted' : avatar_palette[(offer.id|default(0)) % 4] %}

    <div class="prt">

        {# ============ HERO ============ #}
        <header class="prt-hero">
            <span class="prt-avatar prt-avatar--{{ avatar_tone }}" aria-hidden="true"><i class="fa fa-hand-paper-o"></i></span>

            <div>
                <h1 class="prt-hero__title">{{ offer.title }}</h1>
                <div class="prt-hero__meta">
                    <span class="prt-chip prt-chip--{{ sc.cls }}"><span class="dot"></span>{{ sc.label }}</span>

                    {# Cada cuánto se hace es LA propiedad de una tarea, ahora que no
                     # lleva fecha: sin esto, "el reparto" y "una plantación" se ven
                     # igual. #}
                    <span class="prt-chip prt-chip--mute"><i class="fa fa-repeat"></i> {{ vol.repeat(offer) }}</span>

                    {% for category in offer.categories %}
                        <span class="prt-chip prt-chip--mute">{{ category.name }}</span>
                    {% endfor %}

                    {% if offer.featured %}
                        <span class="prt-chip prt-chip--info">Destacada en el panel</span>
                    {% endif %}

                    {% if not offer.openToAnyone %}
                        <span class="prt-chip prt-chip--warn">Sólo a quien lo tenga marcado</span>
                    {% endif %}
                </div>
            </div>

            <div class="prt-hero__actions">
                {% if can_edit %}
                    {{ csa.btn('Editar', { variant: 'secondary', href: path('volunteering_edit', { id: offer.id }), icon: 'fa-pencil' }) }}
                {% endif %}
                {# Prefiltrado a esta tarea: la serie entera, sin el ruido del resto. #}
                {{ csa.btn('Calendario', { variant: 'ghost', href: path('volunteering_calendar', { tarea: offer.id }), icon: 'fa-calendar' }) }}
                {{ csa.btn('Volver', { variant: 'ghost', href: path('volunteering_tasks') }) }}
            </div>
        </header>

        {# ============ QUÉ TOCA HACER ============
         # Cuatro situaciones, y en cada una el botón que la resuelve. El orden no
         # es cosmético: los turnos sin cerrar ganan a todo lo demás porque
         # mientras no se cierran, la gente que fue no tiene sus horas. #}
        {% if to_close|length %}
            <div class="vol-phase vol-phase--info">
                <span class="vol-phase__icon"><i class="fa fa-hourglass-half"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">
                        Hay {{ to_close|length }} turno{{ to_close|length == 1 ? '' : 's' }} sin cerrar
                    </p>
                    <p class="vol-phase__note">
                        Mientras no se cierran, las horas de quien fue no se le computan a nadie.
                        Se cierran uno a uno, desde su ficha.
                    </p>
                </div>
                <div class="vol-phase__actions">
                    {{ csa.btn('Ver cuáles', { variant: 'secondary', href: path('volunteering_shifts', { id: offer.id, ver: 'pending' }), icon: 'fa-check-square-o' }) }}
                </div>
            </div>
        {% elseif offer.isDraft() %}
            <div class="vol-phase vol-phase--quiet">
                <span class="vol-phase__icon"><i class="fa fa-pencil"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">Todavía es un borrador</p>
                    <p class="vol-phase__note">
                        No la ve nadie fuera de gestión y no se está pidiendo gente para ningún turno.
                        {% if offer.shifts|length %}
                            Repasa los {{ offer.shifts|length }} turnos de abajo —anula los que caigan en festivo— y publícala.
                        {% else %}
                            No tiene ningún turno todavía: revisa cada cuánto se repite.
                        {% endif %}
                    </p>
                </div>
                {% if can_edit %}
                    <div class="vol-phase__actions">
                        <form method="post" action="{{ path('volunteering_status', { id: offer.id }) }}"
                              onsubmit="return confirm('Al publicarla, sus turnos empiezan a pedir gente y el sistema avisará a quien tenga marcadas sus áreas. ¿Publicar?');">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_status') }}">
                            <input type="hidden" name="estado" value="published">
                            <button type="submit" class="csa-btn csa-btn--primary csa-btn--sm">
                                <i class="fa fa-bullhorn"></i><span>Publicarla</span>
                            </button>
                        </form>
                    </div>
                {% endif %}
            </div>
        {% elseif offer.isPaused() %}
            <div class="vol-phase vol-phase--quiet">
                <span class="vol-phase__icon"><i class="fa fa-pause"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">Está parada</p>
                    <p class="vol-phase__note">
                        Sus turnos siguen en el calendario pero no piden gente. Lo que ya se hizo se
                        conserva, con sus horas.
                    </p>
                </div>
                {% if can_edit %}
                    <div class="vol-phase__actions">
                        <form method="post" action="{{ path('volunteering_status', { id: offer.id }) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_status') }}">
                            <input type="hidden" name="estado" value="published">
                            <button type="submit" class="csa-btn csa-btn--primary csa-btn--sm">
                                <i class="fa fa-play"></i><span>Reanudarla</span>
                            </button>
                        </form>
                    </div>
                {% endif %}
            </div>
        {% elseif offer.isCancelled() %}
            <div class="vol-phase vol-phase--quiet">
                <span class="vol-phase__icon"><i class="fa fa-ban"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">Tarea anulada</p>
                    <p class="vol-phase__note">Se conserva con su historia. A quien estuviera apuntadx ya se le avisó.</p>
                </div>
            </div>
        {% elseif next %}
            <div class="vol-phase vol-phase--ok">
                <span class="vol-phase__icon"><i class="fa fa-calendar-check-o"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">Al día</p>
                    <p class="vol-phase__note">
                        El próximo turno es el {{ vol.shift_when(next) }}.
                        {% if next.slots %}
                            {% if next.remainingSlots > 0 %}
                                Le falta{{ next.remainingSlots == 1 ? '' : 'n' }} {{ next.remainingSlots }} {{ next.remainingSlots == 1 ? 'persona' : 'personas' }}.
                            {% else %}
                                Tiene las plazas cubiertas.
                            {% endif %}
                        {% endif %}
                    </p>
                </div>
                <div class="vol-phase__actions">
                    {{ csa.btn('Ver el turno', { variant: 'secondary', href: path('volunteering_shift', { id: next.id }), icon: 'fa-arrow-right' }) }}
                </div>
            </div>
        {% else %}
            <div class="vol-phase vol-phase--warn">
                <span class="vol-phase__icon"><i class="fa fa-calendar-times-o"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">No queda ningún turno por venir</p>
                    <p class="vol-phase__note">
                        {% if offer.isRepeating() %}
                            La serie llega hasta donde llegaba; abre más turnos abajo, o amplía la fecha
                            final editando la tarea.
                        {% else %}
                            Es una tarea de una sola vez y ya pasó. Si vuelve a hacer falta, añade un turno.
                        {% endif %}
                    </p>
                </div>
            </div>
        {% endif %}

        {# ============ LA DEFINICIÓN ============ #}
        <div class="vol-split">
            <section class="prt-card">
                {% if offer.description %}
                    <div class="prt-card__head"><h2 class="prt-card__title"><span class="accent"></span>Qué hay que hacer</h2></div>
                {% endif %}
                <div class="prt-card__body">
                    {% if offer.description %}
                        {{ offer.description|nl2br }}
                    {% else %}
                        <p class="vol-empty">Esta tarea no dice en qué consiste. Sin eso, quien no ha venido nunca no sabe si puede con ella.</p>
                    {% endif %}

                    {% if offer.place and offer.place.directions %}
                        <p class="vol-help"><i class="fa fa-map-signs"></i> {{ offer.place.directions }}</p>
                    {% endif %}

                    {% if offer.coordinator %}
                        <div class="vol-owner">
                            <span class="vol-owner__avatar" aria-hidden="true">
                                {{ (offer.coordinator.name|first ~ offer.coordinator.surname|first)|upper }}
                            </span>
                            <div class="vol-owner__who">
                                <span class="vol-owner__role">Quien coordina la tarea</span>
                                <span class="vol-owner__name">{{ offer.coordinator.name }} {{ offer.coordinator.surname }}</span>
                                <span class="vol-owner__hours">Apunta sus horas de coordinación desde su panel</span>
                            </div>
                            <div class="vol-owner__contact">
                                {% if offer.coordinator.celular %}
                                    <a class="vol-actions__btn" href="tel:{{ offer.coordinator.celular|replace({' ': ''}) }}"
                                       title="Llamar a {{ offer.coordinator.name }}"><i class="fa fa-phone"></i></a>
                                {% endif %}
                                {% if offer.coordinator.email %}
                                    <a class="vol-actions__btn" href="mailto:{{ offer.coordinator.email }}"
                                       title="Escribir a {{ offer.coordinator.name }}"><i class="fa fa-envelope-o"></i></a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </section>

            <aside class="vol-facts">
                <div class="vol-fact">
                    <i class="fa fa-map-marker" aria-hidden="true"></i>
                    <div>
                        {% if offer.remote %}
                            <span class="vol-fact__value">Desde casa</span>
                            <span class="vol-fact__sub">No hace falta ir a ningún sitio</span>
                        {% elseif offer.node %}
                            <span class="vol-fact__value">{{ offer.node }}</span>
                            {% if offer.placeNote %}<span class="vol-fact__sub">{{ offer.placeNote }}</span>{% endif %}
                        {% elseif offer.place %}
                            <span class="vol-fact__value">{{ offer.place.name }}</span>
                            {% if offer.placeNote %}<span class="vol-fact__sub">{{ offer.placeNote }}</span>{% endif %}
                        {% elseif offer.placeNote %}
                            <span class="vol-fact__value">{{ offer.placeNote }}</span>
                        {% else %}
                            <span class="vol-fact__value vol-fact__value--muted">Sin indicar dónde</span>
                        {% endif %}
                    </div>
                </div>

                <div class="vol-fact">
                    <i class="fa fa-users" aria-hidden="true"></i>
                    <div>
                        {% if offer.slots %}
                            <span class="vol-fact__sub">Hacen falta por turno</span>
                            <span class="vol-fact__value">{{ offer.slots }} {{ offer.slots == 1 ? 'persona' : 'personas' }}</span>
                        {% else %}
                            <span class="vol-fact__value">Sin tope</span>
                            <span class="vol-fact__sub">Cuanta más gente venga, mejor</span>
                        {% endif %}
                    </div>
                </div>

                <div class="vol-fact">
                    <i class="fa fa-clock-o" aria-hidden="true"></i>
                    <div>
                        {% if offer.creditedMinutes %}
                            <span class="vol-fact__sub">Computa por persona y turno</span>
                            <span class="vol-fact__value">{{ csa.qty(offer.creditedMinutes / 60) }} h</span>
                        {% else %}
                            <span class="vol-fact__value vol-fact__value--muted">No computa horas</span>
                        {% endif %}
                        {% if offer.getCreditedMinutesTotal() %}
                            <span class="vol-fact__sub">{{ csa.qty(offer.getCreditedMinutesTotal() / 60) }} h imputadas en total</span>
                        {% endif %}
                    </div>
                </div>
            </aside>
        </div>

        {# ============ LOS TURNOS QUE VIENEN ============
         # Sólo lo que viene, y sólo el siguiente puñado. Lo que ya pasó —cerrado o
         # sin cerrar— no se mezcla aquí: es histórico y tiene su lista completa,
         # con sus vistas. Así la ficha no cambia de tamaño con la edad de la
         # tarea. #}
        <section class="prt-card" style="margin-top: var(--csa-sp-6);">
            <div class="prt-card__head">
                <h2 class="prt-card__title"><span class="accent"></span>Próximos turnos</h2>
                <div style="display: flex; gap: 8px; align-items: center;">
                    {{ csa.btn('Todos los turnos', { variant: 'ghost', icon: 'fa-history', href: path('volunteering_shifts', { id: offer.id, ver: 'all' }), size: 'sm' }) }}
                    {% if can_edit %}
                        {{ csa.btn('Añadir un turno', { variant: 'ghost', icon: 'fa-plus', href: path('volunteering_shift_new', { id: offer.id }), size: 'sm' }) }}
                        {% if offer.isRepeating() %}
                            <form method="post" action="{{ path('volunteering_open_shifts', { id: offer.id }) }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_open_shifts') }}">
                                <button type="submit" class="csa-btn csa-btn--ghost csa-btn--sm">
                                    <i class="fa fa-calendar-plus-o"></i><span>Abrir más turnos</span>
                                </button>
                            </form>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
            <div class="prt-card__body">
                {% if upcoming|length %}
                    <div class="csa-table-wrap">
                        <table class="csa-table">
                            <thead>
                                <tr>
                                    <th>Cuándo</th>
                                    <th class="csa-table__col-tight">Apuntadxs</th>
                                    <th class="csa-table__col-tight">Estado</th>
                                    <th class="csa-table__actions">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for shift in upcoming %}
                                    <tr>
                                        <td>
                                            <a class="csa-table__primary" href="{{ path('volunteering_shift', { id: shift.id }) }}">{{ vol.shift_when(shift) }}</a>
                                            {% if shift.manual %}{{ csa.badge('a mano', 'neutral') }}{% endif %}
                                        </td>
                                        <td class="csa-table__col-tight">{{ vol.shift_slots(shift) }}</td>
                                        <td class="csa-table__col-tight">{{ vol.shift_status(shift) }}</td>
                                        <td class="csa-table__actions">
                                            <a href="{{ path('volunteering_shift', { id: shift.id }) }}" title="Ver"><i class="fa fa-eye"></i></a>
                                            {% if can_edit %}
                                                <a href="{{ path('volunteering_shift_edit', { id: shift.id }) }}" title="Mover"><i class="fa fa-pencil"></i></a>
                                                <form method="post" action="{{ path('volunteering_shift_cancel', { id: shift.id }) }}" style="display: inline;"
                                                      onsubmit="return confirm('¿Anular el turno del {{ shift.startsAt|date('d/m/Y H:i') }}? Se avisa a quien estuviera apuntadx.');">
                                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_shift_cancel') }}">
                                                    <button type="submit" class="csa-table__action--danger"
                                                            style="background: none; border: none; cursor: pointer; padding: 0;"
                                                            title="Anular este turno"><i class="fa fa-ban"></i></button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <p class="vol-help--muted">
                        {% if upcoming_total > upcoming|length %}
                            Son los {{ upcoming|length }} siguientes de {{ upcoming_total }} por venir.
                            <a href="{{ path('volunteering_shifts', { id: offer.id, ver: 'upcoming' }) }}">Ver todos</a>.
                        {% endif %}
                        {% if offer.isRepeating() %}
                            Los turnos se abren por tramos, hasta {{ horizon_days }} días vista, y el
                            planificador va abriendo el resto. Así una tarea diaria no nace con
                            setecientas filas de golpe.
                        {% endif %}
                    </p>
                {% else %}
                    <p class="vol-empty">
                        No hay turnos por venir.
                        {% if can_edit %}Añade uno a mano, o revisa cada cuánto se repite la tarea.{% endif %}
                    </p>
                {% endif %}
            </div>
        </section>

        {# ============ PESTAÑAS ============ #}
        <div data-csa-tabs style="margin-top: var(--csa-sp-6);">
            <ul class="csa-tabs" role="tablist">
                <li class="csa-tabs__item active">
                    <a class="csa-tabs__link" href="#avisos" role="tab" aria-selected="true">
                        Avisos{% if calls|length %}<span class="csa-tabs__count">{{ calls|length }}</span>{% endif %}
                    </a>
                </li>
                <li class="csa-tabs__item">
                    <a class="csa-tabs__link" href="#historial" role="tab" aria-selected="false">
                        Historial{% if history|length %}<span class="csa-tabs__count">{{ history|length }}</span>{% endif %}
                    </a>
                </li>
                {% if can_edit and not offer.isCancelled() %}
                    <li class="csa-tabs__item">
                        <a class="csa-tabs__link" href="#estado" role="tab" aria-selected="false">Parar o anular</a>
                    </li>
                {% endif %}
            </ul>

            {# ---------- AVISOS ----------
             # Los de TODOS sus turnos, del más reciente atrás. De una tarea continua
             # interesa el rastro completo —a quién se le ha pedido y cuándo—, no sólo
             # lo del turno que se esté mirando. #}
            <section class="csa-tabpanel is-active" id="avisos" role="tabpanel">
                <div class="prt-card">
                    <div class="prt-card__body">
                        {% if calls|length %}
                            <div class="csa-table-wrap">
                                <table class="csa-table">
                                    <thead>
                                        <tr>
                                            <th>Turno</th>
                                            <th class="csa-table__col-tight">A quién</th>
                                            <th class="csa-table__col-tight">Personas</th>
                                            <th class="csa-table__col-tight">Cuándo se mandó</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for call in calls %}
                                            <tr>
                                                <td>
                                                    {% if call.shift %}
                                                        <a href="{{ path('volunteering_shift', { id: call.shift.id }) }}">{{ vol.shift_when(call.shift) }}</a>
                                                    {% else %}
                                                        —
                                                    {% endif %}
                                                </td>
                                                <td class="csa-table__col-tight">
                                                    {{- {
                                                        'matching': 'a quien lo tiene marcado',
                                                        'unspecified': 'a quien no dijo nada',
                                                        'everyone': 'a toda la asociación'
                                                    }[call.scope]|default(call.scope) -}}
                                                </td>
                                                <td class="csa-table__col-tight">{{ call.recipients }}</td>
                                                <td class="csa-table__col-tight">
                                                    {{ call.sentAt|date('d/m/Y H:i') }}
                                                    {% if call.manual %}{{ csa.badge('a mano', 'neutral') }}{% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <p class="vol-empty">No se ha mandado ningún aviso por esta tarea todavía.</p>
                        {% endif %}

                        <p class="vol-help--muted">
                            Los avisos se piden por TURNO, desde la ficha de cada uno: pedir gente para el
                            sábado no gasta el aviso del domingo.
                        </p>
                    </div>
                </div>
            </section>

            {# ---------- HISTORIAL ---------- #}
            <section class="csa-tabpanel" id="historial" role="tabpanel">
                <div class="prt-card">
                    <div class="prt-card__body">
                        {% include '_components/volunteering_history.html.twig' with {
                            events: history,
                            actor_names: actor_names,
                            empty_text: 'Todavía no consta nada. Los cambios, las inscripciones y los avisos quedan registrados aquí.'
                        } only %}
                    </div>
                </div>
            </section>

            {# ---------- PARAR O ANULAR ----------
             # En una pestaña y al final: son las dos acciones que no se pueden dar
             # por error, y ninguna se usa a diario. #}
            {% if can_edit and not offer.isCancelled() %}
                <section class="csa-tabpanel" id="estado" role="tabpanel">
                    <div class="prt-card">
                        <div class="prt-card__body">
                            {% if not offer.isPaused() %}
                                <p class="vol-help">
                                    <strong>Parar</strong> es para el trabajo continuo que se interrumpe una
                                    temporada: el invernadero en invierno, el perro cuando su familia está fuera.
                                    Los turnos siguen en el calendario pero dejan de pedir gente, y se reanuda
                                    con un botón.
                                </p>
                                <form method="post" action="{{ path('volunteering_status', { id: offer.id }) }}"
                                      onsubmit="return confirm('¿Parar esta tarea? Se avisa a quien tenga turnos apuntados por venir.');">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_status') }}">
                                    <input type="hidden" name="estado" value="paused">
                                    <button type="submit" class="csa-btn csa-btn--secondary csa-btn--sm">
                                        <i class="fa fa-pause"></i><span>Parar la tarea</span>
                                    </button>
                                </form>

                                <hr class="vol-sep">
                            {% endif %}

                            <p class="vol-help">
                                <strong>Anular</strong> es para el trabajo que ya no se va a hacer más. Se
                                conserva con toda su historia y sus horas, pero no vuelve a pedir gente ni
                                a abrir turnos.
                            </p>
                            <form method="post" action="{{ path('volunteering_status', { id: offer.id }) }}"
                                  onsubmit="return confirm('¿Anular esta tarea? Se avisa a quien estuviera apuntadx a sus turnos por venir. Se conserva la historia.');">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_status') }}">
                                <input type="hidden" name="estado" value="cancelled">
                                <button type="submit" class="csa-btn csa-btn--danger-soft csa-btn--sm">
                                    <i class="fa fa-ban"></i><span>Anular la tarea</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </section>
            {% endif %}
        </div>
    </div>
{% endblock %}
