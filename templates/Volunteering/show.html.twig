{# ============================================================
 # Una tarea de voluntariado.
 #
 # Mismo lenguaje visual que la ficha de socix (reusa partner_card_styles: hero
 # + avatar + chips + tarjetas + mini-stats), porque es el mismo gesto: abrir la
 # ficha de algo y ver de un vistazo qué es y en qué estado está.
 #
 # Lo que SIEMPRE se mira —qué es, cuándo, dónde, cuánta gente hay— va arriba y
 # sin abrir nada. Lo que se consulta a ratos —el listado nominal, los avisos, el
 # rastro— vive en pestañas. Antes eran seis tarjetas apiladas: para saber si
 # alguien se había apuntado había que bajar por encima de dos formularios.
 # ============================================================ #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Voluntariado · {{ offer.title }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('volunteering_index') }}">Voluntariado</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ offer.title }}</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/partner_card_styles.html.twig' %}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
    {% set can_edit = is_granted('VOLUNTEER_OFFER_EDIT', offer) %}
    {% set is_past = offer.startsAt < date() %}
    {% set signup_count = offer.signups|filter(s => not s.cancelled)|length %}

    {# ============ LA FASE MANDA ============
     # Una tarea pide tres trabajos distintos según el momento: antes se
     # persiguen plazas, el día se pasa lista, después se imputan horas. La
     # ficha los trataba igual —el formulario de cerrar colgaba bajo la tabla
     # estuviera la tarea a cuatro días o cerrada hace un mes— y quien la abría
     # tenía que deducir por su cuenta qué le tocaba hacer.
     #
     # La fase la deriva la entidad (VolunteerOffer::getPhase). Aquí sólo se
     # traduce a cómo se ve, en UN mapa: repartir `phase == '...'` por toda la
     # plantilla haría que añadir una fase obligara a buscarlos todos. #}
    {% set phase_chip = {
        'draft':     { label: 'Borrador',   cls: 'warn'   },
        'cancelled': { label: 'Anulada',    cls: 'baja'   },
        'open':      { label: 'Publicada',  cls: 'activo' },
        'today':     { label: 'Es hoy',     cls: 'warn'   },
        'to_close':  { label: 'Por cerrar', cls: 'info'   },
        'closed':    { label: 'Cerrada',    cls: 'mute'   }
    } %}
    {% set sc = phase_chip[phase]|default({ label: offer.status, cls: 'mute' }) %}

    {% set pending = offer.pendingConfirmationCount %}
    {% set credited_total = offer.creditedMinutesTotal %}
    {% set is_closing = phase in ['today', 'to_close', 'closed'] %}

    {% set avatar_palette = ['sage', 'ochre', 'terra', 'ink'] %}
    {% set avatar_tone = offer.status == 'cancelled' ? 'muted' : avatar_palette[(offer.id|default(0)) % 4] %}

    <div class="prt">

        {# ============ HERO ============ #}
        <header class="prt-hero">
            <span class="prt-avatar prt-avatar--{{ avatar_tone }}" aria-hidden="true"><i class="fa fa-hand-paper-o"></i></span>

            <div>
                <h1 class="prt-hero__title">{{ offer.title }}</h1>
                <div class="prt-hero__meta">
                    <span class="prt-chip prt-chip--{{ sc.cls }}"><span class="dot"></span>{{ sc.label }}</span>

                    {% for category in offer.categories %}
                        <span class="prt-chip prt-chip--mute">{{ category.name }}</span>
                    {% endfor %}

                    {# Quién puede recibir el aviso es una propiedad de la tarea que
                     # cambia a quién llega, no un detalle: se ve sin abrir nada. #}
                    {% if not offer.openToAnyone %}
                        <span class="prt-chip prt-chip--warn">Sólo a quien lo tenga marcado</span>
                    {% endif %}

                    {# Quien monta la tarea, arriba: es a quien hay que llamar si algo
                     # pasa, y saberlo sin abrir pestañas es la mitad de coordinar. #}
                    {% if offer.coordinator %}
                        <span class="prt-chip prt-chip--mute">
                            <i class="fa fa-star-o"></i>
                            La coordina {{ offer.coordinator.name }} {{ offer.coordinator.surname }}
                        </span>
                    {% endif %}
                </div>
            </div>

            <div class="prt-hero__actions">
                {% if can_edit %}
                    {{ csa.btn('Editar', { variant: 'secondary', href: path('volunteering_edit', { id: offer.id }), icon: 'fa-pencil' }) }}
                    {% if offer.startsAt %}
                        <button type="button" class="csa-btn csa-btn--ghost" onclick="document.getElementById('volunteering-repeat-dialog').showModal()">
                            <i class="fa fa-repeat"></i><span>Repetir</span>
                        </button>
                    {% endif %}
                {% endif %}
                {{ csa.btn('Volver', { variant: 'ghost', href: path('volunteering_index') }) }}
            </div>
        </header>

        {# ============ QUÉ TOCA HACER ============
         # La franja que antes eran tres callouts sueltos —y sólo para tareas
         # pasadas—. Ahora cubre las seis fases y siempre dice lo mismo: qué
         # trabajo hay pendiente AHORA con esta tarea, y con qué botón se hace.
         #
         # Va antes que los datos de la tarea a propósito. Cuándo y dónde es algo
         # que ya se sabe cuando abres una tarea tuya; lo que no se sabe es si
         # queda algo por hacer con ella. #}
        {% set marked = signup_count - pending %}

        {# Días NATURALES, no segundos partidos por 86400: con la resta cruda,
         # una tarea que empieza dentro de media hora sale a "1 día" porque el
         # redondeo hacia arriba no distingue horas de días. Comparando las dos
         # fechas a medianoche, hoy es 0 y mañana es 1, que es como lo cuenta
         # cualquiera. #}
        {% set days_left = offer.startsAt
            ? ((offer.startsAt|date('Y-m-d')|date('U') - 'now'|date('Y-m-d')|date('U')) / 86400)|round
            : null %}

        {% if phase == 'draft' %}
            <div class="vol-phase vol-phase--quiet">
                <span class="vol-phase__icon"><i class="fa fa-pencil"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">Todavía es un borrador</p>
                    <p class="vol-phase__note">No la ve nadie fuera de gestión y no se está pidiendo gente. Publícala cuando esté lista.</p>
                </div>
                {% if can_edit %}
                    <div class="vol-phase__actions">
                        {{ csa.btn('Publicarla', { variant: 'primary', href: path('volunteering_edit', { id: offer.id }), icon: 'fa-bullhorn' }) }}
                    </div>
                {% endif %}
            </div>

        {% elseif phase == 'cancelled' %}
            <div class="vol-phase vol-phase--quiet">
                <span class="vol-phase__icon"><i class="fa fa-ban"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">Tarea anulada</p>
                    <p class="vol-phase__note">
                        Se conserva para poder consultarla.
                        {% if signup_count %}A quien se había apuntado ya se le avisó.{% endif %}
                    </p>
                </div>
            </div>

        {% elseif phase == 'open' %}
            {% set full = offer.slots and offer.remainingSlots == 0 %}
            <div class="vol-phase vol-phase--{{ full ? 'ok' : 'warn' }}">
                <span class="vol-phase__icon"><i class="fa fa-{{ full ? 'check' : 'exclamation-triangle' }}"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">
                        {%- if full %}Las plazas están cubiertas
                        {%- elseif offer.slots %}Falta{{ offer.remainingSlots == 1 ? '' : 'n' }} {{ offer.remainingSlots }} {{ offer.remainingSlots == 1 ? 'persona' : 'personas' }} por cubrir
                        {%- else %}Sigue abierta a quien quiera venir{% endif -%}
                    </p>
                    <p class="vol-phase__note">
                        {%- if days_left is not null and days_left <= 0 %}Es hoy mismo.
                        {%- elseif days_left is not null %}Queda{{ days_left == 1 ? '' : 'n' }} {{ days_left }} día{{ days_left == 1 ? '' : 's' }}.
                        {%- endif %}
                        {% if full %}Nada que hacer hasta el día de la tarea.
                        {% elseif suggested|length %}Abajo, en «A quién pedírselo», tienes a quién llamar.
                        {% else %}Cuando se acerque la fecha, el sistema pide gente solo.{% endif %}
                    </p>
                </div>
                {% if not full and can_edit and not everyone_sent %}
                    <div class="vol-phase__actions">
                        {{ csa.btn('Ver los avisos', { variant: 'secondary', href: '#avisos', icon: 'fa-send-o' }) }}
                    </div>
                {% endif %}
            </div>

        {% elseif phase == 'today' %}
            <div class="vol-phase vol-phase--today">
                <span class="vol-phase__icon"><i class="fa fa-check-square-o"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">Toca pasar lista</p>
                    <p class="vol-phase__note">
                        Marca quién ha venido de verdad. Se puede hacer desde el móvil, en el sitio.
                        {% if pending %}Quien lo confirme desde su panel se marca solo.{% endif %}
                    </p>
                </div>
                <div class="vol-phase__figure">
                    <span class="vol-phase__figure-value">{{ marked }}</span>
                    <span class="vol-phase__figure-label">de {{ signup_count }} {{ signup_count == 1 ? 'marcada' : 'marcadas' }}</span>
                </div>
            </div>

        {% elseif phase == 'to_close' %}
            <div class="vol-phase vol-phase--info">
                <span class="vol-phase__icon"><i class="fa fa-hourglass-half"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">
                        Falta{{ pending == 1 ? '' : 'n' }} {{ pending }} {{ pending == 1 ? 'persona' : 'personas' }} por decir si {{ pending == 1 ? 'fue' : 'fueron' }}
                    </p>
                    <p class="vol-phase__note">
                        Se les pregunta en su panel. Si no contestan, ciérrala tú abajo: al hacerlo, estas
                        horas se suman a la aportación de cada socix.
                    </p>
                </div>
                {% if credited_total %}
                    <div class="vol-phase__figure">
                        <span class="vol-phase__figure-value">{{ csa.qty(credited_total / 60) }} h</span>
                        <span class="vol-phase__figure-label">ya imputadas</span>
                    </div>
                {% endif %}
            </div>

        {% elseif offer.wasMissed %}
            <div class="vol-phase vol-phase--warn">
                <span class="vol-phase__icon"><i class="fa fa-exclamation-triangle"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">Pasó y no fue nadie</p>
                    <p class="vol-phase__note">
                        {% if signup_count %}Se apuntó gente pero nadie confirmó haber ido.
                        {% else %}No llegó a apuntarse nadie.{% endif %}
                    </p>
                </div>
            </div>

        {% else %}
            <div class="vol-phase vol-phase--ok">
                <span class="vol-phase__icon"><i class="fa fa-check"></i></span>
                <div class="vol-phase__body">
                    <p class="vol-phase__title">
                        Tarea hecha · {{ offer.attendedCount }} {{ offer.attendedCount == 1 ? 'persona confirmó' : 'personas confirmaron' }} que {{ offer.attendedCount == 1 ? 'fue' : 'fueron' }}
                    </p>
                    <p class="vol-phase__note">
                        Las horas ya están imputadas. Corregirlas es cambiar la aportación de alguien, así
                        que se hace abajo y con cuidado.
                    </p>
                </div>
                {% if credited_total %}
                    <div class="vol-phase__figure">
                        <span class="vol-phase__figure-value">{{ csa.qty(credited_total / 60) }} h</span>
                        <span class="vol-phase__figure-label">imputadas</span>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# ============ LOS CUATRO DATOS ============
         # Cuándo, dónde, cuánta gente y cuánto computa. Es lo que se viene a
         # mirar; antes estaban repartidos entre tres KPIs y una lista de
         # definiciones que además repetía el estado y el tipo de trabajo (que
         # ahora son chips del hero). #}
        <div class="prt-mini">
            <div class="prt-mini__cell">
                <div class="prt-mini__label">Cuándo</div>
                <div class="prt-mini__value">
                    {{ offer.startsAt|date('d/m/Y') }}
                    <small>{{ offer.startsAt|date('H:i') }}{% if offer.endsAt %} — {{ offer.endsAt|date('H:i') }}{% endif %}</small>
                </div>
            </div>

            <div class="prt-mini__cell">
                <div class="prt-mini__label">Dónde</div>
                {# Texto, no cifra: en Inter. Ver .prt-mini__value--text. #}
                {% if offer.remote or offer.node or offer.place %}
                    <div class="prt-mini__value prt-mini__value--text">
                        {%- if offer.remote %}Desde casa
                        {%- elseif offer.node %}{{ offer.node }}
                        {%- else %}{{ offer.place }}{% endif -%}
                    </div>
                {% else %}
                    <div class="prt-mini__value prt-mini__value--muted">Sin indicar</div>
                {% endif %}
            </div>

            <div class="prt-mini__cell">
                <div class="prt-mini__label">Quién viene</div>
                <div class="prt-mini__value">
                    {{ offer.filledSlots }}{% if offer.slots %} de {{ offer.slots }}{% endif %}
                    {% if offer.slots and offer.remainingSlots > 0 %}
                        <small>faltan {{ offer.remainingSlots }}</small>
                    {% elseif offer.slots %}
                        <small>completa</small>
                    {% endif %}
                </div>

                {# Las plazas, una a una. Una cifra ("4 de 6") hay que leerla y
                 # restar; seis casillas de las que dos están vacías se ven sin
                 # leer, que es lo que hace falta cuando lo que se pregunta es
                 # "¿me falta gente?".
                 #
                 # Sólo con tope: una tarea sin número de plazas no tiene
                 # casillas que pintar, y llenarlas de huecos infinitos diría que
                 # falta gente cuando lo que pasa es que cabe la que venga. #}
                {% if offer.slots and offer.slots <= 12 %}
                    <div class="vol-slots" aria-hidden="true">
                        {% for i in 1..offer.slots %}
                            <span class="vol-slots__pip {{ i <= offer.filledSlots ? 'is-filled' : '' }}"></span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {# Cuánto vale el trabajo es CONFIGURACIÓN de la tarea, y hasta que
             # se cierra es lo único que hay sobre horas. En cuanto se imputa
             # algo, lo que importa es cuánto se ha imputado de verdad: eso es un
             # hecho, y los minutos por persona pasan a ser el detalle. #}
            <div class="prt-mini__cell">
                {% if is_closing and credited_total %}
                    <div class="prt-mini__label">Horas {{ phase == 'closed' ? 'imputadas' : 'ya imputadas' }}</div>
                    <div class="prt-mini__value">
                        {{ csa.qty(credited_total / 60) }} h
                        {% if offer.creditedMinutes %}<small>{{ csa.qty(offer.creditedMinutes / 60) }} h por persona</small>{% endif %}
                    </div>
                {% elseif offer.creditedMinutes %}
                    <div class="prt-mini__label">Computa</div>
                    <div class="prt-mini__value">{{ csa.qty(offer.creditedMinutes / 60) }} h <small>por persona</small></div>
                {% else %}
                    <div class="prt-mini__label">Computa</div>
                    <div class="prt-mini__value prt-mini__value--muted">No computa horas</div>
                {% endif %}
            </div>
        </div>

        {% if offer.description %}
            <section class="prt-card">
                <div class="prt-card__head"><h2 class="prt-card__title"><span class="accent"></span>Qué hay que hacer</h2></div>
                <div class="prt-card__body">{{ offer.description|nl2br }}</div>
            </section>
        {% endif %}

        {# ============ PESTAÑAS ============
         # Sin JavaScript los paneles se ven seguidos: la ficha queda larga, que
         # es lo que era antes, pero nunca vacía. Ver assets/js/csa-tabs.js. #}
        <div data-csa-tabs style="margin-top: var(--csa-sp-6);">
            <ul class="csa-tabs" role="tablist">
                <li class="csa-tabs__item active">
                    {# El nombre cambia con la fase porque el contenido cambia de
                     # oficio: antes es la lista de quién viene, después es el
                     # parte de quién vino. #}
                    <a class="csa-tabs__link" href="#gente" role="tab" aria-selected="true">
                        {{ is_closing ? 'Pasar lista' : 'Quién viene' }}{% if signup_count %}<span class="csa-tabs__count">{{ signup_count }}</span>{% endif %}
                    </a>
                </li>
                {% if suggested|length %}
                    <li class="csa-tabs__item">
                        <a class="csa-tabs__link" href="#sugeridas" role="tab" aria-selected="false">
                            A quién pedírselo<span class="csa-tabs__count">{{ suggested|length }}</span>
                        </a>
                    </li>
                {% endif %}
                <li class="csa-tabs__item">
                    <a class="csa-tabs__link" href="#avisos" role="tab" aria-selected="false">Avisos</a>
                </li>
                <li class="csa-tabs__item">
                    <a class="csa-tabs__link" href="#historial" role="tab" aria-selected="false">
                        Historial{% if history|length %}<span class="csa-tabs__count">{{ history|length }}</span>{% endif %}
                    </a>
                </li>
            </ul>

            {# ---------- QUIÉN VIENE ---------- #}
            <section class="csa-tabpanel is-active" id="gente" role="tabpanel">
                <div class="prt-card">
                    <div class="prt-card__body">
                        {% if offer.signups is empty %}
                            <p class="vol-empty">Todavía no se ha apuntado nadie.</p>
                        {% else %}
                            {# Por FASE y no por "ya pasó la fecha". Una tarea anulada la semana
                             # pasada también es pasada, y ofrecer ahí "cerrar e imputar horas" es
                             # invitar a computarle horas a gente por una tarea que se canceló. #}
                            {% set closing_form = is_closing and can_edit %}

                            <form method="post" action="{{ path('volunteering_close', { id: offer.id }) }}"
                                  {% if closing_form %}data-vol-total="{{ csa.qty((offer.creditedMinutes ?: 0) / 60)|replace({',': '.'}) }}"{% endif %}>
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_close') }}">

                                <div class="csa-table-wrap">
                                    <table class="csa-table">
                                        <thead>
                                            <tr>
                                                {% if closing_form %}
                                                    <th class="csa-table__col-tight">Fue</th>
                                                {% endif %}
                                                <th>Socix</th>
                                                <th class="csa-table__col-tight">Viene con</th>
                                                {# Antes de la tarea interesa desde cuándo cuentas con
                                                 # alguien; después ya no, y ese hueco lo necesitan los
                                                 # minutos, que es donde está el trabajo. #}
                                                {% if closing_form %}
                                                    <th class="csa-table__col-tight">Computa</th>
                                                {% else %}
                                                    <th class="csa-table__col-tight">Se apuntó</th>
                                                {% endif %}
                                                <th>Nota</th>
                                                <th class="csa-table__col-tight">Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for signup in offer.signups %}
                                                {% set done = participation[signup.partner.id]|default(null) %}
                                                <tr{% if signup.cancelled %} class="vol-row--out"{% endif %}>
                                                    {% if closing_form %}
                                                        <td class="csa-table__col-tight">
                                                            {% if not signup.cancelled %}
                                                                <input type="checkbox" name="attended[]" value="{{ signup.id }}"
                                                                       data-vol-attended
                                                                       {% if signup.attended %}checked{% endif %}>
                                                            {% endif %}
                                                        </td>
                                                    {% endif %}
                                                    <td>
                                                        {{ signup.partner.name }} {{ signup.partner.surname }}
                                                        {% if signup.coordination %}
                                                            {{ csa.badge('lo organizó', 'plum') }}
                                                        {% endif %}

                                                        {# Cuánto lleva hecho esta persona. No es cotilleo: es
                                                         # lo que distingue a quien viene por primera vez —y a
                                                         # quien conviene recibir— de quien lleva todo el año
                                                         # sosteniendo el reparto. En veces y no en horas: a
                                                         # quien coordina le sirve igual y no convierte la
                                                         # tabla en un marcador. #}
                                                        <span class="vol-track">
                                                            {%- if done %}
                                                                {{ done.times }} {{ done.times == 1 ? 'faena' : 'faenas' }} este año
                                                                {%- if done.last %} · última el {{ done.last|date('d/m') }}{% endif -%}
                                                            {%- else -%}
                                                                primera vez este año
                                                            {%- endif -%}
                                                        </span>
                                                    </td>
                                                    <td class="csa-table__col-tight">{{ signup.companions > 0 ? '+' ~ signup.companions : '—' }}</td>

                                                    {% if closing_form %}
                                                        {# Las horas, por persona. El modelo siempre las
                                                         # guardó por inscripción; era este formulario el que
                                                         # aplicaba las de la tarea a todo el mundo sin dejar
                                                         # corregir a quien se fue antes. En blanco = las de
                                                         # la tarea, que es el caso normal. #}
                                                        <td class="csa-table__col-tight">
                                                            {% if signup.cancelled %}
                                                                —
                                                            {% else %}
                                                                <input type="number" name="hours[{{ signup.id }}]"
                                                                       class="csa-input csa-input--compact vol-minutes"
                                                                       min="0" max="24" step="0.5"
                                                                       data-vol-minutes
                                                                       value="{{ signup.creditedMinutes ? csa.qty(signup.creditedMinutes / 60)|replace({',': '.'}) : '' }}"
                                                                       aria-label="Horas que computan a {{ signup.partner.name }} {{ signup.partner.surname }}">
                                                                <span class="vol-minutes__unit">h</span>
                                                            {% endif %}
                                                        </td>
                                                    {% else %}
                                                        <td class="csa-table__col-tight">{{ signup.createdAt|date('d/m/Y') }}</td>
                                                    {% endif %}

                                                    <td>{{ signup.notes ?: '—' }}</td>
                                                    <td class="csa-table__col-tight">
                                                        {% if signup.cancelled %}
                                                            {{ csa.badge('Se dio de baja', 'terracotta') }}
                                                        {% elseif signup.attended is same as(true) %}
                                                            {{ csa.badge('Fue · ' ~ csa.qty((signup.creditedMinutes ?: 0) / 60) ~ ' h', 'green') }}
                                                        {% elseif signup.attended is same as(false) %}
                                                            {{ csa.badge('No fue', 'neutral') }}
                                                        {% elseif is_past %}
                                                            {{ csa.badge('Sin confirmar', 'sky') }}
                                                        {% else %}
                                                            {{ csa.badge('Apuntadx', 'sky') }}
                                                        {% endif %}

                                                        {# Quién lo dijo. Lo normal es que lo confirme quien
                                                         # fue desde su panel; que lo haya puesto gestión
                                                         # indica una tarea que hubo que cerrar a mano, y eso
                                                         # conviene verlo. #}
                                                        {% if signup.settled and not signup.selfConfirmed %}
                                                            {{ csa.badge('lo puso gestión', 'neutral') }}
                                                        {% endif %}

                                                        {# Contactar es la acción de verdad mientras la tarea
                                                         # no ha pasado: quien coordina llama, no manda un
                                                         # aviso del sistema. #}
                                                        {% if not is_past and not signup.cancelled %}
                                                            <span class="vol-contact">
                                                                {% if signup.partner.celular %}
                                                                    <a href="tel:{{ signup.partner.celular|replace({' ': ''}) }}"
                                                                       title="Llamar a {{ signup.partner.name }}"><i class="fa fa-phone"></i></a>
                                                                {% endif %}
                                                                {% if signup.partner.email %}
                                                                    <a href="mailto:{{ signup.partner.email }}"
                                                                       title="Escribir a {{ signup.partner.name }}"><i class="fa fa-envelope-o"></i></a>
                                                                {% endif %}
                                                            </span>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>

                                {# Cerrar sólo tiene sentido cuando la tarea ya ha pasado. Mientras
                                 # no se cierra, no computa horas a nadie: el "no sabemos" es
                                 # significativo y evita que olvidarse de cerrar infle el contador
                                 # con gente que no apareció. #}
                                {% if closing_form %}
                                    {# El total ANTES del botón, y no después de pulsarlo. Cerrar
                                     # suma horas a la aportación de gente real: quien lo hace tiene
                                     # que poder ver cuánto está imputando mientras marca, no
                                     # enterarse por un flash. Lo recalcula
                                     # assets/js/vol-close-total.js; sin JS se ve el total ya
                                     # imputado, que sigue siendo cierto. #}
                                    <div class="vol-close">
                                        <p class="vol-close__sum">
                                            Se imputarán
                                            <strong data-vol-total-output>{{ csa.qty(credited_total / 60) }} h</strong>
                                            en total
                                        </p>
                                        <p class="vol-help">
                                            Marca quién fue de verdad. Las horas en blanco toman las de la tarea
                                            ({{ csa.qty((offer.creditedMinutes ?: 0) / 60) }} h); cámbialas a quien se fue antes
                                            o vino a otra cosa. Quien no esté marcadx no computa nada.
                                        </p>
                                        <button type="submit" class="csa-btn csa-btn--primary csa-btn--sm">
                                            <i class="fa fa-lock"></i><span>Cerrar e imputar</span>
                                        </button>
                                    </div>
                                {% endif %}
                            </form>
                        {% endif %}

                        {# ---- Anotar a alguien ----
                         # Sólo para quien apareció sin haberse apuntado, que pasa
                         # constantemente. Quien coordina YA NO se anota aquí: se dice al crear
                         # la tarea y su inscripción se pone sola, porque preguntarlo en medio
                         # de pasar lista era pedir una decisión de configuración durante otra
                         # faena — y así no lo ponía nadie. #}
                        {% if can_edit %}
                            <hr class="vol-sep">

                            {# Sin título propio en serif: la pestaña ya dice de qué va el
                             # panel, y un cuarto titular Fraunces aquí abajo competía con
                             # el del hero por la misma atención. #}
                            <p class="vol-help">
                                Anotar a alguien que vino sin apuntarse.
                            </p>

                            {# data-csa-dropdowns: sin él caen los <select> nativos del sistema
                             # —fondo gris oscuro, tipografía del SO— en medio de una pantalla
                             # csa. Y con 246 socixs el menú nativo es inusable: hay que
                             # arrastrar hasta el apellido. El componente añade buscador solo
                             # cuando la lista es larga. Ver assets/js/csa-dropdown.js. #}
                            <form method="post" action="{{ path('volunteering_add_person', { id: offer.id }) }}"
                                  class="vol-repeat" data-csa-dropdowns>
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_add_person') }}">

                                <label>
                                    Quién
                                    <select name="partner" class="csa-select" required
                                            data-placeholder="Escribe un nombre…"
                                            data-invalid-message="Escribe un nombre y elígelo de la lista.">
                                        <option value="">— elige —</option>
                                        {% for partner in all_partners %}
                                            <option value="{{ partner.id }}">{{ partner.name }} {{ partner.surname }}</option>
                                        {% endfor %}
                                    </select>
                                </label>

                                {# Con las horas de la tarea YA ESCRITAS, no de placeholder: un
                                 # placeholder con una cifra parece un valor puesto sin serlo, y
                                 # dejarlo vacío para que el servidor "adivine" es magia que no se
                                 # ve. Así se lee lo que se va a imputar y sólo se toca a quien se
                                 # fue antes. Obligatorio: anotar a alguien sin horas no significa
                                 # nada, y en una tarea que aún no tiene fijado lo que vale el
                                 # campo sale vacío y hay que rellenarlo. #}
                                <label>
                                    Horas
                                    <input type="number" name="hours" min="0.5" max="24" step="0.5" required
                                           value="{{ offer.creditedMinutes ? csa.qty(offer.creditedMinutes / 60)|replace({',': '.'}) : '' }}"
                                           class="csa-input csa-input--compact">
                                </label>

                                <button type="submit" class="csa-btn csa-btn--secondary csa-btn--sm">Anotar</button>
                            </form>

                            <p class="vol-help">
                                Se anota como hecho: si lo estás registrando a mano es porque
                                sabes que ocurrió. Vienen puestas las horas de la tarea; cámbialas
                                si esa persona estuvo otro rato.
                            </p>
                        {% endif %}
                    </div>
                </div>
            </section>

            {# ---------- A QUIÉN PEDÍRSELO ----------
             # Sólo mientras falte gente. Es la herramienta de quien coordina y
             # tiene que llenar una tarea el jueves por la noche: en vez de tirar
             # del grupo de WhatsApp, aquí están las personas a las que tiene
             # sentido pedírselo, con su teléfono.
             #
             # ORDENADAS POR QUIÉN MENOS HA APORTADO, Y SIN ENSEÑAR LA CIFRA DE
             # NADIE. La distinción no es un tecnicismo: la bolsa de gente
             # (VolunteeringController::pool) va por nombre a propósito, porque
             # una tabla ordenada por aportación es un ranking y un ranking
             # expulsa a quien no puede competir. Aquí quien lee es quien reparte
             # la carga de UNA tarea, y necesita no pedírselo siempre a las
             # mismas cuatro; para eso basta el orden. Publicar el contador de
             # cada cual no añade nada y sí convertiría esto en el marcador que
             # se quería evitar. #}
            {% if suggested|length %}
                <section class="csa-tabpanel" id="sugeridas" role="tabpanel">
                    <div class="prt-card">
                        <div class="prt-card__body">
                            <p class="vol-help">
                                Socixs que han marcado este tipo de trabajo y todavía no se han apuntado.
                                Primero quien menos ha echado una mano este año, para repartir la carga.
                            </p>

                            <ul class="vol-suggest">
                                {% for candidate in suggested %}
                                    {% set who = candidate.partner %}
                                    <li>
                                        <div class="vol-suggest__who">
                                            <span class="vol-suggest__name">{{ who.name }} {{ who.surname }}</span>
                                            <span class="vol-suggest__why">
                                                {%- if candidate.same_node -%}
                                                    Recoge su cesta en {{ offer.node }} — ese día ya va a estar allí
                                                {%- else -%}
                                                    Tiene marcado este tipo de trabajo
                                                {%- endif -%}
                                            </span>
                                        </div>
                                        <div class="vol-suggest__contact">
                                            {% if who.celular %}
                                                <a class="csa-btn csa-btn--ghost csa-btn--sm" href="tel:{{ who.celular|replace({' ': ''}) }}">
                                                    <i class="fa fa-phone"></i><span>{{ who.celular }}</span>
                                                </a>
                                            {% endif %}
                                            {% if who.email %}
                                                <a class="csa-btn csa-btn--ghost csa-btn--sm" href="mailto:{{ who.email }}?subject={{ offer.title|url_encode }}">
                                                    <i class="fa fa-envelope-o"></i><span>Escribir</span>
                                                </a>
                                            {% endif %}
                                            {% if not who.celular and not who.email %}
                                                <span class="vol-help--muted">Sin teléfono ni correo en su ficha</span>
                                            {% endif %}
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>

                            <p class="vol-help--muted">
                                Esto es para pedírselo tú, de persona a persona. El aviso automático del sistema
                                va por su cuenta y se ve en «Avisos».
                            </p>
                        </div>
                    </div>
                </section>
            {% endif %}

            {# ---------- AVISOS ---------- #}
            <section class="csa-tabpanel" id="avisos" role="tabpanel">
                <div class="prt-card">
                    <div class="prt-card__body">
                        {# Un círculo vacío frente a un check no dice si eso está pendiente,
                         # descartado o si hay que hacer algo: se etiqueta con palabras. #}
                        <ul class="vol-scopes">
                            <li>
                                <span>A quien tiene marcado este tipo de trabajo</span>
                                {{ 'matching' in sent_scopes ? csa.badge('Enviado', 'green') : csa.badge('Sin enviar', 'neutral') }}
                            </li>
                            <li>
                                <span>
                                    A quien no ha declarado preferencias
                                    {% if not offer.openToAnyone %}
                                        <small class="vol-help--muted">no se le puede pedir: esta tarea no es para cualquiera</small>
                                    {% endif %}
                                </span>
                                {% if not offer.openToAnyone %}
                                    {{ csa.badge('No aplica', 'neutral') }}
                                {% else %}
                                    {{ 'unspecified' in sent_scopes ? csa.badge('Enviado', 'green') : csa.badge('Sin enviar', 'neutral') }}
                                {% endif %}
                            </li>
                            <li>
                                <span>A toda la asociación</span>
                                {{ everyone_sent ? csa.badge('Enviado', 'green') : csa.badge('Sin enviar', 'neutral') }}
                            </li>
                        </ul>

                        <p class="vol-help--muted">Los dos primeros los manda el sistema solo, cuando se acerca la fecha y siguen faltando plazas. El último se manda a mano.</p>

                        {% if can_edit and not everyone_sent and offer.open %}
                            {#
                             # Este botón gasta el canal push de toda la asociación, y el
                             # permiso del navegador se pierde una vez y para siempre: quien
                             # lo apaga no vuelve. Por eso se enseña el NÚMERO antes, se
                             # exige confirmación, y sólo se puede una vez por tarea.
                             #}
                            {{ csa.callout(
                                'Avisar a toda la asociación llega a ' ~ everyone_count ~ ' socix(s), incluidxs quienes han dicho que de esto no les avisen. Sólo se puede hacer una vez por tarea. Úsalo cuando de verdad haga falta.',
                                'warning',
                                'exclamation-triangle'
                            ) }}

                            <form method="post" action="{{ path('volunteering_notify_everyone', { id: offer.id }) }}"
                                  onsubmit="return confirm('Vas a avisar a {{ everyone_count }} socix(s). Esto no se puede deshacer y sólo se puede hacer una vez. ¿Seguro?');">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_notify') }}">
                                <button type="submit" class="csa-btn csa-btn--danger-soft csa-btn--sm">
                                    <i class="fa fa-bullhorn"></i> Avisar a toda la asociación
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </section>

            {# ---------- HISTORIAL ---------- #}
            <section class="csa-tabpanel" id="historial" role="tabpanel">
                <div class="prt-card">
                    <div class="prt-card__body">
                        {% include '_components/volunteering_history.html.twig' with {
                            events: history,
                            actor_names: actor_names,
                            empty_text: 'Todavía no consta nada. Los cambios, las inscripciones y los avisos quedan registrados aquí.'
                        } only %}
                    </div>
                </div>
            </section>
        </div>
    </div>

    {# ============ REPETIR ============
     # El reparto es semanal: sin esto habría que crear la misma tarea cincuenta y
     # dos veces a mano, y no lo haría nadie. Las copias nacen en BORRADOR para
     # poder revisarlas antes de que empiecen a pedir gente solas.
     #
     # Si la tarea ocurre en un punto de recogida, las fechas pueden salir del
     # calendario de reparto de verdad y entonces ya vienen con los cierres y
     # traslados aplicados. Con las cadencias fijas no: ahí sigue habiendo que
     # mirar los festivos a mano.
     #
     # En un diálogo y no como tarjeta fija: se usa una vez al crear la serie y
     # luego estorba el resto de la vida de la tarea. #}
    {% if can_edit and offer.startsAt %}
        <dialog id="volunteering-repeat-dialog" class="csa-modal csa-modal--info" aria-labelledby="volunteering-repeat-title">
            <form method="post" action="{{ path('volunteering_repeat', { id: offer.id }) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_repeat') }}">
                <button class="csa-modal__close" type="button" aria-label="Cerrar" onclick="this.closest('dialog').close()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
                </button>
                <header class="csa-modal__header">
                    <div class="csa-modal__heading">
                        <span class="csa-modal__eyebrow">Copias en borrador</span>
                        <h2 class="csa-modal__title" id="volunteering-repeat-title">Repetir esta tarea</h2>
                    </div>
                </header>
                <div class="csa-modal__body">
                    <div class="vol-repeat">
                        <label>
                            Se repite
                            <select name="cadence" class="csa-select">
                                {% for cadence in repeat_cadences %}
                                    <option value="{{ cadence }}">
                                        {{- {
                                            'delivery': 'los días que haya reparto',
                                            'weekly': 'cada semana',
                                            'biweekly': 'cada dos semanas',
                                            'monthly': 'una vez al mes'
                                        }[cadence] -}}
                                    </option>
                                {% endfor %}
                            </select>
                        </label>

                        {# Hasta cuándo y no cuántas veces: "hasta fin de año" es como
                         # se piensa; "17 veces" obliga a contar semanas a mano. #}
                        <label>
                            hasta el
                            <input type="date" name="until" class="csa-input"
                                   min="{{ offer.startsAt|date('Y-m-d') }}"
                                   value="{{ offer.startsAt|date_modify('+3 months')|date('Y-m-d') }}">
                        </label>
                    </div>

                    <p class="vol-help">
                        {% if offer.node %}
                            Con «los días que haya reparto» las fechas salen del calendario
                            de {{ offer.node.name }}: ya vienen sin las semanas que no
                            reparte y con los traslados aplicados.
                        {% endif %}
                        Las copias se crean como borrador y sin nadie apuntado, y nacen
                        sueltas: anular una no toca a las demás.
                    </p>
                </div>
                <footer class="csa-modal__footer">
                    <button type="button" class="csa-modal__btn csa-modal__btn--ghost" onclick="this.closest('dialog').close()">Cancelar</button>
                    <button type="submit" class="csa-modal__btn csa-modal__btn--primary">Crear las copias</button>
                </footer>
            </form>
        </dialog>
    {% endif %}
{% endblock %}
