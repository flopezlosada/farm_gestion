{# Una tarea de voluntariado: sus datos, quién se ha apuntado y los avisos. #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Voluntariado · {{ offer.title }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('volunteering_index') }}">Voluntariado</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ offer.title }}</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
    {% set status_tone = { 'draft': 'neutral', 'published': 'green', 'cancelled': 'terracotta' } %}
    {% set status_label = { 'draft': 'Borrador', 'published': 'Publicada', 'cancelled': 'Anulada' } %}
    {% set is_past = offer.startsAt < date() %}

    {{ csa.page_header('Voluntariado', offer.title) }}

    {# El estado de la tarea se DERIVA de lo que ha confirmado la gente, no de un
     # campo aparte que habría que mantener en sincronía y que mentiría en cuanto
     # se desincronizara. #}
    {% if offer.done %}
        {{ csa.callout('Tarea hecha: ' ~ offer.attendedCount ~ ' persona(s) confirmaron que fueron.', 'success', 'check') }}
    {% elseif offer.wasMissed %}
        {{ csa.callout('Esta tarea pasó y no fue nadie.', 'warning', 'exclamation-triangle') }}
    {% elseif is_past and not offer.settled %}
        {{ csa.callout('Ya pasó y falta gente por decir si fue o no. Se les pregunta en su panel; si no contestan, ciérrala tú abajo.', 'info') }}
    {% endif %}

    <div class="csa-kpi-row" style="margin-bottom: var(--csa-sp-6);">
        {{ csa.kpi('Apuntadxs', offer.filledSlots, null, null, null, 'sky', 'fa-users') }}
        {% if offer.slots %}
            {{ csa.kpi('Faltan', offer.remainingSlots, null, null, null, offer.remainingSlots > 0 ? 'terracotta' : 'green', 'fa-user-plus') }}
        {% endif %}
        {% if offer.creditedMinutes %}
            {{ csa.kpi('Computa', offer.creditedMinutes, 'min', null, null, 'ochre', 'fa-clock-o') }}
        {% endif %}
    </div>

    {% embed '_components/csa_card.html.twig' with { title: 'La tarea', icon: 'fa-info-circle' } %}
        {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
            {# csa-defs es un grid de FILAS (.csa-defs__row), no de <dt>/<dd>
             # sueltos: puestos sueltos, cada uno cae en una celda y la etiqueta
             # deja de corresponderse con su valor. #}
            <dl class="csa-defs">
                <div class="csa-defs__row">
                    <dt class="csa-defs__label">Estado</dt>
                    <dd class="csa-defs__value">{{ csa.badge(status_label[offer.status]|default(offer.status), status_tone[offer.status]|default('neutral')) }}</dd>
                </div>
                <div class="csa-defs__row">
                    <dt class="csa-defs__label">Cuándo</dt>
                    <dd class="csa-defs__value">{{ offer.startsAt|date('d/m/Y H:i') }}{% if offer.endsAt %} — {{ offer.endsAt|date('H:i') }}{% endif %}</dd>
                </div>
                <div class="csa-defs__row">
                    <dt class="csa-defs__label">Dónde</dt>
                    <dd class="csa-defs__value">
                        {%- if offer.remote %}Desde casa
                        {%- elseif offer.node %}{{ offer.node }}
                        {%- elseif offer.place %}{{ offer.place }}
                        {%- else %}—{% endif -%}
                    </dd>
                </div>
                <div class="csa-defs__row">
                    <dt class="csa-defs__label">Tipo de trabajo</dt>
                    <dd class="csa-defs__value">
                        {% for category in offer.categories %}{{ csa.badge(category.name, 'neutral') }}{% else %}—{% endfor %}
                    </dd>
                </div>
                <div class="csa-defs__row">
                    <dt class="csa-defs__label">A quién se puede pedir</dt>
                    <dd class="csa-defs__value">
                        {% if offer.openToAnyone %}
                            {{ csa.badge('A cualquiera', 'green') }}
                        {% else %}
                            {{ csa.badge('Sólo a quien lo tenga marcado', 'ochre') }}
                        {% endif %}
                    </dd>
                </div>
                {% if offer.description %}
                    <div class="csa-defs__row csa-defs__row--full">
                        <dt class="csa-defs__label">Explicación</dt>
                        <dd class="csa-defs__value">{{ offer.description|nl2br }}</dd>
                    </div>
                {% endif %}
            </dl>
        {% endblock %}
    {% endembed %}

    {# ============ QUIÉN SE HA APUNTADO ============ #}
    {% embed '_components/csa_card.html.twig' with { title: 'Quién se ha apuntado', icon: 'fa-users' } %}
        {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
            {% if offer.signups is empty %}
                <p>Todavía no se ha apuntado nadie.</p>
            {% else %}
                <form method="post" action="{{ path('volunteering_close', { id: offer.id }) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_close') }}">

                    <div class="csa-table-wrap">
                        <table class="csa-table">
                            <thead>
                                <tr>
                                    {% if is_past and is_granted('VOLUNTEER_OFFER_EDIT', offer) %}
                                        <th class="csa-table__col-tight">Fue</th>
                                    {% endif %}
                                    <th>Socix</th>
                                    <th class="csa-table__col-tight">Viene con</th>
                                    <th class="csa-table__col-tight">Se apuntó</th>
                                    <th>Nota</th>
                                    <th class="csa-table__col-tight">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for signup in offer.signups %}
                                    <tr>
                                        {% if is_past and is_granted('VOLUNTEER_OFFER_EDIT', offer) %}
                                            <td class="csa-table__col-tight">
                                                {% if not signup.cancelled %}
                                                    <input type="checkbox" name="attended[]" value="{{ signup.id }}"
                                                           {% if signup.attended %}checked{% endif %}>
                                                {% endif %}
                                            </td>
                                        {% endif %}
                                        <td>
                                            {{ signup.partner.name }} {{ signup.partner.surname }}
                                            {% if signup.coordination %}
                                                {{ csa.badge('lo organizó', 'plum') }}
                                            {% endif %}
                                        </td>
                                        <td class="csa-table__col-tight">{{ signup.companions > 0 ? '+' ~ signup.companions : '—' }}</td>
                                        <td class="csa-table__col-tight">{{ signup.createdAt|date('d/m/Y') }}</td>
                                        <td>{{ signup.notes ?: '—' }}</td>
                                        <td class="csa-table__col-tight">
                                            {% if signup.cancelled %}
                                                {{ csa.badge('Se dio de baja', 'terracotta') }}
                                            {% elseif signup.attended is same as(true) %}
                                                {{ csa.badge('Fue · ' ~ (signup.creditedMinutes ?: 0) ~ ' min', 'green') }}
                                            {% elseif signup.attended is same as(false) %}
                                                {{ csa.badge('No fue', 'neutral') }}
                                            {% else %}
                                                {{ csa.badge('Sin confirmar', 'sky') }}
                                            {% endif %}

                                            {# Quién lo dijo. Lo normal es que lo
                                             # confirme quien fue desde su panel;
                                             # que lo haya puesto gestión indica
                                             # una tarea que hubo que cerrar a
                                             # mano, y eso conviene verlo. #}
                                            {% if signup.settled and not signup.selfConfirmed %}
                                                {{ csa.badge('lo puso gestión', 'neutral') }}
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# Cerrar sólo tiene sentido cuando la tarea ya ha pasado.
                     # Mientras no se cierra, no computa horas a nadie: el
                     # "no sabemos" es significativo y evita que olvidarse de
                     # cerrar infle el contador con gente que no apareció. #}
                    {% if is_past and is_granted('VOLUNTEER_OFFER_EDIT', offer) %}
                        <p class="vol-help" style="margin-top: var(--csa-sp-3);">
                            Marca quién fue de verdad. A cada persona marcada se le computan
                            {{ offer.creditedMinutes ?: 0 }} minutos; a las demás, ninguno.
                        </p>
                        <button type="submit" class="csa-btn csa-btn--primary csa-btn--sm">Cerrar la tarea</button>
                    {% endif %}
                </form>
            {% endif %}
        {% endblock %}
    {% endembed %}

    {# ============ ANOTAR A ALGUIEN ============ #}
    {# Dos huecos que se notan en cuanto esto se usa de verdad: quien ORGANIZA
     # la tarea no se apunta a ella, así que su contador salía a cero — y es la
     # gente que más sostiene el voluntariado. Y quien aparece sin haberse
     # apuntado tampoco constaba, que pasa constantemente. #}
    {% if is_granted('VOLUNTEER_OFFER_EDIT', offer) %}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Anotar a alguien',
            subtitle: 'Quien organizó esta tarea, o quien vino sin apuntarse.',
            icon: 'fa-user-plus'
        } %}
            {% block body %}
            {% import '_macros/csa.html.twig' as csa %}
                <form method="post" action="{{ path('volunteering_add_person', { id: offer.id }) }}" class="vol-repeat">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_add_person') }}">

                    <label>
                        Quién
                        <select name="partner" class="csa-select" required>
                            <option value="">— elige —</option>
                            {% for partner in all_partners %}
                                <option value="{{ partner.id }}">{{ partner.name }} {{ partner.surname }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>
                        En calidad de
                        <select name="role" class="csa-select">
                            <option value="participant">vino a trabajar</option>
                            <option value="coordinator">lo organizó</option>
                        </select>
                    </label>

                    <label>
                        Minutos
                        <input type="number" name="minutes" min="0" max="1440"
                               placeholder="{{ offer.creditedMinutes ?: 0 }}" class="csa-input csa-input--compact">
                    </label>

                    <button type="submit" class="csa-btn csa-btn--secondary csa-btn--sm">Anotar</button>
                </form>

                <p class="vol-help">
                    Se anota como hecho: si lo estás registrando a mano es porque
                    sabes que ocurrió. Si dejas los minutos en blanco se usan los
                    de la tarea ({{ offer.creditedMinutes ?: 0 }}). Quien lo organizó no ocupa plaza.
                </p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {# ============ REPETIR ============ #}
    {# El reparto es semanal: sin esto habría que crear la misma tarea cincuenta
     # y dos veces a mano, y no lo haría nadie. Las copias nacen en BORRADOR para
     # poder revisarlas —los festivos no se modelan— antes de que empiecen a
     # pedir gente solas. #}
    {% if is_granted('VOLUNTEER_OFFER_EDIT', offer) and offer.startsAt %}
        {% embed '_components/csa_card.html.twig' with {
            title: 'Repetir esta tarea',
            subtitle: 'Crea copias en las fechas siguientes, en borrador.',
            icon: 'fa-repeat'
        } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                <form method="post" action="{{ path('volunteering_repeat', { id: offer.id }) }}" class="vol-repeat">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_repeat') }}">

                    <label>
                        Cada
                        <select name="cadence" class="csa-select">
                            <option value="weekly">semana</option>
                            <option value="biweekly">dos semanas</option>
                            <option value="monthly">cuatro semanas</option>
                        </select>
                    </label>

                    <label>
                        durante
                        <input type="number" name="times" value="4" min="1" max="52" class="csa-input csa-input--compact">
                        veces
                    </label>

                    <button type="submit" class="csa-btn csa-btn--secondary csa-btn--sm">Crear las copias</button>
                </form>

                <p class="vol-help">
                    Las copias se crean como borrador y sin nadie apuntado. Revisa
                    que ninguna cae en festivo antes de publicarlas.
                </p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {# ============ AVISOS ============ #}
    {% embed '_components/csa_card.html.twig' with { title: 'Avisos enviados', icon: 'fa-bullhorn' } %}
        {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
            <ul class="csa-list">
                <li>
                    {% if 'matching' in sent_scopes %}<i class="fa fa-check"></i>{% else %}<i class="fa fa-circle-o"></i>{% endif %}
                    A quien tiene marcado este tipo de trabajo
                </li>
                <li>
                    {% if 'unspecified' in sent_scopes %}<i class="fa fa-check"></i>{% else %}<i class="fa fa-circle-o"></i>{% endif %}
                    A quien no ha declarado preferencias
                    {% if not offer.openToAnyone %}
                        <em>(no aplica: esta tarea no es para cualquiera)</em>
                    {% endif %}
                </li>
                <li>
                    {% if everyone_sent %}<i class="fa fa-check"></i>{% else %}<i class="fa fa-circle-o"></i>{% endif %}
                    A toda la asociación
                </li>
            </ul>

            {% if is_granted('VOLUNTEER_OFFER_EDIT', offer) and not everyone_sent and offer.open %}
                {#
                 # Este botón gasta el canal push de toda la asociación, y el
                 # permiso del navegador se pierde una vez y para siempre: quien
                 # lo apaga no vuelve. Por eso se enseña el NÚMERO antes, se
                 # exige confirmación, y sólo se puede una vez por tarea.
                 #}
                {{ csa.callout(
                    'Avisar a toda la asociación llega a ' ~ everyone_count ~ ' socix(s), incluidxs quienes han dicho que de esto no les avisen. Sólo se puede hacer una vez por tarea. Úsalo cuando de verdad haga falta.',
                    'warning',
                    'exclamation-triangle'
                ) }}

                <form method="post" action="{{ path('volunteering_notify_everyone', { id: offer.id }) }}"
                      onsubmit="return confirm('Vas a avisar a {{ everyone_count }} socix(s). Esto no se puede deshacer y sólo se puede hacer una vez. ¿Seguro?');">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('volunteering_notify') }}">
                    <button type="submit" class="csa-btn csa-btn--danger-soft csa-btn--sm">
                        <i class="fa fa-bullhorn"></i> Avisar a toda la asociación
                    </button>
                </form>
            {% endif %}
        {% endblock %}
    {% endembed %}

    <div class="csa-row-between" style="margin-top: var(--csa-sp-6);">
        {{ csa.btn('Volver', { variant: 'ghost', href: path('volunteering_index') }) }}
        {% if is_granted('VOLUNTEER_OFFER_EDIT', offer) %}
            {{ csa.btn('Editar', { variant: 'primary', icon: 'fa-pencil', href: path('volunteering_edit', { id: offer.id }) }) }}
        {% endif %}
    </div>
{% endblock %}
