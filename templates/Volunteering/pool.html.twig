{# La bolsa de voluntariado: quién hay para cada tipo de trabajo. #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Voluntariado · Quién hay{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include '_components/volunteering_styles.html.twig' %}
{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('volunteering_index') }}">Voluntariado</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Quién hay</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Voluntariado', 'Quién hay', 'A quién puedes llamar para cada tipo de trabajo.') }}

    {#
     # Por defecto se enseña sólo a quien HA MARCADO algo. Con las cuatro vistas
     # mezcladas salían los 246 socixs en una tabla de nueve mil píxeles, y el
     # 95% decía "no ha dicho nada": justo el ruido que impide encontrar a quien
     # buscas. Los otros grupos siguen a un clic, y con su número al lado, que
     # ver que "sin decir nada" son doscientos es la mitad de la información.
     #}
    <div class="vol-filters">
        <a href="{{ path('volunteering_pool') }}"
           class="csa-btn csa-btn--sm {{ not current and scope == 'declared' ? 'csa-btn--secondary' : 'csa-btn--ghost' }}">
            Han dicho de qué ({{ counts.declared }})
        </a>
        {% for category in categories %}
            <a href="{{ path('volunteering_pool', { tipo: category.id }) }}"
               class="csa-btn csa-btn--sm {{ current and current.id == category.id ? 'csa-btn--secondary' : 'csa-btn--ghost' }}">
                {{ category.name }} ({{ category.partners|length }})
            </a>
        {% endfor %}
        <a href="{{ path('volunteering_pool', { ver: 'silent' }) }}"
           class="csa-btn csa-btn--sm {{ not current and scope == 'silent' ? 'csa-btn--secondary' : 'csa-btn--ghost' }}">
            No han dicho nada ({{ counts.silent }})
        </a>
        <a href="{{ path('volunteering_pool', { ver: 'refused' }) }}"
           class="csa-btn csa-btn--sm {{ not current and scope == 'refused' ? 'csa-btn--secondary' : 'csa-btn--ghost' }}">
            No quieren avisos ({{ counts.refused }})
        </a>
    </div>

    {% set heading = current
        ? 'Quién quiere ' ~ current.name|lower
        : { 'silent': 'No han dicho de qué', 'refused': 'No quieren avisos' }|default({})[scope]|default('Han dicho de qué quieren') %}

    {% embed '_components/csa_card.html.twig' with { title: heading, icon: 'fa-users' } %}
        {% block body %}
        {% import '_macros/csa.html.twig' as csa %}

            {% if scope == 'silent' and not current %}
                {{ csa.callout('No haber dicho nada NO es negarse: a esta gente se le avisa de las tareas marcadas como aptas para cualquiera.', 'info') }}
            {% elseif scope == 'refused' and not current %}
                {{ csa.callout('Han pedido expresamente que no se les avise de voluntariado. Se respeta siempre, también en el aviso a toda la asociación.', 'warning') }}
            {% endif %}

            {#
             # "Veces" está aquí porque quien coordina necesita saber a quién no
             # ha visto todavía —para acercarse, no para señalarlo— y por eso la
             # tabla NO se puede ordenar por ese número: va por orden alfabético
             # y punto. Un listado ordenado por aportación es un ranking.
             #}
            <div class="csa-table-wrap">
                <table class="csa-table">
                    <thead>
                        <tr>
                            <th>Socix</th>
                            <th class="csa-table__col-tight">Recoge en</th>
                            <th>De qué quiere que le avisen</th>
                            <th class="csa-table__col-tight">Veces en {{ year }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for partner in pagination %}
                            {% set stats = participation[partner.id]|default(null) %}
                            <tr>
                                <td class="csa-table__primary">{{ partner.name }} {{ partner.surname }}</td>
                                <td class="csa-table__col-tight">
                                    {{ partner.weeklyBasketGroup and partner.weeklyBasketGroup.node
                                        ? partner.weeklyBasketGroup.node.name : '—' }}
                                </td>
                                <td>
                                    {% if partner.volunteeringOptOut %}
                                        {{ csa.badge('No quiere avisos', 'terracotta') }}
                                    {% elseif partner.volunteerCategories is empty %}
                                        <span class="vol-help">Nada — sólo lo sencillo</span>
                                    {% else %}
                                        {% for category in partner.volunteerCategories %}
                                            {{ csa.badge(category.name, 'neutral') }}
                                        {% endfor %}
                                    {% endif %}
                                </td>
                                <td class="csa-table__col-tight">
                                    {% if stats %}
                                        {{ stats.times }}
                                        <span class="vol-help">últ. {{ stats.last|date('d/m/Y') }}</span>
                                    {% else %}
                                        <span class="vol-help">ninguna</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4">Aquí no hay nadie todavía.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="csa-dt-bottom">
                {{ knp_pagination_render(pagination) }}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
