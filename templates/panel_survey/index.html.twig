{# ============================================================
 # Encuestas que admiten respuesta — panel de la socia.
 # Primero las que le quedan por responder; debajo, las ya
 # respondidas, más apagadas.
 # ============================================================ #}

{% extends '_layouts/csa_panel.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Encuestas{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Encuestas</span>
{% endblock %}

{% block csa_main %}

    {{ csa.page_header('Encuestas', 'Lo que la asociación te pregunta', 'Tu opinión nos ayuda a decidir. Las respuestas son anónimas.') }}

    {% set pending = surveys|filter(s => answered[s.id] is not defined) %}
    {% set done = surveys|filter(s => answered[s.id] is defined) %}

    {% if surveys is empty %}
        {{ csa.callout('Ahora mismo no hay ninguna encuesta abierta. ¡Gracias por pasarte!', 'info') }}
    {% else %}
        <div class="svy-teasers">
            {% for survey in pending|merge(done) %}
                {{ include('panel_survey/_teaser.html.twig', { survey: survey, answered: answered[survey.id] is defined }) }}
            {% endfor %}
        </div>
    {% endif %}

{% endblock %}

{% block more_css %}
    {{ parent() }}
    {{ include('panel_survey/_teaser_styles.html.twig') }}
{% endblock %}
