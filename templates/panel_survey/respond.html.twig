{# ============================================================
 # Responder una encuesta — panel de la socia.
 # El formulario vive en _form.html.twig y los estilos en
 # _styles.html.twig: los comparte con la respuesta desde el
 # enlace del correo, que se pinta fuera del panel.
 # ============================================================ #}

{% extends '_layouts/csa_panel.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}{{ survey.title }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('panel') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('panel_survey_index') }}">Encuestas</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ survey.title }}</span>
{% endblock %}

{% block csa_main %}
    {% set n = survey.questions|length %}

    <div class="svy">
        {{ csa.page_header('Encuesta', survey.title, survey.description) }}

        <ul class="svy-facts">
            <li><i class="fa fa-list-ol" aria-hidden="true"></i> {{ n }} pregunta{{ n == 1 ? '' : 's' }}</li>
            <li><i class="fa fa-lock" aria-hidden="true"></i> Anónima</li>
            {% if survey.closesAt %}
                <li><i class="fa fa-calendar-o" aria-hidden="true"></i> Hasta el {{ survey.closesAt|date('d/m/Y') }}</li>
            {% endif %}
        </ul>

        {{ include('panel_survey/_form.html.twig', { cancel: path('panel_survey_index') }) }}
    </div>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {{ include('panel_survey/_styles.html.twig') }}
{% endblock %}
