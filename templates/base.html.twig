<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>Administración CSA Vega de Jarama. {% block title %}{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('bundles/app/css/bootstrap.min.css') }}"/>
        <!-- MetisMenu CSS -->
        <link rel="stylesheet" href="{{ asset('bundles/app/css/plugins/metisMenu/metisMenu.min.css') }}"/>
        <!-- Custom CSS -->
        <link rel="stylesheet" href="{{ asset('bundles/app/css/sb-admin-2.css') }}"/>
        <!-- Custom Fonts -->

        <script src="https://kit.fontawesome.com/95aa3a447a.js" crossorigin="anonymous"></script>
    {% endblock %}
    {% block more_css %}
    {% endblock %}
    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}"/>

    {# ---------- Instalación en el móvil (requisito de los avisos push) ----------
     # NO es un capricho de "app nativa": en iOS el push SÓLO existe si la web
     # está añadida a la pantalla de inicio Y se abre en modo standalone. Sin
     # manifest, iOS la añade pero la abre como pestaña de Safari, donde la API
     # de push no está — y el botón "Activar avisos" del panel decía "añade la
     # web a tu pantalla de inicio" para algo que luego no funcionaba.
     #
     # apple-mobile-web-app-capable va ADEMÁS del manifest, no en su lugar: iOS
     # sólo respeta el display:standalone del manifest desde 16.4, y quien tenga
     # un iPhone más viejo se queda sin push si falta esta meta.
     #
     # start_url apunta a /post-login (no a /panel) porque es el dispatcher por
     # rol: lleva a cada cual a su sitio y no deja a gestión aterrizando en un
     # panel de socix que no le corresponde. #}
    <link rel="manifest" href="{{ asset('manifest.json') }}"/>
    <meta name="theme-color" content="#4a7c3a"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
    <meta name="apple-mobile-web-app-title" content="CSA Vega"/>
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}"/>
</head>
<body>
{% block body %}{% endblock %}
{% block javascripts %}

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
    <script src="{{ asset('bundles/app/js/jquery.js') }}"></script>
    <!-- Bootstrap Core JavaScript -->
    <script src="{{ asset('bundles/app/js/bootstrap.min.js') }}"></script>
    <!-- Metis Menu Plugin JavaScript -->
    <script src="{{ asset('bundles/app/js/plugins/metisMenu/metisMenu.min.js') }}"></script>
    <!-- Custom Theme JavaScript -->
    <script src="{{ asset('bundles/app/js/sb-admin-2.js') }}"></script>
{% endblock %}
{% block more_js %}
{% endblock %}
</body>
</html>
