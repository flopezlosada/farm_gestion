{# ============================================================
 # Texto del chip de un fichaje que no se fichó en el momento
 # ({@see TimeEntry::isManual()}). Dice el hecho, no la categoría: quién lo
 # apuntó si fue el supervisor; si no, cuándo se apuntó (el día si fue otro,
 # la hora si fue el mismo). Una sola fuente para calendario, ficha, día y
 # panel del trabajador.
 # ============================================================ #}
{% macro label(entry, madrid) -%}
    {%- if entry.source == constant('App\\Entity\\TimeEntry::SOURCE_SUPERVISOR') -%}
        Apuntado por {{ entry.author ? entry.author.displayName : 'el supervisor' }}
    {%- elseif entry.recordedAt|date('Y-m-d', madrid) != entry.occurredAt|date('Y-m-d', madrid) -%}
        Apuntado el {{ entry.recordedAt|date('d/m', madrid) }}
    {%- else -%}
        Apuntado a las {{ entry.recordedAt|date('H:i', madrid) }}
    {%- endif -%}
{%- endmacro %}
