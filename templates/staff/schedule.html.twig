{# Horario habitual (módulo laboral): plantilla global o excepción de un trabajador. #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Personal · Horario{{ worker ? ' · ' ~ worker.name : '' }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('staff_index') }}">Personal</a>
    {% if worker %}
        <span class="csa-topbar__crumbs-sep">/</span>
        <a href="{{ path('staff_show', { id: worker.id }) }}">{{ worker.name }}</a>
    {% endif %}
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Horario</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    <style>
        /* Columnas fijas (no por contenido): así todas las filas miden igual
           tenga o no "Borrar"/texto heredado, que era lo que las descuadraba. */
        .sch-row { display: grid; grid-template-columns: 110px 1fr 130px;
                   gap: var(--csa-sp-4); align-items: center;
                   background: var(--csa-surface); border: 1px solid var(--csa-rule);
                   border-radius: var(--csa-radius-lg); padding: var(--csa-sp-4) var(--csa-sp-5);
                   margin-bottom: var(--csa-sp-3); }
        .sch-row__day { font-weight: 600; }
        .sch-row__tramos { display: flex; gap: var(--csa-sp-5); align-items: center; flex-wrap: wrap; }
        .sch-row__tramo { display: flex; gap: var(--csa-sp-2); align-items: center; color: var(--csa-ink-soft); font-size: var(--csa-fs-sm); }
        .sch-row__tramo input[type="time"] { width: 8.5em; }
        .sch-row__aside { text-align: right; }
        .sch-row__inherited { color: var(--csa-ink-soft); font-size: var(--csa-fs-sm); font-style: italic; }
        .sch-row__actions { display: flex; gap: var(--csa-sp-3); align-items: center; grid-column: 1 / -1; justify-content: flex-end; }
    </style>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Personal', worker ? 'Horario de ' ~ worker.name : 'Horario habitual',
        worker
            ? 'Excepción de este trabajador: sobrescribe la plantilla global día a día. Un día vacío sigue el horario global.'
            : 'Plantilla de toda la asociación. Cada trabajador puede tener su propia excepción desde su ficha.') }}

    {{ csa.callout('Hasta 2 tramos por día (para la jornada partida). Deja un tramo vacío si no aplica; los dos vacíos = no se trabaja ese día.', 'info') }}

    {% for day in 1..7 %}
        {% set schedule = week[day] %}
        {% set times = schedule ? schedule.times : [] %}
        {% set t1 = times[0] ?? [null, null] %}
        {% set t2 = times[1] ?? [null, null] %}
        {% set save_route = worker ? path('staff_schedule_worker_save', { workerId: worker.id, dayOfWeek: day }) : path('staff_schedule_save', { dayOfWeek: day }) %}
        {% set clear_route = worker ? path('staff_schedule_worker_clear', { workerId: worker.id, dayOfWeek: day }) : path('staff_schedule_clear', { dayOfWeek: day }) %}
        {% set token_id = 'staff_schedule' ~ (worker ? worker.id : '') %}

        <div class="sch-row">
            <span class="sch-row__day">{{ day_names[day] }}</span>

            <div class="sch-row__tramos">
                <span class="sch-row__tramo">
                    Tramo 1
                    <input type="time" name="t1s" form="sch-form-{{ day }}" value="{{ t1[0] }}">
                    –
                    <input type="time" name="t1e" form="sch-form-{{ day }}" value="{{ t1[1] }}">
                </span>
                <span class="sch-row__tramo">
                    Tramo 2
                    <input type="time" name="t2s" form="sch-form-{{ day }}" value="{{ t2[0] }}">
                    –
                    <input type="time" name="t2e" form="sch-form-{{ day }}" value="{{ t2[1] }}">
                </span>
            </div>

            <span class="sch-row__aside">
                {% if not schedule and worker and global_week[day] %}
                    <span class="sch-row__inherited">Sigue la global</span>
                {% endif %}
            </span>

            <div class="sch-row__actions">
                <form id="sch-form-{{ day }}" method="post" action="{{ save_route }}" style="display:contents;">
                    <input type="hidden" name="_token" value="{{ csrf_token(token_id) }}">
                    {{ csa.btn('Guardar', { variant: 'primary', type: 'submit' }) }}
                </form>
                {% if schedule %}
                    <form method="post" action="{{ clear_route }}" onsubmit="return confirm('¿Borrar el horario del {{ day_names[day]|lower }}?');">
                        <input type="hidden" name="_token" value="{{ csrf_token(token_id) }}">
                        {{ csa.btn('Borrar', { variant: 'ghost', type: 'submit' }) }}
                    </form>
                {% endif %}
            </div>
        </div>
    {% endfor %}
{% endblock %}
