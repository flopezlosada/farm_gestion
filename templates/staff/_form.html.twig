{# ============================================================
 # Form compartido de trabajador (new + edit).
 # Espera: form, submit_label, cancel_path.
 # ============================================================ #}
{% form_theme form 'form_div_layout.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{{ form_start(form, { attr: { role: 'form', class: 'csa-form-narrow' } }) }}

    <div class="csa-stack-lg">

        {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Ficha laboral', subtitle: 'Datos de la relación laboral. El acceso para fichar se gestiona aparte.' } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                <div class="csa-form-grid">
                    {{ csa.field(form.name, 'Nombre completo', { full: true }) }}
                    {{ csa.field(form.hireDate, 'Fecha de alta') }}
                    {{ csa.field(form.recordingStartDate, 'Registro en la app desde') }}
                    {{ csa.field(form.workdayType, 'Tipo de jornada') }}
                    {{ csa.field(form.annualVacationDays, 'Días de vacaciones al año') }}
                    {{ csa.field(form.leaveDate, 'Fecha de baja') }}
                </div>
            {% endblock %}
        {% endembed %}

        {% embed '_components/csa_form_section.html.twig' with { num: '2', title: 'Datos personales', subtitle: 'Para identificarle en el registro de jornada y poder contactar. Todos opcionales.' } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                <div class="csa-form-grid">
                    {{ csa.field(form.nif, 'DNI/NIE') }}
                    {{ csa.field(form.phone, 'Teléfono') }}
                    {{ csa.field(form.email, 'Correo personal', { full: true }) }}
                    {{ csa.field(form.address, 'Dirección', { full: true }) }}
                </div>
            {% endblock %}
        {% endembed %}

        {% embed '_components/csa_form_section.html.twig' with { num: '3', title: 'Cesta', subtitle: 'Mientras trabaja su cesta es gratis. Cuando se va, se decide si la paga o se le sigue regalando.' } %}
            {% block body %}
                {% import '_macros/csa.html.twig' as csa %}
                <div class="csa-form-grid">
                    {% if form.alreadyMember is defined %}
                        {{ csa.field(form.alreadyMember, '¿Ya es socia?', { full: true, attr: { class: 'csa-segmented' } }) }}
                        {{ csa.field(form.partner, 'Su ficha de socia', { full: true, show_when: 'alreadyMember=1' }) }}
                        {% if form.givesBasket is defined %}
                            <div class="csa-field csa-field--full">
                                <label for="{{ form.givesBasket.vars.id }}" style="display:flex; gap:.6rem; align-items:flex-start; cursor:pointer;">
                                    {{ form_widget(form.givesBasket) }}
                                    <span>
                                        <strong>Recibe cesta</strong>
                                        <span class="csa-field__hint" style="display:block;">Al guardar se sigue a dar de alta su cesta. Si es socia y ya tiene una, no hace falta otra.</span>
                                    </span>
                                </label>
                            </div>
                        {% endif %}
                    {% else %}
                        {# Ya tiene ficha de no socia: no hay nada que preguntar. #}
                        <p class="csa-field--full" style="margin: 0;">
                            <i class="fa fa-shopping-basket"></i>
                            Ficha de cesta de no socia: <a href="{{ path('partner_show', { id: form.vars.data.partner.id }) }}">{{ form.vars.data.partner.legalName }}</a>
                        </p>
                    {% endif %}
                    {% if form.basketAfterLeave is defined %}
                        {{ csa.field(form.basketAfterLeave, 'Su cesta tras la baja') }}
                        {{ csa.field(form.basketGiftUntil, 'Se le regala hasta') }}
                    {% endif %}
                </div>
            {% endblock %}
        {% endembed %}

        <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
            <div></div>
            <div class="csa-row">
                {{ csa.btn('Cancelar', { variant: 'ghost', href: cancel_path }) }}
                <button type="submit" class="csa-btn csa-btn--primary">{{ submit_label }}</button>
            </div>
        </div>

    </div>

    {{ form_rest(form) }}
{{ form_end(form, { render_rest: false }) }}
