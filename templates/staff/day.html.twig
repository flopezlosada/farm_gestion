{# Detalle de un día: fichajes de la jornada + corregir/anular/añadir. #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% import 'staff/_punch.html.twig' as p %}

{% set madrid = 'Europe/Madrid' %}
{% set ymd = date|date('Y-m-d', madrid) %}

{% block title %}{{ worker.name }} · {{ date|date('j M Y', madrid) }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('staff_index') }}">Personal</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('staff_show', { id: worker.id }) }}">{{ worker.name }}</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('staff_calendar', { id: worker.id, year: date|date('Y', madrid), month: date|date('n', madrid) }) }}">Calendario</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ date|date('j M', madrid) }}</span>
{% endblock %}

{% block more_css %}
    {{ parent() }}
    {% include 'staff/_edit_styles.html.twig' %}
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Personal · ' ~ worker.name, date|date('l, j F Y', madrid)|capitalize,
        'Fichajes de la jornada. Total: ' ~ (total // 60) ~ 'h ' ~ '%02d'|format(total % 60) ~ 'm.') }}

    {{ include('staff/_day_warning.html.twig', { open: open, anomaly: anomaly, date: date, madrid: madrid }) }}

    {% if closed %}
        {# Mes aprobado: el registro ya no se toca. Se dice aquí, y no sólo al
         # intentar guardar, para que nadie rellene un formulario para nada. #}
        <div class="csa-callout csa-callout--info" style="max-width:560px; margin-bottom: 1rem;">
            <i class="fa fa-lock"></i> El registro de este mes ya está aprobado y no se puede cambiar.
            Para corregirlo, reabre el mes en «Cierre de mes».
        </div>
    {% endif %}

    <div class="stf-reg" style="max-width:560px;">
        <div class="stf-day">
            <div class="stf-day__head">Tramos del día</div>
            {% set popts = { csrf_id: 'staff_entry' ~ worker.id, correct_route: 'staff_entry_correct', void_route: 'staff_entry_void', base_params: { id: worker.id }, return_to: ymd, readonly: closed } %}
            {% for seg in segments %}
                <div class="stf-pun">
                    {{ p.punch(seg.in, 'in', madrid, popts) }}
                    <span style="color:#9ca3af;">→</span>
                    {{ p.punch(seg.out, 'out', madrid, popts) }}
                    {% if seg.minutes is not null %}
                        <span style="margin-left:auto; color:#6b7280;">{{ (seg.minutes // 60) }}h {{ '%02d'|format(seg.minutes % 60) }}m</span>
                    {% endif %}
                </div>
            {% else %}
                <div class="stf-reg-empty">Sin fichajes este día.</div>
            {% endfor %}
        </div>
    </div>

    {# Un día que no se trabajó no se rellena con el horario: se explica con una
     # ausencia (permiso, huelga…), que es lo que deja aprobar el mes. #}
    {% if absence_type %}
        <div class="csa-callout csa-callout--info" style="max-width:560px; margin-bottom: 1rem;">
            Día cubierto por una ausencia: <strong>{{ constant('App\\Entity\\Absence::TYPE_LABELS')[absence_type]|default('Ausencia') }}</strong>.
        </div>
    {% elseif segments is empty and not closed and is_granted('ROLE_GESTION_LABORAL_EDIT') %}
        <div class="csa-row" style="max-width:560px; margin-bottom: 1rem; align-items: center; gap: .8rem;">
            <span style="color:#6b7280;">¿No vino a trabajar (un permiso, una huelga…)?</span>
            {{ csa.btn('Registrar la ausencia', { variant: 'secondary', icon: 'fa-calendar-times-o', href: path('staff_absence_new', { id: worker.id, date: ymd, back: 'day' }) }) }}
        </div>
    {% endif %}

    {# Traza del día: cómo entró cada fichaje y lo que se anuló. Es lo que el
     # supervisor mira para aprobar el mes; sin esto, un día tecleado entero a
     # posteriori se ve igual que uno fichado en el momento. #}
    {% set type_label = { in: 'Entrada', out: 'Salida' } %}
    {% if entries is not empty or voided is not empty %}
        <div class="stf-reg" style="max-width:560px;">
            <div class="stf-day">
                <div class="stf-day__head">Traza del día</div>
                {% for e in entries %}
                    <div class="stf-trail">
                        <strong>{{ type_label[e.type]|default(e.type) }} {{ e.occurredAt|date('H:i', madrid) }}</strong>
                        {% if e.manual %}
                            <span class="stf-trail__meta">
                                apuntado el {{ e.recordedAt|date('d/m/Y H:i', madrid) }}{{ e.author ? ' por ' ~ e.author.displayName : '' }}{{ e.note ? ' · «' ~ e.note ~ '»' : '' }}
                            </span>
                        {% else %}
                            <span class="stf-trail__meta">fichado en el momento</span>
                        {% endif %}
                    </div>
                {% endfor %}
                {% for e in voided %}
                    <div class="stf-trail stf-trail--voided">
                        <s>{{ type_label[e.type]|default(e.type) }} {{ e.occurredAt|date('H:i', madrid) }}</s>
                        <span class="stf-late stf-late--voided">anulado</span>
                        <span class="stf-trail__meta">
                            el {{ e.voidedAt|date('d/m/Y H:i', madrid) }}{{ e.voidedBy ? ' por ' ~ e.voidedBy.displayName : '' }}{{ e.voidReason ? ' · «' ~ e.voidReason ~ '»' : '' }}
                        </span>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if not closed %}
    <details class="stf-add" open>
        <summary><i class="fa fa-plus-circle"></i> Añadir un registro a este día</summary>
        <form method="post" action="{{ path('staff_entry_add', { id: worker.id }) }}" class="stf-addrow">
            <input type="hidden" name="_token" value="{{ csrf_token('staff_entry' ~ worker.id) }}">
            <input type="hidden" name="return_to" value="{{ ymd }}">
            <input type="hidden" name="date" value="{{ ymd }}">
            {% set next_type = open ? 'out' : 'in' %}
            <input type="hidden" name="type" value="{{ next_type }}">
            <label>Tipo
                <span class="stf-fixedtype stf-fixedtype--{{ next_type }}">{{ next_type == 'out' ? 'Salida' : 'Entrada' }}</span>
            </label>
            <label>Hora
                <input type="time" name="time" class="csa-input" required>
            </label>
            <button type="submit" class="csa-btn csa-btn--primary">Añadir</button>
        </form>
    </details>
    {% endif %}
{% endblock %}
