{# Registrar ausencia (vacaciones/baja/permiso/huelga) — supervisor. También
 # justifica un día sin fichar: el controller pasa cancel_url para volver a
 # la pantalla de la que se vino. #}
{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}

{% block title %}Registrar ausencia · {{ worker.name }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('staff_index') }}">Personal</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('staff_show', { id: worker.id }) }}">{{ worker.name }}</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Ausencia</span>
{% endblock %}

{% block csa_main %}
    {{ csa.page_header('Personal · ' ~ worker.name, 'Registrar ausencia', 'Vacaciones, baja, permiso o huelga. Queda aprobada directamente y explica los días que no se trabajaron: no hace falta inventar fichajes.') }}

    {% form_theme form 'form_div_layout.html.twig' %}
    {{ form_start(form, { attr: { class: 'csa-form-narrow' } }) }}
        <div class="csa-stack-lg">
            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Ausencia', subtitle: 'Tipo y fechas (ambos días incluidos). Una baja médica sin fecha de alta se deja sin «Hasta».' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.type, 'Tipo') }}
                        {{ csa.field(form.startDate, 'Desde') }}
                        {{ csa.field(form.endDate, 'Hasta') }}
                        <div class="csa-field csa-field--full"{{ csa.reveal(form.topsUpToFullPay, 'type=sick_leave') }}>
                            <label for="{{ form.topsUpToFullPay.vars.id }}" style="display:flex; gap:.5rem; align-items:flex-start;">
                                {{ form_widget(form.topsUpToFullPay) }}
                                <span>
                                    La asociación complementa hasta el 100 % del sueldo
                                    <span class="csa-field__hint" style="display:block;">Marcada, cobra el sueldo entero durante la baja. Desmarcada, sólo la prestación (nada los 3 primeros días, el 60 % del 4.º al 20.º y el 75 % desde el 21.º). Cambia la previsión de sueldos.</span>
                                </span>
                            </label>
                        </div>
                        {{ csa.field(form.note, 'Comentario', { full: true }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: cancel_url }) }}
                    <button type="submit" class="csa-btn csa-btn--primary">Registrar ausencia</button>
                </div>
            </div>
        </div>
        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}
{% endblock %}
