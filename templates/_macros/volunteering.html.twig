{# ---------- MACROS DEL VOLUNTARIADO ----------
 #
 # En fichero propio y no como {% import _self %} dentro de la pantalla: dentro
 # de un {% embed %}, `_self` apunta a la plantilla EMBEBIDA, no a la que la
 # incluye, así que un macro local se vuelve invisible justo donde más se usa.
 # Importándolo por nombre funciona igual en todas partes:
 #
 #   {% import '_macros/volunteering.html.twig' as vol %}
 #   {{ vol.duration(90) }}   →   1 h 30 min
 #}

{# ---------- DURATION ----------
 # Minutos en algo que se lee. Las horas viajan en minutos enteros por toda la
 # aplicación (un decimal de Doctrine vuelve como string y acaba sumándose con
 # floats), así que el formateo vive aquí y no en cada pantalla.
 #}
{% macro duration(minutes) %}
    {%- if minutes < 60 -%}
        {{ minutes }} min
    {%- elseif minutes % 60 == 0 -%}
        {{ (minutes / 60)|round }} h
    {%- else -%}
        {{ (minutes // 60) }} h {{ minutes % 60 }} min
    {%- endif -%}
{% endmacro %}

{# ---------- ACTOR ----------
 # Quién hizo algo, con nombre si se ha podido resolver.
 #
 # El actor se guarda como texto ("gestor:1") para que el rastro sobreviva al
 # borrado de la cuenta; aquí se traduce a nombre y, si no se pudo, se enseña el
 # código crudo — que es lo honesto cuando esa cuenta ya no existe.
 #
 #   {{ vol.actor(event.actor, actor_names) }}
 #}
{% macro actor(actor, names = {}) %}
    {%- if actor is null or actor == '' -%}
        —
    {%- elseif actor == 'system' -%}
        automático
    {%- elseif actor == 'cli' -%}
        comando
    {%- else -%}
        {{ names[actor]|default(actor) }}
    {%- endif -%}
{% endmacro %}

{# ---------- DETAIL ----------
 # El payload de un evento, en cristiano.
 #
 # Diccionario de CLAVES y no de tipos de evento: las claves son pocas y se
 # repiten entre tipos, mientras que enumerar aquí cada tipo sería duplicar el
 # catálogo de VolunteerEvent en una plantilla y olvidarse de tocarlo al añadir
 # uno. Lo que no está en el diccionario se pinta tal cual, que es mejor que
 # esconderlo.
 #
 #   {{ vol.detail(event.payload) }}
 #}
{% macro detail(payload) %}
    {%- set labels = {
        'role': 'en calidad de', 'minutes': 'minutos', 'companions': 'acompañantes',
        'scope': 'alcance', 'recipients': 'destinatarixs', 'times': 'veces',
        'cadence': 'cada', 'active': 'se ofrece', 'name': 'nombre',
        'moved': 'cambia de fecha', 'relocated': 'cambia de sitio',
        'before': 'antes', 'after': 'ahora', 'again': 'de nuevo',
        'areas': 'áreas', 'opt_out': 'no quiere avisos', 'status': 'estado'
    } -%}
    {%- set values = {
        'coordinator': 'lo organizó', 'participant': 'fue a trabajar',
        'matching': 'a quien lo tiene marcado', 'unspecified': 'a quien no dijo nada',
        'everyone': 'a toda la asociación', 'weekly': 'semana',
        'biweekly': 'dos semanas', 'monthly': 'cuatro semanas',
        'draft': 'borrador', 'published': 'publicada', 'cancelled': 'anulada'
    } -%}
    {#- Claves donde `false` significa "no pasó nada", y decirlo es ruido: nadie
        quiere leer "cambia de fecha: no" en cada edición. -#}
    {%- set silent_when_false = ['moved', 'relocated', 'again', 'opt_out'] -%}
    {#- Claves donde el booleano ES el hecho, y se dice con una frase entera en
        vez de un "clave: sí/no" que no se entiende. Índice 0 = false, 1 = true.

        Sin esto, retirar un área quedaba registrado como "Área editada · nombre:
        Obras" y el dato que importaba —que se retiró— se perdía: el filtro de
        arriba escondía TODOS los `false`, y en `active` el false es la noticia. -#}
    {%- set as_phrase = { 'active': ['queda retirada', 'vuelve a ofrecerse'] } -%}
    {%- set parts = [] -%}
    {%- for key, value in payload -%}
        {%- if value is null or (value is same as(false) and key in silent_when_false) -%}
            {#- fuera -#}
        {%- elseif as_phrase[key] is defined and (value is same as(true) or value is same as(false)) -%}
            {%- set parts = parts|merge([as_phrase[key][value ? 1 : 0]]) -%}
        {%- else -%}
            {%- if value is iterable -%}
                {%- set shown = value is empty ? 'nadie' : value|join(', ') -%}
            {%- elseif value is same as(true) -%}
                {%- set shown = 'sí' -%}
            {%- elseif value is same as(false) -%}
                {%- set shown = 'no' -%}
            {%- else -%}
                {%- set shown = values[value]|default(value) -%}
            {%- endif -%}
            {%- set parts = parts|merge([(labels[key]|default(key)) ~ ': ' ~ shown]) -%}
        {%- endif -%}
    {%- endfor -%}
    {{- parts|join(' · ') -}}
{% endmacro %}

{# ---------- CHECK ----------
 # Una casilla con su etiqueta AL LADO.
 #
 # No usa csa.field a propósito: aquella macro le pone `csa-input` al widget,
 # que fija alto y ancho de campo de texto, y un checkbox acaba siendo un
 # cuadrado enorme centrado y separado de su etiqueta. Se ve así hoy en
 # staff/_form (deuda preexistente); aquí no se replica.
 #
 #   {{ vol.check(form.remote, 'Se hace desde casa', 'si lo marcas se ignora el lugar') }}
 #}
{% macro check(field, label, hint = null) %}
    <div class="csa-field csa-field--full">
        <label class="vol-check" for="{{ field.vars.id }}">
            {{ form_widget(field) }}
            <span>
                {{ label }}
                {% if hint %}<span class="vol-check__hint">{{ hint }}</span>{% endif %}
            </span>
        </label>
        {% if not field.vars.valid %}
            <div class="csa-field__error">{{ form_errors(field) }}</div>
        {% endif %}
    </div>
{% endmacro %}


{# ---------- ESTADO DE UNA TAREA ----------
 # La insignia que resume en qué punto está una tarea.
 #
 # En una macro porque son SIETE ramas y se pintan en dos listados —el de tareas
 # y la ficha de un área—. Copiadas, el día que se añada un estado quedaría uno
 # de los dos diciendo otra cosa sobre la misma tarea, y eso no da error: sólo
 # miente.
 #
 # No es lo mismo que `VolunteerOffer::getPhase()`, y la diferencia es
 # deliberada. La fase responde "qué trabajo toca ahora" y gobierna la ficha;
 # esto responde "cómo salió", que es lo que se lee de un vistazo en una lista:
 # una tarea pasada a la que no fue nadie y otra que se cerró bien están en la
 # misma fase y no se parecen en nada.
 #
 #   {{ vol.task_status(offer, now) }}
 #}
{% macro task_status(offer, now) %}
    {% import '_macros/csa.html.twig' as ui %}
    {%- if offer.status == 'draft' -%}
        {{ ui.badge('Borrador', 'neutral') }}
    {%- elseif offer.status == 'cancelled' -%}
        {{ ui.badge('Anulada', 'terracotta') }}
    {%- elseif offer.wasMissed(now) -%}
        {{ ui.badge('No fue nadie', 'terracotta') }}
    {%- elseif offer.isDone(now) -%}
        {{ ui.badge('Hecha', 'green') }}
    {%- elseif offer.startsAt <= now -%}
        {{ ui.badge('Sin confirmar', 'ochre') }}
    {%- else -%}
        {{ ui.badge('Publicada', 'sky') }}
    {%- endif -%}
{% endmacro %}


{# ---------- PLAZAS DE UNA TAREA ----------
 # Cuánta gente hay de la que hace falta.
 #
 # Sin tope, "4" a secas se lee como "hay 4 plazas", así que se dice.
 #
 #   {{ vol.task_slots(offer) }}
 #}
{% macro task_slots(offer) %}
    {%- if offer.slots -%}
        {{ offer.filledSlots }} / {{ offer.slots }}
    {%- else -%}
        {{ offer.filledSlots }} <span class="vol-help">(sin tope)</span>
    {%- endif -%}
{% endmacro %}


{# ---------- DÓNDE SE HACE UNA TAREA ----------
 # Casa, punto de recogida o un lugar escrito a mano, en ese orden de precedencia
 # —el mismo que usa el modelo—.
 #
 #   {{ vol.task_place(offer) }}
 #}
{% macro task_place(offer) %}
    {%- if offer.remote %}Desde casa
    {%- elseif offer.node %}{{ offer.node }}
    {%- elseif offer.place %}{{ offer.place }}
    {%- else %}—{% endif -%}
{% endmacro %}
