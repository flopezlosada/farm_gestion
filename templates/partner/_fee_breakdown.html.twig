{# ============================================================
 # El desglose de una cuota calculada (FeeStatement), igual en la ficha
 # y en «Cuotas del mes»: qué cesta cuesta qué (y de quién es, si paga la
 # de otra persona), las cuotas de socix del mes, y cada ajuste con su motivo y A DÓNDE VA lo de más.
 #
 #   {% import 'partner/_fee_breakdown.html.twig' as bd %}
 #   {{ bd.styles() }}  una vez, dentro de <style>
 #   {{ bd.lines(statement) }}  {{ bd.adjustments(statement) }}
 # ============================================================ #}

{% macro styles() %}
    .fee-bd { margin: 0; padding: 0; list-style: none; font-size: 12.5px; line-height: 1.45; }
    .fee-bd li + li { margin-top: 2px; }
    .fee-bd__part { color: var(--prl-ochre-d, #8a6a1f); font-size: 11.5px; }
    .fee-bd__soft { color: var(--csa-ink-soft, #6b6b6b); }
    .fee-bd__to { color: var(--csa-ink-soft, #6b6b6b); font-size: 11.5px; white-space: nowrap; }
    .fee-rc { max-width: 400px; margin: 0; padding: 10px 14px 8px; border-radius: 8px; background: var(--csa-surface-alt, #f5f5f3);
              font-size: 13px; line-height: 1.45; font-variant-numeric: lining-nums tabular-nums; }
    .fee-rc__group + .fee-rc__group { margin-top: 10px; }
    .fee-rc__head { font-weight: 500; color: var(--csa-ink, #2b2b2b); margin-bottom: 2px; }
    .fee-rc__row { display: flex; align-items: baseline; gap: 10px; padding: 1px 0; }
    .fee-rc__row--sub { padding-left: 12px; }
    .fee-rc__name { color: var(--csa-ink, #2b2b2b); }
    .fee-rc__row--sub .fee-rc__name { color: var(--csa-ink-soft, #6b6b6b); }
    .fee-rc__calc { color: var(--csa-ink-faint, #999); font-size: 12px; white-space: nowrap; }
    .fee-rc__amount { margin-left: auto; white-space: nowrap; }
    .fee-rc__total { display: flex; align-items: baseline; margin-top: 8px; padding-top: 6px; border-top: 1px solid var(--csa-rule, #e6e4dd); }
    .fee-rc__total-label { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--csa-ink-faint, #999); }
    .fee-rc__total .fee-rc__amount { font-family: var(--csa-serif); font-variation-settings: "opsz" 30; font-weight: 500; font-size: 17px; letter-spacing: -0.02em; }
{% endmacro %}

{# Una fila del recibo: concepto, la cuenta en gris (si la hay) y el importe a la derecha. #}
{% macro receipt_row(name, calc, amount, sub) %}
    <div class="fee-rc__row{{ sub ? ' fee-rc__row--sub' }}">
        <span class="fee-rc__name">{{ name }}</span>
        {% if calc %}<span class="fee-rc__calc">{{ calc }}</span>{% endif %}
        <span class="fee-rc__amount">{{ amount }}</span>
    </div>
{% endmacro %}

{# El cálculo de la cuota del mes, como un recibo: cada cesta con sus partes y la cuenta de cada una (3 cestas × 15,00 €), las cuotas de socix y los ajustes del mes, y el total que da. #}
{% macro receipt(statement) %}
    {% import 'accounting/_money.html.twig' as fmt %}
    <div class="fee-rc">
        {% for l in statement.lines %}
            <div class="fee-rc__group">
                <div class="fee-rc__head">
                    {{ l.label }}
                    {% if l.share.partner != statement.payer %}<span class="fee-bd__soft">(de {{ l.share.partner.legalName }})</span>{% endif %}
                    {% if l.partial %}<span class="fee-bd__part">{{ l.partLabel }}</span>{% endif %}
                    {% if l.free %}<span class="fee-bd__part">gratis: cesta de trabajador</span>
                    {% elseif l.freeWeeks > 0 %}<span class="fee-bd__part">{{ l.freeWeeks }} {{ l.freeWeeks == 1 ? 'semana gratis' : 'semanas gratis' }} (cesta de trabajador)</span>{% endif %}
                </div>
                {% for p in l.parts %}
                    {{ _self.receipt_row(p.name, p.multiplied ? p.quantityLabel ~ ' × ' ~ (p.unitPrice|number_format(2, ',', '.')) ~ ' €' : null, fmt.money(p.total), true) }}
                {% else %}
                    {{ _self.receipt_row('Sin cargo', null, fmt.money(0), true) }}
                {% endfor %}
            </div>
        {% endfor %}
        {% if statement.charges is not empty or statement.adjustments is not empty %}
            <div class="fee-rc__group">
                {% for c in statement.charges %}
                    {{ _self.receipt_row(c.concept.label ~ (c.household != statement.payer ? ' (de ' ~ c.household.legalName ~ ')' : ''), null, c.missing ? 'sin precio' : fmt.money(c.total), false) }}
                {% endfor %}
                {% for a in statement.adjustments %}
                    {{ _self.receipt_row(a.reason|capitalize, a.increase ? '→ ' ~ (a.initiative ? a.initiative.name : 'para la asociación') : null, fmt.money(a.amount, true), false) }}
                {% endfor %}
            </div>
        {% endif %}
        <div class="fee-rc__total"><span class="fee-rc__total-label">Total del mes</span><span class="fee-rc__amount">{{ fmt.money(statement.total) }}</span></div>
    </div>
{% endmacro %}

{# Cada cesta: modalidad, importe, de quién es, si la tuvo parte del mes cuántas semanas, y si es de trabajador cuántas no se cobran. #}
{% macro lines(statement) %}
    {% import 'accounting/_money.html.twig' as fmt %}
    <ul class="fee-bd">
        {% for l in statement.lines %}
            {% set parts = [
                l.vegCents ? 'verdura ' ~ (l.vegCents / 100)|number_format(2, ',', '.') : null,
                l.eggCents ? 'huevos ' ~ (l.eggCents / 100)|number_format(2, ',', '.') : null,
                l.transportCents ? 'transporte ' ~ (l.transportCents / 100)|number_format(2, ',', '.') : null,
            ]|filter(p => p) %}
            <li>
                {{ l.label }} · <b>{{ fmt.money(l.total) }}</b>
                {% if l.share.partner != statement.payer %}<span class="fee-bd__soft">(de {{ l.share.partner.legalName }})</span>{% endif %}
                {% if l.partial %}<span class="fee-bd__part">{{ l.partLabel }}</span>{% endif %}
                {% if l.free %}<span class="fee-bd__part">gratis: cesta de trabajador</span>
                {% elseif l.freeWeeks > 0 %}<span class="fee-bd__part">{{ l.freeWeeks }} {{ l.freeWeeks == 1 ? 'semana gratis' : 'semanas gratis' }} (cesta de trabajador)</span>{% endif %}
                {% if parts|length > 1 %}<span class="fee-bd__soft">— {{ parts|join(' + ') }}</span>{% endif %}
            </li>
        {% endfor %}
        {# Las cuotas de socix del mes: inscripción el mes de la primera cesta, mantenimiento en junio y diciembre. #}
        {% for c in statement.charges %}
            <li>
                {{ c.concept.label }} · {% if c.missing %}<span class="fee-bd__part">sin precio</span>{% else %}<b>{{ fmt.money(c.total) }}</b>{% endif %}
                {% if c.household != statement.payer %}<span class="fee-bd__soft">(de {{ c.household.legalName }})</span>{% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{# Cada ajuste: importe con signo, motivo y, si paga de más, a qué iniciativa va o que es para la asociación. #}
{% macro adjustments(statement) %}
    {% import 'accounting/_money.html.twig' as fmt %}
    <ul class="fee-bd">
        {% for a in statement.adjustments %}
            <li>
                {{ fmt.money(a.amount, true) }} {{ a.reason }}
                {% if a.increase %}<span class="fee-bd__to">→ {{ a.initiative ? a.initiative.name : 'para la asociación' }}</span>{% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}
