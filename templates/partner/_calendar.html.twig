{# ============================================================
 # Calendario de recogida — partial compartido gestor / socio.
 #
 # Rejilla mensual (qué días recoge de un vistazo) + papelera (no recoge)
 # + panel del día seleccionado. Para cambiar un día se ARRASTRA en la
 # rejilla (día→papelera = no recoge; día→día libre = mover).
 #
 # Espera en contexto los datos del calendario (partner, slots, tray,
 # weeks, selected, selected_editable, current, prev, next, pickup_place)
 # y un objeto `cal` que desacopla las rutas/CSRF de cada pantalla:
 #   cal.route_view / route_skip / route_move / route_recover / route_reset
 #                  / route_extra_remove (quitar la cesta extra de un día; solo gestor)
 #   cal.idp        hash de parámetros de id ({id: ...} en gestor, {} en panel)
 #   cal.csrf_skip / csrf_move / csrf_reset / csrf_extra_remove   tokens ya calculados
 #   cal.readonly   true = solo lectura (sin arrastre, papelera, reset ni botones)
 #
 # R1: en cestas compartidas el día y el contenido los marca la
 # alternancia con el otro hogar — no hay acciones.
 # ============================================================ #}
{% import '_macros/csa.html.twig' as csa %}
{% set EGG = constant('App\\Entity\\BasketComponent::ID_EGGS') %}
{# ro = solo lectura total (sin acciones). dnd = capa de arrastrar y soltar (escritorio);
   el socio (móvil) edita por toques con los botones del panel, sin arrastre. #}
{% set ro = cal.readonly|default(false) %}
{% set dnd = cal.dnd|default(false) %}
{% set cg_all = cg_deliveries is defined ? cg_deliveries : [] %}
{# Icono por categoría del producto del pedido (FontAwesome 4). Categoría nueva sin
   entrada → cesta genérica. Mapa fijo: escalar = añadir aquí (o migrar a un campo en
   la categoría si crecen mucho). Clave = nombre de la categoría en minúsculas. #}
{% set CG_ICONS = {'aceite': 'fa-tint', 'verdura': 'fa-leaf', 'fruta': 'fa-lemon-o', 'legumbre': 'fa-circle-o', 'legumbres': 'fa-circle-o'} %}
{% set CG_ICON_DEFAULT = 'fa-shopping-basket' %}

{# Lista (solo lectura) de lo que lleva una entrega ese día. El contenido del día ya no
   se edita por componente: el modelo es "todo junto por día". #}
{% macro components(selected, EGG) %}
    {% for it in selected.items|sort((a, b) => a.component.id - b.component.id) %}
        {% set is_egg = it.component.id == EGG %}
        <div class="rcal-comp">
            <span class="rcal-comp__ic {{ is_egg ? 'egg' : 'veg' }}">{% if is_egg %}<span class="rcal-egg"></span>{% else %}<i class="fa fa-leaf"></i>{% endif %}</span>
            <span class="rcal-comp__t">
                <span class="rcal-comp__name">{{ is_egg ? 'Huevos' : 'Cesta de verdura' }}</span>
                <span class="rcal-comp__sub">{{ it.amount + 0 }} {{ is_egg ? 'docena' : 'cesta' }}{{ (it.amount + 0) != 1 ? 's' }}</span>
            </span>
        </div>
    {% else %}
        <p class="csa-muted">Sin componentes.</p>
    {% endfor %}
{% endmacro %}

{# Filas del/los pedido(s) del grupo de consumo de un día, en el MISMO formato que la
   cesta/huevos (icono redondo por categoría + producto + cantidad·productor). Se pintan
   dentro de "Qué se lleva ese día", después de los huevos. `with_header` pone el
   encabezado cuando el día no tiene cesta (saltado/cerrado/solo-pedido) y por tanto no
   lo puso ya la lista de la cesta. #}
{% macro cg_rows(cg_today, icons, icon_default, with_header) %}
    {% if cg_today is not empty %}
        {% if with_header %}<div class="rcal-sect">Qué se lleva ese día</div>{% endif %}
        {% for d in cg_today %}
            {% for line in d.order.lines %}
                {% if line.quantity > 0 %}
                    {% set cat = line.product and line.product.category ? line.product.category.name|lower : '' %}
                    <div class="rcal-comp">
                        <span class="rcal-comp__ic cg"><i class="fa {{ icons[cat]|default(icon_default) }}"></i></span>
                        <span class="rcal-comp__t">
                            <span class="rcal-comp__name">{{ line.roundItem.name }}</span>
                            <span class="rcal-comp__sub">{{ line.quantity|number_format(2, ',', '.') }} {{ line.roundItem.unit }}{% if d.order.round.producer %} · {{ d.order.round.producer.name }}{% endif %}</span>
                        </span>
                    </div>
                {% endif %}
            {% endfor %}
        {% endfor %}
        <p class="csa-muted rcal-cgnote">
            {{ (cg_today|first).withBasket ? 'Pedido del grupo de consumo, se entrega junto a tu cesta.' : 'Pedido del grupo de consumo, se entrega en tu punto de recogida.' }}
            La fecha la fija el grupo y no se puede cambiar.
        </p>
    {% endif %}
{% endmacro %}

{# Marcadores de pedido para una celda de la rejilla: un iconito por pedido, con el icono
   de la categoría de su primer producto (distinto por tipo). #}
{% macro cg_cell_marks(cg_here, icons, icon_default) %}
    {% if cg_here is not empty %}
        <span class="rcal-mk rcal-mk--cg">
            {% for d in cg_here %}
                {% set fl = d.order.lines|filter(l => l.quantity > 0)|first %}
                {% set cat = fl and fl.product and fl.product.category ? fl.product.category.name|lower : '' %}
                <span class="rcal-mk__i cg" title="Pedido del grupo de consumo{% if d.order.round.producer %} · {{ d.order.round.producer.name }}{% endif %}"><i class="fa {{ icons[cat]|default(icon_default) }}"></i></span>
            {% endfor %}
        </span>
    {% endif %}
{% endmacro %}

{% if partner.sharePartner %}
    {# El texto dice lo que se puede hacer HOY, y eso cambió: la cesta ya se mueve, pero
       con las dos mitades a la vez. Para el socix es una petición al otro hogar; para
       quien gestiona, un cambio que arrastra a los dos. Lo que sigue sin poderse es
       saltarse la semana: con media cesta sin dueño en el punto no está decidido qué se
       hace, y eso lo decide la asociación, no el software. #}
    {% if cal.shared_needs_consent|default(false) %}
        {{ csa.callout('Esta cesta es compartida con ' ~ (cal.shared_other_name|default('otro hogar')) ~ ': para cambiarla de día se lo pides y lo acepta. Los huevos son tuyos y los mueves sin preguntar. Para no recoger una semana, escribe a administración.', 'info', 'info-circle') }}
    {% else %}
        {{ csa.callout('Cesta compartida: al cambiarla de día se mueven las dos mitades y se avisa a los dos hogares. Los huevos van por separado (cada hogar los suyos).', 'info', 'info-circle') }}
    {% endif %}
{% endif %}

{# Banner del modo "mover por toque" (socio, sin arrastre): aparece al pulsar
   "Mover a otra fecha" y guía a tocar el día destino. #}
{# También en compartidas: con el dedo no se arrastra, y sin este modo la única vía de quien
   aplica el cambio sería un ratón. #}
{% if not ro and cal.route_move is defined %}
    <div id="rcal-move-banner" class="rcal-movebanner" hidden>
        <span><i class="fa fa-hand-o-up"></i> Toca el día (resaltado) al que quieres mover la cesta.</span>
        <button type="button" id="rcal-move-cancel" class="csa-btn csa-btn--ghost csa-btn--sm">Cancelar</button>
    </div>
{% endif %}

<div class="rcal" data-rcal-view-year="{{ current.format('Y') }}" data-rcal-view-month="{{ current.format('n') }}">

    <div class="rcal-left">

    {# ===== REJILLA ===== #}
    <div class="rcal-grid" data-rcal-drop="grid">

        {# Cabecera: navegación de mes (izquierda) + reset (derecha), dentro de la tarjeta. #}
        <div class="rcal-cal-hd">
            <div class="rcal-nav">
                <a class="rcal-navbtn" href="{{ path(cal.route_view, cal.idp|merge({ year: prev.format('Y'), month: prev.format('n') })) }}"
                   aria-label="Mes anterior" title="Mes anterior"><i class="fa fa-chevron-left"></i></a>
                <a class="rcal-navbtn" href="{{ path(cal.route_view, cal.idp|merge({ year: next.format('Y'), month: next.format('n') })) }}"
                   aria-label="Mes siguiente" title="Mes siguiente"><i class="fa fa-chevron-right"></i></a>
                <span class="rcal-month">{{ current|format_datetime('none', 'none', pattern='LLLL yyyy', locale='es') }}</span>
            </div>

            {# Reset del mes a su patrón: red de seguridad para estados enredados. No en
               compartidas (R1) ni en solo lectura. Recarga normal (no AJAX): es una acción
               rara y conviene ver el mes limpio de cero. #}
            {% if cal.route_reset is defined and partner.sharePartner is null and not ro %}
                <form id="rcal-reset-form" action="{{ path(cal.route_reset, cal.idp) }}" method="post" class="rcal-resetform">
                    <input type="hidden" name="_csrf_token" value="{{ cal.csrf_reset }}">
                    <input type="hidden" name="year" value="{{ current.format('Y') }}">
                    <input type="hidden" name="month" value="{{ current.format('n') }}">
                    <button type="button" class="csa-btn csa-btn--ghost csa-btn--sm"
                            onclick="document.getElementById('rcal-confirm-reset').showModal()">
                        <i class="fa fa-rotate-left"></i><span>Resetear el mes</span>
                    </button>
                </form>
                {{ csa.confirm_dialog('rcal-confirm-reset', {
                    variant: 'warning',
                    eyebrow: 'Resetear mes',
                    title: '¿Resetear el calendario de este mes?',
                    body: 'Se deshacen los cambios puntuales (mover, no recoger, recuperar) de ' ~ (current|format_datetime('none', 'none', pattern='LLLL yyyy', locale='es')) ~ ' y las entregas vuelven a su patrón. Úsalo si algo quedó descuadrado.',
                    confirm_label: 'Resetear',
                    external_form_id: 'rcal-reset-form',
                }) }}
            {% endif %}
        </div>

        <div class="rcal-body">
        <div class="rcal-dow"><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span></div>
        <div class="rcal-weeks">
            {% for week in weeks %}
                {% for day in week %}
                    {% set slot = day.slot %}
                    {% set is_sel = slot and selected and slot.basket.id == selected.basket.id %}
                    {% set wknd = day.date.format('N') in [6, 7] %}
                    {% set is_today = day.date.format('Y-m-d') == date('today').format('Y-m-d') %}
                    {% set cg_here = cg_all|filter(d => d.order.round.deliveryDate and d.order.round.deliveryDate|date('Y-m-d') == day.date|date('Y-m-d')) %}
                    {% if slot and slot.closed|default(false) %}
                        {# Semana CERRADA (excepción de cancelación: festivo/vacaciones). No
                           hay reparto para nadie. Gris, no arrastrable ni editable; navegable
                           para que el panel explique el cierre. #}
                        <a href="{{ path(cal.route_view, cal.idp|merge({ year: slot.basket.date.format('Y'), month: slot.basket.date.format('n'), sel: slot.basket.id })) }}"
                           class="rcal-cell rcal-closed{{ is_sel ? ' sel' }}{{ not day.inMonth ? ' out' }}">
                            <span class="n">{{ day.date.format('j') }}</span>
                            <span class="x"><i class="fa fa-lock"></i></span>
                        </a>
                    {% elseif slot %}
                        {# Rojo si se le han quitado todos los componentes (no recoge nada).
                           Las "no recoge" (saltadas) ya NO llegan aquí: viven en la papelera
                           y su día sale libre. #}
                        {% set no_pickup = slot.items is empty %}
                        {# Una entrega real y futura se puede TOCAR mientras la pantalla no sea
                           de solo lectura. De ahí salen dos permisos distintos, y hay que
                           separarlos porque la cesta compartida tiene uno y no el otro. #}
                        {% set day_future = not no_pickup and slot.date > date('today') and not ro %}
                        {# ACUMULABLE: destino de un "traslado sumando" (ese día pasa a llevar dos
                           cestas). En una compartida no se ofrece — media cesta duplicada no es
                           una cesta, y qué se monta ese día es decisión del reparto. #}
                        {% set day_editable = day_future and partner.sharePartner is null %}
                        {# ARRASTRABLE: sólo en escritorio (`dnd`). En compartidas, sólo para quien
                           APLICA el cambio —administración—, no para quien lo PIDE: soltar una cesta
                           en otro día es un gesto que da por hecho el resultado, y desde el panel del
                           socix el resultado es "se lo hemos preguntado al otro hogar y ya veremos".
                           Eso no cabe en un arrastre; ahí la vía es la lista de botones, que lo dice.
                           Quien sí lo aplica arrastra, y al soltar confirma: mueve también al otro
                           hogar y le manda un aviso. La papelera no acepta ninguna de las dos,
                           porque "no recoger" sigue sin poder hacerse en una compartida. #}
                        {% set day_grab = day_future and dnd and (partner.sharePartner is null or not cal.shared_needs_consent|default(false)) %}
                        {# Se navega al mes LÓGICO del Basket (su viernes-ciclo), que para las
                           entregas del mes coincide con el visible, pero para una que se cuela
                           por fecha física desde un mes vecino es donde el panel la resuelve. #}
                        <a href="{{ path(cal.route_view, cal.idp|merge({ year: slot.basket.date.format('Y'), month: slot.basket.date.format('n'), sel: slot.basket.id })) }}"
                           class="rcal-cell {{ no_pickup ? 'rcal-skip' : 'rcal-pick' }}{{ is_sel ? ' sel' }}{{ is_today ? ' rcal-today' }}{{ day_grab ? ' rcal-grab' }}{{ not day.inMonth ? ' out' }}"
                           {% if day_editable %}data-rcal-accumulate-to="{{ slot.basket.id }}" data-rcal-accumulate-date="{{ slot.date|format_date(pattern='EEEE d MMM', locale='es') }}"{% endif %}
                           {% if day_grab %}draggable="true" data-rcal-draggable data-rcal-kind="grid" data-rcal-skip-url="{{ path(cal.route_skip, cal.idp|merge({ basketId: slot.basket.id })) }}" data-rcal-move-url="{{ path(cal.route_move, cal.idp|merge({ basketId: slot.basket.id })) }}"{% if partner.sharePartner %} data-rcal-shared="{{ cal.shared_other_name|default('el otro hogar') }}"{% endif %}{% endif %}>
                            <span class="n">{{ day.date.format('j') }}</span>
                            {% if is_today %}<span class="rcal-today-tag">hoy</span>{% endif %}
                            {% if day_grab %}<span class="rcal-grip" title="{{ partner.sharePartner ? 'Arrastra para cambiar el día (mueve las dos mitades)' : 'Arrastra para mover o no recoger' }}"><i class="fa fa-arrows"></i></span>{% endif %}
                            {% if no_pickup %}
                                <span class="x"><i class="fa fa-ban"></i></span>
                            {% else %}
                                {# Marcadores de producto. Orden fijo por id de componente (verdura,
                                   huevos): si no, al quitar y re-añadir se desordenan. #}
                                <span class="rcal-mk">
                                    {% for item in slot.items|sort((a, b) => a.component.id - b.component.id) %}
                                        {% if item.component.id == EGG %}
                                            <span class="rcal-mk__i egg" title="Huevos"><span class="rcal-egg"></span></span>
                                        {% else %}
                                            <span class="rcal-mk__i veg" title="Verdura"><i class="fa fa-leaf"></i></span>
                                        {% endif %}
                                    {% endfor %}
                                </span>
                            {% endif %}
                            {{ _self.cg_cell_marks(cg_here, CG_ICONS, CG_ICON_DEFAULT) }}
                        </a>
                    {% else %}
                        {# Celda libre. Si el nodo reparte ese día (dropBasketId) y no es solo
                           lectura, es destino válido para soltar una entrega arrastrada (mover).
                           Si además hay pedido del grupo de consumo ese día, se marca con su
                           iconito; y si el día es una entrega SALTADA (papelera), se hace
                           navegable para poder ver el pedido en el panel. #}
                        {# Un día sin cesta pero CON pedido también debe poder pincharse para ver
                           "qué se lleva ese día". Dos vías según por qué no hay cesta:
                           (a) la entrega está SALTADA (en la papelera) → sigue teniendo Basket,
                               se navega por `sel` a su slot saltado;
                           (b) la socia no recibe cesta esa semana → no hay slot, se navega por
                               fecha (`seld`) y el panel dibuja un panel solo-pedido. #}
                        {% set cg_skip = cg_here is not empty ? (tray|default([])|filter(t => t.date|date('Y-m-d') == day.date|date('Y-m-d'))|first) : null %}
                        {% set cg_day_sel = cg_selected_date is defined and cg_selected_date and cg_selected_date == day.date|date('Y-m-d') %}
                        {% if cg_here is not empty %}
                            <a href="{{ path(cal.route_view, cal.idp|merge(cg_skip ? { year: day.date.format('Y'), month: day.date.format('n'), sel: cg_skip.basket.id } : { year: day.date.format('Y'), month: day.date.format('n'), seld: day.date|date('Y-m-d') })) }}"
                               class="rcal-cell empty rcal-cg-day{{ cg_day_sel ? ' sel' }}{{ not day.inMonth ? ' out' }}{{ wknd ? ' wknd' }}{{ is_today ? ' rcal-today' }}">
                                <span class="n">{{ day.date.format('j') }}</span>
                                {% if is_today %}<span class="rcal-today-tag">hoy</span>{% endif %}
                                {{ _self.cg_cell_marks(cg_here, CG_ICONS, CG_ICON_DEFAULT) }}
                            </a>
                        {% else %}
                            <div class="rcal-cell empty{{ not day.inMonth ? ' out' }}{{ wknd ? ' wknd' }}{{ is_today ? ' rcal-today' }}"
                                 {% if day.dropBasketId and not ro %}data-rcal-target data-rcal-to="{{ day.dropBasketId }}" data-rcal-to-date="{{ day.date|format_date(pattern='EEEE d MMM', locale='es') }}"{% endif %}>
                                <span class="n">{{ day.date.format('j') }}</span>
                                {% if is_today %}<span class="rcal-today-tag">hoy</span>{% endif %}
                            </div>
                        {% endif %}
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </div>
        <div class="rcal-legend">
            <span class="lg"><span class="rcal-mk__i veg"><i class="fa fa-leaf"></i></span>Verdura</span>
            <span class="lg"><span class="rcal-mk__i egg"><span class="rcal-egg"></span></span>Huevos</span>
            {% if cg_all is not empty %}<span class="lg"><span class="rcal-mk__i cg"><i class="fa fa-shopping-basket"></i></span>Pedido</span>{% endif %}
        </div>
        </div>{# /.rcal-body #}
    </div>{# /.rcal-grid #}

    {# ===== PAPELERA (no recoge, recuperable) ===== #}
    {% if partner.sharePartner is null and not ro %}
    <div class="rcal-tray" data-rcal-drop="tray">
        <div class="rcal-tray__hd">
            <span class="rcal-tray__ic"><i class="fa fa-inbox"></i></span>
            <span class="rcal-tray__txt">
                <span class="rcal-tray__title">No recoge</span>
                <span class="rcal-tray__hint">
                    <span class="rcal-dragonly">Arrastra un día aquí para no recogerlo · o saca uno (a un día libre) para recuperarlo</span>
                    <span class="rcal-tapmove">Estas semanas no las recoges. Toca una para volver a recogerla.</span>
                </span>
            </span>
        </div>
        <div class="rcal-tray__body">
            {# La tarjeta es SIEMPRE un enlace (tocar = seleccionar ese día → "Volver a recoger",
               flujo móvil) y ADEMÁS arrastrable si la pantalla permite recuperar a un día elegido
               (escritorio: arrastrar la ficha a un día libre). #}
            {% for t in tray %}
                {% set t_grab = t.date > date('today') and cal.route_recover is defined %}
                <a class="rcal-tray-card{{ t_grab ? ' rcal-grab' }}"
                   href="{{ path(cal.route_view, cal.idp|merge({ year: t.basket.date.format('Y'), month: t.basket.date.format('n'), sel: t.basket.id })) }}"
                   {% if t_grab %}draggable="true" data-rcal-draggable data-rcal-kind="tray" data-rcal-skip-url="{{ path(cal.route_skip, cal.idp|merge({ basketId: t.basket.id })) }}" data-rcal-recover-url="{{ path(cal.route_recover, cal.idp|merge({ basketId: t.basket.id })) }}"{% endif %}>
                    <span class="rcal-tray-card__ic"><i class="fa fa-ban"></i></span>
                    <span class="rcal-tray-card__d">{{ t.date|format_date(pattern='EEE d MMM', locale='es') }}</span>
                </a>
            {% else %}
                <p class="rcal-tray__empty">Nada aparcado este mes.</p>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    </div>{# /.rcal-left #}

    {# ===== PANEL DEL DÍA SELECCIONADO ===== #}
    <div class="rcal-panel">
        {% set cg_day = cg_selected_date is defined and cg_selected_date
            ? cg_all|filter(d => d.order.round.deliveryDate and d.order.round.deliveryDate|date('Y-m-d') == cg_selected_date)
            : [] %}
        {% if cg_day is not empty %}
            {# Día SIN cesta pero con pedido: panel solo-pedido (se llegó pinchando el día,
               por `seld`). La entrega es fija; no hay acciones de cesta. #}
            <div class="rcal-panel__hd">
                <div class="rcal-panel__eyebrow"><i class="fa fa-shopping-basket"></i> Recoges</div>
                <div class="rcal-panel__day">{{ date(cg_selected_date)|format_date('full', locale='es')|capitalize }}</div>
                {% if pickup_place %}<div class="rcal-panel__where"><i class="fa fa-map-marker"></i>Recoge en {{ pickup_place }}</div>{% endif %}
            </div>
            <div class="rcal-panel__bd">
                {{ _self.cg_rows(cg_day, CG_ICONS, CG_ICON_DEFAULT, true) }}
            </div>
        {% elseif selected %}
            {% set bid = selected.basket.id %}
            {# Pedido(s) del grupo de consumo que se entregan el día seleccionado. #}
            {% set cg_today = cg_all|filter(d => d.order.round.deliveryDate and d.order.round.deliveryDate|date('Y-m-d') == selected.date|date('Y-m-d')) %}
            {# Vacío = sin componentes y no saltada explícitamente: no recoge nada. #}
            {% set is_empty = not selected.skipped and selected.items is empty %}
            {% set is_closed = selected.closed|default(false) %}
            {% set is_skip = not is_closed and (selected.skipped or is_empty) %}
            {# Solo-lectura: el flag de pantalla (ro), compartidas (R1) y entregas pasadas. #}
            {% set readonly = ro or partner.sharePartner is not null or not selected_editable %}

            <div class="rcal-panel__hd{{ is_closed ? ' is-closed' : (is_skip ? ' is-skip') }}">
                <div class="rcal-panel__eyebrow">
                    {% if is_closed %}<i class="fa fa-lock"></i> Semana cerrada
                    {% elseif is_skip %}<i class="fa fa-ban"></i> No recoge
                    {% else %}<i class="fa fa-leaf"></i> Recoges
                    {% endif %}
                </div>
                <div class="rcal-panel__day">{{ selected.date|format_date('full', locale='es')|capitalize }}</div>
                {# El lugar es el del slot seleccionado: si esa semana está trasladada a otro
                   nodo (PartnerNodeOverride), el slot trae su nodo destino; si no, el de casa. #}
                {% set where = selected.pickup_place|default(pickup_place) %}
                {% if where and not is_skip and not is_closed %}
                    <div class="rcal-panel__where">
                        <i class="fa fa-map-marker"></i>Recoge en {{ where }}
                        {% if selected.relocated|default(false) %}<span class="rcal-panel__reloc">· trasladada esta semana</span>{% endif %}
                    </div>
                {% endif %}
            </div>

            {% if is_closed %}
                {# Semana CERRADA por excepción de calendario (festivo/vacaciones): no hay
                   reparto para nadie. No editable — el cierre se gestiona desde Excepciones
                   de reparto, no aquí. #}
                <div class="rcal-panel__bd">
                    <div class="rcal-sect"><i class="fa fa-lock"></i> Semana cerrada</div>
                    <p class="csa-muted">El {{ selected.date|format_date('long', locale='es') }} no hay reparto (excepción de calendario). No se recoge nada esa semana y no sale en el listado.</p>
                </div>
            {% elseif selected.skipped %}
                {# Saltada: no lleva nada esa semana; si es editable, se puede restaurar.
                   Una cesta movida que se marca "no recoge" también cae aquí. #}
                <div class="rcal-panel__bd">
                    <div class="rcal-sect">Esta semana no recoge</div>
                    <p class="csa-muted">La entrega del {{ selected.date|format_date('long', locale='es') }} está marcada como NO recogida y no saldrá en el reparto.</p>
                </div>
                {% if not readonly %}
                    <div class="rcal-panel__ft">
                        <form action="{{ path(cal.route_skip, cal.idp|merge({ basketId: bid })) }}" method="post" style="margin: 0;" data-rcal-ajax>
                            <input type="hidden" name="_csrf_token" value="{{ cal.csrf_skip }}">
                            <input type="hidden" name="recover" value="1">
                            <button type="submit" class="rcal-switch" aria-pressed="false">
                                <span class="rcal-switch__track"><span class="rcal-switch__knob"></span></span>
                                <span class="rcal-switch__txt">
                                    <span class="rcal-switch__label">No recoge esta semana</span>
                                    <span class="rcal-switch__sub">Enciéndelo para volver a recoger</span>
                                </span>
                            </button>
                        </form>
                    </div>
                {% endif %}
            {% else %}
                {# Entrega activa. El contenido es de solo lectura: para cambiar el día se
                   ARRASTRA en la rejilla (a la papelera = no recoge; a un día libre = mover).
                   El botón de abajo es un atajo accesible para "no recoge". #}
                <div class="rcal-panel__bd">
                    {% if is_empty and not readonly %}
                        <div class="rcal-empty-note"><i class="fa fa-ban"></i> Esta semana no recoge nada.</div>
                    {% endif %}
                    <div class="rcal-sect">Qué se lleva ese día</div>

                    {{ _self.components(selected, EGG) }}
                    {# El pedido se lista aquí, como una fila más después de los huevos. #}
                    {{ _self.cg_rows(cg_today, CG_ICONS, CG_ICON_DEFAULT, false) }}

                    {# AÑADIDO de esa semana. Las cantidades de arriba ya lo incluyen y no se
                       distinguen de las de patrón, así que este bloque es la única vía para
                       deshacerlo. Dos casos DISTINTOS, con acciones distintas:
                        (a) CESTAS TRASLADADAS sumando desde otros días (accumulated_from): hay
                            que DEVOLVERLAS a su semana, no solo quitar el añadido — su semana
                            de origen está vaciada y nadie las recolocaría. Un gesto.
                        (b) CESTA EXTRA genuina, puesta a mano por gestión: se quita y punto.
                            El socix no la toca (no la puso él); solo aparece con
                            route_extra_remove, que es del gestor.
                       No usan `readonly`: en compartidas también valen, porque el añadido no
                       elige el día de la cesta (lo que veta R1). #}
                    {% set accumulated_from = selected.accumulated_from|default([]) %}
                    {% if accumulated_from is not empty and not ro and selected_editable and cal.route_undo_accumulate is defined %}
                        {% set many = accumulated_from|length > 1 %}
                        {% set origins = accumulated_from|map(d => d|format_date(pattern='d MMM', locale='es'))|join(', ') %}
                        <div class="rcal-extra" style="margin-top: var(--csa-sp-4);">
                            <div class="rcal-sect"><i class="fa fa-compress"></i> {{ many ? 'Lleva cestas trasladadas' : 'Lleva una cesta trasladada' }}</div>
                            <p class="csa-muted">Este día suma {{ many ? 'las cestas' : 'la cesta' }} del <strong>{{ origins }}</strong>. Al deshacerlo, {{ many ? 'cada cesta vuelve' : 'la cesta vuelve' }} a su semana y este día se queda con la que le toca.</p>
                            <form id="rcal-undoacc-form-{{ bid }}" action="{{ path(cal.route_undo_accumulate, cal.idp|merge({ basketId: bid })) }}" method="post" style="margin: 0;">
                                <input type="hidden" name="_csrf_token" value="{{ cal.csrf_undo_accumulate }}">
                                <input type="hidden" name="view_year" value="{{ current.format('Y') }}">
                                <input type="hidden" name="view_month" value="{{ current.format('n') }}">
                                <button type="button" class="csa-btn csa-btn--secondary csa-btn--block"
                                        onclick="document.getElementById('rcal-confirm-undoacc-{{ bid }}').showModal()">
                                    <i class="fa fa-undo"></i><span>{{ many ? 'Deshacer los traslados' : 'Deshacer el traslado' }}</span>
                                </button>
                            </form>
                            {{ csa.confirm_dialog('rcal-confirm-undoacc-' ~ bid, {
                                variant: 'warning',
                                eyebrow: 'Traslado sumando',
                                title: many ? '¿Devolver esas cestas a sus semanas?' : '¿Devolver esa cesta a su semana?',
                                body: (many ? 'Las cestas del ' : 'La cesta del ') ~ origins ~ ' vuelven a su semana y el ' ~ (selected.date|date('d/m/Y')) ~ ' se queda con la que le toca. Si ese día tenía además una cesta extra puesta a mano, también se retira y habrá que volver a añadirla.',
                                confirm_label: many ? 'Devolverlas' : 'Devolverla',
                                external_form_id: 'rcal-undoacc-form-' ~ bid,
                            }) }}
                        </div>
                    {% elseif selected.extra|default(false) and not ro and selected_editable and cal.route_extra_remove is defined %}
                        <div class="rcal-extra" style="margin-top: var(--csa-sp-4);">
                            <div class="rcal-sect"><i class="fa fa-plus-circle"></i> Lleva una cesta extra</div>
                            <p class="csa-muted">Parte de lo de arriba es un añadido puntual de esta semana. Si lo quitas, queda solo lo que le toca por su cesta.</p>
                            <form id="rcal-extra-form-{{ bid }}" action="{{ path(cal.route_extra_remove, cal.idp|merge({ basketId: bid })) }}" method="post" style="margin: 0;">
                                <input type="hidden" name="_csrf_token" value="{{ cal.csrf_extra_remove }}">
                                <input type="hidden" name="view_year" value="{{ current.format('Y') }}">
                                <input type="hidden" name="view_month" value="{{ current.format('n') }}">
                                <button type="button" class="csa-btn csa-btn--secondary csa-btn--block"
                                        onclick="document.getElementById('rcal-confirm-extra-{{ bid }}').showModal()">
                                    <i class="fa fa-times"></i><span>Quitar la cesta extra</span>
                                </button>
                            </form>
                            {{ csa.confirm_dialog('rcal-confirm-extra-' ~ bid, {
                                variant: 'warning',
                                eyebrow: 'Cesta extra',
                                title: '¿Quitar la cesta extra de esa semana?',
                                body: 'Se quita el añadido puntual del ' ~ (selected.date|date('d/m/Y')) ~ ' y queda solo lo que le toca por su cesta.',
                                confirm_label: 'Quitar la extra',
                                external_form_id: 'rcal-extra-form-' ~ bid,
                            }) }}
                        </div>
                    {% endif %}

                    {# COMPARTIDAS — NO RECOGER HUEVOS: interruptor on/off de los huevos de esa
                       semana. Solo si el patrón contempla huevos ahí (EGG en 'available') y con la
                       feature activa (cal.egg_move + ruta del toggle). La cesta sigue bloqueada. #}
                    {% if partner.sharePartner and not ro and selected_editable and cal.egg_move|default(false) and cal.route_egg_toggle is defined %}
                        {% set egg_available = false %}
                        {% for c in selected.available|default([]) %}{% if c.id == EGG %}{% set egg_available = true %}{% endif %}{% endfor %}
                        {% if egg_available %}
                            {% set egg_present = false %}
                            {% for it in selected.items %}{% if it.component.id == EGG %}{% set egg_present = true %}{% endif %}{% endfor %}
                            <form action="{{ path(cal.route_egg_toggle, cal.idp|merge({ basketId: bid, componentId: EGG })) }}" method="post" style="margin-top: var(--csa-sp-3);">
                                <input type="hidden" name="_csrf_token" value="{{ cal.csrf_egg_toggle }}">
                                <button type="submit" class="rcal-switch" aria-pressed="{{ egg_present ? 'true' : 'false' }}">
                                    <span class="rcal-switch__track"><span class="rcal-switch__knob"></span></span>
                                    <span class="rcal-switch__txt">
                                        <span class="rcal-switch__label">{{ egg_present ? 'Recoge los huevos esta semana' : 'No recoge los huevos esta semana' }}</span>
                                        <span class="rcal-switch__sub">{{ egg_present ? 'Apágalo para no recoger los huevos (la cesta no cambia)' : 'Enciéndelo para volver a recogerlos' }}</span>
                                    </span>
                                </button>
                            </form>
                        {% endif %}
                    {% endif %}

                    {# COMPARTIDAS: la cesta no se mueve (R1, alternancia con el otro hogar), pero
                       los HUEVOS sí (cada hogar los suyos). Selector de fecha destino → mueve SOLO
                       el componente huevos (component_id=EGG) por el endpoint de mover. Se muestra
                       aunque el panel esté en "readonly" (que en compartidas está siempre puesto),
                       si la entrega es futura y este día lleva huevos. #}
                    {% if partner.sharePartner and not ro and selected_editable and has_egg_drop_targets|default(false) and cal.route_move is defined and cal.egg_move|default(false) %}
                        {% set sel_has_eggs = false %}
                        {% for it in selected.items %}{% if it.component.id == EGG %}{% set sel_has_eggs = true %}{% endif %}{% endfor %}
                        {% if sel_has_eggs %}
                            <div class="rcal-eggmove" style="margin-top: var(--csa-sp-4);">
                                <div class="rcal-sect"><span class="rcal-mk__i egg"><span class="rcal-egg"></span></span> Mover los huevos a otra fecha</div>
                                {# "Sólo los huevos" sigue siendo el sentido del bloque, pero ya no
                                   porque la cesta no pueda moverse —puede, con las dos mitades— sino
                                   porque los huevos son de cada hogar y van por su cuenta. #}
                                <p class="csa-muted">Los huevos son tuyos y se mueven solos, sin tocar la cesta ni al otro hogar. Elige el día:</p>
                                {# Un botón por fecha destino (son pocas): evita el <select> nativo, cuya lista
                                   desplegada la dibuja el SO y no se puede estilar. Cada botón postea su
                                   to_basket_id (el valor del submit pulsado). #}
                                <form action="{{ path(cal.route_move, cal.idp|merge({ basketId: bid })) }}" method="post" class="rcal-eggmove__form">
                                    <input type="hidden" name="_csrf_token" value="{{ cal.csrf_move }}">
                                    <input type="hidden" name="component_id" value="{{ EGG }}">
                                    <input type="hidden" name="view_year" value="{{ current.format('Y') }}">
                                    <input type="hidden" name="view_month" value="{{ current.format('n') }}">
                                    {% for t in egg_drop_targets|default([]) %}
                                        <button type="submit" name="to_basket_id" value="{{ t.basketId }}"
                                                class="csa-btn csa-btn--secondary csa-btn--block" style="margin-bottom: var(--csa-sp-2);">
                                            {# "Mover los huevos", no "Mover": al lado hay otra lista de
                                               fechas para la cesta, y con el mismo rótulo las dos son
                                               indistinguibles — el mismo día aparecía dos veces
                                               diciendo lo mismo y haciendo cosas distintas. #}
                                            <i class="fa fa-arrows"></i> Mover los huevos al {{ t.date|format_date(pattern='EEEE d MMM', locale='es') }}
                                        </button>
                                    {% endfor %}
                                </form>
                            </div>
                        {% endif %}
                    {% endif %}

                    {# COMPARTIDAS — MOVER LA CESTA. La cesta es UNA y se parte entre dos hogares,
                       así que su día no lo decide ninguno de los dos por su cuenta: o lo aplica
                       administración (que ya ha hablado con ellos), o lo pide un hogar y lo acepta
                       el otro.

                       EN LAS DOS PANTALLAS Y SIEMPRE VISIBLE, igual que el bloque de los huevos de
                       justo encima. Estuvo un rato sólo para quien pide, y quien aplicaba se quedaba
                       con un aviso pequeño de "arrastra este día": los huevos tenían su bloque con su
                       botón y la cesta no tenía nada, que es una asimetría que no se sostiene — y en
                       una pantalla táctil, directamente, no había forma de cambiar el día.

                       Lo que hubo que arreglar no era tener dos listas, era que las dos decían "Mover
                       al viernes 18 sept" sin decir QUÉ movían. Con "la cesta" y "los huevos" en el
                       rótulo, cada una se lee por lo que hace. El arrastre sigue existiendo en
                       escritorio como atajo. #}
                    {% if partner.sharePartner and not ro and selected_editable and cal.route_shared_move is defined and has_drop_targets|default(false) %}
                        {# Las dos pantallas mandan la semana de forma distinta: la del gestor la
                           lleva en la ruta, la del socix en el cuerpo (su endpoint no la tiene en
                           el path). Se resuelve aquí, con el día que se está pintando. #}
                        {% set shared_action = cal.shared_move_in_path|default(false)
                            ? path(cal.route_shared_move, cal.idp|merge({ basketId: bid }))
                            : path(cal.route_shared_move) %}
                        <div class="rcal-eggmove" style="margin-top: var(--csa-sp-4);">
                            <div class="rcal-sect"><i class="fa fa-arrows"></i> Cambiar el día de la cesta</div>
                            {% if cal.shared_needs_consent|default(false) %}
                                <p class="csa-muted">
                                    La cesta la compartes con {{ cal.shared_other_name|default('el otro hogar') }}: elige el día que te vendría bien y se lo pedimos. No cambia nada hasta que conteste.
                                </p>
                                {# Cada botón manda la PETICIÓN. Sin confirmación: esto no cambia el
                                   reparto, sólo pregunta al otro hogar, y el párrafo de arriba lo dice. #}
                                <form action="{{ shared_action }}" method="post" class="rcal-eggmove__form">
                                    <input type="hidden" name="_csrf_token" value="{{ cal.csrf_shared_move }}">
                                    <input type="hidden" name="basket_id" value="{{ bid }}">
                                    {% for t in drop_targets|default([]) %}
                                        <button type="submit" name="to_basket_id" value="{{ t.basketId }}"
                                                class="csa-btn csa-btn--secondary csa-btn--block" style="margin-bottom: var(--csa-sp-2);">
                                            <i class="fa fa-paper-plane-o"></i>
                                            Pedir el {{ t.date|format_date(pattern='EEEE d MMM', locale='es') }}
                                        </button>
                                    {% endfor %}
                                </form>
                            {% else %}
                                <p class="csa-muted">Se mueven las dos mitades, la de {{ cal.shared_other_name|default('el otro hogar') }} también, y se avisa a los dos hogares. Elige el día:</p>
                                {# Un modal por fecha, porque cada uno confirma un destino distinto.
                                   El mismo aviso que sale al soltarla arrastrando: quien lo hace tiene
                                   que leer a quién más está moviendo antes de moverlo. #}
                                {% for t in drop_targets|default([]) %}
                                    <button type="button" class="csa-btn csa-btn--secondary csa-btn--block"
                                            style="margin-bottom: var(--csa-sp-2);"
                                            onclick="document.getElementById('confirm-sharedmove-{{ bid }}-{{ t.basketId }}').showModal()">
                                        <i class="fa fa-arrows"></i> Mover la cesta al {{ t.date|format_date(pattern='EEEE d MMM', locale='es') }}
                                    </button>
                                    {{ csa.confirm_dialog('confirm-sharedmove-' ~ bid ~ '-' ~ t.basketId, {
                                        variant: 'warning',
                                        eyebrow: 'Cesta compartida',
                                        title: 'Se mueven las dos mitades',
                                        body: 'La cesta la comparten dos hogares y es una sola: al cambiarla de día se mueve también la de '
                                            ~ cal.shared_other_name|default('el otro hogar')
                                            ~ '. Se avisará a los dos por sus canales.',
                                        confirm_label: 'Mover las dos',
                                        action: shared_action,
                                        csrf_token: cal.csrf_shared_move,
                                        extra_fields: [
                                            { name: 'basket_id', value: bid },
                                            { name: 'to_basket_id', value: t.basketId },
                                            { name: 'view_year', value: current.format('Y') },
                                            { name: 'view_month', value: current.format('n') },
                                        ],
                                    }) }}
                                {% endfor %}
                            {% endif %}
                        </div>
                    {% endif %}

                    {% if not readonly and dnd %}
                        <div class="rcal-hint rcal-dragonly" style="margin-top: var(--csa-sp-4);">
                            <i class="fa fa-arrows"></i> Arrastra este día en el calendario para moverlo a otra fecha o a "No recoge".
                        </div>
                    {% elseif partner.sharePartner and selected_editable and not ro and not cal.shared_needs_consent|default(false) and has_drop_targets|default(false) %}
                        {# El gesto de la cesta compartida ya tiene su bloque arriba, con botón por
                           fecha, que es lo que funciona también con el dedo. Esto sólo anuncia el
                           atajo de escritorio, y no nombra la papelera: a "No recoge" no se puede
                           arrastrar una compartida. #}
                        <div class="rcal-hint rcal-dragonly" style="margin-top: var(--csa-sp-4);">
                            <i class="fa fa-arrows"></i> También puedes arrastrar este día en el calendario. Se moverán las dos mitades.
                        </div>
                    {% endif %}
                </div>

                {% if not readonly %}
                    <div class="rcal-panel__ft">
                        {# Mover por toque (móvil/socio): inicia el modo "elige día destino".
                           En escritorio (dnd) se mueve arrastrando, así que no se muestra. #}
                        {# has_drop_targets solo cuenta días LIBRES; con todas las semanas
                           ocupadas (una semanal, p. ej.) el botón desaparecía y el único
                           cambio posible —trasladar sumando a otro día suyo— quedaba fuera
                           del alcance del dedo. De ahí el `or accumulate_targets`. #}
                        {% if cal.route_move is defined and (has_drop_targets|default(false) or accumulate_targets|default(false)) %}
                            <button type="button" class="csa-btn csa-btn--secondary csa-btn--block rcal-tapmove" data-rcal-move-start
                                    data-rcal-move-url="{{ path(cal.route_move, cal.idp|merge({ basketId: bid })) }}"
                                    data-rcal-move-from="{{ bid }}"
                                    style="margin-bottom: var(--csa-sp-3);">
                                <i class="fa fa-arrows"></i><span>Mover a otra fecha</span>
                            </button>
                        {% endif %}
                        {# Interruptor on/off de la semana. Apagarlo = no recoge (route_skip).
                           Reversible y sin confirmación: el propio interruptor invita a
                           volver a encenderlo. #}
                        <form id="rcal-skip-form-{{ bid }}" action="{{ path(cal.route_skip, cal.idp|merge({ basketId: bid })) }}" method="post" style="margin: 0;" data-rcal-ajax>
                            <input type="hidden" name="_csrf_token" value="{{ cal.csrf_skip }}">
                            <button type="submit" class="rcal-switch" aria-pressed="true">
                                <span class="rcal-switch__track"><span class="rcal-switch__knob"></span></span>
                                <span class="rcal-switch__txt">
                                    <span class="rcal-switch__label">Recoge esta semana</span>
                                    <span class="rcal-switch__sub">Apágalo para no recoger · reversible</span>
                                </span>
                            </button>
                        </form>
                    </div>
                {% elseif not partner.sharePartner and not ro %}
                    <div class="rcal-panel__ft">
                        <div class="rcal-hint" style="text-align: center;"><i class="fa fa-lock"></i> Se recoge hoy o ya pasó · solo lectura</div>
                    </div>
                {% endif %}
            {% endif %}

            {# En día SALTADO o CERRADO no hay lista de cesta arriba, pero el pedido llega
               igual (entrega fija e independiente): se muestra en su propia sección. En día
               activo ya va integrado en "Qué se lleva ese día". #}
            {% if (selected.skipped or selected.closed|default(false)) and cg_today is not empty %}
                <div class="rcal-panel__bd">
                    {{ _self.cg_rows(cg_today, CG_ICONS, CG_ICON_DEFAULT, true) }}
                </div>
            {% endif %}
        {% else %}
            <div class="rcal-empty">
                <p>Este mes no tiene entregas para el socio.</p>
                <p style="margin-top: var(--csa-sp-2); font-size: 12px;">Navega a otro mes con las flechas de arriba.</p>
            </div>
        {% endif %}
    </div>

</div>

{# Modal de confirmación del TRASLADO SUMANDO (llevar una cesta a un día que ya recoge).
   Vive FUERA de .rcal para sobrevivir al refresco AJAX (que reemplaza .rcal). NO cuelga de
   `dnd`: el gesto existe también por toque, y el modal es el mismo. #}
{% if partner.sharePartner is null and not ro and cal.route_move is defined %}
<dialog id="rcal-accumulate-modal" class="csa-modal csa-modal--warning" role="alertdialog" aria-labelledby="rcal-accumulate-title">
    <button class="csa-modal__close" type="button" aria-label="Cerrar" onclick="this.closest('dialog').close()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>
    <header class="csa-modal__header">
        <span class="csa-modal__icon" aria-hidden="true"><i class="fa fa-exclamation-triangle"></i></span>
        <div class="csa-modal__heading">
            <span class="csa-modal__eyebrow">Trasladar sumando</span>
            <h2 class="csa-modal__title" id="rcal-accumulate-title">¿Trasladar la cesta a un día que ya recoge?</h2>
        </div>
    </header>
    <div class="csa-modal__body">
        <p>El <strong id="rcal-accumulate-day">ese día</strong> ya recoge cesta. Si continúas, ese día pasará a llevar <strong>2 cestas</strong> y el día de origen se quedará sin entrega.</p>
        <p class="csa-muted">Se puede deshacer: en ese día aparecerá «Deshacer el traslado», y la cesta volverá a su semana.</p>
    </div>
    <footer class="csa-modal__footer">
        <button type="button" class="csa-modal__btn csa-modal__btn--ghost" onclick="this.closest('dialog').close()" autofocus>Cancelar</button>
        <button type="button" class="csa-modal__btn csa-modal__btn--primary" id="rcal-accumulate-confirm">Sí, trasladar y sumar</button>
    </footer>
</dialog>
{% endif %}

{# Modal de confirmación del cambio de día en una cesta COMPARTIDA. El arrastre no pregunta
   nada por su cuenta, y aquí el gesto mueve la cesta de DOS familias y les manda un aviso:
   quien lo hace tiene que leer a quién está moviendo antes de soltarlo. Mismo sitio y mismo
   motivo que el de arriba: fuera de .rcal para sobrevivir al refresco AJAX. #}
{% if partner.sharePartner and not ro and cal.route_move is defined and not cal.shared_needs_consent|default(false) %}
<dialog id="rcal-shared-modal" class="csa-modal csa-modal--warning" role="alertdialog" aria-labelledby="rcal-shared-title">
    <button class="csa-modal__close" type="button" aria-label="Cerrar" onclick="this.closest('dialog').close()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>
    <header class="csa-modal__header">
        <span class="csa-modal__icon" aria-hidden="true"><i class="fa fa-exclamation-triangle"></i></span>
        <div class="csa-modal__heading">
            <span class="csa-modal__eyebrow">Cesta compartida</span>
            <h2 class="csa-modal__title" id="rcal-shared-title">Se mueven las dos mitades</h2>
        </div>
    </header>
    <div class="csa-modal__body">
        <p>Esta cesta la comparten dos hogares y es una sola: al llevarla al <strong id="rcal-shared-day">otro día</strong> se mueve también la de <strong>{{ cal.shared_other_name|default('el otro hogar') }}</strong>.</p>
        <p class="csa-muted">Se avisará a los dos por sus canales.</p>
    </div>
    <footer class="csa-modal__footer">
        <button type="button" class="csa-modal__btn csa-modal__btn--ghost" onclick="this.closest('dialog').close()" autofocus>Cancelar</button>
        <button type="button" class="csa-modal__btn csa-modal__btn--primary" id="rcal-shared-confirm">Sí, mover las dos</button>
    </footer>
</dialog>
{% endif %}

{# Interacción del calendario: arrastrar (escritorio, solo si `dnd`) y mover por TOQUE
   (móvil, siempre). Van juntos a propósito: comparten el token, el modal de traslado
   sumando y el re-vinculado tras cada refresco AJAX. Separados, el gesto de acumular solo
   existía arrastrando y con el dedo era inalcanzable.

   TAMBIÉN EN COMPARTIDAS, desde que la cesta de dos hogares puede cambiar de día. Antes
   este bloque no se cargaba ahí, y por eso en esa ficha no había arrastre: no es que
   estuviera desactivado, es que no había JS. Lo que sigue apagado dentro son los dos gestos
   que en una compartida no existen —la papelera ("no recoge") y el traslado sumando—, y el
   movimiento pide confirmación antes de salir, porque arrastra también al otro hogar. #}
{% if not ro and cal.route_move is defined %}
<script>
(function () {
    const SKIP_CSRF = {{ (cal.csrf_skip|default(''))|json_encode|raw }};
    const MOVE_CSRF = {{ (cal.csrf_move|default(''))|json_encode|raw }};
    // Arrastrar y soltar: solo en escritorio. El flujo por toque va siempre.
    const DND = {{ dnd ? 'true' : 'false' }};

    // Traslado SUMANDO: llevar una cesta a un día donde el socio ya recoge no manda el
    // cambio directo, sino que confirma primero (ese día pasa a llevar 2 cestas). El envío
    // lo decide quien abre el modal (`run`), porque el arrastre postea por AJAX y el toque
    // con recarga normal.
    const accModal = document.getElementById('rcal-accumulate-modal');
    let pendingAcc = null;
    function openAccumulate(dateLabel, run) {
        if (!accModal) { // sin <dialog>: respaldo con confirm nativo.
            if (window.confirm('Ese día ya recoge. ¿Trasladar la cesta y sumar (pasará a 2 cestas)?')) {
                run();
            }
            return;
        }
        pendingAcc = run;
        const dayEl = document.getElementById('rcal-accumulate-day');
        if (dayEl) dayEl.textContent = dateLabel || 'ese día';
        if (accConfirm) accConfirm.disabled = false; // rearmar en cada apertura.
        accModal.showModal();
    }

    // Cesta COMPARTIDA: soltarla en otro día mueve las DOS mitades y avisa a los dos
    // hogares, así que se confirma antes de mandar nada. Mismo patrón que el de arriba.
    const sharedModal = document.getElementById('rcal-shared-modal');
    let pendingShared = null;
    function openShared(dateLabel, run) {
        if (!sharedModal) { // sin <dialog>: respaldo con confirm nativo.
            if (window.confirm('Esta cesta es compartida: se moverán las dos mitades y se avisará a los dos hogares. ¿Sigo?')) {
                run();
            }
            return;
        }
        pendingShared = run;
        const dayEl = document.getElementById('rcal-shared-day');
        if (dayEl) dayEl.textContent = dateLabel || 'otro día';
        if (sharedConfirm) sharedConfirm.disabled = false; // rearmar en cada apertura.
        sharedModal.showModal();
    }

    let dragged = null;

    function clearHighlights() {
        document.querySelectorAll('.rcal-dropok, .rcal-dragok').forEach(function (el) {
            el.classList.remove('rcal-dropok', 'rcal-dragok');
        });
    }

    // handlers: { <kind>: fn(card) }. La zona acepta una ficha si hay handler para su
    // tipo; al soltar, ejecuta el de ese tipo. Una misma celda acepta MOVER (ficha de
    // rejilla) y RECUPERAR (ficha de papelera).
    function wireDrop(el, handlers) {
        el.addEventListener('dragover', function (e) {
            if (!dragged || !handlers[dragged.dataset.rcalKind]) return;
            e.preventDefault();
            el.classList.add('rcal-dropok');
        });
        el.addEventListener('dragleave', function (e) {
            if (e.target === el) el.classList.remove('rcal-dropok');
        });
        el.addEventListener('drop', function (e) {
            if (!dragged || !handlers[dragged.dataset.rcalKind]) return;
            e.preventDefault();
            handlers[dragged.dataset.rcalKind](dragged);
        });
    }

    // (Re)vincula el DnD, el flujo por toque y la intercepción de forms sobre un nodo
    // .rcal concreto. Se llama al cargar y tras cada refresco AJAX (el .rcal se reemplaza
    // entero, así que sin esto los listeners se quedarían en el nodo viejo).
    function bind(cal) {
        // Mes que se está viendo: se manda con el cambio para que el servidor NOS DEVUELVA
        // a este mes (y no salte al del destino) cuando el movimiento cruza de mes — el
        // destino se dibuja en la semana vecina de esta misma vista.
        const view = { view_year: cal.dataset.rcalViewYear, view_month: cal.dataset.rcalViewMonth };

        bindTapMove(cal, view);

        // Forms del panel (no recoge / volver a recoger): por AJAX. El botón del diálogo de
        // confirmación es un submit nativo (form="..."), así que su submit burbujea hasta aquí.
        cal.addEventListener('submit', function (e) {
            const form = e.target.closest('form[data-rcal-ajax]');
            if (!form) return;
            e.preventDefault();
            const fields = {};
            new FormData(form).forEach(function (v, k) { fields[k] = v; });
            send(form.action, fields);
        });

        if (!DND) return;

        cal.addEventListener('dragstart', function (e) {
            const card = e.target.closest('[data-rcal-draggable]');
            if (!card) return;
            dragged = card;
            e.dataTransfer.effectAllowed = 'move';
            // setData es obligatorio en Firefox para que arranque el arrastre.
            e.dataTransfer.setData('text/plain', '');
            card.classList.add('rcal-dragging');
            // Destinos válidos: días libres del nodo. Para una ficha de rejilla, además
            // la papelera (no recoge).
            cal.querySelectorAll('[data-rcal-target]').forEach(function (el) { el.classList.add('rcal-dragok'); });
            // Una cesta COMPARTIDA sólo admite cambiar de día: ni la papelera ("no recoge",
            // que ahí no se puede) ni el traslado sumando. Se sale antes de resaltarlos para
            // no ofrecer un destino que el servidor va a rechazar.
            if (card.dataset.rcalShared) return;
            if (card.dataset.rcalKind === 'grid') {
                const tray = cal.querySelector('.rcal-tray');
                if (tray) tray.classList.add('rcal-dragok');
                // Días donde YA recoge: destinos válidos para TRASLADAR SUMANDO (menos el propio origen).
                cal.querySelectorAll('[data-rcal-accumulate-to]').forEach(function (el) {
                    if (el !== card) el.classList.add('rcal-dragok');
                });
            }
        });

        cal.addEventListener('dragend', function () {
            if (dragged) dragged.classList.remove('rcal-dragging');
            dragged = null;
            clearHighlights();
        });

        cal.querySelectorAll('[data-rcal-target]').forEach(function (cell) {
            wireDrop(cell, {
                grid: function (card) {
                    const fields = Object.assign({ to_basket_id: cell.dataset.rcalTo, _csrf_token: MOVE_CSRF }, view);
                    // Compartida: confirmar primero, que esto mueve a dos familias.
                    if (card.dataset.rcalShared) {
                        openShared(cell.dataset.rcalToDate, function () { send(card.dataset.rcalMoveUrl, fields); });

                        return;
                    }
                    send(card.dataset.rcalMoveUrl, fields);
                },
                tray: function (card) { send(card.dataset.rcalRecoverUrl, Object.assign({ to_basket_id: cell.dataset.rcalTo, _csrf_token: MOVE_CSRF }, view)); },
            });
        });

        // Soltar una cesta sobre un día que YA recoge: confirmar y trasladar sumando.
        cal.querySelectorAll('[data-rcal-accumulate-to]').forEach(function (cell) {
            wireDrop(cell, {
                grid: function (card) {
                    if (card === cell) return; // sobre sí misma: nada que hacer.
                    const url = card.dataset.rcalMoveUrl;
                    const to = cell.dataset.rcalAccumulateTo;
                    openAccumulate(cell.dataset.rcalAccumulateDate, function () {
                        send(url, Object.assign({ to_basket_id: to, accumulate: 1, _csrf_token: MOVE_CSRF }, view));
                    });
                },
            });
        });

        const tray = cal.querySelector('.rcal-tray');
        if (tray) {
            wireDrop(tray, {
                // "No recoger" no existe en una compartida: si una mitad salta y la otra no,
                // queda media cesta sin dueño en el punto. El servidor lo rechaza igualmente;
                // aquí se ignora el gesto para no pasear a nadie hasta un mensaje de error.
                grid: function (card) {
                    if (card.dataset.rcalShared) return;
                    send(card.dataset.rcalSkipUrl, { _csrf_token: SKIP_CSRF });
                },
            });
        }
    }

    // POST por AJAX y refresco EN SITIO del calendario (sin recargar la página). El
    // endpoint redirige al GET del calendario; seguimos el redirect, y del HTML resultante
    // reemplazamos solo .rcal (rejilla + papelera + panel) y los avisos flash. El servidor
    // sigue siendo la fuente de verdad. Si algo falla, recarga normal como respaldo.
    async function send(url, fields) {
        if (!url) return;
        const cal = document.querySelector('.rcal');
        if (!cal) return;
        cal.classList.add('rcal-busy');
        try {
            const resp = await fetch(url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new URLSearchParams(fields),
            });
            const doc = new DOMParser().parseFromString(await resp.text(), 'text/html');
            const fresh = doc.querySelector('.rcal');
            if (!fresh) { window.location.reload(); return; }
            const imported = document.importNode(fresh, true);
            cal.replaceWith(imported);
            bind(imported);

            // Avisos flash del shell (errores/confirmaciones): se refrescan en sitio.
            const content = document.querySelector('.csa-content');
            if (content) {
                const old = content.querySelector('.csa-alerts');
                if (old) old.remove();
                const freshAlerts = doc.querySelector('.csa-alerts');
                if (freshAlerts) content.insertBefore(document.importNode(freshAlerts, true), content.firstElementChild);
            }
        } catch (err) {
            window.location.reload();
        }
    }

    // Cierre de avisos flash inyectados por AJAX (el script del componente no se reejecuta).
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.csa-alert__close');
        if (btn) { const a = btn.closest('.csa-alert'); if (a) a.remove(); }
    });

    // POST normal con recarga (sin fetch): lo que usa el flujo por TOQUE. Se mantiene
    // aparte del AJAX a propósito — en móvil una recarga completa es más robusta y deja
    // el aviso del servidor a la vista.
    function post(url, fields) {
        if (!url) return;
        const f = document.createElement('form');
        f.method = 'post';
        f.action = url;
        Object.keys(fields).forEach(function (k) {
            const i = document.createElement('input');
            i.type = 'hidden';
            i.name = k;
            i.value = fields[k];
            f.appendChild(i);
        });
        document.body.appendChild(f);
        f.submit();
    }

    // Mover por TOQUE (móvil): el arrastre HTML5 no responde al dedo, así que el cambio de
    // día va por clics. Pulsar "Mover a otra fecha" entra en modo destino y resalta los
    // días donde se puede soltar; tocar uno manda el cambio. Dos clases de destino:
    //   - día LIBRE del nodo ([data-rcal-target]) → cambio de día normal;
    //   - día donde YA recoge ([data-rcal-accumulate-to], menos el de origen) → traslado
    //     sumando, previa confirmación en el modal.
    // El servidor revalida en ambos casos (plazo, nodo, un hueco por día).
    let moveUrl = null;
    let moveFrom = null;
    // Nombre del otro hogar cuando la cesta que se está moviendo es COMPARTIDA, o null.
    // Decide si al tocar el día destino hay que confirmar antes de mandar nada.
    let moveShared = null;

    function exitMoveMode(cal) {
        moveUrl = null;
        moveFrom = null;
        moveShared = null;
        cal.classList.remove('rcal-moving');
        cal.querySelectorAll('.rcal-dragok').forEach(function (el) { el.classList.remove('rcal-dragok'); });
        const banner = document.getElementById('rcal-move-banner');
        if (banner) banner.hidden = true;
    }

    function bindTapMove(cal, view) {
        cal.addEventListener('click', function (e) {
            // 1) Iniciar el modo mover desde el panel del día seleccionado.
            const start = e.target.closest('[data-rcal-move-start]');
            if (start) {
                moveUrl = start.dataset.rcalMoveUrl;
                moveFrom = start.dataset.rcalMoveFrom || null;
                moveShared = start.dataset.rcalShared || null;
                cal.classList.add('rcal-moving');
                cal.querySelectorAll('[data-rcal-target]').forEach(function (el) { el.classList.add('rcal-dragok'); });
                // En una compartida no se resaltan los días donde ya recoge: el traslado
                // sumando no se ofrece ahí (media cesta duplicada no es una cesta).
                if (!moveShared) {
                    cal.querySelectorAll('[data-rcal-accumulate-to]').forEach(function (el) {
                        if (el.dataset.rcalAccumulateTo !== moveFrom) el.classList.add('rcal-dragok');
                    });
                }
                const banner = document.getElementById('rcal-move-banner');
                if (banner) banner.hidden = false;
                cal.scrollIntoView({ behavior: 'smooth', block: 'start' });
                return;
            }
            if (!moveUrl) return;

            // 2a) Tocar un día LIBRE resuelto: cambio de día directo.
            const target = e.target.closest('[data-rcal-target]');
            if (target) {
                const url = moveUrl;
                const fields = Object.assign({ to_basket_id: target.dataset.rcalTo, _csrf_token: MOVE_CSRF }, view);
                // Compartida: confirmar, que esto mueve la cesta de dos familias.
                if (moveShared) {
                    const label = target.dataset.rcalToDate;
                    exitMoveMode(cal);
                    openShared(label, function () { post(url, fields); });

                    return;
                }
                post(url, fields);
                return;
            }

            // 2b) Tocar un día donde YA recoge: traslado sumando, tras confirmar. Se anula
            //     la navegación de la celda (es un <a> al detalle de ese día).
            const acc = e.target.closest('[data-rcal-accumulate-to]');
            if (acc && acc.dataset.rcalAccumulateTo !== moveFrom) {
                e.preventDefault();
                const url = moveUrl;
                const to = acc.dataset.rcalAccumulateTo;
                exitMoveMode(cal);
                openAccumulate(acc.dataset.rcalAccumulateDate, function () {
                    post(url, Object.assign({ to_basket_id: to, accumulate: 1, _csrf_token: MOVE_CSRF }, view));
                });
            }
        });

        const cancel = document.getElementById('rcal-move-cancel');
        if (cancel) cancel.addEventListener('click', function () { exitMoveMode(cal); });
    }

    // Confirmación del traslado sumando: el modal vive fuera de .rcal (no se reemplaza en
    // los refrescos AJAX), así que su botón se engancha una sola vez aquí.
    const accConfirm = document.getElementById('rcal-accumulate-confirm');
    if (accConfirm) {
        accConfirm.addEventListener('click', function () {
            accConfirm.disabled = true; // evita doble envío por doble-click/Enter.
            if (accModal) accModal.close();
            if (!pendingAcc) return;
            const run = pendingAcc;
            pendingAcc = null;
            run();
        });
    }

    const sharedConfirm = document.getElementById('rcal-shared-confirm');
    if (sharedConfirm) {
        sharedConfirm.addEventListener('click', function () {
            sharedConfirm.disabled = true; // evita doble envío por doble-click/Enter.
            if (sharedModal) sharedModal.close();
            if (!pendingShared) return;
            const run = pendingShared;
            pendingShared = null;
            run();
        });
    }

    const root = document.querySelector('.rcal');
    if (root) bind(root);

    // Móvil: la celda de un día es un enlace que RECARGA la página. En una sola
    // columna el panel del detalle (con "Mover a otra fecha" y, al pulsarlo, los
    // huecos) queda al fondo, tras la rejilla y la papelera, y el usuario se queda
    // arriba sin verlo — "no pasa nada". Si la recarga trae una selección explícita
    // (?sel), llevamos la vista al panel. Solo en táctil; en escritorio el panel ya
    // está a la vista (columna derecha).
    if (root && window.matchMedia('(hover: none), (pointer: coarse)').matches
        && new URLSearchParams(window.location.search).has('sel')) {
        const panel = root.querySelector('.rcal-panel');
        if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
})();
</script>
{% endif %}
