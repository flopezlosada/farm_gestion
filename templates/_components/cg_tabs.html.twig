{# Script de pestañas compartido (producer/show, consumer_group_product/show).
 # Opera sobre cualquier .prt-tab / .prt-tabpanel de la página; sin estado
 # propio por instancia, así que basta incluirlo una vez. Recuerda la pestaña
 # activa en el hash de la URL. #}
<script>
(function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.prt-tab'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('.prt-tabpanel'));
    if (!tabs.length) { return; }

    function activate(name) {
        tabs.forEach(function (t) {
            var on = t.dataset.tab === name;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function (p) { p.hidden = p.dataset.tabpanel !== name; });
    }

    tabs.forEach(function (t) {
        t.addEventListener('click', function () {
            activate(t.dataset.tab);
            history.replaceState(null, '', '#' + t.dataset.tab);
        });
    });

    var initial = (location.hash || '').slice(1);
    if (initial && tabs.some(function (t) { return t.dataset.tab === initial; })) {
        activate(initial);
    }
})();
</script>
