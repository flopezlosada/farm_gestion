{#
 # Bloque de voluntariado para la home del panel.
 #
 # Está aquí y no en una pestaña porque una pestaña "Voluntariado" no la abre
 # nadie: hay que estar en el camino, no al lado. Y lo que se enseña es la
 # NECESIDAD concreta —fecha, sitio, cuánta gente falta—, no el contador propio.
 #
 # Lo que cambia cada semana se lee; "llevas 0 horas" es el mismo píxel toda la
 # vida y a las dos semanas es mobiliario. Además, un déficit sin una acción al
 # lado es un reproche sin salida, y eso lo que consigue es que la gente deje de
 # entrar en la web — y con ella se pierde el canal de la cesta.
 #
 # ERA UNA LISTA DE ENLACES y ahora son tarjetas. Con título y una línea de meta
 # había que abrir cada tarea para saber si podías ir, y apuntarse eran tres
 # pantallas. La tarjeta trae los cinco datos que deciden —cuándo, dónde, cuánto
 # cuenta, cuánta gente falta y quién va ya— y el botón de apuntarse.
 #
 # Espera: shifts (lista corta de turnos), total (cuántos hay en realidad) y
 # my_node_id.
 #}
{% if shifts is not empty %}

    {# Cuántos de los que se asoman se hacen desde casa. Es la salida para quien
     # no puede subir a la finca —la mayoría de quien nunca se apunta— y por eso
     # se cuenta aparte en vez de dejarla escondida en una etiqueta. #}
    {% set desde_casa = shifts|filter(s => s.offer.remote)|length %}

    <div class="vol-need">
        <p class="vol-need__lead">
            <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
            <span>
                {% if total|default(0) > shifts|length %}
                    <strong>Hay {{ total }} días esperando gente.</strong> Éstos son los más cercanos:
                {% elseif shifts|length == 1 %}
                    <strong>Hay un día esperando gente.</strong>
                {% else %}
                    <strong>Hay {{ shifts|length }} días esperando gente.</strong>
                {% endif %}
                {% if desde_casa %}
                    <span class="vol-need__sub">{% if desde_casa == 1 %}Uno de ellos se hace{% else %}{{ desde_casa }} de ellos se hacen{% endif %} desde casa.</span>
                {% endif %}
            </span>
        </p>
    </div>

    <div class="vol-tasks">
        {% for shift in shifts %}
            {% include '_components/volunteering_task_card.html.twig' with {
                shift: shift,
                my_node_id: my_node_id|default(null),
                csrf: csrf_token('panel_volunteering')
            } only %}
        {% endfor %}
    </div>

    {# Con el número, el botón deja de ser "ver más" y pasa a decir cuánto queda
     # fuera: es la diferencia entre curiosear y saber que faltan seis. Y la línea
     # de abajo dice lo que hay que decir en voz alta, porque si no se dice, se
     # supone lo contrario. #}
    <a href="{{ path('panel_volunteering') }}" class="vol-all">
        <i class="fa fa-hand-paper-o" aria-hidden="true"></i>
        Ver todo lo que hace falta
        {% if total|default(0) > shifts|length %}<span class="vol-all__count">{{ total }}</span>{% endif %}
    </a>
    <p class="vol-note">Echar una mano no es obligatorio.</p>

{% endif %}
