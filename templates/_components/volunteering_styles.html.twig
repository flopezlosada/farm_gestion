{#
 # Estilos propios del módulo de voluntariado. Se incluyen desde el bloque
 # more_css de las pantallas que los usan, igual que partner_card_styles.
 #
 # Sólo lo que NO existe ya en el lenguaje csa: la lista de tareas y sus piezas.
 # Todo lo demás (tarjetas, botones, badges, inputs) usa los componentes
 # canónicos. Nada de colores a pelo: sólo tokens --csa-*.
 #}
<style>
    .vol-list { list-style: none; margin: 0; padding: 0; }

    .vol-item {
        display: flex;
        gap: var(--csa-sp-4);
        align-items: flex-start;
        justify-content: space-between;
        padding: var(--csa-sp-4) 0;
        border-bottom: 1px solid var(--csa-rule-soft);
    }
    .vol-item:last-child { border-bottom: 0; padding-bottom: 0; }
    .vol-item:first-child { padding-top: 0; }

    /* Lo ya comprometido baja de intensidad: la atención va a lo que sigue sin cubrir. */
    .vol-item--signed { opacity: .72; }

    .vol-item__main { min-width: 0; flex: 1 1 auto; }

    .vol-item__title {
        margin: 0 0 var(--csa-sp-1);
        font-family: var(--csa-serif);
        font-size: var(--csa-fs-lg);
        line-height: var(--csa-lh-snug);
        color: var(--csa-ink);
    }

    .vol-item__meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--csa-sp-1) var(--csa-sp-4);
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-muted);
    }
    .vol-item__meta i { margin-right: var(--csa-sp-1); opacity: .7; }

    .vol-item__desc {
        margin: var(--csa-sp-2) 0 0;
        font-size: var(--csa-fs-sm);
        line-height: var(--csa-lh-normal);
        color: var(--csa-ink-soft);
    }

    .vol-item__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--csa-sp-1);
        margin-top: var(--csa-sp-2);
    }

    .vol-item__action {
        flex: 0 0 auto;
        text-align: right;
        display: flex;
        flex-direction: column;
        gap: var(--csa-sp-2);
        align-items: flex-end;
    }

    .vol-item__slots {
        margin: 0;
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-muted);
        white-space: nowrap;
    }
    .vol-item__slots strong { color: var(--csa-terracotta, var(--csa-ink)); }

    .vol-item__signed {
        margin: 0 0 var(--csa-sp-1);
        font-size: var(--csa-fs-sm);
        color: var(--csa-green);
        white-space: nowrap;
    }

    .vol-item__companions {
        display: block;
        margin-bottom: var(--csa-sp-2);
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-muted);
        white-space: nowrap;
    }
    .vol-item__companions .csa-input { width: 4.5rem; display: inline-block; margin: 0 var(--csa-sp-1); }

    .vol-mine { list-style: none; margin: 0; padding: 0; }
    .vol-mine li {
        padding: var(--csa-sp-2) 0;
        border-bottom: 1px solid var(--csa-rule-soft);
    }
    .vol-mine li:last-child { border-bottom: 0; }
    .vol-mine__when {
        display: block;
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-muted);
    }

    .vol-prefs {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
        gap: var(--csa-sp-2);
        margin: var(--csa-sp-3) 0;
    }
    .vol-pref {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0 var(--csa-sp-2);
        align-items: start;
        padding: var(--csa-sp-2);
        border: 1px solid var(--csa-rule-soft);
        border-radius: var(--csa-radius-md);
        cursor: pointer;
    }
    .vol-pref:hover { background: var(--csa-sage-bg-hover); }
    .vol-pref__name { font-size: var(--csa-fs-base); color: var(--csa-ink); }
    .vol-pref__desc {
        grid-column: 2;
        font-size: var(--csa-fs-xs);
        color: var(--csa-ink-muted);
        line-height: var(--csa-lh-snug);
    }

    /* Separada de las casillas de categorías: no es una más de la lista, es la
       que las anula todas. Si se pintara como una más, se marcaría por error. */
    .vol-optout {
        display: flex;
        gap: var(--csa-sp-2);
        align-items: center;
        margin: var(--csa-sp-3) 0;
        padding-top: var(--csa-sp-3);
        border-top: 1px solid var(--csa-rule-soft);
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-muted);
        cursor: pointer;
    }

    /* Una sola línea: "cada [semana] durante [4] veces [botón]". Partido en
       varias filas se lee como un formulario largo y da más respeto del que
       merece. */
    .vol-repeat {
        display: flex;
        flex-wrap: wrap;
        gap: var(--csa-sp-3);
        align-items: center;
        margin-bottom: var(--csa-sp-3);
    }
    .vol-repeat label {
        display: flex;
        gap: var(--csa-sp-2);
        align-items: center;
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-muted);
    }
    .vol-repeat .csa-input { width: 5rem; }
    .vol-repeat .csa-select { width: auto; }

    /* Anular un turno. Bloque propio y NO .vol-repeat: aquello estrecha su input
       a 5rem, que es lo que quiere «cada N semanas» y lo que estropeaba el motivo
       de la anulación. Encuadrado y al pie: se ve, pero no compite con lo que se
       viene a hacer en esta pantalla. */
    .vol-cancel {
        margin-top: var(--csa-sp-8);
        padding: var(--csa-sp-4) var(--csa-sp-5) var(--csa-sp-5);
        border: 1px solid var(--csa-rule);
        border-radius: var(--csa-radius-md);
        background: var(--csa-surface-alt);
    }
    .vol-cancel__title {
        margin: 0 0 var(--csa-sp-1);
        font-family: var(--csa-serif);
        font-size: var(--csa-fs-md);
        color: var(--csa-ink);
    }
    .vol-cancel__title .fa { color: var(--csa-terracotta); margin-right: var(--csa-sp-2); }
    .vol-cancel__help {
        margin: 0 0 var(--csa-sp-4);
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-soft);
        max-width: 62ch;
    }
    /* `flex-end` y no `center`: la etiqueta de dos líneas empuja el input hacia
       abajo y el botón tiene que quedar a la altura del input, no del rótulo. */
    .vol-cancel__row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--csa-sp-3);
        align-items: flex-end;
    }
    .vol-cancel__field {
        flex: 1 1 22rem;
        display: flex;
        flex-direction: column;
        gap: var(--csa-sp-2);
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-soft);
    }
    .vol-cancel__field em { font-style: normal; color: var(--csa-ink-muted); }
    .vol-cancel__field .csa-input { width: 100%; }

    /* Casilla con etiqueta al lado. Ver la macro vol.check: la macro csa.field
       le pone csa-input al widget y un checkbox acaba como un cuadrado enorme
       centrado, sin relación visual con lo que dice. */
    .vol-check {
        display: flex;
        gap: var(--csa-sp-2);
        align-items: flex-start;
        cursor: pointer;
        font-size: var(--csa-fs-base);
        /* Explícito: es un <label> y Bootstrap 3 le mete font-weight:700, así
           que salía MÁS negrita que las etiquetas de los campos de al lado
           —que son 600— y rompía la coherencia del formulario. */
        font-weight: 400;
        color: var(--csa-ink);
    }
    .vol-check input[type="checkbox"] {
        width: 1rem;
        height: 1rem;
        margin: 0;
        flex: 0 0 auto;
        /* Alineado con la primera línea del texto, no con el centro del bloque. */
        margin-top: 0.2em;
    }
    .vol-check__hint {
        display: block;
        font-size: var(--csa-fs-xs);
        color: var(--csa-ink-muted);
        line-height: var(--csa-lh-snug);
    }

    /* ---- Aire dentro de las secciones del formulario ----
       El callout viene con `margin: 0` del componente global —cada pantalla
       decide su hueco— y aquí quedaba pegado al campo de arriba y a la casilla
       de abajo, todo amontonado. Se le da el hueco AQUÍ y no en el componente,
       que lo usan muchas más pantallas. */
    .csa-form-section .csa-callout { margin: var(--csa-sp-5) 0; }

    /* Una aclaración en prosa dentro de una sección, para lo que no cabe en el
       hint de un campo: el hint va en una línea y se corta con puntos
       suspensivos, así que explicar ahí una idea entera es no explicarla.

       Prefijo `vol-` y no `csa-` a propósito, aunque sirva para cualquier
       formulario: esto vive en la hoja de voluntariado y sólo se carga en sus
       pantallas. Con nombre canónico, otra pantalla lo usaría dándolo por
       global y saldría sin estilo. Si hace falta en más sitios, sube a
       assets/css/csa/03-components.css y entonces sí se llama csa-form-note. */
    .vol-note {
        margin: var(--csa-sp-4) 0 0;
        font-size: var(--csa-fs-sm);
        line-height: var(--csa-lh-normal);
        color: var(--csa-ink-soft);
    }
    .vol-note + .csa-form-grid { margin-top: var(--csa-sp-5); }

    /* Filtro por área de la bolsa. En línea y envolviendo: son media docena de
       áreas y un desplegable escondería justo lo que hay que ver de un vistazo. */
    .vol-filters {
        display: flex;
        flex-wrap: wrap;
        gap: var(--csa-sp-2);
        margin-bottom: var(--csa-sp-4);
    }

    /* Un botón de acción dentro de una tabla tiene que parecer los enlaces de
       al lado: la columna de acciones ya son iconos y un <button> nativo mete
       fondo, borde y su propia tipografía. */
    .csa-table__iconbtn {
        background: none;
        border: 0;
        padding: 0;
        cursor: pointer;
        color: inherit;
        font: inherit;
        line-height: 1;
    }
    .csa-table__iconbtn:hover { color: var(--csa-ink); }

    /* Historial de un objeto: tres columnas fijas —cuándo, qué, quién— para que
       la vista salte por la columna de fechas sin leer cada línea entera. */
    .vol-history { list-style: none; margin: 0; padding: 0; }
    .vol-history li {
        display: grid;
        grid-template-columns: 10rem 1fr auto;
        gap: var(--csa-sp-3);
        align-items: baseline;
        padding: var(--csa-sp-2) 0;
        border-bottom: 1px solid var(--csa-rule-soft);
        font-size: var(--csa-fs-sm);
    }
    .vol-history li:last-child { border-bottom: 0; }
    .vol-history__when { color: var(--csa-ink-muted); font-variant-numeric: tabular-nums; }
    .vol-history__what { color: var(--csa-ink); }
    .vol-history__detail { display: block; font-size: var(--csa-fs-xs); color: var(--csa-ink-muted); }
    .vol-history__who { color: var(--csa-ink-muted); font-size: var(--csa-fs-xs); white-space: nowrap; }

    /* En móvil las tres columnas no caben: se apilan y la fecha encabeza. */
    @media (max-width: 640px) {
        .vol-history li { grid-template-columns: 1fr; gap: var(--csa-sp-1); }
        .vol-history__who { white-space: normal; }
    }

    /* Filtro que no se puso desde la barra sino entrando desde otra pantalla:
       se ve qué recorta y se quita de un clic. */
    .vol-chip {
        display: inline-flex;
        gap: var(--csa-sp-2);
        align-items: center;
        padding: var(--csa-sp-1) var(--csa-sp-3);
        border: 1px solid var(--csa-rule-soft);
        border-radius: var(--csa-radius-pill, 999px);
        background: var(--csa-sage-bg);
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink);
    }
    .vol-chip a {
        text-decoration: none;
        color: var(--csa-ink-muted);
        font-size: var(--csa-fs-md);
        line-height: 1;
    }
    .vol-chip a:hover { color: var(--csa-ink); }

    /* Los tres avisos de un turno: qué salió y qué va a salir.
       Antes era `.vol-scopes`, una fila con una etiqueta «Enviado / Sin enviar»
       a la derecha. Se leía como una lista de tareas por hacer y no lo es: dos
       de los tres los abre el planificador solo y no hay botón que los lance.
       Ahora cada línea es un hecho con su fecha, y lo que manda es la FRASE, no
       la insignia. */
    .vol-calls { list-style: none; margin: 0 0 var(--csa-sp-3); padding: 0; }
    /* Tres columnas —marca, qué, cuándo— y el «cuándo» a la derecha. En una
       tarjeta de mil y pico píxeles, apilar la frase debajo del rótulo dejaba
       media pantalla vacía; puesta enfrente, la fila se lee de un barrido y el
       ancho se usa. `minmax(0, …)` para que el texto largo parta en vez de
       desbordar. */
    .vol-calls__item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) minmax(0, auto);
        gap: var(--csa-sp-3);
        align-items: baseline;
        padding: var(--csa-sp-3) 0;
        border-bottom: 1px solid var(--csa-rule-soft);
    }
    .vol-calls__item:last-child { border-bottom: 0; }
    /* El icono es lo único que separa hecho de no hecho, así que carga el color:
       enviado en verde, pendiente en un gris que no compite. */
    .vol-calls__item > .fa {
        flex: none;
        margin-top: 2px;
        font-size: 15px;
        color: var(--csa-ink-muted);
    }
    .vol-calls__item.is-sent > .fa { color: var(--csa-green); }
    .vol-calls__what {
        margin: 0;
        font-size: var(--csa-fs-sm);
        font-weight: 500;
        color: var(--csa-ink);
    }
    .vol-calls__when {
        margin: 0;
        font-size: var(--csa-fs-xs);
        color: var(--csa-ink-soft);
        text-align: right;
        max-width: 52ch;
    }

    @media (max-width: 720px) {
        /* Apilado: enfrentar las dos columnas en un móvil deja el «cuándo» en
           una tira de tres palabras por línea. */
        .vol-calls__item { grid-template-columns: auto minmax(0, 1fr); }
        .vol-calls__when { grid-column: 2; text-align: left; margin-top: 2px; }
    }

    /* Pedirlo a toda la asociación. Separado por una regla y NO por un recuadro
       de color: el `csa-callout` es un aviso de ancho de página y aquí, dentro
       de la tarjeta, estiraba la frase en una línea de más de mil píxeles con la
       mitad derecha vacía. El color de advertencia lo lleva ya el botón.
       El botón va ENFRENTE del texto, no debajo: debajo dejaba vacía la mitad
       derecha de la tarjeta, y además pegado al pie de un párrafo se pulsa sin
       leerlo. */
    .vol-shout {
        display: flex;
        gap: var(--csa-sp-5);
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        margin-top: var(--csa-sp-5);
        padding-top: var(--csa-sp-4);
        border-top: 1px solid var(--csa-rule);
    }
    .vol-shout__text { flex: 1 1 24rem; min-width: 0; }
    .vol-shout form { flex: none; }
    .vol-shout__lead {
        margin: 0 0 var(--csa-sp-1);
        font-family: var(--csa-serif);
        font-size: var(--csa-fs-md);
        line-height: var(--csa-lh-snug);
        color: var(--csa-ink);
    }
    .vol-shout__lead .fa { color: var(--csa-ochre); margin-right: var(--csa-sp-2); }
    .vol-shout__note {
        margin: 0;
        font-size: var(--csa-fs-sm);
        line-height: var(--csa-lh-normal);
        color: var(--csa-ink-soft);
    }

    /* «Ya se le pidió», en el sitio donde estaría su botón. */
    .vol-suggest__asked {
        display: inline-flex;
        align-items: center;
        gap: var(--csa-sp-2);
        font-size: var(--csa-fs-xs);
        color: var(--csa-ink-muted);
        white-space: nowrap;
    }
    .vol-suggest__asked .fa { color: var(--csa-green); }

    .vol-total {
        margin: 0 0 var(--csa-sp-2);
        font-size: var(--csa-fs-md);
        color: var(--csa-ink);
    }

    .vol-help {
        margin: 0 0 var(--csa-sp-2);
        font-size: var(--csa-fs-sm);
        line-height: var(--csa-lh-normal);
        color: var(--csa-ink-muted);
    }
    .vol-help--muted { font-size: var(--csa-fs-xs); color: var(--csa-ink-soft); }

    /* El porqué en la ficha de gestión: destacado sobre la descripción, porque
       es la frase que va a leer un socix en su tarjeta. */
    .vol-why {
        display: flex; gap: var(--csa-sp-2); align-items: baseline;
        margin: 0 0 var(--csa-sp-3);
        padding: var(--csa-sp-3) var(--csa-sp-4);
        border-left: 3px solid var(--csa-terracotta);
        background: var(--csa-surface-alt);
        border-radius: 0 var(--csa-radius-md) var(--csa-radius-md) 0;
        font-size: var(--csa-fs-sm); line-height: var(--csa-lh-normal);
        color: var(--csa-ink);
    }
    .vol-why > i { color: var(--csa-terracotta); flex-shrink: 0; }

    .vol-empty {
        margin: 0;
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-muted);
    }

    .vol-sep {
        border: 0;
        border-top: 1px solid var(--csa-rule-soft);
        margin: var(--csa-sp-4) 0;
    }

    /* Un dato que falta o que no aplica, dentro de una celda de tabla. En gris y
       no en blanco: una celda vacía se lee como "se olvidaron de rellenarlo". */
    .vol-muted { color: var(--csa-ink-muted); }

    /* ---------- CALENDARIO DEL SOCIX ----------
       Cabecera de día. El día corto va primero y en oscuro porque es lo que se
       busca al recorrer la lista ("¿qué hay el sábado?"); la fecha larga queda
       detrás en pequeño, para situarse cuando el mes cambia. */
    .vol-day {
        display: flex;
        align-items: baseline;
        gap: var(--csa-sp-3);
        margin: var(--csa-sp-5) 0 var(--csa-sp-2);
        padding-bottom: var(--csa-sp-2);
        border-bottom: 1px solid var(--csa-rule-soft);
        font-family: var(--csa-serif);
        font-size: var(--csa-fs-lg);
        font-weight: 500;
        color: var(--csa-ink);
    }
    .vol-day:first-child { margin-top: 0; }
    .vol-day__long {
        font-family: var(--csa-sans);
        font-size: var(--csa-fs-xs);
        font-weight: 400;
        color: var(--csa-ink-muted);
    }

    /* Celda de la tira cuyo valor NO es una cifra.
       El componente pinta el valor en Fraunces 600 a 18px, que es lo correcto
       para un número —la fecha, cuánta gente viene, los minutos— y demasiado
       para un texto: "Torremocha" con ese peso pesa como un titular y hace que
       la pantalla parezca escrita en dos fuentes distintas. Regla del proyecto:
       la serif se reserva a la cifra destacada. */
    .prt-mini__value--text {
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0;
    }

    /* Ajustes que se contestan una vez: el estado se lee en una frase y el
       formulario vive detrás de este desplegable. Nativo (<details>), sin JS y
       sin caja gris — sólo el texto y su flecha. */
    .vol-details > summary {
        display: inline-flex;
        gap: var(--csa-sp-2);
        align-items: center;
        margin-bottom: var(--csa-sp-2);
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-muted);
        cursor: pointer;
        list-style: none;
    }
    .vol-details > summary::-webkit-details-marker { display: none; }
    .vol-details > summary::before {
        content: '';
        width: 0.4rem;
        height: 0.4rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: rotate(-45deg);
        transition: transform 0.15s ease;
    }
    .vol-details[open] > summary::before { transform: rotate(45deg); }
    .vol-details > summary:hover { color: var(--csa-ink); }

    /* ---- Qué toca hacer con esta tarea ----
       La franja que abre la ficha. Va antes que los datos porque cuándo y dónde
       ya lo sabe quien abre una tarea suya; lo que no sabe es si queda algo
       pendiente. El tono lo pone la fase, y son los mismos cuatro colores que
       usa el resto del sistema — nada de una paleta propia para esta pantalla. */
    .vol-phase {
        display: flex;
        gap: var(--csa-sp-4);
        align-items: center;
        margin-bottom: var(--csa-sp-4);
        padding: var(--csa-sp-4) var(--csa-sp-5);
        border: 1px solid var(--csa-rule-soft);
        border-radius: var(--csa-radius-lg);
        background: var(--csa-surface);
    }
    .vol-phase__icon { flex-shrink: 0; font-size: var(--csa-fs-lg); line-height: 1.2; }
    .vol-phase__body { flex: 1 1 auto; min-width: 0; }
    .vol-phase__title {
        margin: 0;
        font-size: var(--csa-fs-md);
        font-weight: 600;
        color: var(--csa-ink);
    }
    .vol-phase__note {
        margin: var(--csa-sp-1) 0 0;
        font-size: var(--csa-fs-sm);
        line-height: var(--csa-lh-normal);
        color: var(--csa-ink-soft);
    }
    .vol-phase__actions { flex-shrink: 0; }

    /* La cifra de la franja: en serif, como el resto de cifras destacadas. */
    .vol-phase__figure { flex-shrink: 0; text-align: right; }
    .vol-phase__figure-value {
        display: block;
        font-family: var(--csa-serif);
        font-size: var(--csa-fs-xl);
        line-height: var(--csa-lh-tight);
        color: var(--csa-ink);
    }
    .vol-phase__figure-label {
        display: block;
        font-size: var(--csa-fs-xs);
        color: var(--csa-ink-muted);
    }

    /* Ocre y no rojo cuando faltan plazas: es una petición, no un error, y
       normalmente queda tiempo de sobra para resolverla. */
    .vol-phase--warn { background: color-mix(in srgb, var(--csa-ochre-soft) 35%, var(--csa-surface)); border-color: var(--csa-ochre-soft); }
    .vol-phase--warn .vol-phase__icon { color: var(--csa-ochre); }
    .vol-phase--ok { background: color-mix(in srgb, var(--csa-green-soft) 35%, var(--csa-surface)); border-color: var(--csa-green-soft); }
    .vol-phase--ok .vol-phase__icon { color: var(--csa-green); }
    .vol-phase--info { background: color-mix(in srgb, var(--csa-sky-soft) 30%, var(--csa-surface)); border-color: var(--csa-sky-soft); }
    .vol-phase--info .vol-phase__icon { color: var(--csa-sky); }
    .vol-phase--quiet { background: var(--csa-surface-alt); }
    .vol-phase--quiet .vol-phase__icon { color: var(--csa-ink-muted); }

    /* El día de la tarea es el único momento con un trabajo que hacer AHÍ, con
       el móvil en la mano: es la única franja con el verde entero. */
    .vol-phase--today { background: var(--csa-green); border-color: var(--csa-green); }
    .vol-phase--today .vol-phase__icon,
    .vol-phase--today .vol-phase__title,
    .vol-phase--today .vol-phase__figure-value { color: #fff; }
    .vol-phase--today .vol-phase__note,
    .vol-phase--today .vol-phase__figure-label { color: rgba(255, 255, 255, 0.85); }

    @media (max-width: 640px) {
        .vol-phase { flex-wrap: wrap; }
        .vol-phase__figure { text-align: left; }
        .vol-phase__actions { width: 100%; }
        .vol-phase__actions .csa-btn { width: 100%; justify-content: center; }
    }

    /* ---- Lo que se lee | lo que se consulta ----
       Dos columnas: la descripción manda la altura, y los tres datos de un
       vistazo van al lado en vez de en una tira que ocupaba dos filas. */
    .vol-split {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 21rem;
        gap: var(--csa-sp-4);
        align-items: start;
        margin-bottom: var(--csa-sp-4);
    }
    .vol-split .prt-card { margin-bottom: 0; }

    .vol-facts {
        background: var(--csa-surface);
        border: 1px solid var(--csa-rule-soft);
        border-radius: var(--csa-radius-lg);
        overflow: hidden;
    }
    .vol-fact {
        display: flex;
        align-items: flex-start;
        gap: var(--csa-sp-3);
        padding: var(--csa-sp-4);
        border-bottom: 1px solid var(--csa-rule-soft);
    }
    .vol-fact:last-child { border-bottom: 0; }
    .vol-fact > i { margin-top: 2px; color: var(--csa-ink-muted); }
    .vol-fact__value {
        display: block;
        font-size: var(--csa-fs-base);
        font-weight: 600;
        color: var(--csa-ink);
    }
    /* Sólo la PRIMERA letra. Con `text-transform: capitalize` se ponía en
       mayúscula cada palabra y salía "Lunes, 31 De Agosto De 2026" y "0,5 H". */
    .vol-fact__value::first-letter { text-transform: uppercase; }
    .vol-fact__value--muted { font-weight: 500; color: var(--csa-ink-muted); }
    .vol-fact__sub {
        display: block;
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-soft);
    }

    @media (max-width: 900px) {
        .vol-split { grid-template-columns: 1fr; }
    }

    /* ---- Quien coordina ----
       Al pie de lo que hay que hacer, con su teléfono: es a quien se llama si
       algo pasa ese día. */
    .vol-owner {
        display: flex;
        align-items: center;
        gap: var(--csa-sp-3);
        margin-top: var(--csa-sp-4);
        padding-top: var(--csa-sp-4);
        border-top: 1px solid var(--csa-rule-soft);
    }
    .vol-owner__avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        border-radius: var(--csa-radius-pill);
        background: var(--csa-ochre-soft);
        color: var(--csa-amber);
        font-size: var(--csa-fs-xs);
        font-weight: 700;
        letter-spacing: 0.02em;
    }
    .vol-owner__who { display: flex; flex-direction: column; min-width: 0; }
    .vol-owner__role { font-size: var(--csa-fs-xs); color: var(--csa-ink-muted); }

    /* La tarea encima de la fecha, en la ficha de un turno: pequeña y enlace,
     * para que el hero diga «este día» y no vuelva a parecer la ficha de la
     * tarea. La hora va detrás del día, más ligera que él. */
    .vol-kicker {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
        font-size: var(--csa-fs-xs);
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--csa-ink-soft);
        text-decoration: none;
    }
    .vol-kicker:hover { color: var(--csa-ink); text-decoration: underline; }
    .vol-kicker__time { font-weight: 400; color: var(--csa-ink-soft); }

    .vol-owner__name { font-size: var(--csa-fs-base); font-weight: 600; color: var(--csa-ink); }
    .vol-owner__hours { font-size: var(--csa-fs-xs); color: var(--csa-ink-muted); }
    .vol-owner__contact { display: flex; gap: var(--csa-sp-3); margin-left: auto; }

    /* ---- Ocupación ----
       Quiénes son las plazas, no cuántas: "4 de 6" hay que leerlo y restar,
       cuatro fichas con iniciales y dos huecos se ven sin leer. */
    .vol-occupancy {
        display: flex;
        align-items: center;
        gap: var(--csa-sp-5);
        flex-wrap: wrap;
        margin-bottom: var(--csa-sp-4);
        padding: var(--csa-sp-4) var(--csa-sp-5);
        background: var(--csa-surface);
        border: 1px solid var(--csa-rule-soft);
        border-radius: var(--csa-radius-lg);
    }
    .vol-occupancy__count { display: flex; align-items: baseline; gap: var(--csa-sp-2); flex-wrap: wrap; }
    .vol-occupancy__label {
        flex-basis: 100%;
        font-size: var(--csa-fs-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--csa-ink-muted);
    }
    .vol-occupancy__value {
        font-family: var(--csa-serif);
        font-size: var(--csa-fs-2xl);
        line-height: 1;
        color: var(--csa-ink);
    }
    .vol-occupancy__of { font-size: var(--csa-fs-sm); color: var(--csa-ink-soft); white-space: nowrap; }

    .vol-occupancy__pips { display: flex; gap: var(--csa-sp-2); flex-wrap: wrap; }
    .vol-pip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: var(--csa-radius-md);
        font-size: var(--csa-fs-xs);
        font-weight: 700;
        letter-spacing: 0.02em;
    }
    .vol-pip--filled { background: var(--csa-green-soft); color: #3a5c2a; }
    /* El hueco va punteado y no relleno: se lee como "aquí falta alguien" y no
       como una ficha apagada. */
    .vol-pip--empty {
        border: 1.5px dashed var(--csa-rule);
        color: var(--csa-rule);
        font-weight: 400;
        font-size: var(--csa-fs-md);
    }

    .vol-occupancy__note {
        flex: 1 1 12rem;
        margin: 0;
        font-size: var(--csa-fs-sm);
        line-height: var(--csa-lh-normal);
        color: var(--csa-ink-soft);
    }
    .vol-occupancy__note strong { color: var(--csa-terracotta); font-weight: 600; }

    @media (max-width: 640px) {
        .vol-occupancy { gap: var(--csa-sp-3); }
        .vol-occupancy__note { flex-basis: 100%; }
    }

    /* ---- Una persona en la lista ----
       Avatar + nombre arriba, contexto debajo. El avatar no es adorno: en una
       lista de doce filas de texto, las iniciales dan un punto de anclaje para
       encontrar a alguien sin leer cada renglón. */
    .vol-person { display: flex; align-items: flex-start; gap: var(--csa-sp-3); }
    .vol-person__avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border-radius: var(--csa-radius-pill);
        background: var(--csa-green-soft);
        color: #3a5c2a;
        font-size: var(--csa-fs-xs);
        font-weight: 700;
    }
    .vol-person__body { min-width: 0; }
    .vol-person__top {
        display: flex;
        align-items: center;
        gap: var(--csa-sp-2);
        flex-wrap: wrap;
    }
    /* En la base de datos muchos nombres están en MAYÚSCULAS: se bajan y se
       recapitalizan por CSS, que respeta los compuestos ("ANA MARÍA" → "Ana
       María"). El filtro capitalize de Twig sólo tocaría la primera palabra. */
    .vol-person__name {
        font-size: var(--csa-fs-base);
        font-weight: 600;
        color: var(--csa-ink);
        text-transform: capitalize;
    }
    .vol-person__meta {
        display: flex;
        align-items: center;
        gap: var(--csa-sp-3);
        flex-wrap: wrap;
        margin-top: 2px;
        font-size: var(--csa-fs-xs);
        color: var(--csa-ink-muted);
    }
    /* La nota la escribe quien se apunta y suele ser un aviso ("llego tarde"):
       en ocre para que se lea antes que el resto del contexto. */
    .vol-person__note { color: var(--csa-amber); }
    .vol-person__note i { margin-right: 3px; }

    /* Fila separadora dentro de la tabla: quien coordina va aparte porque
       coordinar no es venir, y mezclarlo con la asistencia hace pensar que hay
       un brazo más del que hay. */
    .vol-people__sep td {
        padding-top: var(--csa-sp-4);
        font-size: var(--csa-fs-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--csa-ink-muted);
        border-bottom: 0;
    }

    /* Acciones de la fila: con caja, para que se lean como botones y no como
       iconos sueltos perdidos entre badges. */
    .vol-actions { display: flex; gap: var(--csa-sp-2); justify-content: flex-end; }
    .vol-actions__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        padding: 0;
        border: 1px solid var(--csa-rule-soft);
        border-radius: var(--csa-radius-sm);
        background: var(--csa-surface);
        color: var(--csa-ink-muted);
        font-size: var(--csa-fs-sm);
        text-decoration: none;
        cursor: pointer;
    }
    .vol-actions__btn:hover { border-color: var(--csa-ink-muted); color: var(--csa-ink); }
    .vol-actions__btn--danger:hover { border-color: var(--csa-terracotta); color: var(--csa-terracotta); }

    /* Cuánto lleva hecho cada quien, bajo su nombre. Terciario a propósito: es
       contexto para quien coordina, no una nota en su expediente. */
    .vol-track {
        display: block;
        margin-top: 2px;
        font-size: var(--csa-fs-xs);
        color: var(--csa-ink-muted);
    }

    /* Teléfono y correo en la fila. Iconos sueltos, sin caja: la columna de
       estado ya lleva badges y un botón más la volvería ilegible. */
    .vol-contact { display: inline-flex; gap: var(--csa-sp-2); margin-left: var(--csa-sp-2); }
    .vol-contact a { color: var(--csa-ink-muted); text-decoration: none; }
    .vol-contact a:hover { color: var(--csa-green); }

    /* Quien se dio de baja sigue en la lista —hace falta saber que se descolgó—
       pero baja de intensidad para que no compita con quien sí viene. */
    .vol-row--out { opacity: .55; }

    /* Minutos por persona en el cierre. Estrecho y con la unidad al lado: es un
       número de dos o tres cifras, no un campo de texto. */
    .vol-minutes { width: 4.5rem; display: inline-block; text-align: right; }
    .vol-minutes__unit { margin-left: var(--csa-sp-1); font-size: var(--csa-fs-xs); color: var(--csa-ink-muted); }

    /* El cierre: el total, la explicación y el botón, juntos y separados de la
       tabla. Cerrar suma horas a gente real y no se deshace solo, así que el
       total se ve ANTES de pulsar. */
    .vol-close {
        margin-top: var(--csa-sp-4);
        padding-top: var(--csa-sp-4);
        border-top: 1px solid var(--csa-rule-soft);
    }
    .vol-close__sum {
        margin: 0 0 var(--csa-sp-2);
        font-size: var(--csa-fs-sm);
        color: var(--csa-ink-soft);
    }
    .vol-close__sum strong {
        font-family: var(--csa-serif);
        font-size: var(--csa-fs-lg);
        font-weight: 500;
        color: var(--csa-ink);
    }

    /* ---- A quién pedírselo ----
       Una lista para leer y coger el teléfono, no una tabla. Sin cifras de
       aportación a propósito: el orden ya reparte la carga y publicar el
       contador de cada cual convertiría esto en el marcador que se quiere
       evitar. */
    .vol-suggest { list-style: none; margin: 0 0 var(--csa-sp-3); padding: 0; }
    .vol-suggest li {
        display: flex;
        gap: var(--csa-sp-4);
        align-items: center;
        justify-content: space-between;
        padding: var(--csa-sp-3) 0;
        border-bottom: 1px solid var(--csa-rule-soft);
    }
    .vol-suggest li:last-child { border-bottom: 0; }
    .vol-suggest__who { min-width: 0; }
    .vol-suggest__name { display: block; font-size: var(--csa-fs-base); color: var(--csa-ink); }
    .vol-suggest__why {
        display: block;
        margin-top: 2px;
        font-size: var(--csa-fs-xs);
        color: var(--csa-ink-muted);
    }
    .vol-suggest__contact { display: flex; gap: var(--csa-sp-2); flex-shrink: 0; }
    /* El formulario de «pedírselo» no debe formar caja: así su botón es un item
       flex más, en fila con el teléfono y el correo, y hereda el `flex: 1` que
       los estira en móvil. Sin esto el form se lleva el ancho y el botón sale
       descolgado de la fila. */
    .vol-suggest__contact form { display: contents; }

    @media (max-width: 640px) {
        .vol-suggest li { flex-direction: column; align-items: stretch; }
        .vol-suggest__contact { width: 100%; }
        .vol-suggest__contact .csa-btn { flex: 1; justify-content: center; }
    }

    /* ---- Tareas de la home del panel ----
       Móvil primero: una columna, botones de 46px y nada que dependa del hover.
       Quien mira esto lo hace de pie y con una mano. */

    /* El aviso de cuánto hace falta. Va antes de las tarjetas porque da la
       escala: tres tarjetas sin contexto parecen todo lo que hay. */
    .vol-need { margin-bottom: var(--csa-sp-3); }
    .vol-need__lead {
        display: flex; align-items: flex-start; gap: var(--csa-sp-2);
        margin: 0;
        font-size: var(--csa-fs-sm); line-height: var(--csa-lh-snug);
        color: var(--csa-ink);
    }
    /* El triángulo, en gris. Encabeza tarjetas que ya no llevan alarma ninguna:
       un aviso rojo sobre una lista tranquila es el único grito de la pantalla y
       lo daba un icono decorativo, no un dato. La misma regla que las tarjetas
       —terracota sólo para lo destructivo— vale también aquí. */
    .vol-need__lead > i { color: var(--csa-ink-muted); margin-top: 2px; flex-shrink: 0; }
    .vol-need__sub {
        display: block; margin-top: 2px;
        font-size: var(--csa-fs-xs); color: var(--csa-ink-muted);
    }

    .vol-tasks { display: flex; flex-direction: column; gap: var(--csa-sp-3); }

    /* ---- LA TARJETA DE TURNO ----
       UN SOLO ACENTO: el botón verde. Y en un turno inminente, dos trozos de
       TEXTO en ámbar. Nada más.

       Antes tenía borde y franja lateral de color, cápsula gris del área,
       etiquetas azul y verde, pastilla terracota de "faltan N" y un corro de
       círculos con iniciales. En nueve tarjetas eso eran unos sesenta elementos
       con acento: la pantalla era un mosaico donde nada destacaba porque todo
       destacaba. Lo que se quitó de color vuelve por tipografía, orden y
       blanco. */
    .vol-task {
        background: var(--csa-surface);
        border: 1px solid var(--csa-rule);
        border-radius: var(--csa-radius-lg);
        padding: var(--csa-sp-4);
    }

    /* Ya vas: el verde pasa al borde y al fondo, y el botón desaparece — no hay
       nada que pulsar salvo deshacer. Es el único estado que tiñe la tarjeta,
       y puede porque es el que uno tiene de uno en uno, no de nueve en nueve. */
    .vol-task--mine { border-color: var(--csa-green); background: #f6faf1; }

    /* El área, en versalitas y en gris: no se pulsa, no avisa de nada y se
       repite en cada tarjeta. Como cápsula pesaba lo mismo que el título. */
    .vol-task__kicker {
        margin: 0;
        font-size: 11px; font-weight: 600; letter-spacing: 0.09em;
        text-transform: uppercase; color: var(--csa-ink-muted);
    }
    .vol-task__kicker--mine { color: var(--csa-green); }
    /* «no es de tus áreas, pero puedes venir»: la diferencia se dice con
       palabras. Bajarle el contraste a la tarjeta sería usar el lenguaje
       universal de «deshabilitado» para decir justo lo contrario. */
    .vol-task__aside {
        text-transform: none; letter-spacing: 0; font-weight: 500;
        color: var(--csa-ink-soft);
    }

    .csa-app .vol-task__title {
        margin: 7px 0 0;
        font-family: var(--csa-serif); font-weight: 400; font-size: var(--csa-fs-lg);
        line-height: var(--csa-lh-snug); letter-spacing: -0.012em;
        color: var(--csa-ink);
    }

    /* Cuánta gente falta: línea propia y en negro. En ÁMBAR y no en terracota
       cuando corre prisa — terracota es el color destructivo del sistema, y
       usarlo aquí enseñaba que el rojizo es donde uno se apunta. Y es texto,
       nunca relleno: una pastilla rellena en seis tarjetas seguidas deja de
       avisar. */
    .vol-task__need {
        margin: 9px 0 0;
        font-size: var(--csa-fs-base); font-weight: 600; color: var(--csa-ink);
    }
    .vol-task__need--now { color: var(--csa-amber); }

    /* El para-qué. En gris: es el motivo para ir, no un error del sistema. */
    .vol-task__why {
        margin: 5px 0 0;
        font-size: var(--csa-fs-sm); line-height: var(--csa-lh-normal);
        color: var(--csa-ink-soft);
    }

    /* Los tres datos que deciden —cuándo, dónde, cuánto cuesta— en tres líneas
       y no en chips sueltos: se leen de corrido y en voz alta. */
    .vol-task__meta {
        display: grid; gap: 4px;
        margin-top: 14px; padding-top: var(--csa-sp-3);
        border-top: 1px solid var(--csa-rule-soft);
        font-size: var(--csa-fs-sm); line-height: 1.35; color: var(--csa-ink-soft);
    }
    .vol-task__meta p { margin: 0; }
    .vol-task__when { color: var(--csa-ink); font-weight: 600; text-transform: capitalize; }
    /* «Hoy» y «Mañana» son el otro trozo en ámbar de un turno inminente. */
    .vol-task__when em { font-style: normal; color: var(--csa-amber); }

    /* Acompañantes: encima del botón y en una línea, para que no se lea como un
       segundo campo obligatorio. */
    .vol-task__companions {
        display: flex; align-items: center; gap: var(--csa-sp-2);
        margin-top: var(--csa-sp-3);
        font-size: var(--csa-fs-sm); color: var(--csa-ink-soft);
    }
    .vol-task__companions .csa-input { width: 68px; height: 44px; text-align: center; }

    /* 44px: el botón es el objetivo de toda la tarjeta y tiene que acertarse sin
       apuntar. A lo ancho porque no compite con nada. SIEMPRE verde, también en
       los urgentes: que el sitio donde uno dice que sí sea siempre igual vale
       más que subrayar la prisa una vez más. */
    .vol-task__cta {
        width: 100%; height: 44px; margin-top: 14px;
        border: 0; border-radius: var(--csa-radius-md); cursor: pointer;
        background: var(--csa-green); color: #fff;
        font-family: var(--csa-sans); font-size: var(--csa-fs-base); font-weight: 600;
    }
    .vol-task__cta:hover { opacity: 0.92; }

    /* Deshacer SÍ es destructivo: libera la plaza. Enlace y no botón, para que
       no compita con nada — es lo único terracota del módulo. */
    .vol-task__undo {
        margin-top: var(--csa-sp-3); padding: 0;
        background: none; border: 0; cursor: pointer;
        font-family: var(--csa-sans); font-size: var(--csa-fs-sm); font-weight: 500;
        color: var(--csa-terracotta); text-decoration: underline;
    }


    /* ---- Las cuatro pestañas del voluntariado del socix ----
       Sobre el componente canónico (.csa-tabs--folder), que ya envuelve solo por
       debajo de 768px. Aquí sólo lo que es propio de esta pantalla. */
    /* A LA IZQUIERDA, no centradas. El componente canónico centra con
       `width: fit-content; margin: 0 auto`, que va bien en Ajustes —una rejilla
       simétrica— pero aquí deja los rótulos flotando en mitad de la pantalla,
       lejos del contenido que encabezan y con el ojo saltando de un lado a otro
       al bajar. La navegación de una sección se lee donde empieza el texto. */
    .vol-tabs {
        width: 100%; margin: 0 0 var(--csa-sp-5); justify-content: flex-start;
    }
    /* Lo que hay por confirmar SÍ tiene que verse: es una pregunta con respuesta
       de un clic, y hasta que no se conteste esas horas no las tiene nadie. El
       gris del contador canónico —pensado para "Quién viene · 3"— aquí se pierde. */
    .vol-tabs .csa-tabs__count {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 18px; height: 18px; padding: 0 5px;
        border-radius: var(--csa-radius-pill);
        background: var(--csa-terracotta); color: #fff;
        font-size: 10.5px; font-weight: 700; opacity: 1;
    }
    .vol-tabs .csa-tabs__item.active .csa-tabs__count { color: #fff; opacity: 1; }

    /* Móvil: cuatro rótulos en dos filas. El componente ya las deja envolver;
       lo que falta es que no queden pegadas al borde ni desalineadas. */
    @media (max-width: 640px) {
        .vol-tabs { justify-content: center; }
    }

    /* ---- Montones de la pantalla de voluntariado ----
       Una regla arriba y el título en versalitas: separa sin añadir un marco más
       a una pantalla que ya vive dentro de una csa-card.

       SIN PUNTO DE COLOR. Eran tres puntos de tres colores distintos para decir
       algo que ya dicen el título y el orden: el primer montón es el urgente
       porque está primero y porque se llama «Falta gente ya». */
    .vol-group {
        border-top: 1px solid var(--csa-rule);
        margin-top: 28px; padding-top: var(--csa-sp-4);
    }
    .vol-group__head {
        display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--csa-sp-2);
        margin-bottom: var(--csa-sp-3);
    }
    .csa-app .vol-group__title {
        margin: 0;
        font-family: var(--csa-sans); font-weight: 600; font-size: var(--csa-fs-xs);
        letter-spacing: 0.1em; text-transform: uppercase; color: var(--csa-ink);
    }
    /* El contador, a la derecha y en gris: acompaña, no encabeza. */
    .vol-group__n { margin-left: auto; font-size: var(--csa-fs-sm); color: var(--csa-ink-muted); }
    /* El subtítulo baja a su propia línea: es lo que distingue un montón del de
       al lado, y en la misma fila que el título se perdía. */
    .vol-group__hint {
        flex-basis: 100%; margin-top: -7px;
        font-size: var(--csa-fs-sm); color: var(--csa-ink-soft);
    }
    .vol-group__more {
        margin: 14px 0 0;
        font-size: var(--csa-fs-sm); font-weight: 500; color: var(--csa-ink-soft);
    }

    /* Las dos respuestas de «¿pudiste ir?»: MISMO PESO Y NINGUNA VERDE. Es una
       pregunta de hecho, no una recomendación; pintar «sí, la hice» en primario
       empuja a decir que sí a quien no fue, y de ahí salen las horas del año de
       esa persona. */
    .vol-task__answers {
        display: grid; grid-template-columns: 1fr 1fr; gap: var(--csa-sp-2);
        margin-top: 14px;
    }
    .vol-task__answer {
        height: 44px; border-radius: var(--csa-radius-md); cursor: pointer;
        background: var(--csa-surface); color: var(--csa-ink);
        border: 1px solid #d9d4c4;
        font-family: var(--csa-sans); font-size: var(--csa-fs-base); font-weight: 600;
    }
    .vol-task__answer:hover { background: var(--csa-surface-alt); }

    /* ---- Mis áreas ----
       Sin tarjeta: la pantalla ES el bloque. Con una csa-card alrededor había
       dos títulos para lo mismo —«Mis áreas» en la pestaña y «Qué tareas te
       interesan» en la cabecera de la tarjeta— y un icono y una banda gris para
       envolver dos párrafos. */
    .vol-areas { max-width: 54ch; }
    .csa-app .vol-areas__state {
        margin: 0;
        font-size: var(--csa-fs-md); line-height: var(--csa-lh-snug); color: var(--csa-ink);
    }
    .vol-areas__note {
        margin: var(--csa-sp-2) 0 0;
        font-size: var(--csa-fs-sm); line-height: var(--csa-lh-normal); color: var(--csa-ink-soft);
    }
    /* La salida, separada del resto por una regla: no es una casilla más de la
       lista de áreas, es lo contrario de todas ellas. */
    .vol-areas__out {
        margin-top: var(--csa-sp-4); padding-top: var(--csa-sp-4);
        border-top: 1px solid var(--csa-rule);
    }
    .vol-areas__out-hint {
        margin: 6px 0 0 30px;
        font-size: var(--csa-fs-sm); color: var(--csa-ink-muted);
    }
    .vol-areas__save {
        height: 44px; margin-top: var(--csa-sp-4); padding: 0 var(--csa-sp-6);
        border: 0; border-radius: var(--csa-radius-md); cursor: pointer;
        background: var(--csa-green); color: #fff;
        font-family: var(--csa-sans); font-size: var(--csa-fs-base); font-weight: 600;
    }
    .vol-areas__save:hover { opacity: 0.92; }

    /* ---- El día a día, plegado en una fila ----
       Misma regla que un montón (línea arriba, título en versalitas) pero sin
       tarjetas debajo: son turnos de una plaza y un rato corto, y con el peso de
       un montón entero dejaban la faena de verdad a cuatro scrolls. */
    .vol-fold {
        display: flex; align-items: center; justify-content: space-between;
        gap: var(--csa-sp-4);
        border-top: 1px solid var(--csa-rule);
        margin-top: 28px; padding: 18px 0; min-height: 44px;
        text-decoration: none; color: inherit;
    }
    .vol-fold:hover { color: inherit; }
    .vol-fold__title {
        display: block;
        font-size: var(--csa-fs-xs); font-weight: 600;
        letter-spacing: 0.1em; text-transform: uppercase; color: var(--csa-ink);
    }
    .vol-fold__hint {
        display: block; margin-top: 5px;
        font-size: var(--csa-fs-sm); line-height: 1.4; color: var(--csa-ink-soft);
    }
    .vol-fold__go {
        flex-shrink: 0;
        font-size: var(--csa-fs-sm); font-weight: 500; color: var(--csa-ink-soft);
        white-space: nowrap;
    }

    /* ---- Filtros ----
       La activa en VERDE SUAVE y no en negro sólido. Un negro relleno es el
       elemento más pesado de la pantalla y estaba puesto en un control
       secundario: pesaba más que el botón donde uno se apunta.
       44px de alto porque se tocan con el pulgar, y envolviendo a dos filas en
       vez de con scroll horizontal, que esconde la cuarta opción sin avisar. */
    .vol-filters {
        display: flex; flex-wrap: wrap; gap: var(--csa-sp-2);
        margin-bottom: var(--csa-sp-4);
    }
    .vol-filter {
        display: inline-flex; align-items: center; gap: 6px;
        height: 44px; padding: 0 13px;
        border: 1px solid var(--csa-rule); border-radius: var(--csa-radius-pill);
        background: var(--csa-surface); color: var(--csa-ink-soft);
        font-family: var(--csa-sans); font-size: var(--csa-fs-sm); font-weight: 500;
        cursor: pointer;
    }
    .vol-filter--on {
        background: var(--csa-green-soft); border-color: var(--csa-green);
        color: var(--csa-ink); font-weight: 600;
    }
    .vol-filter__n { font-weight: 500; color: var(--csa-ink-muted); }
    .vol-filter--on .vol-filter__n { color: var(--csa-ink-soft); }

    @media (min-width: 640px) {
        .vol-tasks { display: grid; grid-template-columns: 1fr 1fr; }
        .vol-all { width: auto; padding: 0 var(--csa-sp-5); }
    }

    /* ---- Quién prepara tu cesta (home del socix) ----
       Una banda baja, no una tarjeta: cuelga de la franja de la próxima cesta y
       habla de esa misma entrega. Con el peso de una tarjeta competiría con ella. */
    .vol-prep {
        display: flex;
        align-items: center;
        gap: var(--csa-sp-3);
        margin-top: var(--csa-sp-2);
        padding: var(--csa-sp-3) var(--csa-sp-4);
        background: var(--csa-surface);
        border: 1px solid var(--csa-rule-soft);
        border-radius: var(--csa-radius-lg);
    }
    .vol-prep__faces { display: flex; flex-shrink: 0; }
    .vol-prep__face {
        width: 28px; height: 28px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: var(--csa-radius-pill);
        background: var(--csa-green-soft); color: var(--csa-green);
        border: 2px solid var(--csa-surface);
        font-size: var(--csa-fs-xs); font-weight: 700;
    }
    .vol-prep__face + .vol-prep__face { margin-left: -8px; }
    .vol-prep__text {
        margin: 0;
        font-size: var(--csa-fs-sm);
        line-height: var(--csa-lh-normal);
        color: var(--csa-ink-soft);
    }
    /* En la BBDD los nombres están en mayúsculas: se bajan y se recapitalizan por
       CSS, que respeta los compuestos ("MARIA JOSE" → "Maria Jose"). El filtro
       capitalize de Twig sólo tocaría la primera palabra. */
    .vol-prep__name { color: var(--csa-ink); font-weight: 600; text-transform: capitalize; }
    .vol-prep__plus { color: var(--csa-ink-muted); font-size: var(--csa-fs-xs); }
    .vol-prep__gap { color: var(--csa-ink-muted); }

    /* Sin nadie apuntadx: ocre, no rojo. Es una petición, no un error — y falta
       tiempo para resolverlo. El rojo aquí sería alarma sin causa. */
    .vol-prep--empty {
        align-items: flex-start;
        background: color-mix(in srgb, var(--csa-ochre-soft) 40%, var(--csa-surface));
        border-color: var(--csa-ochre-soft);
    }
    .vol-prep--empty .vol-prep__text { color: var(--csa-ink); }
    .vol-prep--empty .vol-prep__text strong { display: block; }
    .vol-prep__icon { color: var(--csa-ochre); flex-shrink: 0; line-height: 1.6; }
    .vol-prep__body { display: flex; flex-direction: column; gap: var(--csa-sp-3); align-items: flex-start; }

    /* ---- Tu aportación (home del socix) ----
       Fondo ocre muy suave: es el bloque cálido de la pantalla, no una alerta.
       Con el mismo blanco que las tarjetas se perdía dentro del listado de tareas. */
    .vol-gauge {
        padding: var(--csa-sp-4);
        margin-bottom: var(--csa-sp-4);
        background: color-mix(in srgb, var(--csa-ochre-soft) 28%, var(--csa-surface));
        border: 1px solid var(--csa-ochre-soft);
        border-radius: var(--csa-radius-lg);
    }
    .vol-gauge__head {
        display: flex; align-items: flex-end; justify-content: space-between;
        gap: var(--csa-sp-3); margin-bottom: var(--csa-sp-4);
    }
    .vol-gauge__label {
        display: block;
        font-size: var(--csa-fs-xs); font-weight: 600;
        letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--csa-ink-muted);
    }
    /* La cifra es el ancla del bloque y por eso pesa: a tamaño de subtítulo se
       leía como una etiqueta más y la barra de debajo se quedaba sin sujeto. */
    .vol-gauge__value {
        display: block; margin-top: var(--csa-sp-1);
        font-family: var(--csa-serif); font-size: 34px; font-weight: 500;
        letter-spacing: -0.02em; color: var(--csa-ink); line-height: 1;
    }
    /* La referencia del colectivo: presente pero en segundo plano. Compite con
       la cifra propia si se le da el mismo peso, y el sujeto de la frase es lo
       que ha hecho esta persona, no lo que hace el resto. */
    .vol-gauge__ref { text-align: right; flex-shrink: 0; }
    .vol-gauge__ref-label {
        display: block; font-size: var(--csa-fs-xs); color: var(--csa-ink-muted);
    }
    .vol-gauge__ref-value {
        display: block; margin-top: 2px;
        font-family: var(--csa-serif); font-size: var(--csa-fs-lg);
        color: var(--csa-ink-soft); line-height: 1.1;
    }

    /* La marca de la mediana necesita aire por debajo para no comerse el texto:
       sobresale del carril a propósito, para que se lea como una referencia
       externa y no como un tramo más de la barra. */
    .vol-gauge__track {
        position: relative; height: 10px; border-radius: var(--csa-radius-pill);
        background: var(--csa-surface-alt); border: 1px solid var(--csa-rule-soft);
    }
    .vol-gauge__track--marked { margin-bottom: var(--csa-sp-2); }
    .vol-gauge__fill {
        display: block; height: 100%; border-radius: var(--csa-radius-pill);
        background: var(--csa-green);
    }
    .vol-gauge__fill--behind { background: var(--csa-ochre); }
    .vol-gauge__mark {
        position: absolute; top: -4px; width: 2px; height: 18px;
        margin-left: -1px; border-radius: 1px; background: var(--csa-ink);
    }

    .vol-gauge__lead {
        margin: var(--csa-sp-3) 0 0;
        font-size: var(--csa-fs-sm); line-height: var(--csa-lh-normal);
        color: var(--csa-ink-soft);
    }
    .vol-gauge__lead strong { color: var(--csa-ink); }
    .vol-gauge__note {
        margin: var(--csa-sp-2) 0 0;
        font-size: var(--csa-fs-xs); color: var(--csa-ink-muted);
    }

    /* En móvil la acción cae debajo y ocupa el ancho: a 360px, dos columnas
       dejan el botón de "me apunto" en una tira de 90px. */
    @media (max-width: 640px) {
        .vol-item { flex-direction: column; }
        .vol-item__action { text-align: left; align-items: stretch; width: 100%; }
        .vol-item__slots { white-space: normal; }
        .vol-prep__body { width: 100%; }
        .vol-prep__body .csa-btn { width: 100%; justify-content: center; }
    }

/* Las pills de coordinación llegan en minúsculas desde el formulario (en la
 * base de datos los nombres están EN MAYÚSCULAS y así gritan); aquí se les
 * pone la inicial. Sólo dentro del buscador de casillas: en el resto de pills
 * —áreas, nodos— el texto ya viene bien escrito. */
[data-csa-check-filter] .csa-field input[type="checkbox"][name$="[]"] + label { text-transform: capitalize; }

/* Franjas horarias del formulario de tarea: dos horas y el botón de quitar en
   una fila. El botón se alinea con los campos, no con las etiquetas. */
.vol-slots { display: grid; gap: var(--csa-sp-3); }
.vol-slot { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; gap: var(--csa-sp-3); align-items: end; }
.vol-slot .csa-field + .csa-field { margin-top: 0; }
.vol-slot__remove { height: 40px; }
@media (max-width: 768px) {
  .vol-slot { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .vol-slot__remove { grid-column: 1 / -1; }
}
</style>
