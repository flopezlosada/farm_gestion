{#
 # Estilos del shell del panel del socix: la barra de pestañas de abajo y la hoja
 # «Más». Sólo los usa este shell, así que viven aquí y no en el CSS global —
 # el shell de gestión no tiene barra de pestañas ni la quiere.
 #
 # EL BREAKPOINT ES 900px Y NO ES ARBITRARIO: es exactamente donde
 # 03-components.css saca el sidebar de la pantalla. Con la barra apareciendo más
 # tarde (a 640, que es lo que pide el ojo) quedaba una franja entre 640 y 900
 # —una tablet en vertical, sin ir más lejos— con el sidebar ya escondido y la
 # barra todavía sin salir: sin ninguna navegación.
 #}
<style>
    .csa-tabbar { display: none; }

    @media (max-width: 900px) {
        .csa-tabbar {
            position: fixed; bottom: 0; left: 0; right: 0; z-index: 90;
            display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
            background: color-mix(in srgb, var(--csa-surface) 94%, transparent);
            backdrop-filter: blur(12px);
            border-top: 1px solid var(--csa-rule);
            /* El hueco de la barra de gestos del iPhone: sin esto, la última
               pestaña queda debajo de ella y no se puede pulsar. */
            padding-bottom: env(safe-area-inset-bottom, 0);
        }
        .csa-tabbar__item {
            /* 52px mínimo: por debajo de 44 un pulgar falla, y el pulgar es el
               único dedo disponible cuando se sostiene el móvil con una mano. */
            min-height: 52px;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            gap: 3px; padding: 6px 2px;
            background: none; border: none; cursor: pointer;
            font-family: var(--csa-sans); font-size: 10.5px; font-weight: 500;
            color: var(--csa-ink-muted); text-decoration: none;
        }
        .csa-tabbar__item i { font-size: 17px; }
        .csa-tabbar__item--active { color: var(--csa-green); font-weight: 700; }
        .csa-tabbar__item--active i { color: var(--csa-green); }

        /* Sitio para la barra al final del scroll: sin esto, el último botón de
           cualquier pantalla queda tapado y parece que no existe. */
        .csa-shell--tabbed .csa-content {
            padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px));
        }
    }

    /* ---- Hoja «Más» ---- */
    .csa-sheet { position: fixed; inset: 0; z-index: 120; }
    .csa-sheet[hidden] { display: none; }
    .csa-sheet__scrim { position: absolute; inset: 0; background: rgba(28, 29, 26, 0.38); }
    .csa-sheet__panel {
        position: absolute; left: 0; right: 0; bottom: 0;
        max-height: 82%; overflow: auto;
        background: var(--csa-bg);
        border-radius: var(--csa-radius-xl) var(--csa-radius-xl) 0 0;
        box-shadow: 0 -8px 32px rgba(28, 29, 26, 0.18);
        padding: var(--csa-sp-2) var(--csa-sp-4) calc(var(--csa-sp-6) + env(safe-area-inset-bottom, 0px));
    }
    .csa-sheet__grip {
        width: 36px; height: 4px; margin: var(--csa-sp-2) auto var(--csa-sp-3);
        border-radius: var(--csa-radius-pill); background: var(--csa-rule);
    }
    .csa-sheet__title {
        margin: 0 0 var(--csa-sp-3); font-family: var(--csa-serif);
        font-size: var(--csa-fs-lg); font-weight: 400; color: var(--csa-ink);
    }
    .csa-sheet__list { display: flex; flex-direction: column; gap: var(--csa-sp-2); }
    .csa-sheet__area {
        display: flex; align-items: center; gap: var(--csa-sp-3);
        min-height: 60px; padding: var(--csa-sp-3) var(--csa-sp-4);
        background: var(--csa-surface); border: 1px solid var(--csa-rule-soft);
        border-radius: var(--csa-radius-lg); text-decoration: none;
    }
    .csa-sheet__area--active { border-color: var(--csa-green); }
    .csa-sheet__area--quiet { background: transparent; }
    .csa-sheet__icon {
        width: 38px; height: 38px; flex-shrink: 0;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: var(--csa-radius-md);
        background: var(--csa-green-soft); color: var(--csa-green);
    }
    .csa-sheet__area--quiet .csa-sheet__icon { background: var(--csa-surface-alt); color: var(--csa-ink-muted); }
    .csa-sheet__body { flex: 1; min-width: 0; }
    .csa-sheet__label { display: block; font-size: var(--csa-fs-base); font-weight: 600; color: var(--csa-ink); }
    /* La explicación no es adorno: "Encuestas" no dice qué te van a preguntar. */
    .csa-sheet__hint { display: block; font-size: var(--csa-fs-xs); color: var(--csa-ink-muted); margin-top: 2px; }
    .csa-sheet__chevron { color: var(--csa-ink-muted); }

    /* ---------- MENÚ DE CUENTA (avatar de la topbar) ----------
       El <summary> pierde su triángulo nativo y se comporta como el enlace que
       era: mismo aspecto, ahora desplegable. */
    .csa-me[data-account-menu] { position: relative; }
    .csa-me[data-account-menu] > summary { list-style: none; cursor: pointer; }
    .csa-me[data-account-menu] > summary::-webkit-details-marker { display: none; }

    .csa-account-menu {
        position: absolute; top: calc(100% + 6px); right: 0; z-index: 40;
        min-width: 208px; padding: var(--csa-sp-2);
        background: var(--csa-surface); border: 1px solid var(--csa-rule);
        border-radius: var(--csa-radius-md); box-shadow: 0 8px 24px rgba(0,0,0,.12);
    }
    .csa-account-menu__group {
        font-size: var(--csa-fs-xs); text-transform: uppercase; letter-spacing: .04em;
        color: var(--csa-ink-muted); padding: var(--csa-sp-2) var(--csa-sp-3) var(--csa-sp-1);
    }
    .csa-account-menu a {
        display: flex; align-items: center; gap: var(--csa-sp-3);
        padding: var(--csa-sp-2) var(--csa-sp-3);
        border-radius: var(--csa-radius-sm);
        color: var(--csa-ink); font-size: var(--csa-fs-sm);
        text-decoration: none; border-bottom: 0;
    }
    /* Se fija el color también en :visited: el reset de Bootstrap 3 lo pisa y
       los enlaces ya visitados salían morados dentro del menú. */
    .csa-account-menu a:visited { color: var(--csa-ink); }
    .csa-account-menu a:hover { background: var(--csa-surface-alt); color: var(--csa-ink); text-decoration: none; }
    .csa-account-menu a i { width: 16px; text-align: center; color: var(--csa-ink-muted); }

    /* Cerrar sesión, separada y sin estridencias: es la única acción del menú
       que no se deshace sola volviendo atrás. */
    .csa-account-menu__out {
        margin-top: var(--csa-sp-2); padding-top: var(--csa-sp-3);
        border-top: 1px solid var(--csa-rule);
    }

    /* En móvil el menú se pega al borde y no se sale de la pantalla. */
    @media (max-width: 600px) {
        .csa-account-menu { right: -8px; min-width: 190px; }
    }

    /* ---------- AVISOS EN ESTE APARATO ----------
       Estado a la izquierda y acción a la derecha, como cualquier fila de
       ajustes: lo que pasa se lee, lo que se puede hacer se pulsa. Antes el
       botón era las dos cosas y no se sabía si "Avisos activados" era un estado
       o algo que iba a pasar al pulsarlo. */
    .csa-push {
        display: flex; align-items: flex-start; justify-content: space-between;
        gap: var(--csa-sp-4); flex-wrap: wrap;
    }
    .csa-push__main { flex: 1; min-width: 220px; }
    .csa-push__state { font-size: var(--csa-fs-base); color: var(--csa-ink); }
    /* La explicación sólo aparece cuando hay algo que explicar, y en pequeño:
       es la salida de un atasco, no el contenido de la tarjeta. */
    .csa-push__note {
        margin: var(--csa-sp-2) 0 0; max-width: 60ch;
        font-size: var(--csa-fs-sm); color: var(--csa-ink-muted);
    }
    .csa-push__btn { flex-shrink: 0; }

    /* En móvil el botón baja y ocupa el ancho: a esa anchura, un botón pequeño
       pegado al borde derecho es el objetivo más incómodo de la pantalla. */
    @media (max-width: 520px) {
        .csa-push { flex-direction: column; align-items: stretch; }
        .csa-push__btn { width: 100%; }
    }
</style>
