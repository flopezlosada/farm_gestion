{#
 # Un TURNO de voluntariado, como tarjeta.
 #
 # SUSTITUYE A UNA LISTA DE ENLACES. El teaser de la home enseñaba título y una
 # línea de meta, y para saber si podías ir había que abrir la tarea: cuándo
 # empieza y acaba, dónde, cuánto cuenta, cuánta gente falta y quién va ya. Cinco
 # datos que caben en la tarjeta y que son exactamente los que deciden si alguien
 # se apunta o no.
 #
 # ES DE UN TURNO Y NO DE UNA TAREA: lo que se decide es si puedes ir ESE DÍA. De
 # "sacar al perro" no se puede decir sí; del domingo por la mañana, sí.
 #
 # Y el botón está AQUÍ. Mandar a otra pantalla para decir que sí convierte un
 # gesto en un trámite, y quien tiene que pensárselo dos veces no vuelve. Es el
 # mismo endpoint que usa la tarjeta de "quién prepara tu cesta", así que
 # apuntarse desde la home no es un camino nuevo, es el mismo botón.
 #
 # POR QUÉ DICE PARA QUÉ SIRVE: la descripción no es adorno. "Desbrozar el camino
 # de la parcela de arriba" no le dice nada a quien no sabe qué pasa si no se
 # hace; con el porqué al lado, la petición deja de ser una tarea que alguien ha
 # apuntado y pasa a ser algo que hace falta.
 #
 # Espera: shift (VolunteerShift), my_node_id (para señalar el de su punto) y
 # csrf (token de panel_volunteering).
 #}
{% import '_macros/csa.html.twig' as csa %}

{% set offer = shift.offer %}
{% set faltan = shift.remainingSlots %}
{% set en_mi_punto = my_node_id and offer.node and offer.node.id == my_node_id %}
{# La regla de "urgente" vive en VolunteerShift::isUrgent(): la usan también el
 # grupo en el que cae el turno y el orden de la pantalla, y tres copias de un
 # umbral es la forma segura de que un día digan cosas distintas. #}
{% set urgente = shift.isUrgent %}

{# Los rasgos por los que se filtra viajan en el HTML: el filtro de la pantalla
 # de voluntariado es de navegador y no recarga, así que decide con lo que ya
 # está pintado. En la home no hay filtro y no estorban. #}
<article class="vol-task{% if urgente %} vol-task--urgent{% endif %}"
         data-vol-task
         data-vol-remote="{{ offer.remote ? '1' : '0' }}"
         data-vol-mine="{{ en_mi_punto ? '1' : '0' }}"
         data-vol-weekend="{{ shift.startsAt|date('N') >= 6 ? '1' : '0' }}">

    <div class="vol-task__tags">
        {% for category in offer.categories|slice(0, 1) %}
            {{ csa.badge(category.name, 'neutral', { no_dot: true }) }}
        {% endfor %}
        {% if offer.remote %}{{ csa.badge('Desde casa', 'sky', { no_dot: true }) }}{% endif %}
        {% if en_mi_punto %}{{ csa.badge('En tu punto de recogida', 'green', { no_dot: true }) }}{% endif %}
        {% if faltan %}
            <span class="vol-task__gap">
                <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
                {% if faltan == 1 %}Falta 1{% else %}Faltan {{ faltan }}{% endif %}
            </span>
        {% endif %}
    </div>

    <h3 class="vol-task__title">{{ offer.title }}</h3>

    {# EL PORQUÉ, y por ese orden: si quien organiza ha dicho qué pasa si no lo
     # hace nadie, eso es lo que va aquí. "Desbrozar el camino de la parcela de
     # arriba" no le dice nada a quien no sabe qué depende de eso.
     #
     # Sin consecuencia se cae a la descripción, recortada: aquí cabe el motivo,
     # no el parte entero, y quien quiera el detalle abre el calendario. Es
     # justamente ese recorte el que hacía imposible fiar el porqué a la
     # descripción — escrito al final, se perdía. #}
    {% if offer.consequence %}
        <p class="vol-task__why{% if urgente %} vol-task__why--urgent{% endif %}">{{ offer.consequence }}</p>
    {% elseif offer.description %}
        <p class="vol-task__why">{{ offer.description|striptags|u.truncate(150, '…', false) }}</p>
    {% endif %}

    <ul class="vol-task__facts">
        <li>
            <i class="fa fa-calendar-o" aria-hidden="true"></i>
            <span>
                <strong>{{ shift.startsAt|format_date(pattern="EEE d 'de' MMMM", locale='es') }}</strong>
                {%- if shift.startsAt|date('H:i') != '00:00' %}
                    · {{ shift.startsAt|date('H:i') }}{% if shift.endsAt %}–{{ shift.endsAt|date('H:i') }}{% endif %}
                {%- endif %}
            </span>
        </li>
        <li>
            <i class="fa fa-{{ offer.remote ? 'home' : 'map-marker' }}" aria-hidden="true"></i>
            <span>
                {%- if offer.remote -%}
                    Desde casa, a tu ritmo
                {%- elseif offer.node -%}
                    {{ offer.node }}
                {%- elseif offer.place -%}
                    {{ offer.place.name }}
                {%- elseif offer.placeNote -%}
                    {{ offer.placeNote }}
                {%- else -%}
                    Por concretar
                {%- endif -%}
            </span>
        </li>
        {% if shift.creditedMinutes %}
            <li>
                <i class="fa fa-clock-o" aria-hidden="true"></i>
                <span>Cuenta {{ (shift.creditedMinutes / 60)|round(1)|number_format(0, ',', '.') }} h</span>
            </li>
        {% endif %}
    </ul>

    {# Quién va ya. Es lo que convierte "hace falta gente" en "estas dos personas
     # van a estar allí": nadie se apunta el primero de buena gana, y ver una cara
     # conocida pesa más que el número de huecos. #}
    {% if shift.slots %}
        {% set dentro = shift.filledSlots %}
        {% set caras = shift.committedSignups|slice(0, 4) %}
        {# Los huecos libres, con tope de 4 para que un turno de veinte plazas no
         # dibuje una fila que se sale. Y con guarda: en Twig `1..0` cuenta hacia
         # atrás y pintaría DOS huecos justo cuando no queda ninguno. #}
        {% set libres = min(4, max(0, shift.slots - dentro)) %}
        <div class="vol-task__cover">
            <div class="vol-task__faces" aria-hidden="true">
                {% for signup in caras %}
                    <span class="vol-task__face">{{ signup.partner.name|first|upper }}</span>
                {% endfor %}
                {% if libres > 0 %}
                    {% for i in 1..libres %}
                        <span class="vol-task__face vol-task__face--empty"></span>
                    {% endfor %}
                {% endif %}
            </div>
            <span class="vol-task__count">{{ dentro }} de {{ shift.slots }}</span>
        </div>
    {% endif %}

    {# Sin enlace a una ficha propia: en el panel del socix no existe (la ficha del
     # turno vive en gestión). La tarjeta ya trae lo que decide, y para lo demás
     # está el calendario. #}
    <form method="post" action="{{ path('panel_volunteering_signup', { id: shift.id }) }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf }}">
        {# "Vengo con N más" donde la tarea lo admite. En una asociación de
         # unidades familiares llevarse a los peques es el caso normal, y este
         # campo sólo estaba en la lista vieja: al pasar la pantalla a tarjetas
         # se habría perdido en silencio. #}
        {% if offer.companionsAllowed %}
            <label class="vol-task__companions">
                Vengo con
                <input type="number" name="companions" value="0" min="0" max="10" class="csa-input csa-input--compact">
                más
            </label>
        {% endif %}
        <button type="submit" class="vol-task__cta">Me apunto</button>
    </form>

</article>
