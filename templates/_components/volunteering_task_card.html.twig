{#
 # Un TURNO de voluntariado, como tarjeta.
 #
 # ES DE UN TURNO Y NO DE UNA TAREA: lo que se decide es si puedes ir ESE DÍA. De
 # "sacar al perro" no se puede decir sí; del domingo por la mañana, sí.
 #
 # Y el botón está AQUÍ. Mandar a otra pantalla para decir que sí convierte un
 # gesto en un trámite, y quien tiene que pensárselo dos veces no vuelve.
 #
 # ── UN SOLO ACENTO POR TARJETA ──────────────────────────────────────────────
 #
 # La regla del módulo: color sólo para lo que puedes pulsar y para lo que está
 # en riesgo. Todo lo demás lo dicen la tipografía, el orden y el blanco.
 #
 # Esta tarjeta llegó a tener cuatro acentos a la vez —cápsula gris del área,
 # etiqueta azul "desde casa", etiqueta verde "en tu punto", pastilla terracota
 # "faltan 2"—, más borde y franja lateral de color si urgía, más un corro de
 # círculos verdes con iniciales. Apiladas, la pantalla era un mosaico en el que
 # nada destacaba porque todo destacaba, y la alarma había dejado de significar
 # alarma. En nueve tarjetas se contaron unos sesenta elementos con acento.
 #
 # Ahora: el botón verde, y en un turno inminente dos trozos de TEXTO en ámbar.
 # Ni bordes, ni franjas, ni pastillas, ni botones rojos.
 #
 # Lo que se quitó de color no se perdió: el área pasa a antetítulo, "desde
 # casa" y "en tu punto" viajan dentro de la línea del sitio (y además son
 # filtros), quién va se dice en palabras —"van 2 de 4"—, y la urgencia la
 # comunica el montón que contiene la tarjeta y su posición.
 #
 # TERRACOTA NO APARECE EN LOS ESTADOS AFIRMATIVOS. En este sistema es el color
 # destructivo (borrar, cancelar); usarlo para "faltan personas" y, peor, como
 # relleno del botón "Me apunto", enseñaba que un botón rojizo es donde uno se
 # apunta. Aquí sólo lo lleva "No voy a poder ir".
 #
 # Espera: shift (VolunteerShift), my_node_id, my_category_ids (para saber si es
 # de sus áreas), csrf (token de panel_volunteering) y mine (bool: la tarjeta se
 # pinta en estado «ya vas», con el enlace de baja en lugar del botón).
 #}
{% import '_macros/volunteering.html.twig' as vol %}

{% set offer = shift.offer %}
{% set faltan = shift.remainingSlots %}
{% set en_mi_punto = my_node_id and offer.node and offer.node.id == my_node_id %}
{% set apuntado = mine|default(false) %}

{# La regla de "urgente" vive en VolunteerShift::isUrgent(): la comparten el
 # montón en el que cae el turno y el orden, y tres copias de un umbral es la
 # forma segura de que un día digan cosas distintas. #}
{% set urgente = shift.isUrgent and not apuntado %}

{# De sus áreas o no. Sólo sirve para decirlo CON PALABRAS en el antetítulo: la
 # tarjeta es idéntica de nítida y lleva el mismo botón. Bajarle el contraste
 # sería usar el lenguaje universal de «deshabilitado» para decir justo lo
 # contrario, que es «puedes venir». #}
{% set areas = offer.categories %}
{% set de_otra_area = my_category_ids|default([]) is not empty and areas|length > 0
    and areas|filter(c => c.id in my_category_ids)|length == 0 %}

<article class="vol-task{% if apuntado %} vol-task--mine{% endif %}"
         data-vol-task
         data-vol-remote="{{ offer.remote ? '1' : '0' }}"
         data-vol-mine="{{ en_mi_punto ? '1' : '0' }}"
         data-vol-weekend="{{ shift.startsAt|date('N') >= 6 ? '1' : '0' }}">

    {# ── ANTETÍTULO ── el área, en versalitas y en gris. Era una cápsula y no
     # necesita serlo: no se pulsa, no avisa de nada y se repite en cada
     # tarjeta. #}
    <p class="vol-task__kicker{% if apuntado %} vol-task__kicker--mine{% endif %}">
        {%- if apuntado -%}
            Ya vas
        {%- else -%}
            {%- for category in areas|slice(0, 1) %}{{ category.name }}{% endfor -%}
            {%- if de_otra_area %}<span class="vol-task__aside"> · no es de tus áreas, pero puedes venir</span>{% endif -%}
        {%- endif -%}
    </p>

    <h3 class="vol-task__title">{{ offer.title }}</h3>

    {# A quien ya va no se le dice cuánta gente falta ni por qué hace falta: ya
     # dijo que sí. Eso es de la tarjeta que pide, no de la que confirma. #}
    {% if not apuntado %}
        {% if faltan %}
            <p class="vol-task__need{% if urgente %} vol-task__need--now{% endif %}">
                {% if faltan == 1 %}Falta 1 persona{% else %}Faltan {{ faltan }} personas{% endif %}
            </p>
        {% endif %}

        {# El porqué: si quien organiza ha dicho qué pasa si no lo hace nadie, eso
         # es lo que va aquí. Sin consecuencia se cae a la descripción, recortada.
         # En gris y no en rojo: es el motivo para ir, no un error del sistema. #}
        {% if offer.consequence %}
            <p class="vol-task__why">{{ offer.consequence }}</p>
        {% elseif offer.description %}
            <p class="vol-task__why">{{ offer.description|striptags|u.truncate(150, '…', false) }}</p>
        {% endif %}
    {% endif %}

    {# ── LOS TRES DATOS QUE DECIDEN ── cuándo, dónde y cuánto cuesta. En tres
     # líneas y no en chips sueltos: se leen de corrido y en voz alta. #}
    {% set hoy = shift.startsAt|date('Y-m-d') == 'now'|date('Y-m-d') %}
    {% set manana = shift.startsAt|date('Y-m-d') == 'tomorrow'|date('Y-m-d') %}
    <div class="vol-task__meta">
        <p class="vol-task__when">
            {%- if hoy %}<em>Hoy</em>, {% elseif manana %}<em>Mañana</em>, {% endif -%}
            {{- shift.startsAt|format_date(pattern="EEEE d", locale='es') -}}
            {%- if shift.startsAt|date('H:i') != '00:00' -%}
                {{ ' · ' }}{{- shift.startsAt|date('H:i') -}}
                {%- if shift.endsAt %}–{{ shift.endsAt|date('H:i') }}{% endif -%}
            {%- endif -%}
        </p>

        {# «Desde casa» y «en tu punto de recogida» viajan aquí dentro y no como
         # etiquetas de color: son matices del sitio, y además ya son filtros. #}
        <p>
            {%- if offer.remote -%}
                Desde casa, a tu ritmo
            {%- elseif offer.node -%}
                {{ offer.node }}{% if en_mi_punto %}, en tu punto de recogida{% endif %}
            {%- elseif offer.place -%}
                {{ offer.place.name }}
            {%- elseif offer.placeNote -%}
                {{ offer.placeNote }}
            {%- else -%}
                Por concretar
            {%- endif -%}
        </p>

        <p>
            {%- if shift.creditedMinutes %}Cuenta {{ vol.duration(shift.creditedMinutes) }}{% endif -%}
            {# A quien ya va se le dice con quién viene, que es SU dato, en vez
             # de cuánta gente falta, que ya no le toca resolver. #}
            {%- if apuntado and companions|default(0) > 0 -%}
                {%- if shift.creditedMinutes %} · {% endif -%}
                vas con {{ companions }} más
            {%- endif -%}
            {# Quién va, EN PALABRAS. Eran hasta cinco círculos con iniciales por
             # tarjeta —treinta y nueve en una pantalla— para decir un número que
             # cabe en cuatro palabras. Y de paso dejan de salir las iniciales de
             # unas socias en la pantalla de otras. #}
            {%- if shift.slots and not apuntado %}
                {%- if shift.creditedMinutes %} · {% endif -%}
                {%- if shift.filledSlots > 0 -%}
                    van {{ shift.filledSlots }} de {{ shift.slots }}
                {%- else -%}
                    no va nadie todavía
                {%- endif -%}
            {%- endif -%}
        </p>
    </div>

    {% if apuntado %}
        {# Lo único pulsable es deshacer, y eso sí es destructivo: libera la
         # plaza. Enlace y no botón, para que no compita con nada. #}
        <form method="post" action="{{ path('panel_volunteering_withdraw', { id: shift.id }) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf }}">
            <button type="submit" class="vol-task__undo">No voy a poder ir</button>
        </form>
    {% else %}
        <form method="post" action="{{ path('panel_volunteering_signup', { id: shift.id }) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf }}">
            {# "Vengo con N más" donde la tarea lo admite. En una asociación de
             # unidades familiares llevarse a los peques es el caso normal. #}
            {% if offer.companionsAllowed %}
                <label class="vol-task__companions">
                    Vengo con
                    <input type="number" name="companions" value="0" min="0" max="10" class="csa-input csa-input--compact">
                    más
                </label>
            {% endif %}
            <button type="submit" class="vol-task__cta">Me apunto</button>
        </form>
    {% endif %}

</article>
