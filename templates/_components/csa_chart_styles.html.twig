{# ============================================================
 # Estilos de los gráficos de barras de '_macros/csa.html.twig'
 # (hbar_chart / vbar_chart). Serie única, un solo color de marca:
 # la magnitud la codifica la LONGITUD de la barra, no el color.
 # ============================================================ #}
<style>
.csa-chart { display: flex; flex-direction: column; gap: 2px; }

/* ---------- horizontal (ranking) ---------- */
.csa-chart--hbar .csa-chart__hrow {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr) auto;
    align-items: center; gap: var(--csa-sp-3); padding: 5px 0;
}
.csa-chart__label {
    font-size: 12.5px; color: var(--csa-ink-soft, #5a564a);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.csa-chart__track {
    display: block; height: 14px; background: var(--csa-surface-2, #f2f2ef);
    border-radius: 4px; overflow: hidden;
}
.csa-chart__bar {
    display: block; height: 100%; min-width: 3px;
    background: var(--prt-sage-d, #2f4426); border-radius: 4px;
}
.csa-chart__value {
    font-variant-numeric: tabular-nums; font-size: 12.5px; font-weight: 600;
    color: var(--csa-ink, #1d1c17); white-space: nowrap; text-align: right;
}

/* ---------- vertical (tiempo) ---------- */
.csa-chart--vbar {
    flex-direction: row; align-items: flex-end; gap: var(--csa-sp-3);
    height: 160px; padding-top: 20px; /* hueco para la etiqueta de valor */
}
.csa-chart__vcol {
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
    flex: 1 1 0; height: 100%; min-width: 0;
}
.csa-chart__vtrack {
    display: flex; align-items: flex-end; width: 100%; max-width: 40px;
    height: 100%; background: var(--csa-surface-2, #f2f2ef); border-radius: 4px 4px 0 0;
    overflow: hidden;
}
.csa-chart__bar--v { width: 100%; min-height: 3px; border-radius: 4px 4px 0 0; }
.csa-chart__value--top { margin-bottom: 4px; }
.csa-chart__label--v {
    margin-top: 6px; font-size: 11px; color: var(--csa-ink-soft, #5a564a);
    max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

@media (max-width: 640px) {
    .csa-chart--hbar .csa-chart__hrow { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) auto; }
}
</style>
