{# ============================================================
 # Nuevo nodo de reparto — shell csa.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% form_theme form 'form_div_layout.html.twig' %}

{% block title %}Nuevo nodo de reparto{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('node_index') }}">Nodos de reparto</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">Nuevo</span>
{% endblock %}

{% block csa_main %}

    {{ csa.page_header(
        'Socixs · Reparto',
        'Nuevo nodo de reparto',
        'Sitio físico de entrega: día semanal y cadencia.'
    ) }}

    {{ form_start(form, { attr: { role: 'form', class: 'csa-form-narrow', 'data-csa-dropdowns': '' } }) }}

        <div class="csa-stack-lg">

            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Identidad', subtitle: 'Nombre del sitio.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.name, 'Nombre', { full: true }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '2', title: 'Reparto', subtitle: 'Día de la semana, cadencia y el dato que la concreta.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.deliveryWeekday, 'Día de reparto') }}
                        {{ csa.field(form.cadence, 'Cadencia') }}
                        {{ csa.field(form.anchorDate, 'Fecha ancla (sólo quincenal)') }}
                        {{ csa.field(form.monthlyWeek, 'Semana del mes (sólo mensual)') }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '3', title: 'Web pública', subtitle: 'Lo que ven lxs visitantes en la página Hazte socix.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.schedule, 'Horario público', { full: true }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {# Sólo existe con el módulo de voluntariado encendido: NodeType no
               añade los campos si está apagado, y pedirlos aquí reventaría. #}
            {% if form.deliveryPrep is defined %}
                {% embed '_components/csa_form_section.html.twig' with {
                    num: '4',
                    title: 'Montaje de las cestas',
                    subtitle: 'Si las cestas de este punto las monta gente voluntaria, y cuándo.'
                } %}
                    {% block body %}
                        {% import '_macros/csa.html.twig' as csa %}
                        {# La casilla viene del macro de voluntariado porque es
                           donde vive hoy; csa.field le pone `csa-input` a los
                           checkbox y salen como un cuadrado enorme suelto. #}
                        {% import '_macros/volunteering.html.twig' as vol %}
                        {{ vol.check(form.deliveryPrep, 'Este punto monta las cestas con voluntariado', 'cada semana que abra se convoca sola a la gente que hace falta') }}
                        <div class="csa-form-grid">
                            {{ csa.field(form.deliveryPrepDayOffset, 'Qué día se monta') }}
                            {{ csa.field(form.deliveryPrepTime, 'Hora del montaje') }}
                            {{ csa.field(form.deliveryPrepSlots, 'Cuánta gente hace falta') }}
                            {{ csa.field(form.deliveryPrepMinutes, 'Cuánto dura (minutos)') }}
                        </div>
                    {% endblock %}
                {% endembed %}
            {% endif %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: path('node_index') }) }}
                    <button type="submit" class="csa-btn csa-btn--primary">Crear nodo</button>
                </div>
            </div>

        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}

{% endblock %}
