{# ============================================================
 # Editar nodo de reparto — shell csa.
 # ============================================================ #}

{% extends '_layouts/csa_shell.html.twig' %}
{% import '_macros/csa.html.twig' as csa %}
{% form_theme form 'form_div_layout.html.twig' %}

{% block title %}Editar nodo · {{ node.name }}{% endblock %}

{% block csa_crumbs %}
    <a href="{{ path('dashboard') }}">Inicio</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <a href="{{ path('node_index') }}">Nodos de reparto</a>
    <span class="csa-topbar__crumbs-sep">/</span>
    <span class="csa-topbar__crumb-active">{{ node.name }}</span>
{% endblock %}

{% block csa_main %}

    {{ csa.page_header(
        'Socixs · Reparto',
        'Editar ' ~ node.name,
        node.weeklyBasketGroups|length ~ ' grupo(s) asociado(s).'
    ) }}

    {# El cambio de cadencia se ha rechazado: dejaría cestas que este punto no
       puede repartir. Se listan para corregirlas antes de volver a intentarlo —
       a qué modalidad pasa cada socio lo decide administración, no el sistema. #}
    {% if orphaned_shares is defined and orphaned_shares is not empty %}
        <div class="csa-card csa-stack" style="border-color: var(--csa-danger); margin-bottom: var(--csa-sp-5);">
            {{ csa.callout(
                'No se ha cambiado la cadencia' ~ (attempted_cadence ? ' a ' ~ attempted_cadence|lower : '') ~
                ': hay ' ~ orphaned_shares|length ~ ' cesta(s) que este punto no podría repartir. Cámbiales la modalidad primero.',
                'danger', 'exclamation-triangle'
            ) }}
            <ul class="csa-stack-sm" style="margin: 0; padding-left: var(--csa-sp-5);">
                {% for share in orphaned_shares %}
                    <li>
                        <a href="{{ path('partner_show', { id: share.partner.id }) }}">{{ share.partner.nameForDelivery }}</a>
                        · cesta {{ share.basketShare.name|lower }}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {{ form_start(form, { attr: { role: 'form', class: 'csa-form-narrow', 'data-csa-dropdowns': '' } }) }}

        <div class="csa-stack-lg">

            {% embed '_components/csa_form_section.html.twig' with { num: '1', title: 'Identidad', subtitle: 'Nombre del sitio.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.name, 'Nombre', { full: true }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '2', title: 'Reparto', subtitle: 'Día de la semana, cadencia y el dato que la concreta.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.deliveryWeekday, 'Día de reparto') }}
                        {{ csa.field(form.cadence, 'Cadencia') }}
                        {{ csa.field(form.anchorDate, 'Fecha ancla (sólo quincenal)') }}
                        {{ csa.field(form.monthlyWeek, 'Semana del mes (sólo mensual)') }}
                    </div>
                    {# Aviso ANTES de tocar nada: cambiar la semana del punto
                       arrastra a sus cestas mensuales, no sólo al calendario. #}
                    {% if monthly_share_count is defined and monthly_share_count > 0 %}
                        {{ csa.callout(
                            'Este punto tiene ' ~ monthly_share_count ~ ' cesta(s) mensual(es). Si cambias la semana, se les actualizará a todas y se recolocarán los listados ya generados.',
                            'warning', 'exclamation-triangle'
                        ) }}
                    {% endif %}
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with { num: '3', title: 'Web pública', subtitle: 'Lo que ven lxs visitantes en la página Hazte socix.' } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    <div class="csa-form-grid">
                        {{ csa.field(form.schedule, 'Horario público', { full: true }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed '_components/csa_form_section.html.twig' with {
                num: '4',
                title: 'Quién recibe el listado',
                subtitle: 'A quién le llega por correo el listado de este punto en cuanto cierra su plazo de cambios.'
            } %}
                {% block body %}
                    {% import '_macros/csa.html.twig' as csa %}
                    {# Sin candidatas el campo sale vacío y nadie sabe por qué: la
                     # lista la alimenta Usuarias, no esta pantalla. #}
                    {% if form.sheetRecipients.vars.choices is empty %}
                        {{ csa.callout('Todavía no hay ninguna cuenta del equipo a la que mandárselo. Se habilita dando permisos de gestión en Administración › Usuarias.', 'warning', 'exclamation-triangle') }}
                    {% endif %}

                    <div class="csa-form-grid">
                        {{ csa.field(form.sheetRecipients, 'Quién recibe el listado de este punto', {
                            full: true,
                            hint: 'si no marcas a nadie, se manda a la dirección general de Ajustes'
                        }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="csa-row-between" style="padding-top: var(--csa-sp-5); border-top: 1px solid var(--csa-rule);">
                <div></div>
                <div class="csa-row">
                    {{ csa.btn('Cancelar', { variant: 'ghost', href: path('node_index') }) }}
                    <button type="submit" class="csa-btn csa-btn--primary">Guardar cambios</button>
                </div>
            </div>

        </div>

        {{ form_rest(form) }}
    {{ form_end(form, { render_rest: false }) }}

{% endblock %}
